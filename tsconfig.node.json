{
  "compilerOptions": {
    "target": "es2023",
    "lib": [
      "ES2023"
    ],
    "module": "nodenext",
    "types": [
      "node"
    ],
    "noEmit": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noPropertyAccessFromIndexSignature": true,
    "erasableSyntaxOnly": true
  },
  "include": [
    "vite.config.ts",
    "scripts/**/*.ts",
    ".claude/hooks/*.ts"
  ]
}
