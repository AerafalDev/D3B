{
  "name": "d3b",
  "private": true,
  "version": "0.10.0",
  "license": "MIT",
  "type": "module",
  "packageManager": "bun@1.4.3",
  "engines": {
    "bun": ">=1.4.3"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "tauri": "tauri",
    "app": "tauri dev",
    "check": "bun run check:web && bun run check:rust",
    "check:web": "biome check . && bun run typecheck && bun run test && bun run rules",
    "rules": "bun scripts/check-folders.ts",
    "pr:size": "bun scripts/check-pr-size.ts",
    "data:fetch": "bun scripts/fetch-data.ts",
    "check:rust": "cargo fmt --manifest-path src-tauri/Cargo.toml --check && cargo clippy --manifest-path src-tauri/Cargo.toml --all-targets -- -D warnings && cargo test --manifest-path src-tauri/Cargo.toml",
    "fix": "biome check --write . && cargo fmt --manifest-path src-tauri/Cargo.toml",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.node.json",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@dnd-kit/core": "6.3.1",
    "@fontsource-variable/geist": "5.3.0",
    "@monaco-editor/react": "4.7.0",
    "@tailwindcss/vite": "4.3.5",
    "@tauri-apps/api": "2.12.4",
    "@tauri-apps/plugin-log": "2.10.2",
    "@tauri-apps/plugin-opener": "2.7.3",
    "@tauri-apps/plugin-process": "2.4.0",
    "@tauri-apps/plugin-updater": "2.14.1",
    "@xterm/addon-fit": "0.11.0",
    "@xterm/xterm": "6.0.0",
    "@xyflow/react": "12.12.1",
    "class-variance-authority": "0.7.1",
    "cmdk": "1.1.1",
    "cn": "0.5.2",
    "dockview-react": "8.9.0",
    "elkjs": "0.12.1",
    "i18next": "27.1.1",
    "lucide-react": "1.72.0",
    "next-themes": "0.4.6",
    "radix-ui": "1.8.1",
    "react": "19.3.1",
    "react-arborist": "4.0.1",
    "react-dom": "19.3.1",
    "react-hook-form": "7.92.0",
    "react-hotkeys-hook": "5.4.0",
    "react-i18next": "18.0.1",
    "react-resizable-panels": "4.21.0",
    "shadcn": "4.23.0",
    "sonner": "2.0.8",
    "tailwindcss": "4.3.5",
    "tw-animate-css": "1.4.0",
    "zod": "4.6.7",
    "zundo": "2.3.0",
    "zustand": "5.1.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.6",
    "@tauri-apps/cli": "2.12.4",
    "@testing-library/react": "16.3.3",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "happy-dom": "21.0.4",
    "typescript": "7.0.2",
    "vite": "8.3.8",
    "vitest": "5.1.0"
  }
}
