<Application
    x:Class="D3B.App.App"
    x:ClassModifier="internal"
    Name="D3B"
    RequestedThemeVariant="Dark"
    xmlns="https://github.com/avaloniaui"
    xmlns:shadui="clr-namespace:ShadUI;assembly=ShadUI"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceInclude Source="avares://D3B.App/Themes/Icons.axaml" />
                <ResourceInclude Source="avares://D3B.App/Themes/Controls.axaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>
    <Application.Styles>
        <shadui:ShadTheme />
        <StyleInclude Source="avares://D3B.App/Themes/Styles.axaml" />
    </Application.Styles>
</Application>
