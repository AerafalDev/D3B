<Application
    x:Class="D3B.App.App"
    x:ClassModifier="internal"
    Name="D3B"
    RequestedThemeVariant="Dark"
    xmlns="https://github.com/avaloniaui"
    xmlns:c="clr-namespace:D3B.App.Controls"
    xmlns:shadui="clr-namespace:ShadUI;assembly=ShadUI"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <ResourceDictionary>
            <c:MapPalette
                x:Key="MapPalette"
                Ally="#2DD4BF"
                Bot="#FAFAFA"
                ChallengerCell="#66EF4444"
                Character="#3B82F6"
                CharacterRing="#DBEAFE"
                DefenderCell="#663B82F6"
                Door="#F59E0B"
                Element="#A78BFA"
                Enemy="#F87171"
                Exit="#38BDF8"
                ExitFill="#4738BDF8"
                Grid="#2A2A30"
                Harvested="#3F6B4A"
                Hover="#FAFAFA"
                Npc="#F472B6"
                Obstacle="#3A3A42"
                Resource="#22C55E"
                Stairs="#5A4A2E"
                Unknown="#71717A"
                Walkable="#1C1C20"
                Zone1="#1D2533"
                Zone2="#2B1F36"
                Zone3="#1F3328"
                Zone4="#36261D" />
            <CornerRadius x:Key="SmCornerRadius">6</CornerRadius>
            <CornerRadius x:Key="MdCornerRadius">7</CornerRadius>
            <CornerRadius x:Key="LgCornerRadius">10</CornerRadius>
            <CornerRadius x:Key="XlCornerRadius">12</CornerRadius>
            <ResourceDictionary.MergedDictionaries>
                <ResourceInclude Source="avares://D3B.App/Themes/Colors.axaml" />
                <ResourceInclude Source="avares://D3B.App/Themes/IntelliJIcons.axaml" />
                <ResourceInclude Source="avares://D3B.App/Themes/Icons.axaml" />
                <ResourceInclude Source="avares://D3B.App/Themes/Controls.axaml" />
                <ResourceInclude Source="avares://D3B.App/Themes/Menus.axaml" />
                <ResourceInclude Source="avares://D3B.App/Themes/Window.axaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>
    <Application.Styles>
        <shadui:ShadTheme />
        <StyleInclude Source="avares://D3B.App/Themes/Styles.axaml" />
    </Application.Styles>
</Application>
