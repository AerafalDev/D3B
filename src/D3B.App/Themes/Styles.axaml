<Styles
    xmlns="https://github.com/avaloniaui"
    xmlns:c="clr-namespace:D3B.App.Controls"
    xmlns:shadui="clr-namespace:ShadUI;assembly=ShadUI"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!--  Every size here and in the views is one of one scale, so that the pages agree (D159, D335): spacings 4, 8, 12, 16,
         24, 32; fonts 11, 12, 12.5 the studio's text, 14 the pages', 16, 22, 28; the studio's controls 24 to 30 high, the
         pages' 32 and 36; radii 6, 7, 10, 12, round; icons 12, 14, 16, 20. The studio's frame follows the mockup,
         docs/mockups/studio-7c.html; the pages it keeps until 7c3 and 7c4 keep their own.  -->
    <Style Selector="TextBlock.Caption">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="Normal" />
    </Style>
    <Style Selector="TextBlock.Label">
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontWeight" Value="Medium" />
    </Style>
    <Style Selector="TextBlock.Title">
        <Setter Property="FontSize" Value="16" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="TextBlock.PageTitle">
        <Setter Property="FontSize" Value="22" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="TextBlock.Figure">
        <Setter Property="FontSize" Value="28" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="FontFeatures" Value="+tnum" />
    </Style>
    <Style Selector="TextBlock.Figures">
        <Setter Property="FontFeatures" Value="+tnum" />
    </Style>
    <Style Selector="TextBlock.Muted">
        <Setter Property="Foreground" Value="{DynamicResource MutedColor}" />
    </Style>
    <Style Selector="TextBlock.Problem">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{DynamicResource ErrorColor}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style Selector="TextBlock.Mono, SelectableTextBlock.Mono">
        <Setter Property="FontFamily" Value="Cascadia Mono, Consolas, Courier New" />
        <Setter Property="FontSize" Value="12" />
    </Style>
    <Style Selector="SelectableTextBlock.Mono">
        <Setter Property="LineHeight" Value="20" />
    </Style>

    <Style Selector="StackPanel.PageHeader">
        <Setter Property="Margin" Value="32,24,32,16" />
        <Setter Property="Spacing" Value="4" />
    </Style>
    <Style Selector="Border.Card, Border.Plate">
        <Setter Property="Background" Value="{DynamicResource CardBackgroundColor}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderColor}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="12" />
    </Style>
    <Style Selector="Border.Card">
        <Setter Property="Padding" Value="16" />
    </Style>
    <Style Selector="Border.Card.Flush">
        <Setter Property="Padding" Value="0" />
    </Style>
    <Style Selector="Border.Card.Warned, Border.Plate.Warned">
        <Setter Property="BorderBrush" Value="{DynamicResource WarningColor60}" />
    </Style>
    <Style Selector="Border.PlateFooter">
        <Setter Property="Background" Value="{DynamicResource PlateFooterColor}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderColor}" />
        <Setter Property="BorderThickness" Value="0,1,0,0" />
        <Setter Property="CornerRadius" Value="0,0,11,11" />
        <Setter Property="Padding" Value="16,12" />
    </Style>
    <Style Selector="Border.PlateFooter.Warned">
        <Setter Property="Background" Value="{DynamicResource WarningColor5}" />
        <Setter Property="BorderBrush" Value="{DynamicResource WarningColor60}" />
    </Style>
    <Style Selector="Border.Row">
        <Setter Property="BorderBrush" Value="{DynamicResource BorderColor}" />
        <Setter Property="BorderThickness" Value="0,1,0,0" />
        <Setter Property="Padding" Value="0,12" />
        <Setter Property="MinHeight" Value="56" />
    </Style>
    <Style Selector="Border.Row:nth-child(1)">
        <Setter Property="BorderThickness" Value="0" />
    </Style>
    <Style Selector="Border.Inset">
        <Setter Property="Background" Value="{DynamicResource GhostColor}" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Padding" Value="12,8" />
    </Style>
    <Style Selector="Border.Banner">
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="12" />
        <Setter Property="Padding" Value="24" />
    </Style>
    <Style Selector="Border.Banner.Danger">
        <Setter Property="Background" Value="{DynamicResource ErrorColor5}" />
        <Setter Property="BorderBrush" Value="{DynamicResource ErrorColor60}" />
    </Style>
    <Style Selector="Border.Banner.Info">
        <Setter Property="Background" Value="{DynamicResource InfoColor5}" />
        <Setter Property="BorderBrush" Value="{DynamicResource InfoColor60}" />
    </Style>
    <Style Selector="Border.Banner.Strip">
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Padding" Value="16,8" />
    </Style>
    <Style Selector="Border.Code">
        <Setter Property="Background" Value="{DynamicResource CardBackgroundColor}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderColor}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Padding" Value="12" />
    </Style>
    <Style Selector="ItemsControl.Rows > ContentPresenter">
        <Setter Property="BorderBrush" Value="{DynamicResource BorderColor}" />
        <Setter Property="BorderThickness" Value="0,1,0,0" />
        <Setter Property="Padding" Value="0,12" />
    </Style>
    <Style Selector="StackPanel.Toolbar">
        <Setter Property="Orientation" Value="Horizontal" />
        <Setter Property="Spacing" Value="8" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!--  Every control of a toolbar or a row is 36 high, ShadUI's fields' height, so that a row lines up; only the icon
         buttons of a list's items are 32, inside their 40.  -->
    <Style Selector="Button.IconButton, ToggleButton.IconButton">
        <Setter Property="Width" Value="36" />
        <Setter Property="Height" Value="36" />
        <Setter Property="MinHeight" Value="36" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Foreground" Value="{DynamicResource MutedColor}" />
    </Style>
    <Style Selector="Button.IconButton.Compact">
        <Setter Property="Width" Value="32" />
        <Setter Property="Height" Value="32" />
        <Setter Property="MinHeight" Value="32" />
    </Style>
    <Style Selector="Button.IconButton:pointerover, ToggleButton.IconButton:pointerover, ToggleButton.IconButton:checked">
        <Setter Property="Foreground" Value="{DynamicResource ForegroundColor}" />
    </Style>
    <Style Selector="ToggleButton.IconButton:checked">
        <Setter Property="Background" Value="{DynamicResource GhostHoverColor}" />
    </Style>
    <Style Selector="Border.Segmented">
        <Setter Property="Background" Value="{DynamicResource GhostColor}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderColor}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Padding" Value="2" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.Segment, ToggleButton.Segment">
        <Setter Property="Height" Value="30" />
        <Setter Property="MinHeight" Value="30" />
        <Setter Property="Padding" Value="12,0" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Foreground" Value="{DynamicResource MutedColor}" />
    </Style>
    <Style Selector="Button.Segment.Selected, ToggleButton.Segment:checked">
        <Setter Property="Background" Value="{DynamicResource CardBackgroundColor}" />
        <Setter Property="Foreground" Value="{DynamicResource ForegroundColor}" />
    </Style>
    <Style Selector="Button.Segment.Selected /template/ ContentPresenter, ToggleButton.Segment:checked /template/ ContentPresenter">
        <Setter Property="BoxShadow" Value="0 1 2 0 #26000000" />
    </Style>

    <Style Selector="c|Icon.Small">
        <Setter Property="Width" Value="14" />
        <Setter Property="Height" Value="14" />
    </Style>
    <Style Selector="c|Icon.Large">
        <Setter Property="Width" Value="20" />
        <Setter Property="Height" Value="20" />
    </Style>
    <Style Selector="c|Icon.Muted">
        <Setter Property="Foreground" Value="{DynamicResource MutedColor}" />
    </Style>
    <Style Selector="c|Icon.Help">
        <Setter Property="Width" Value="14" />
        <Setter Property="Height" Value="14" />
        <Setter Property="Foreground" Value="{DynamicResource MutedColor}" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Cursor" Value="Help" />
    </Style>
    <Style Selector="c|Icon[Tone=Success]">
        <Setter Property="Foreground" Value="{DynamicResource SuccessColor}" />
    </Style>
    <Style Selector="c|Icon[Tone=Warning]">
        <Setter Property="Foreground" Value="{DynamicResource WarningColor}" />
    </Style>
    <Style Selector="c|Icon[Tone=Info]">
        <Setter Property="Foreground" Value="{DynamicResource InfoColor}" />
    </Style>
    <Style Selector="c|Icon[Tone=Danger]">
        <Setter Property="Foreground" Value="{DynamicResource ErrorColor}" />
    </Style>

    <Style Selector="Border.ItemIcon">
        <Setter Property="Width" Value="16" />
        <Setter Property="Height" Value="16" />
        <Setter Property="CornerRadius" Value="4" />
        <Setter Property="Background" Value="{DynamicResource GhostColor}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderColor}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Border.ItemIcon.HasIcon">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
    </Style>
    <Style Selector="Border.ItemIcon.Large">
        <Setter Property="Width" Value="32" />
        <Setter Property="Height" Value="32" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Padding" Value="4" />
    </Style>
    <Style Selector="Border.ItemIcon.Large.HasIcon">
        <Setter Property="Background" Value="{DynamicResource GhostColor}" />
        <Setter Property="BorderThickness" Value="1" />
    </Style>
    <Style Selector="Image.DetailIcon">
        <Setter Property="Width" Value="16" />
        <Setter Property="Height" Value="16" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style Selector="ProgressBar.Meter">
        <Setter Property="Height" Value="6" />
        <Setter Property="MinHeight" Value="6" />
        <Setter Property="Maximum" Value="100" />
        <Setter Property="Foreground" Value="{DynamicResource ForegroundColor}" />
        <Setter Property="Background" Value="{DynamicResource GhostColor}" />
    </Style>
    <Style Selector="ProgressBar.Meter.Thin">
        <Setter Property="Height" Value="4" />
        <Setter Property="MinHeight" Value="4" />
    </Style>
    <Style Selector="ProgressBar.Meter.Success">
        <Setter Property="Foreground" Value="{DynamicResource SuccessColor}" />
    </Style>
    <Style Selector="ProgressBar.Meter.Info">
        <Setter Property="Foreground" Value="{DynamicResource InfoColor}" />
    </Style>
    <Style Selector="ProgressBar.Meter.Warning">
        <Setter Property="Foreground" Value="{DynamicResource WarningColor}" />
    </Style>
    <Style Selector="ProgressBar.Meter.Danger">
        <Setter Property="Foreground" Value="{DynamicResource ErrorColor}" />
    </Style>


    <!--  The studio's frame (D320 to D322): panels as rounded blocks with a hairline edge on the window's near black, the
         focused one outlined in the accent; tabs as lit buttons; thin dark scrollbars seen on hover.  -->
    <Style Selector="Border.Dock">
        <Setter Property="Background" Value="{DynamicResource PanelColor}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderColor60}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="ClipToBounds" Value="True" />
    </Style>
    <Style Selector="Border.Dock.Recess">
        <Setter Property="Background" Value="{DynamicResource RecessColor}" />
    </Style>
    <Style Selector="Border.Dock.Focused">
        <Setter Property="BorderBrush" Value="{DynamicResource AccentEdgeColor}" />
    </Style>
    <Style Selector="Border.Strip">
        <Setter Property="Height" Value="36" />
        <Setter Property="Padding" Value="6,0" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderColor60}" />
        <Setter Property="BorderThickness" Value="0,0,0,1" />
    </Style>
    <Style Selector="Border.Dock c|AppPage /template/ Grid#PART_Body">
        <Setter Property="Margin" Value="24,16,24,24" />
    </Style>
    <Style Selector="Border.Dock.Compact c|AppPage /template/ Grid#PART_Body">
        <Setter Property="Margin" Value="10,8,10,10" />
    </Style>
    <Style Selector="Border.Dock c|AppPage /template/ Grid#PART_Header">
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="Margin" Value="0,0,0,8" />
    </Style>
    <Style Selector="Border.Dock c|AppPage TextBlock.PageTitle">
        <Setter Property="IsVisible" Value="False" />
    </Style>

    <Style Selector="Border.TabHost">
        <Setter Property="Height" Value="26" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="MaxWidth" Value="220" />
        <Setter Property="Transitions">
            <Transitions>
                <BrushTransition Duration="0:0:0.12" Property="Background" />
            </Transitions>
        </Setter>
    </Style>
    <Style Selector="Border.TabHost:pointerover">
        <Setter Property="Background" Value="{DynamicResource HoverColor}" />
    </Style>
    <Style Selector="Border.TabHost.On">
        <Setter Property="Background" Value="{DynamicResource RaisedColor}" />
    </Style>
    <Style Selector="Border.TabHost TextBlock.TabTitle">
        <Setter Property="FontWeight" Value="Normal" />
        <Setter Property="Foreground" Value="{DynamicResource MutedColor}" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>
    <Style Selector="Border.TabHost:pointerover TextBlock.TabTitle">
        <Setter Property="Foreground" Value="{DynamicResource ForegroundColor}" />
    </Style>
    <Style Selector="Border.TabHost.On TextBlock.TabTitle">
        <Setter Property="Foreground" Value="{DynamicResource BrightColor}" />
    </Style>
    <Style Selector="Button.TabFace">
        <Setter Property="Theme" Value="{DynamicResource StudioButton}" />
        <Setter Property="Height" Value="26" />
        <Setter Property="MinHeight" Value="26" />
        <Setter Property="Padding" Value="9,0,4,0" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="FontWeight" Value="Normal" />
        <Setter Property="FontSize" Value="12.5" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.TabFace:pointerover, Button.TabFace:pressed">
        <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="Button.TabFace.Plain">
        <Setter Property="Padding" Value="9,0" />
    </Style>
    <Style Selector="Button.TabClose">
        <Setter Property="Theme" Value="{DynamicResource StudioButton}" />
        <Setter Property="Width" Value="16" />
        <Setter Property="Height" Value="16" />
        <Setter Property="MinHeight" Value="16" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Margin" Value="0,0,5,0" />
        <Setter Property="CornerRadius" Value="4" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Opacity" Value="0" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="Border.TabHost:pointerover Button.TabClose, Border.TabHost.On Button.TabClose">
        <Setter Property="Opacity" Value="0.6" />
    </Style>
    <Style Selector="Button.TabClose:pointerover">
        <Setter Property="Background" Value="{DynamicResource PressColor}" />
        <Setter Property="Opacity" Value="1" />
    </Style>

    <Style Selector="Button.Tool">
        <Setter Property="Theme" Value="{DynamicResource StudioButton}" />
        <Setter Property="Height" Value="28" />
        <Setter Property="MinHeight" Value="28" />
        <Setter Property="MinWidth" Value="28" />
        <Setter Property="Padding" Value="6,0" />
        <Setter Property="CornerRadius" Value="7" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Foreground" Value="{DynamicResource MutedColor}" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="FontWeight" Value="Normal" />
    </Style>
    <Style Selector="Button.Tool:pointerover">
        <Setter Property="Background" Value="{DynamicResource HoverColor}" />
        <Setter Property="Foreground" Value="{DynamicResource BrightColor}" />
    </Style>
    <Style Selector="Button.Tool:pressed">
        <Setter Property="Background" Value="{DynamicResource PressColor}" />
    </Style>
    <Style Selector="Button.Tool:disabled">
        <Setter Property="Opacity" Value="0.4" />
    </Style>
    <Style Selector="Button.Tool.Small">
        <Setter Property="Height" Value="24" />
        <Setter Property="MinHeight" Value="24" />
        <Setter Property="MinWidth" Value="24" />
        <Setter Property="Padding" Value="0" />
    </Style>
    <Style Selector="Button.Tool.Run">
        <Setter Property="Height" Value="30" />
        <Setter Property="MinHeight" Value="30" />
        <Setter Property="MinWidth" Value="30" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="CornerRadius" Value="9" />
        <Setter Property="Foreground" Value="{DynamicResource ForegroundColor}" />
    </Style>

    <Style Selector="Button.TitleSearch">
        <Setter Property="Theme" Value="{DynamicResource StudioButton}" />
        <Setter Property="Height" Value="28" />
        <Setter Property="MinHeight" Value="28" />
        <Setter Property="Padding" Value="10,0,6,0" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Background" Value="{DynamicResource PanelColor}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderColor60}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Foreground" Value="{DynamicResource DimColor}" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="FontWeight" Value="Normal" />
        <Setter Property="Cursor" Value="IBeam" />
    </Style>
    <Style Selector="Button.TitleSearch:pointerover">
        <Setter Property="Background" Value="{DynamicResource HeaderColor}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderColor}" />
        <Setter Property="Foreground" Value="{DynamicResource MutedColor}" />
    </Style>

    <Style Selector="Border.Key">
        <Setter Property="MinWidth" Value="18" />
        <Setter Property="Height" Value="18" />
        <Setter Property="Padding" Value="5,0" />
        <Setter Property="CornerRadius" Value="4" />
        <Setter Property="Background" Value="{DynamicResource RaisedColor}" />
        <Setter Property="BoxShadow" Value="inset 0 -1 0 0 #66000000" />
    </Style>
    <Style Selector="Border.Key > TextBlock">
        <Setter Property="FontSize" Value="10.5" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="Foreground" Value="{DynamicResource MutedColor}" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Border.Key.Flat">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BoxShadow" Value="none" />
    </Style>
    <Style Selector="Border.Key.Flat > TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource DimColor}" />
    </Style>
    <Style Selector="Border.Key.Tip">
        <Setter Property="Background" Value="#36363C" />
    </Style>
    <Style Selector="Border.Key.Tip > TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource ForegroundColor}" />
    </Style>
    <Style Selector="Border.Key.Popup">
        <Setter Property="Background" Value="{DynamicResource TipColor}" />
    </Style>

    <Style Selector="Border.MenuPopup">
        <Setter Property="Background" Value="{DynamicResource PopupColor}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderColor}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="Padding" Value="5" />
        <Setter Property="MinWidth" Value="240" />
    </Style>
    <Style Selector="Border.MenuPopup Separator">
        <Setter Property="Height" Value="1" />
        <Setter Property="MinHeight" Value="1" />
        <Setter Property="Margin" Value="8,4" />
        <Setter Property="Background" Value="{DynamicResource BorderColor}" />
    </Style>
    <Style Selector="MenuItem.Heading">
        <Setter Property="Height" Value="24" />
        <Setter Property="IsHitTestVisible" Value="False" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="Foreground" Value="{DynamicResource DimColor}" />
    </Style>

    <Style Selector="ToolTip">
        <Setter Property="Background" Value="{DynamicResource TipColor}" />
        <Setter Property="Foreground" Value="{DynamicResource BrightColor}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderColor}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Padding" Value="10,7" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="MaxWidth" Value="280" />
    </Style>

    <Style Selector="TextBlock.Bright">
        <Setter Property="Foreground" Value="{DynamicResource BrightColor}" />
    </Style>
    <Style Selector="TextBlock.Dim">
        <Setter Property="Foreground" Value="{DynamicResource DimColor}" />
    </Style>
    <Style Selector="TextBlock.Small">
        <Setter Property="FontSize" Value="11" />
    </Style>

    <Style Selector="Button.Status">
        <Setter Property="Theme" Value="{DynamicResource StudioButton}" />
        <Setter Property="Height" Value="26" />
        <Setter Property="MinHeight" Value="26" />
        <Setter Property="Padding" Value="9,0" />
        <Setter Property="CornerRadius" Value="13" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Foreground" Value="{DynamicResource MutedColor}" />
        <Setter Property="FontWeight" Value="Normal" />
        <Setter Property="FontSize" Value="12.5" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.Status:pointerover">
        <Setter Property="Background" Value="{DynamicResource HoverColor}" />
        <Setter Property="Foreground" Value="{DynamicResource ForegroundColor}" />
    </Style>
    <Style Selector="Button.Status.Accent">
        <Setter Property="Background" Value="{DynamicResource AccentSoftColor}" />
        <Setter Property="Foreground" Value="{DynamicResource BrightColor}" />
    </Style>

    <Style Selector="Panel.PageHost[IsVisible=True]">
        <Style.Animations>
            <Animation Duration="0:0:0.15" Easing="CubicEaseOut">
                <KeyFrame Cue="0%">
                    <Setter Property="Opacity" Value="0" />
                </KeyFrame>
                <KeyFrame Cue="100%">
                    <Setter Property="Opacity" Value="1" />
                </KeyFrame>
            </Animation>
        </Style.Animations>
    </Style>
</Styles>
