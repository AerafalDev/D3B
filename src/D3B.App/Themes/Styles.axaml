<Styles
    xmlns="https://github.com/avaloniaui"
    xmlns:c="clr-namespace:D3B.App.Controls"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Style Selector="Border.ItemIcon">
        <Setter Property="Width" Value="16" />
        <Setter Property="Height" Value="16" />
        <Setter Property="CornerRadius" Value="4" />
        <Setter Property="Background" Value="{DynamicResource GhostColor}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderColor}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Border.ItemIcon.Large">
        <Setter Property="Width" Value="34" />
        <Setter Property="Height" Value="34" />
        <Setter Property="CornerRadius" Value="8" />
    </Style>
    <Style Selector="Border.ItemIcon.HasIcon">
        <Setter Property="Width" Value="18" />
        <Setter Property="Height" Value="18" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
    </Style>
    <Style Selector="Border.ItemIcon.Large.HasIcon">
        <Setter Property="Width" Value="34" />
        <Setter Property="Height" Value="34" />
        <Setter Property="Background" Value="{DynamicResource GhostColor}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="2" />
    </Style>
    <Style Selector="Image.DetailIcon">
        <Setter Property="Width" Value="14" />
        <Setter Property="Height" Value="14" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Border.Tile">
        <Setter Property="Background" Value="{DynamicResource CardBackgroundColor}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderColor}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{DynamicResource XlCornerRadius}" />
        <Setter Property="Padding" Value="18,16" />
    </Style>
    <Style Selector="Border.Banner">
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{DynamicResource XlCornerRadius}" />
        <Setter Property="Padding" Value="18,16" />
    </Style>
    <Style Selector="Border.Banner.Danger">
        <Setter Property="Background" Value="{DynamicResource ErrorColor5}" />
        <Setter Property="BorderBrush" Value="{DynamicResource ErrorColor60}" />
    </Style>
    <Style Selector="Border.Code">
        <Setter Property="Background" Value="{DynamicResource CardBackgroundColor}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderColor}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{DynamicResource LgCornerRadius}" />
        <Setter Property="Padding" Value="14,12" />
    </Style>
    <Style Selector="SelectableTextBlock.Mono">
        <Setter Property="FontFamily" Value="Cascadia Mono, Consolas, Courier New" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="LineHeight" Value="19" />
    </Style>
    <Style Selector="Border.Plate">
        <Setter Property="Background" Value="{DynamicResource CardBackgroundColor}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderColor}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="14" />
    </Style>
    <Style Selector="Border.Plate.Paused">
        <Setter Property="BorderBrush" Value="{DynamicResource WarningColor60}" />
    </Style>
    <Style Selector="Border.PlateFooter">
        <Setter Property="Background" Value="{DynamicResource PlateFooterColor}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderColor}" />
        <Setter Property="BorderThickness" Value="0,1,0,0" />
        <Setter Property="CornerRadius" Value="0,0,13,13" />
        <Setter Property="Padding" Value="20,14" />
    </Style>
    <Style Selector="Border.PlateFooter.Paused">
        <Setter Property="Background" Value="{DynamicResource WarningColor5}" />
        <Setter Property="BorderBrush" Value="{DynamicResource WarningColor60}" />
    </Style>
    <Style Selector="TextBlock.Coordinates">
        <Setter Property="FontSize" Value="30" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="FontFeatures" Value="+tnum" />
    </Style>
    <Style Selector="TextBlock.Figures">
        <Setter Property="FontFeatures" Value="+tnum" />
    </Style>
    <Style Selector="StackPanel.PageHeader">
        <Setter Property="Margin" Value="32,26,32,20" />
        <Setter Property="Spacing" Value="4" />
    </Style>
    <Style Selector="TextBlock.PageTitle">
        <Setter Property="FontSize" Value="26" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="Border.Rail">
        <Setter Property="Width" Value="60" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderColor}" />
        <Setter Property="BorderThickness" Value="0,0,1,0" />
    </Style>
    <Style Selector="Border.RailSeparator">
        <Setter Property="Width" Value="24" />
        <Setter Property="Height" Value="1" />
        <Setter Property="Margin" Value="0,4" />
        <Setter Property="Background" Value="{DynamicResource BorderColor}" />
    </Style>
    <Style Selector="Button.RailItem">
        <Setter Property="Width" Value="40" />
        <Setter Property="Height" Value="40" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="CornerRadius" Value="{DynamicResource LgCornerRadius}" />
        <Setter Property="Foreground" Value="{DynamicResource MutedColor}" />
        <Setter Property="ToolTip.Placement" Value="Right" />
    </Style>
    <Style Selector="Button.RailItem.Selected">
        <Setter Property="Background" Value="{DynamicResource GhostHoverColor}" />
        <Setter Property="Foreground" Value="{DynamicResource ForegroundColor}" />
    </Style>
    <Style Selector="Button.RailItem c|Icon">
        <Setter Property="Width" Value="18" />
        <Setter Property="Height" Value="18" />
    </Style>
    <Style Selector="c|Icon.Muted">
        <Setter Property="Foreground" Value="{DynamicResource MutedColor}" />
    </Style>
    <Style Selector="c|Icon[Tone=Success]">
        <Setter Property="Foreground" Value="{DynamicResource SuccessColor}" />
    </Style>
    <Style Selector="c|Icon[Tone=Warning]">
        <Setter Property="Foreground" Value="{DynamicResource WarningColor}" />
    </Style>
    <Style Selector="c|Icon[Tone=Info]">
        <Setter Property="Foreground" Value="{DynamicResource InfoColor}" />
    </Style>
    <Style Selector="c|Icon[Tone=Danger]">
        <Setter Property="Foreground" Value="{DynamicResource ErrorColor}" />
    </Style>
    <Style Selector="Button.Chip">
        <Setter Property="Height" Value="28" />
        <Setter Property="Padding" Value="11,0" />
        <Setter Property="CornerRadius" Value="999" />
        <Setter Property="FontSize" Value="12" />
    </Style>
    <Style Selector="Button.Chip.Selected">
        <Setter Property="Background" Value="{DynamicResource GhostHoverColor}" />
        <Setter Property="BorderBrush" Value="{DynamicResource ForegroundColor}" />
    </Style>
    <Style Selector="Button.Segment">
        <Setter Property="Height" Value="28" />
        <Setter Property="Padding" Value="11,0" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{DynamicResource MutedColor}" />
    </Style>
    <Style Selector="Button.Segment.Selected">
        <Setter Property="Background" Value="{DynamicResource GhostHoverColor}" />
        <Setter Property="Foreground" Value="{DynamicResource ForegroundColor}" />
    </Style>
    <Style Selector="ToggleButton.Toggle">
        <Setter Property="Height" Value="28" />
        <Setter Property="Padding" Value="10,0" />
        <Setter Property="FontSize" Value="12" />
    </Style>
    <Style Selector="TextBlock.Mono">
        <Setter Property="FontFamily" Value="Cascadia Mono, Consolas, Courier New" />
        <Setter Property="FontSize" Value="12" />
    </Style>
</Styles>
