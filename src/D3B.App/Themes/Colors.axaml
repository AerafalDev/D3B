<ResourceDictionary xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!--  The studio's palette, next's (D530), dark only as next is (D320): VS Code's Dark Modern as discreet islands, the window's
         frame darker than its parts, each part a card with a faint edge, the editor lighter, one blue accent kept rare, green,
         amber and red for states alone. ShadUI's own keys come first, given D3B's values, then the studio's. The app's
         resources are read before ShadUI's theme, so these win.  -->
    <Color x:Key="ForegroundColor">#D6D6D6</Color>
    <Color x:Key="ForegroundLeadColor">#A8A8A8</Color>
    <Color x:Key="BackgroundColor">Transparent</Color>
    <Color x:Key="MutedColor">#A8A8A8</Color>
    <Color x:Key="BorderColor">#343434</Color>
    <Color x:Key="BorderColor60">#232323</Color>
    <Color x:Key="BorderColor30">#1E1E1E</Color>
    <Color x:Key="OutlineColor">#3C3C3C</Color>
    <Color x:Key="GhostColor">#262626</Color>
    <Color x:Key="GhostHoverColor">#313131</Color>
    <Color x:Key="GhostHoverColor50">#80313131</Color>
    <Color x:Key="SelectionColor">#0FFFFFFF</Color>
    <Color x:Key="PrimaryColor">#0078D4</Color>
    <Color x:Key="PrimaryColor75">#BF0078D4</Color>
    <Color x:Key="PrimaryColor50">#800078D4</Color>
    <Color x:Key="PrimaryColor10">#1A0078D4</Color>
    <Color x:Key="PrimaryForegroundColor">#FFFFFF</Color>
    <Color x:Key="SecondaryColor">#313131</Color>
    <Color x:Key="SecondaryColor75">#BF313131</Color>
    <Color x:Key="SecondaryColor50">#80313131</Color>
    <Color x:Key="SecondaryForegroundColor">#D6D6D6</Color>
    <Color x:Key="DestructiveColor">#F85149</Color>
    <Color x:Key="DestructiveColor75">#BFF85149</Color>
    <Color x:Key="DestructiveColor50">#80F85149</Color>
    <Color x:Key="DestructiveColor10">#1AF85149</Color>
    <Color x:Key="DestructiveForegroundColor">#FFFFFF</Color>
    <Color x:Key="InfoColor">#0078D4</Color>
    <Color x:Key="InfoColor60">#990078D4</Color>
    <Color x:Key="InfoColor20">#330078D4</Color>
    <Color x:Key="InfoColor10">#1A0078D4</Color>
    <Color x:Key="InfoColor5">#0D0078D4</Color>
    <Color x:Key="SuccessColor">#3FB950</Color>
    <Color x:Key="SuccessColor60">#993FB950</Color>
    <Color x:Key="SuccessColor20">#333FB950</Color>
    <Color x:Key="SuccessColor10">#1A3FB950</Color>
    <Color x:Key="SuccessColor5">#0D3FB950</Color>
    <Color x:Key="WarningColor">#D29922</Color>
    <Color x:Key="WarningColor60">#99D29922</Color>
    <Color x:Key="WarningColor20">#33D29922</Color>
    <Color x:Key="WarningColor10">#1AD29922</Color>
    <Color x:Key="WarningColor5">#0DD29922</Color>
    <Color x:Key="ErrorColor">#F85149</Color>
    <Color x:Key="ErrorColor60">#99F85149</Color>
    <Color x:Key="ErrorColor20">#33F85149</Color>
    <Color x:Key="ErrorColor10">#1AF85149</Color>
    <Color x:Key="ErrorColor5">#0DF85149</Color>
    <Color x:Key="BusyAreaOverlayColor">#1971717A</Color>
    <Color x:Key="CardBackgroundColor">#212121</Color>
    <Color x:Key="DialogOverlayColor">#000000</Color>
    <Color x:Key="DialogBackgroundColor">#1F1F1F</Color>
    <Color x:Key="TitleBarBackgroundColor">Transparent</Color>
    <Color x:Key="WindowBackgroundColor">#111111</Color>
    <Color x:Key="WindowButtonHoverColor">#2A2A2A</Color>
    <Color x:Key="SidebarBackgroundColor">#111111</Color>
    <Color x:Key="SwitchBackgroundColor">#313131</Color>
    <Color x:Key="SwitchForegroundColor">#FFFFFF</Color>
