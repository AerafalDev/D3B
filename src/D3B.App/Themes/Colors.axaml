    <Color x:Key="FieldColor">#313131</Color>
    <Color x:Key="InputColor">#313131</Color>
    <Color x:Key="RaisedColor">#2A2D2E</Color>
    <Color x:Key="PopupColor">#1F1F1F</Color>
    <Color x:Key="TipColor">#202020</Color>
    <Color x:Key="HoverColor">#14FFFFFF</Color>
    <Color x:Key="ClearColor">#00FFFFFF</Color>
    <Color x:Key="PressColor">#1FFFFFFF</Color>
