<ResourceDictionary xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!--  The studio's palette, Unreal's look made modern and dark only (D320): neutral greys from the window's near black up,
         one blue accent for selection and focus, green, amber and red for states alone. ShadUI's own keys come first, given
         D3B's values, then the studio's. The app's resources are read before ShadUI's theme, so these win.  -->
    <Color x:Key="ForegroundColor">#CFD0D5</Color>
    <Color x:Key="ForegroundLeadColor">#8E9099</Color>
    <Color x:Key="BackgroundColor">Transparent</Color>
    <Color x:Key="MutedColor">#8E9099</Color>
    <Color x:Key="BorderColor">#17FFFFFF</Color>
    <Color x:Key="BorderColor60">#0EFFFFFF</Color>
    <Color x:Key="BorderColor30">#0AFFFFFF</Color>
    <Color x:Key="OutlineColor">#24FFFFFF</Color>
    <Color x:Key="GhostColor">#1C1C20</Color>
    <Color x:Key="GhostHoverColor">#2A2A30</Color>
    <Color x:Key="GhostHoverColor50">#802A2A30</Color>
    <Color x:Key="SelectionColor">#0AFFFFFF</Color>

    <Color x:Key="PrimaryColor">#3B82F6</Color>
    <Color x:Key="PrimaryColor75">#BF3B82F6</Color>
    <Color x:Key="PrimaryColor50">#803B82F6</Color>
    <Color x:Key="PrimaryColor10">#1A3B82F6</Color>
    <Color x:Key="PrimaryForegroundColor">#FFFFFF</Color>
    <Color x:Key="SecondaryColor">#232328</Color>
    <Color x:Key="SecondaryColor75">#BF232328</Color>
    <Color x:Key="SecondaryColor50">#80232328</Color>
    <Color x:Key="SecondaryForegroundColor">#CFD0D5</Color>
    <Color x:Key="DestructiveColor">#EA5D52</Color>
    <Color x:Key="DestructiveColor75">#BFEA5D52</Color>
    <Color x:Key="DestructiveColor50">#80EA5D52</Color>
    <Color x:Key="DestructiveColor10">#1AEA5D52</Color>
    <Color x:Key="DestructiveForegroundColor">#FFFFFF</Color>

    <Color x:Key="InfoColor">#3B82F6</Color>
    <Color x:Key="InfoColor60">#993B82F6</Color>
    <Color x:Key="InfoColor20">#333B82F6</Color>
    <Color x:Key="InfoColor10">#1A3B82F6</Color>
    <Color x:Key="InfoColor5">#0D3B82F6</Color>
    <Color x:Key="SuccessColor">#3ECF5C</Color>
    <Color x:Key="SuccessColor60">#993ECF5C</Color>
    <Color x:Key="SuccessColor20">#333ECF5C</Color>
    <Color x:Key="SuccessColor10">#1A3ECF5C</Color>
    <Color x:Key="SuccessColor5">#0D3ECF5C</Color>
    <Color x:Key="WarningColor">#E9AD3C</Color>
    <Color x:Key="WarningColor60">#99E9AD3C</Color>
    <Color x:Key="WarningColor20">#33E9AD3C</Color>
    <Color x:Key="WarningColor10">#1AE9AD3C</Color>
    <Color x:Key="WarningColor5">#0DE9AD3C</Color>
    <Color x:Key="ErrorColor">#EA5D52</Color>
    <Color x:Key="ErrorColor60">#99EA5D52</Color>
    <Color x:Key="ErrorColor20">#33EA5D52</Color>
    <Color x:Key="ErrorColor10">#1AEA5D52</Color>
    <Color x:Key="ErrorColor5">#0DEA5D52</Color>

    <Color x:Key="BusyAreaOverlayColor">#1971717A</Color>
    <Color x:Key="CardBackgroundColor">#1B1B1F</Color>
    <Color x:Key="DialogOverlayColor">#000000</Color>
    <Color x:Key="DialogBackgroundColor">#1A1A1E</Color>
    <Color x:Key="TitleBarBackgroundColor">Transparent</Color>
    <Color x:Key="WindowBackgroundColor">#09090B</Color>
    <Color x:Key="WindowButtonHoverColor">#2A2A30</Color>
    <Color x:Key="SidebarBackgroundColor">#09090B</Color>
    <Color x:Key="SwitchBackgroundColor">#232328</Color>
    <Color x:Key="SwitchForegroundColor">#F4F4F6</Color>
    <Color x:Key="TabItemSelectedColor">#232328</Color>
    <Color x:Key="TabItemsBackgroundColor">#161619</Color>

    <!--  The studio's surfaces, from the deepest up: the editor's recess, a panel, its header, a raised control, a hover.  -->
    <Color x:Key="RecessColor">#111113</Color>
    <Color x:Key="PanelColor">#161619</Color>
    <Color x:Key="HeaderColor">#1B1B1F</Color>
    <Color x:Key="FieldColor">#1C1C20</Color>
    <Color x:Key="InputColor">#0E0E10</Color>
    <Color x:Key="RaisedColor">#232328</Color>
    <Color x:Key="PopupColor">#202025</Color>
    <Color x:Key="TipColor">#26262B</Color>
    <Color x:Key="HoverColor">#2A2A30</Color>
    <Color x:Key="PressColor">#33333A</Color>
    <Color x:Key="BrightColor">#F4F4F6</Color>
    <Color x:Key="DimColor">#5F616A</Color>
    <Color x:Key="AccentColor">#3B82F6</Color>
    <Color x:Key="AccentHoverColor">#4B8EF8</Color>
    <Color x:Key="AccentSoftColor">#2E3B82F6</Color>
    <Color x:Key="AccentEdgeColor">#593B82F6</Color>
    <Color x:Key="AccentTextColor">#9CC0FF</Color>
    <Color x:Key="PlayingColor">#3ECF5C</Color>
    <Color x:Key="PlayingEdgeColor">#593ECF5C</Color>
    <Color x:Key="PlayingTextColor">#7FD896</Color>
    <Color x:Key="PausedColor">#E9AD3C</Color>
    <Color x:Key="PausedEdgeColor">#59E9AD3C</Color>
    <Color x:Key="CloseHoverColor">#C42B1C</Color>

    <Color x:Key="PlateFooterColor">#111113</Color>
    <Color x:Key="TourGrowingColor">#A78BFA</Color>
</ResourceDictionary>
