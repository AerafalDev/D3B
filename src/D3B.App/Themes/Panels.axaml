<Styles
    xmlns="https://github.com/avaloniaui"
    xmlns:c="clr-namespace:D3B.App.Controls"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!--  The panels' toolbars and lines: the bottom panel's tabs and the statistics' tab include them, no other view, so that their
         short class names (Empty, Count, Line) stay theirs (D327, D516).  -->
    <Style Selector="Border.Toolbar">
        <Setter Property="Padding" Value="8,6" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderColor}" />
        <Setter Property="BorderThickness" Value="0,0,0,1" />
    </Style>
    <Style Selector="Border.Toolbar > Grid > StackPanel">
        <Setter Property="Orientation" Value="Horizontal" />
        <Setter Property="Spacing" Value="6" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.Dd">
        <Setter Property="Theme" Value="{DynamicResource StudioButton}" />
        <Setter Property="Height" Value="26" />
        <Setter Property="MinHeight" Value="26" />
        <Setter Property="Padding" Value="8,0" />
        <Setter Property="CornerRadius" Value="7" />
        <Setter Property="Background" Value="{DynamicResource FieldColor}" />
        <Setter Property="Foreground" Value="{DynamicResource ForegroundColor}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="Normal" />
        <Setter Property="MaxWidth" Value="240" />
    </Style>
    <Style Selector="Button.Dd:pointerover">
        <Setter Property="Background" Value="{DynamicResource RaisedColor}" />
    </Style>
    <Style Selector="Button.Dd:disabled">
        <Setter Property="Opacity" Value="0.5" />
    </Style>
    <Style Selector="Border.Segs">
        <Setter Property="Background" Value="{DynamicResource FieldColor}" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Padding" Value="2" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Border.Segs > StackPanel">
        <Setter Property="Orientation" Value="Horizontal" />
        <Setter Property="Spacing" Value="2" />
    </Style>
    <Style Selector="Button.Seg">
        <Setter Property="Theme" Value="{DynamicResource StudioButton}" />
        <Setter Property="Height" Value="22" />
        <Setter Property="MinHeight" Value="22" />
        <Setter Property="Padding" Value="9,0" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="Foreground" Value="{DynamicResource MutedColor}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="Normal" />
    </Style>
    <Style Selector="Button.Seg:pointerover">
        <Setter Property="Foreground" Value="{DynamicResource ForegroundColor}" />
    </Style>
    <Style Selector="Button.Seg.On">
        <Setter Property="Background" Value="{DynamicResource RaisedColor}" />
        <Setter Property="Foreground" Value="{DynamicResource BrightColor}" />
    </Style>
    <Style Selector="Button.Ib">
        <Setter Property="Theme" Value="{DynamicResource StudioButton}" />
        <Setter Property="Width" Value="26" />
        <Setter Property="Height" Value="26" />
        <Setter Property="MinHeight" Value="26" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="CornerRadius" Value="7" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="Foreground" Value="{DynamicResource MutedColor}" />
    </Style>
    <Style Selector="Button.Ib:pointerover">
        <Setter Property="Background" Value="{DynamicResource HoverColor}" />
        <Setter Property="Foreground" Value="{DynamicResource BrightColor}" />
    </Style>
    <Style Selector="Button.Ib.On">
        <Setter Property="Background" Value="{DynamicResource AccentSoftColor}" />
        <Setter Property="Foreground" Value="{DynamicResource AccentTextColor}" />
    </Style>
    <Style Selector="Button.Ib:disabled">
        <Setter Property="Opacity" Value="0.4" />
    </Style>
    <Style Selector="Button.Ib c|Icon">
        <Setter Property="Width" Value="14" />
        <Setter Property="Height" Value="14" />
    </Style>
    <Style Selector="TextBox.Find">
        <Setter Property="Height" Value="26" />
        <Setter Property="MinHeight" Value="26" />
        <Setter Property="MinWidth" Value="100" />
        <Setter Property="MaxWidth" Value="240" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="Padding" Value="4,0,8,0" />
        <Setter Property="CornerRadius" Value="7" />
        <Setter Property="Background" Value="{DynamicResource FieldColor}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.MenuRow">
        <Setter Property="Theme" Value="{DynamicResource StudioButton}" />
        <Setter Property="Height" Value="30" />
        <Setter Property="MinHeight" Value="30" />
        <Setter Property="Padding" Value="8,0" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="FontWeight" Value="Normal" />
    </Style>
    <Style Selector="Button.MenuRow:pointerover">
        <Setter Property="Background" Value="{DynamicResource HoverColor}" />
    </Style>
    <Style Selector="Button.MenuRow.On">
        <Setter Property="Background" Value="{DynamicResource AccentSoftColor}" />
    </Style>
    <Style Selector="FlyoutPresenter.Bare">
        <Setter Property="Background" Value="{DynamicResource ClearColor}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="MaxWidth" Value="400" />
    </Style>
    <Style Selector="Border.Count">
        <Setter Property="MinWidth" Value="16" />
        <Setter Property="Height" Value="16" />
        <Setter Property="Padding" Value="5,0" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Border.Count > TextBlock">
        <Setter Property="FontSize" Value="10.5" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Border.Count.Error">
        <Setter Property="Background" Value="#2EEA5D52" />
    </Style>
    <Style Selector="Border.Count.Error > TextBlock">
        <Setter Property="Foreground" Value="#F3A19A" />
    </Style>
    <Style Selector="Border.Count.Warning">
        <Setter Property="Background" Value="#29E9AD3C" />
    </Style>
    <Style Selector="Border.Count.Warning > TextBlock">
        <Setter Property="Foreground" Value="#F0C674" />
    </Style>
    <Style Selector="Border.Line">
        <Setter Property="MinHeight" Value="26" />
        <Setter Property="Padding" Value="10,0" />
        <Setter Property="BorderBrush" Value="#06FFFFFF" />
        <Setter Property="BorderThickness" Value="0,0,0,1" />
        <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="Border.Line:pointerover">
        <Setter Property="Background" Value="#06FFFFFF" />
    </Style>
    <Style Selector="TextBlock.Time">
        <Setter Property="Foreground" Value="{DynamicResource DimColor}" />
        <Setter Property="FontSize" Value="11.5" />
        <Setter Property="FontFeatures" Value="+tnum" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="TextBlock.Empty">
        <Setter Property="Foreground" Value="{DynamicResource DimColor}" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="TextAlignment" Value="Center" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="MaxWidth" Value="360" />
    </Style>
</Styles>
