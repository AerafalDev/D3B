<UserControl
    x:Class="D3B.App.Views.ProfileView"
    x:ClassModifier="internal"
    x:DataType="vm:ProfileViewModel"
    xmlns="https://github.com/avaloniaui"
    xmlns:c="clr-namespace:D3B.App.Controls"
    xmlns:l="clr-namespace:D3B.App.Localization"
    xmlns:m="clr-namespace:D3B.App.Controls.WorldMaps"
    xmlns:s="clr-namespace:D3B.App.ViewModels.Settings"
    xmlns:v="clr-namespace:D3B.App.Views"
    xmlns:vm="clr-namespace:D3B.App.ViewModels"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Styles>
        <Style Selector="TextBox.NameEdit">
            <Setter Property="Background" Value="{DynamicResource ClearColor}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FontSize" Value="17" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource BrightColor}" />
            <Setter Property="MinHeight" Value="28" />
            <Setter Property="MaxWidth" Value="340" />
            <Setter Property="Padding" Value="6,1" />
            <Setter Property="Margin" Value="-6,0,0,0" />
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="CornerRadius" Value="6" />
        </Style>
        <Style Selector="TextBox.NameEdit:pointerover /template/ Border#PART_BorderElement, TextBox.NameEdit:focus /template/ Border#PART_BorderElement">
            <Setter Property="Background" Value="{DynamicResource FieldColor}" />
        </Style>
        <Style Selector="TextBox.NameEdit:focus /template/ Border#PART_BorderElement">
            <Setter Property="BorderBrush" Value="{DynamicResource AccentEdgeColor}" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
        <Style Selector="Button.Link">
            <Setter Property="Background" Value="{DynamicResource ClearColor}" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="Height" Value="18" />
            <Setter Property="Foreground" Value="{DynamicResource MutedColor}" />
            <Setter Property="FontSize" Value="12" />
        </Style>
        <Style Selector="Button.Link:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource ClearColor}" />
            <Setter Property="Foreground" Value="{DynamicResource ForegroundColor}" />
        </Style>
        <Style Selector="Button.Link.Accent">
            <Setter Property="Foreground" Value="{DynamicResource AccentColor}" />
        </Style>
        <Style Selector="Button.Link.Accent:pointerover /template/ ContentPresenter">
            <Setter Property="Foreground" Value="{DynamicResource AccentHoverColor}" />
        </Style>
        <Style Selector="UserControl.Band Border#WideHost">
            <Setter Property="IsVisible" Value="False" />
        </Style>
        <Style Selector="UserControl.Plays Border#WideHost, UserControl.Plays Border#BandHost">
            <Setter Property="IsVisible" Value="False" />
        </Style>
        <Style Selector="UserControl:not(.Band) Border#BandHost">
            <Setter Property="IsVisible" Value="False" />
        </Style>
        <Style Selector="Border.Preview">
            <Setter Property="Background" Value="{DynamicResource RecessColor}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderColor}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="ClipToBounds" Value="True" />
        </Style>
        <Style Selector="Border.Figure">
            <Setter Property="Padding" Value="12,10" />
        </Style>
        <Style Selector="TextBlock.SideTitle">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource BrightColor}" />
        </Style>
    </UserControl.Styles>
    <Grid ColumnDefinitions="*,Auto" Name="Body">
        <DockPanel>
            <StackPanel DockPanel.Dock="Top" Margin="24,16,24,0" Name="Header">
                <Grid ColumnDefinitions="Auto,*,Auto" RowDefinitions="Auto,Auto">
                    <Border
                        Background="#2A2238"
                        CornerRadius="10"
                        Height="38"
                        VerticalAlignment="Top"
                        Width="38">
                        <c:Icon
                            Drawing="{StaticResource Nodes.Template}"
                            Height="18"
                            Tint="#C9A7F2"
                            Width="18" />
                    </Border>
                    <TextBox
                        AutomationProperties.Name="{l:Tr ProfileName}"
                        Classes="NameEdit"
                        Grid.Column="1"
                        IsReadOnly="{Binding IsReadOnly}"
                        Margin="14,0,12,0"
                        Text="{Binding EditName}"
                        VerticalAlignment="Center" />
                    <WrapPanel
                        Grid.Column="1"
                        Grid.ColumnSpan="2"
                        Grid.Row="1"
                        Margin="14,2,0,0">
                            <TextBlock
                                Classes="Dim"
                                Margin="0,0,5,0"
                                Text="{l:Tr VariantOf}"
                                VerticalAlignment="Center" />
                            <TextBlock
                                Classes="Muted"
                                Margin="0,0,6,0"
                                Text="{Binding BehaviorName}"
                                VerticalAlignment="Center" />
                            <TextBlock
                                Classes="Dim"
                                IsVisible="{Binding !IsBehaviorProfile}"
                                Margin="0,0,6,0"
                                Text="·"
                                VerticalAlignment="Center" />
                            <TextBlock
                                Foreground="{DynamicResource AccentTextColor}"
                                IsVisible="{Binding HasChanges}"
                                Margin="0,0,8,0"
                                Text="{Binding ChangedText}"
                                VerticalAlignment="Center" />
                            <TextBlock
                                Classes="Dim"
                                IsVisible="{Binding !HasChanges}"
                                Margin="0,0,8,0"
                                Text="{Binding ChangedText}"
                                VerticalAlignment="Center" />
                            <Button
                                Classes="Link Accent"
                                Command="{Binding ResetAllCommand}"
                                Content="{l:Tr ResetAll}"
                                VerticalAlignment="Center">
                                <Button.IsVisible>
                                    <MultiBinding Converter="{x:Static BoolConverters.And}">
                                        <Binding Path="HasChanges" />
                                        <Binding Path="!IsReadOnly" />
                                    </MultiBinding>
                                </Button.IsVisible>
                            </Button>
                            <TextBlock
                                Classes="Dim"
                                IsVisible="{Binding IsReadOnly}"
                                Margin="0,0,8,0"
                                Text="{l:Tr GivenReadOnly}"
                                VerticalAlignment="Center" />
                    </WrapPanel>
                    <StackPanel
                        Grid.Column="2"
                        Orientation="Horizontal"
                        Spacing="6"
                        VerticalAlignment="Top">
                        <Button
                            AutomationProperties.Name="{l:Tr More}"
                            Classes="Tool"
                            IsVisible="{Binding IsOwn}"
                            ToolTip.Tip="{l:Tr More}">
                            <c:Icon Drawing="{StaticResource General.MoreHorizontal}" />
                            <Button.Flyout>
                                <MenuFlyout Placement="BottomEdgeAlignedRight">
                                    <MenuItem Command="{Binding DuplicateCommand}" Header="{l:Tr Duplicate}" />
                                    <MenuItem Command="{Binding AskDeleteCommand}" Header="{l:Tr Delete}" />
                                </MenuFlyout>
                            </Button.Flyout>
                        </Button>
                        <Button
                            Classes="Primary"
                            Command="{Binding SaveCommand}"
                            Content="{l:Tr Save}"
                            IsVisible="{Binding IsOwn}">
                            <ToolTip.Tip>
                                <c:KeyTip Keys="Ctrl S" Text="{l:Tr Save}" />
                            </ToolTip.Tip>
                        </Button>
                        <Button
                            Classes="Primary"
                            Command="{Binding CopyToProjectCommand}"
                            Content="{l:Tr CopyToProject}"
                            IsVisible="{Binding IsReadOnly}" />
                    </StackPanel>
                </Grid>
                <TextBlock
                    Classes="Problem"
                    IsVisible="{Binding HasNameProblem}"
                    Margin="52,6,0,0"
                    Text="{Binding NameProblem}" />
                <Border
                    Classes="Banner Danger"
                    IsVisible="{Binding HasError}"
                    Margin="0,10,0,0"
                    Padding="12,8">
                    <TextBlock Text="{Binding Error}" TextWrapping="Wrap" />
                </Border>
                <Border
                    Classes="Banner Danger"
                    IsVisible="{Binding Editor.HasRuleProblems, FallbackValue=False}"
                    Margin="0,10,0,0"
                    Padding="12,8">
                    <TextBlock Text="{Binding Editor.Rules}" TextWrapping="Wrap" />
                </Border>
                <StackPanel
                    IsVisible="{Binding IsActivityMissing}"
                    Margin="0,10,0,0"
                    Orientation="Horizontal"
                    Spacing="10">
                    <TextBlock
                        Classes="Problem"
                        Text="{Binding Review}"
                        VerticalAlignment="Center" />
                    <ComboBox
                        ItemsSource="{Binding Activities}"
                        PlaceholderText="{l:Tr ChooseActivity}"
                        SelectedItem="{Binding EditActivity}"
                        Width="220">
                        <ComboBox.ItemTemplate>
                            <DataTemplate x:DataType="vm:ActivityChoiceViewModel">
                                <TextBlock Text="{Binding Name}" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                </StackPanel>
            </StackPanel>
            <Border
                BorderBrush="{DynamicResource BorderColor}"
                BorderThickness="0,1,0,0"
                DockPanel.Dock="Top"
                MaxHeight="280"
                Margin="0,12,0,0"
                Name="BandHost" />
            <ScrollViewer Name="Form">
                <StackPanel IsEnabled="{Binding !IsReadOnly}" Margin="12,4,24,48">
                    <Border
                        Background="{DynamicResource CardBackgroundColor}"
                        BorderBrush="{DynamicResource BorderColor}"
                        BorderThickness="1"
                        CornerRadius="10"
                        IsVisible="{Binding IsBehaviorProfile}"
                        Margin="12,18,0,0"
                        Padding="16,14">
                        <StackPanel Spacing="10">
                            <TextBlock Classes="SideTitle" Text="{l:Tr ProfilePlaysTitle}" />
                            <TextBlock
                                Classes="Bright"
                                Text="{Binding BehaviorName}"
                                TextTrimming="CharacterEllipsis" />
                            <TextBlock
                                Classes="Dim"
                                Text="{Binding BehaviorDetail}"
                                TextWrapping="Wrap" />
                            <Button
                                Classes="Outline"
                                Command="{Binding EditStepsCommand}"
                                Content="{l:Tr ProfileEditSteps}"
                                HorizontalAlignment="Left"
                                IsVisible="{Binding CanEditSteps}" />
                        </StackPanel>
                    </Border>
                    <TextBlock
                        Classes="Muted"
                        IsVisible="{Binding Editor.IsEmpty, FallbackValue=False}"
                        Margin="12,22,0,0"
                        Text="{l:Tr NoSetting}" />
                    <v:SettingsFormView DataContext="{Binding Editor}" Name="Sections" />
                </StackPanel>
            </ScrollViewer>
        </DockPanel>
        <Border
            BorderBrush="{DynamicResource BorderColor}"
            BorderThickness="1,0,0,0"
            Grid.Column="1"
            Name="WideHost">
            <Grid
                IsVisible="{Binding !IsBehaviorProfile}"
                Name="Side"
                RowDefinitions="Auto,*">
                <Grid
                    ColumnDefinitions="*,Auto"
                    Margin="16,12,16,6">
                    <TextBlock Classes="SideTitle" Text="{l:Tr ProfileMapTitle}" />
                    <TextBlock
                        Classes="Dim"
                        FontSize="11.5"
                        Grid.Column="1"
                        MaxWidth="200"
                        Text="{Binding Map.Hovered}"
                        TextTrimming="CharacterEllipsis" />
                </Grid>
                <ScrollViewer Grid.Row="1">
                    <StackPanel Margin="16,0,16,16" Spacing="10">
                        <Border
                            Classes="Preview"
                            Height="280"
                            IsVisible="{Binding Map.IsAvailable}"
                            Name="MapFrame">
                            <m:WorldMapView
                                AutomationProperties.Name="{l:Tr WorldMapName}"
                                Name="Map"
                                Scene="{Binding Map.Scene}"
                                Source="{Binding Map.Source}"
                                World="{Binding Map.Layer}" />
                        </Border>
                        <TextBlock
                            Classes="Dim"
                            IsVisible="{Binding !Map.IsAvailable}"
                            Text="{l:Tr ProfileMapUnavailable}"
                            TextWrapping="Wrap" />
                        <TextBlock
                            Classes="Dim"
                            IsVisible="{Binding Map.HasHint}"
                            Text="{Binding Map.Hint}"
                            TextWrapping="Wrap" />
                        <Button
                            Classes="Outline"
                            Command="{Binding Map.EditZoneCommand}"
                            Content="{l:Tr ProfileMapEditZone}"
                            HorizontalAlignment="Left"
                            IsVisible="{Binding Map.CanEditZone}" />
                    <TextBlock Classes="SideTitle" Text="{l:Tr Preview}" Margin="0,6,0,0" />
                    <Border Classes="Preview" IsVisible="{Binding Editor.HasZone, FallbackValue=False}">
                        <c:ZoneMapCanvas
                            Height="170"
                            Palette="{DynamicResource MapPalette}"
                            Scene="{Binding Editor.Zone, FallbackValue={x:Null}}" />
                    </Border>
                    <Border
                        Classes="Preview"
                        Height="110"
                        IsVisible="{Binding !Editor.HasZone, FallbackValue=True}">
                        <TextBlock
                            Classes="Dim"
                            HorizontalAlignment="Center"
                            Margin="16"
                            Text="{Binding Editor.NoZoneText, FallbackValue=''}"
                            TextAlignment="Center"
                            TextWrapping="Wrap"
                            VerticalAlignment="Center" />
                    </Border>
                    <WrapPanel IsVisible="{Binding Editor.HasZone, FallbackValue=False}">
                        <StackPanel
                            IsVisible="{Binding Editor.HasForecast, FallbackValue=False}"
                            Margin="0,0,12,4"
                            Orientation="Horizontal"
                            Spacing="5">
                            <Ellipse
                                Fill="{DynamicResource ForegroundColor}"
                                Height="6"
                                VerticalAlignment="Center"
                                Width="6" />
                            <TextBlock
                                Classes="Dim"
                                FontSize="11"
                                Text="{l:Tr TourProbable}" />
                        </StackPanel>
                        <StackPanel
                            IsVisible="{Binding Editor.HasForecast, FallbackValue=False}"
                            Margin="0,0,12,4"
                            Orientation="Horizontal"
                            Spacing="5">
                            <Border
                                Background="{DynamicResource BorderColor}"
                                CornerRadius="2"
                                Height="8"
                                VerticalAlignment="Center"
                                Width="8" />
                            <TextBlock
                                Classes="Dim"
                                FontSize="11"
                                Text="{l:Tr TourEmpty}" />
                        </StackPanel>
                        <StackPanel
                            IsVisible="{Binding Editor.HasIsolated, FallbackValue=False}"
                            Margin="0,0,12,4"
                            Orientation="Horizontal"
                            Spacing="5">
                            <Rectangle
                                Height="8"
                                RadiusX="2"
                                RadiusY="2"
                                Stroke="{DynamicResource WarningColor}"
                                StrokeDashArray="2,1"
                                StrokeThickness="1"
                                VerticalAlignment="Center"
                                Width="8" />
                            <TextBlock
                                Classes="Dim"
                                FontSize="11"
                                Text="{l:Tr TourIsolated}" />
                        </StackPanel>
                    </WrapPanel>
                    <Border
                        Background="{DynamicResource CardBackgroundColor}"
                        CornerRadius="10"
                        IsVisible="{Binding Editor.HasFigures, FallbackValue=False}"
                        Margin="0,0,0,10">
                        <ItemsControl ItemsSource="{Binding Editor.Figures, FallbackValue={x:Null}}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Columns="3" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="s:FigureViewModel">
                                    <Border Classes="Figure">
                                        <StackPanel>
                                            <TextBlock
                                                Classes="Bright Figures"
                                                FontSize="16"
                                                FontWeight="SemiBold"
                                                Text="{Binding Value}"
                                                TextTrimming="CharacterEllipsis" />
                                            <TextBlock
                                                Classes="Dim"
                                                FontSize="11"
                                                Text="{Binding Label}"
                                                TextTrimming="CharacterEllipsis"
                                                ToolTip.Tip="{Binding Label}" />
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Border>
                    <StackPanel IsVisible="{Binding Editor.HasPlayers, FallbackValue=False}" Spacing="2">
                        <TextBlock Classes="SideTitle" Text="{l:Tr PlayedBy}" />
                        <ItemsControl ItemsSource="{Binding Editor.PlayerNotes, FallbackValue={x:Null}}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="s:PlayerNoteViewModel">
                                    <Border
                                        BorderBrush="{DynamicResource BorderColor}"
                                        BorderThickness="0,0,0,1"
                                        Padding="0,8">
                                        <StackPanel>
                                            <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                                            <TextBlock
                                                Classes="Dim"
                                                FontSize="11.5"
                                                IsVisible="{Binding HasNote}"
                                                Text="{Binding Note}"
                                                TextWrapping="Wrap" />
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Border>
    </Grid>
</UserControl>
