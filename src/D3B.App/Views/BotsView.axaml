<UserControl
    x:Class="D3B.App.Views.BotsView"
    x:ClassModifier="internal"
    x:DataType="vm:BotsViewModel"
    xmlns="https://github.com/avaloniaui"
    xmlns:activities="clr-namespace:D3B.Bot.Activities;assembly=D3B.Bot"
    xmlns:c="clr-namespace:D3B.App.Controls"
    xmlns:l="clr-namespace:D3B.App.Localization"
    xmlns:shadui="clr-namespace:ShadUI;assembly=ShadUI"
    xmlns:vm="clr-namespace:D3B.App.ViewModels"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Styles>
        <Style Selector="Border.Step">
            <Setter Property="Width" Value="24" />
            <Setter Property="Height" Value="24" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Background" Value="{DynamicResource GhostColor}" />
        </Style>
        <Style Selector="Border.Step > TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="ProgressBar.Load">
            <Setter Property="Height" Value="6" />
            <Setter Property="MinHeight" Value="6" />
            <Setter Property="Maximum" Value="100" />
        </Style>
    </UserControl.Styles>
    <Panel>
        <StackPanel
            HorizontalAlignment="Center"
            IsVisible="{Binding IsEmpty}"
            Margin="32"
            MaxWidth="460"
            Spacing="22"
            VerticalAlignment="Center">
            <Border
                Background="{DynamicResource CardBackgroundColor}"
                BorderBrush="{DynamicResource BorderColor}"
                BorderThickness="1"
                CornerRadius="16"
                Height="60"
                HorizontalAlignment="Center"
                Width="60">
                <c:Icon
                    Classes="Muted"
                    Data="{StaticResource IconBot}"
                    Height="28"
                    Width="28" />
            </Border>
            <StackPanel Spacing="8">
                <TextBlock
                    Classes="h3"
                    HorizontalAlignment="Center"
                    Text="{l:Tr NoBotTitle}" />
                <TextBlock
                    Classes="Small Muted"
                    Text="{l:Tr NoBotDetail}"
                    TextAlignment="Center"
                    TextWrapping="Wrap" />
            </StackPanel>
            <Border Classes="Tile">
                <StackPanel Spacing="14">
                    <Grid ColumnDefinitions="Auto,*">
                        <Border Classes="Step">
                            <TextBlock Text="1" />
                        </Border>
                        <TextBlock
                            Classes="Small"
                            Grid.Column="1"
                            Margin="12,0,0,0"
                            Text="{l:Tr NoBotStep1}"
                            TextWrapping="Wrap"
                            VerticalAlignment="Center" />
                    </Grid>
                    <Grid ColumnDefinitions="Auto,*">
                        <Border Classes="Step">
                            <TextBlock Text="2" />
                        </Border>
                        <TextBlock
                            Classes="Small"
                            Grid.Column="1"
                            Margin="12,0,0,0"
                            Text="{l:Tr NoBotStep2}"
                            TextWrapping="Wrap"
                            VerticalAlignment="Center" />
                    </Grid>
                    <Grid ColumnDefinitions="Auto,*">
                        <Border Classes="Step">
                            <TextBlock Text="3" />
                        </Border>
                        <TextBlock
                            Classes="Small"
                            Grid.Column="1"
                            Margin="12,0,0,0"
                            Text="{l:Tr NoBotStep3}"
                            TextWrapping="Wrap"
                            VerticalAlignment="Center" />
                    </Grid>
                </StackPanel>
            </Border>
        </StackPanel>
        <Grid ColumnDefinitions="300,*" IsVisible="{Binding !IsEmpty}">
            <Border BorderBrush="{DynamicResource BorderColor}" BorderThickness="0,0,1,0">
                <DockPanel>
                    <StackPanel
                        DockPanel.Dock="Top"
                        Margin="22,22,22,14"
                        Spacing="2">
                        <TextBlock Classes="h4" Text="{l:Tr Bots}" />
                        <TextBlock Classes="Caption Muted" Text="{Binding Summary}" />
                    </StackPanel>
                    <ListBox
                        Background="Transparent"
                        BorderThickness="0"
                        ItemsSource="{Binding Items}"
                        Margin="10,0,10,10"
                        Padding="0"
                        SelectedItem="{Binding Selected}">
                        <ListBox.ItemTemplate>
                            <DataTemplate x:DataType="vm:BotViewModel">
                                <Grid ColumnDefinitions="Auto,*" Margin="2,5">
                                    <Panel Height="38" Width="38">
                                        <shadui:Avatar
                                            Fallback="{Binding Initials}"
                                            Height="36"
                                            HorizontalAlignment="Left"
                                            VerticalAlignment="Top"
                                            Width="36" />
                                        <Border
                                            Background="{DynamicResource WindowBackgroundColor}"
                                            CornerRadius="7"
                                            Height="14"
                                            HorizontalAlignment="Right"
                                            VerticalAlignment="Bottom"
                                            Width="14">
                                            <c:StatusPill
                                                Classes="Dot"
                                                HorizontalAlignment="Center"
                                                Tone="{Binding Tone}" />
                                        </Border>
                                    </Panel>
                                    <StackPanel
                                        Grid.Column="1"
                                        Margin="12,0,6,0"
                                        Spacing="2"
                                        VerticalAlignment="Center">
                                        <TextBlock
                                            Classes="Small"
                                            FontWeight="SemiBold"
                                            Text="{Binding Name}"
                                            TextTrimming="CharacterEllipsis" />
                                        <TextBlock
                                            Classes="Caption Muted"
                                            Text="{Binding Summary}"
                                            TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>
            <ScrollViewer Grid.Column="1">
                <ContentControl Content="{Binding Selected}" Margin="32,26,32,32">
                    <ContentControl.ContentTemplate>
                        <DataTemplate x:DataType="vm:BotViewModel">
                            <StackPanel MaxWidth="900" Spacing="18">
                                <Grid ColumnDefinitions="Auto,*">
                                    <shadui:Avatar
                                        Fallback="{Binding Initials}"
                                        FontSize="18"
                                        Height="56"
                                        Width="56" />
                                    <StackPanel
                                        Grid.Column="1"
                                        Margin="16,0,0,0"
                                        Spacing="8"
                                        VerticalAlignment="Center">
                                        <TextBlock Classes="h3" Text="{Binding Name}" />
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <c:StatusPill Text="{Binding Connection}" Tone="{Binding ConnectionTone}" />
                                            <c:StatusPill
                                                IsVisible="{Binding IsPaused}"
                                                Text="{l:Tr Paused}"
                                                Tone="Warning" />
                                            <TextBlock
                                                Classes="Small Muted"
                                                Text="{Binding Level}"
                                                VerticalAlignment="Center" />
                                        </StackPanel>
                                    </StackPanel>
                                </Grid>
                                <Border Classes="Banner Warning" IsVisible="{Binding IsPaused}">
                                    <Grid ColumnDefinitions="Auto,*,Auto">
                                        <c:Icon
                                            Data="{StaticResource IconPause}"
                                            Foreground="{DynamicResource WarningColor}"
                                            Height="20"
                                            Margin="0,1,0,0"
                                            VerticalAlignment="Top"
                                            Width="20" />
                                        <StackPanel
                                            Grid.Column="1"
                                            Margin="12,0,16,0"
                                            Spacing="3">
                                            <TextBlock
                                                Classes="Small"
                                                FontWeight="SemiBold"
                                                Text="{l:Tr PausedTitle}" />
                                            <TextBlock
                                                Classes="Caption Muted"
                                                Text="{l:Tr PausedDetail}"
                                                TextWrapping="Wrap" />
                                        </StackPanel>
                                        <Button
                                            Classes="Primary"
                                            Command="{Binding ResumeCommand}"
                                            Grid.Column="2"
                                            VerticalAlignment="Center">
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <c:Icon
                                                    Data="{StaticResource IconResume}"
                                                    Height="14"
                                                    Width="14" />
                                                <TextBlock Text="{l:Tr Resume}" />
                                            </StackPanel>
                                        </Button>
                                    </Grid>
                                </Border>
                                <Grid ColumnDefinitions="*,14,*" RowDefinitions="Auto,14,Auto">
                                    <Border Classes="Tile">
                                        <StackPanel Spacing="10">
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <c:Icon
                                                    Classes="Muted"
                                                    Data="{StaticResource IconPin}"
                                                    Height="15"
                                                    Width="15" />
                                                <TextBlock
                                                    Classes="Label"
                                                    Text="{l:Tr Position}"
                                                    VerticalAlignment="Center" />
                                            </StackPanel>
                                            <StackPanel Spacing="3">
                                                <TextBlock Classes="Value" Text="{Binding Coordinates}" />
                                                <TextBlock
                                                    Classes="Small"
                                                    Text="{Binding Area}"
                                                    TextTrimming="CharacterEllipsis" />
                                                <TextBlock
                                                    Classes="Caption Muted"
                                                    Text="{Binding MapDetail}"
                                                    TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>
                                    <Border Classes="Tile" Grid.Column="2">
                                        <StackPanel Spacing="10">
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <c:Icon
                                                    Classes="Muted"
                                                    Data="{StaticResource IconBag}"
                                                    Height="15"
                                                    Width="15" />
                                                <TextBlock
                                                    Classes="Label"
                                                    Text="{l:Tr Pods}"
                                                    VerticalAlignment="Center" />
                                            </StackPanel>
                                            <StackPanel Spacing="8">
                                                <TextBlock Classes="Value" Text="{Binding Load}" />
                                                <ProgressBar Classes="Load" Value="{Binding LoadPercent}" />
                                                <TextBlock Classes="Caption Muted" Text="{Binding LoadDetail}" />
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>
                                    <Border Classes="Tile" Grid.Row="2">
                                        <StackPanel Spacing="10">
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <c:Icon
                                                    Classes="Muted"
                                                    Data="{StaticResource IconCoins}"
                                                    Height="15"
                                                    Width="15" />
                                                <TextBlock
                                                    Classes="Label"
                                                    Text="{l:Tr Kamas}"
                                                    VerticalAlignment="Center" />
                                            </StackPanel>
                                            <TextBlock Classes="Value" Text="{Binding Kamas}" />
                                        </StackPanel>
                                    </Border>
                                    <Border
                                        Classes="Tile"
                                        Grid.Column="2"
                                        Grid.Row="2">
                                        <StackPanel Spacing="10">
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <c:Icon
                                                    Classes="Muted"
                                                    Data="{StaticResource IconUser}"
                                                    Height="15"
                                                    Width="15" />
                                                <TextBlock
                                                    Classes="Label"
                                                    Text="{l:Tr State}"
                                                    VerticalAlignment="Center" />
                                            </StackPanel>
                                            <TextBlock
                                                Classes="Value"
                                                Text="{Binding Doing}"
                                                TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                    </Border>
                                </Grid>
                                <Border Classes="Tile" Padding="20,18">
                                    <StackPanel Spacing="16">
                                        <Grid ColumnDefinitions="*,Auto">
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <c:Icon
                                                    Classes="Muted"
                                                    Data="{StaticResource IconPulse}"
                                                    Height="15"
                                                    Width="15" />
                                                <TextBlock
                                                    Classes="Label"
                                                    Text="{l:Tr Activity}"
                                                    VerticalAlignment="Center" />
                                            </StackPanel>
                                            <c:StatusPill
                                                Grid.Column="1"
                                                IsVisible="{Binding HasRun}"
                                                Text="{Binding ActivityText}"
                                                Tone="{Binding ActivityTone}" />
                                        </Grid>
                                        <StackPanel Spacing="4">
                                            <TextBlock
                                                FontSize="18"
                                                FontWeight="SemiBold"
                                                Text="{Binding ActivityName}" />
                                            <TextBlock
                                                Classes="Small Muted"
                                                Text="{Binding ActivityDetail}"
                                                TextWrapping="Wrap" />
                                        </StackPanel>
                                        <Border Background="{DynamicResource BorderColor}" Height="1" />
                                        <Grid ColumnDefinitions="*,Auto" IsVisible="{Binding IsChoosing}">
                                            <ComboBox
                                                HorizontalAlignment="Stretch"
                                                ItemsSource="{Binding Activities}"
                                                PlaceholderText="{l:Tr ChooseActivity}"
                                                SelectedItem="{Binding SelectedActivity}">
                                                <ComboBox.ItemTemplate>
                                                    <DataTemplate x:DataType="activities:ActivityDefinition">
                                                        <TextBlock Text="{Binding Name}" />
                                                    </DataTemplate>
                                                </ComboBox.ItemTemplate>
                                            </ComboBox>
                                            <Button
                                                Classes="Primary"
                                                Command="{Binding StartCommand}"
                                                Grid.Column="1"
                                                Margin="10,0,0,0">
                                                <StackPanel Orientation="Horizontal" Spacing="8">
                                                    <c:Icon
                                                        Data="{StaticResource IconPlay}"
                                                        Height="13"
                                                        Width="13" />
                                                    <TextBlock Text="{l:Tr Start}" />
                                                </StackPanel>
                                            </Button>
                                        </Grid>
                                        <Button
                                            Classes="Outline"
                                            Command="{Binding StopCommand}"
                                            HorizontalAlignment="Left"
                                            IsVisible="{Binding IsActivityRunning}">
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <c:Icon
                                                    Data="{StaticResource IconStop}"
                                                    Height="13"
                                                    Width="13" />
                                                <TextBlock Text="{l:Tr Stop}" />
                                            </StackPanel>
                                        </Button>
                                        <TextBlock
                                            Classes="Small Muted"
                                            IsVisible="{Binding HasNothingToChoose}"
                                            Text="{l:Tr NoActivityAvailable}"
                                            TextWrapping="Wrap" />
                                        <TextBlock
                                            Classes="Small"
                                            Foreground="{DynamicResource ErrorColor}"
                                            IsVisible="{Binding Error, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                                            Text="{Binding Error}"
                                            TextWrapping="Wrap" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </DataTemplate>
                    </ContentControl.ContentTemplate>
                </ContentControl>
            </ScrollViewer>
        </Grid>
    </Panel>
</UserControl>
