<UserControl
    x:Class="D3B.App.Views.BotsView"
    x:ClassModifier="internal"
    x:DataType="vm:BotsViewModel"
    xmlns="https://github.com/avaloniaui"
    xmlns:c="clr-namespace:D3B.App.Controls"
    xmlns:l="clr-namespace:D3B.App.Localization"
    xmlns:shadui="clr-namespace:ShadUI;assembly=ShadUI"
    xmlns:vm="clr-namespace:D3B.App.ViewModels"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Styles>
        <Style Selector="Border.Step">
            <Setter Property="Width" Value="24" />
            <Setter Property="Height" Value="24" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Background" Value="{DynamicResource GhostColor}" />
        </Style>
        <Style Selector="Border.Step > TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="ProgressBar.Load">
            <Setter Property="Height" Value="6" />
            <Setter Property="MinHeight" Value="6" />
            <Setter Property="Maximum" Value="100" />
        </Style>
        <Style Selector="ProgressBar.Load.Full">
            <Setter Property="Foreground" Value="{DynamicResource WarningColor}" />
        </Style>
        <Style Selector="Grid.Offline">
            <Setter Property="Opacity" Value="0.55" />
        </Style>
    </UserControl.Styles>
    <Panel>
        <StackPanel
            HorizontalAlignment="Center"
            IsVisible="{Binding IsEmpty}"
            Margin="32"
            MaxWidth="460"
            Spacing="22"
            VerticalAlignment="Center">
            <Border
                Background="{DynamicResource CardBackgroundColor}"
                BorderBrush="{DynamicResource BorderColor}"
                BorderThickness="1"
                CornerRadius="16"
                Height="60"
                HorizontalAlignment="Center"
                Width="60">
                <c:Icon
                    Classes="Muted"
                    Data="{StaticResource IconBot}"
                    Height="28"
                    Width="28" />
            </Border>
            <StackPanel Spacing="8">
                <TextBlock
                    Classes="h3"
                    HorizontalAlignment="Center"
                    Text="{l:Tr NoBotTitle}" />
                <TextBlock
                    Classes="Small Muted"
                    Text="{l:Tr NoBotDetail}"
                    TextAlignment="Center"
                    TextWrapping="Wrap" />
            </StackPanel>
            <Border Classes="Tile">
                <StackPanel Spacing="14">
                    <Grid ColumnDefinitions="Auto,*">
                        <Border Classes="Step">
                            <TextBlock Text="1" />
                        </Border>
                        <TextBlock
                            Classes="Small"
                            Grid.Column="1"
                            Margin="12,0,0,0"
                            Text="{l:Tr NoBotStep1}"
                            TextWrapping="Wrap"
                            VerticalAlignment="Center" />
                    </Grid>
                    <Grid ColumnDefinitions="Auto,*">
                        <Border Classes="Step">
                            <TextBlock Text="2" />
                        </Border>
                        <TextBlock
                            Classes="Small"
                            Grid.Column="1"
                            Margin="12,0,0,0"
                            Text="{l:Tr NoBotStep2}"
                            TextWrapping="Wrap"
                            VerticalAlignment="Center" />
                    </Grid>
                    <Grid ColumnDefinitions="Auto,*">
                        <Border Classes="Step">
                            <TextBlock Text="3" />
                        </Border>
                        <TextBlock
                            Classes="Small"
                            Grid.Column="1"
                            Margin="12,0,0,0"
                            Text="{l:Tr NoBotStep3}"
                            TextWrapping="Wrap"
                            VerticalAlignment="Center" />
                    </Grid>
                </StackPanel>
            </Border>
        </StackPanel>
        <DockPanel IsVisible="{Binding !IsEmpty}">
            <StackPanel Classes="PageHeader" DockPanel.Dock="Top">
                <TextBlock Classes="PageTitle" Text="{l:Tr Bots}" />
                <TextBlock Classes="Small Muted" Text="{Binding Summary}" />
            </StackPanel>
            <ScrollViewer>
                <ItemsControl ItemsSource="{Binding Items}" Margin="32,0,32,32">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <c:CardGrid />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:BotViewModel">
                            <Border Classes="Plate" Classes.Paused="{Binding IsPaused}">
                                <DockPanel>
                                    <Border
                                        Classes="PlateFooter"
                                        Classes.Paused="{Binding IsPaused}"
                                        DockPanel.Dock="Bottom">
                                        <StackPanel Spacing="12">
                                            <Grid ColumnDefinitions="Auto,*,Auto" IsVisible="{Binding IsPaused}">
                                                <c:Icon
                                                    Data="{StaticResource IconPause}"
                                                    Foreground="{DynamicResource WarningColor}"
                                                    Height="16"
                                                    VerticalAlignment="Center"
                                                    Width="16" />
                                                <StackPanel
                                                    Grid.Column="1"
                                                    Margin="10,0,12,0"
                                                    Spacing="1"
                                                    VerticalAlignment="Center">
                                                    <TextBlock
                                                        Classes="Small"
                                                        FontWeight="SemiBold"
                                                        Text="{l:Tr PausedTitle}"
                                                        TextTrimming="CharacterEllipsis" />
                                                    <TextBlock
                                                        Classes="Caption Muted"
                                                        Text="{l:Tr PausedDetail}"
                                                        TextWrapping="Wrap" />
                                                </StackPanel>
                                                <Button
                                                    Classes="Primary"
                                                    Command="{Binding ResumeCommand}"
                                                    Grid.Column="2"
                                                    VerticalAlignment="Center">
                                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                                        <c:Icon
                                                            Data="{StaticResource IconResume}"
                                                            Height="14"
                                                            Width="14" />
                                                        <TextBlock Text="{l:Tr Resume}" />
                                                    </StackPanel>
                                                </Button>
                                            </Grid>
                                            <Grid ColumnDefinitions="*,Auto,Auto" IsVisible="{Binding HasRun}">
                                                <StackPanel Spacing="1" VerticalAlignment="Center">
                                                    <TextBlock
                                                        Classes="Small"
                                                        FontWeight="SemiBold"
                                                        Text="{Binding ActivityName}"
                                                        TextTrimming="CharacterEllipsis" />
                                                    <TextBlock
                                                        Classes="Caption Muted Figures"
                                                        Text="{Binding ActivityDetail}"
                                                        TextWrapping="Wrap" />
                                                </StackPanel>
                                                <c:StatusPill
                                                    Grid.Column="1"
                                                    Margin="12,0,0,0"
                                                    Text="{Binding ActivityText}"
                                                    Tone="{Binding ActivityTone}" />
                                                <Button
                                                    Classes="Outline"
                                                    Command="{Binding StopCommand}"
                                                    Grid.Column="2"
                                                    IsVisible="{Binding IsActivityRunning}"
                                                    Margin="10,0,0,0">
                                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                                        <c:Icon
                                                            Data="{StaticResource IconStop}"
                                                            Height="13"
                                                            Width="13" />
                                                        <TextBlock Text="{l:Tr Stop}" />
                                                    </StackPanel>
                                                </Button>
                                            </Grid>
                                            <SelectableTextBlock
                                                Classes="Caption Figures"
                                                Foreground="{DynamicResource ErrorColor}"
                                                IsVisible="{Binding ActivityProblem, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                                                Text="{Binding ActivityProblem}"
                                                TextWrapping="Wrap" />
                                            <Grid ColumnDefinitions="*,Auto" IsVisible="{Binding IsChoosing}">
                                                <ComboBox
                                                    HorizontalAlignment="Stretch"
                                                    ItemsSource="{Binding Activities}"
                                                    PlaceholderText="{l:Tr ChooseActivity}"
                                                    SelectedItem="{Binding SelectedActivity}">
                                                    <ComboBox.ItemTemplate>
                                                        <DataTemplate x:DataType="vm:ActivityChoiceViewModel">
                                                            <Grid ColumnDefinitions="*,Auto">
                                                                <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                                                                <TextBlock
                                                                    Classes="Caption Muted"
                                                                    Grid.Column="1"
                                                                    IsVisible="{Binding HasDetail}"
                                                                    Margin="10,0,0,0"
                                                                    Text="{Binding Detail}"
                                                                    VerticalAlignment="Center" />
                                                            </Grid>
                                                        </DataTemplate>
                                                    </ComboBox.ItemTemplate>
                                                </ComboBox>
                                                <Button
                                                    Classes="Primary"
                                                    Command="{Binding StartCommand}"
                                                    Grid.Column="1"
                                                    Margin="10,0,0,0">
                                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                                        <c:Icon
                                                            Data="{StaticResource IconPlay}"
                                                            Height="13"
                                                            Width="13" />
                                                        <TextBlock Text="{l:Tr Start}" />
                                                    </StackPanel>
                                                </Button>
                                            </Grid>
                                            <TextBlock
                                                Classes="Caption Muted"
                                                IsVisible="{Binding HasNothingToChoose}"
                                                Text="{l:Tr NoActivityAvailable}"
                                                TextWrapping="Wrap" />
                                            <TextBlock
                                                Classes="Caption"
                                                Foreground="{DynamicResource ErrorColor}"
                                                IsVisible="{Binding Error, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                                                Text="{Binding Error}"
                                                TextWrapping="Wrap" />
                                        </StackPanel>
                                    </Border>
                                    <StackPanel>
                                        <Grid ColumnDefinitions="Auto,*,Auto" Margin="20,18,20,0">
                                            <Panel Height="42" Width="42">
                                                <shadui:Avatar
                                                    Fallback="{Binding Initials}"
                                                    Height="40"
                                                    HorizontalAlignment="Left"
                                                    VerticalAlignment="Top"
                                                    Width="40" />
                                                <Border
                                                    Background="{DynamicResource CardBackgroundColor}"
                                                    CornerRadius="7"
                                                    Height="14"
                                                    HorizontalAlignment="Right"
                                                    VerticalAlignment="Bottom"
                                                    Width="14">
                                                    <c:StatusPill
                                                        Classes="Dot"
                                                        HorizontalAlignment="Center"
                                                        Tone="{Binding Tone}" />
                                                </Border>
                                            </Panel>
                                            <StackPanel
                                                Grid.Column="1"
                                                Margin="12,0"
                                                Spacing="1"
                                                VerticalAlignment="Center">
                                                <TextBlock
                                                    FontSize="16"
                                                    FontWeight="SemiBold"
                                                    Text="{Binding Name}"
                                                    TextTrimming="CharacterEllipsis" />
                                                <TextBlock Classes="Caption Muted" Text="{Binding Level}" />
                                            </StackPanel>
                                            <StackPanel
                                                Grid.Column="2"
                                                Orientation="Horizontal"
                                                Spacing="4"
                                                VerticalAlignment="Top">
                                                <Button
                                                    Classes="Ghost"
                                                    Command="{Binding ShowMapCommand}"
                                                    CornerRadius="{DynamicResource MdCornerRadius}"
                                                    Height="26"
                                                    IsVisible="{Binding HasMap}"
                                                    Padding="0"
                                                    ToolTip.Tip="{l:Tr ShowMap}"
                                                    Width="26">
                                                    <c:Icon
                                                        Classes="Muted"
                                                        Data="{StaticResource IconMap}"
                                                        Height="15"
                                                        Width="15" />
                                                </Button>
                                                <Button
                                                    Classes="Ghost"
                                                    Command="{Binding ShowJournalCommand}"
                                                    CornerRadius="{DynamicResource MdCornerRadius}"
                                                    Height="26"
                                                    IsVisible="{Binding HasJournal}"
                                                    Padding="0"
                                                    ToolTip.Tip="{l:Tr ShowJournal}"
                                                    Width="26">
                                                    <c:Icon
                                                        Classes="Muted"
                                                        Data="{StaticResource IconJournal}"
                                                        Height="15"
                                                        Width="15" />
                                                </Button>
                                                <c:StatusPill Text="{Binding Connection}" Tone="{Binding ConnectionTone}" />
                                            </StackPanel>
                                        </Grid>
                                        <Grid
                                            Classes.Offline="{Binding !IsConnected}"
                                            ColumnDefinitions="*,28,*"
                                            Margin="20,16,20,20">
                                            <StackPanel Spacing="2" ToolTip.Tip="{Binding MapDetail}">
                                                <TextBlock Classes="Coordinates" Text="{Binding Coordinates}" />
                                                <TextBlock
                                                    Classes="Small"
                                                    Text="{Binding Place}"
                                                    TextTrimming="CharacterEllipsis" />
                                                <TextBlock Classes="Caption Muted" Text="{Binding Doing}" />
                                            </StackPanel>
                                            <StackPanel
                                                Grid.Column="2"
                                                Spacing="8"
                                                VerticalAlignment="Bottom">
                                                <Grid ColumnDefinitions="*,Auto">
                                                    <TextBlock
                                                        Classes="Small Figures"
                                                        Text="{Binding Load}"
                                                        TextTrimming="CharacterEllipsis" />
                                                    <TextBlock
                                                        Classes="Caption Muted Figures"
                                                        Grid.Column="1"
                                                        Margin="8,0,0,0"
                                                        Text="{Binding LoadPercentText}"
                                                        VerticalAlignment="Center" />
                                                </Grid>
                                                <ProgressBar
                                                    Classes="Load"
                                                    Classes.Full="{Binding IsNearlyFull}"
                                                    Value="{Binding LoadPercent}" />
                                                <StackPanel Orientation="Horizontal" Spacing="7">
                                                    <c:Icon
                                                        Classes="Muted"
                                                        Data="{StaticResource IconCoins}"
                                                        Height="14"
                                                        VerticalAlignment="Center"
                                                        Width="14" />
                                                    <TextBlock Classes="Small Figures" Text="{Binding Kamas}" />
                                                </StackPanel>
                                            </StackPanel>
                                        </Grid>
                                    </StackPanel>
                                </DockPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </DockPanel>
    </Panel>
</UserControl>
