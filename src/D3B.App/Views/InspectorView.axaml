<UserControl
    x:Class="D3B.App.Views.InspectorView"
    x:ClassModifier="internal"
    x:DataType="vm:InspectorViewModel"
    xmlns="https://github.com/avaloniaui"
    xmlns:c="clr-namespace:D3B.App.Controls"
    xmlns:l="clr-namespace:D3B.App.Localization"
    xmlns:logs="clr-namespace:D3B.App.ViewModels.Logs"
    xmlns:vm="clr-namespace:D3B.App.ViewModels.Inspector"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Styles>
        <Style Selector="Border.FrameRow">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Padding" Value="6,6" />
            <Setter Property="CornerRadius" Value="{DynamicResource MdCornerRadius}" />
        </Style>
        <Style Selector="Border.FrameRow:pointerover">
            <Setter Property="Background" Value="{DynamicResource GhostHoverColor}" />
        </Style>
        <Style Selector="Border.Fold">
            <Setter Property="Background" Value="{DynamicResource CardBackgroundColor}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderColor}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="{DynamicResource LgCornerRadius}" />
            <Setter Property="Margin" Value="98,2,0,8" />
            <Setter Property="Padding" Value="14,10" />
        </Style>
        <Style Selector="TextBlock.Hidden">
            <Setter Property="Foreground" Value="{DynamicResource WarningColor}" />
        </Style>
        <Style Selector="TextBlock.Note">
            <Setter Property="Foreground" Value="{DynamicResource MutedColor}" />
            <Setter Property="FontStyle" Value="Italic" />
        </Style>
    </UserControl.Styles>
    <DockPanel>
        <StackPanel Classes="PageHeader" DockPanel.Dock="Top">
            <TextBlock Classes="PageTitle" Text="{l:Tr Inspector}" />
            <TextBlock Classes="Small Muted" Text="{Binding Summary}" />
        </StackPanel>
        <StackPanel
            DockPanel.Dock="Top"
            Margin="32,0,32,14"
            Spacing="12">
            <Grid ColumnDefinitions="*,Auto">
                <ItemsControl ItemsSource="{Binding Bots}" VerticalAlignment="Center">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel ItemSpacing="6" LineSpacing="6" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="logs:LogSourceViewModel">
                            <Button
                                Classes="Outline Chip"
                                Classes.Selected="{Binding IsSelected}"
                                Command="{Binding SelectCommand}">
                                <StackPanel Orientation="Horizontal" Spacing="7">
                                    <c:StatusPill Classes="Dot" Tone="{Binding Tone}" />
                                    <TextBlock Text="{Binding Name}" VerticalAlignment="Center" />
                                    <TextBlock
                                        Classes="Caption Muted"
                                        Text="{l:Tr Live}"
                                        VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <ComboBox
                    DropDownOpened="OnCapturesOpened"
                    Grid.Column="1"
                    ItemsSource="{Binding Captures}"
                    Margin="12,0,0,0"
                    MinWidth="240"
                    PlaceholderText="{l:Tr ReplayCapture}"
                    SelectedItem="{Binding Capture}">
                    <ComboBox.ItemTemplate>
                        <DataTemplate x:DataType="vm:CaptureChoiceViewModel">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <c:Icon
                                    Classes="Muted"
                                    Data="{StaticResource IconCopy}"
                                    Height="13"
                                    VerticalAlignment="Center"
                                    Width="13" />
                                <TextBlock Text="{Binding Label}" VerticalAlignment="Center" />
                            </StackPanel>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
            </Grid>
            <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto,Auto">
                <Border
                    BorderBrush="{DynamicResource BorderColor}"
                    BorderThickness="1"
                    CornerRadius="{DynamicResource MdCornerRadius}"
                    Padding="2">
                    <StackPanel Orientation="Horizontal" Spacing="2">
                        <ToggleButton
                            Classes="Toggle"
                            Content="{l:Tr FrameClient}"
                            IsChecked="{Binding ShowsClient}" />
                        <ToggleButton
                            Classes="Toggle"
                            Content="{l:Tr FrameServer}"
                            IsChecked="{Binding ShowsServer}" />
                        <ToggleButton
                            Classes="Toggle"
                            Content="{l:Tr FrameD3B}"
                            IsChecked="{Binding ShowsD3B}" />
                    </StackPanel>
                </Border>
                <TextBox
                    Grid.Column="1"
                    HorizontalAlignment="Left"
                    Margin="12,0"
                    MinWidth="200"
                    PlaceholderText="{l:Tr FramesSearch}"
                    Text="{Binding Search}"
                    VerticalAlignment="Center"
                    Width="260">
                    <TextBox.InnerLeftContent>
                        <c:Icon
                            Classes="Muted"
                            Data="{StaticResource IconSearch}"
                            Height="14"
                            Margin="10,0,0,0"
                            Width="14" />
                    </TextBox.InnerLeftContent>
                </TextBox>
                <ToggleButton
                    Classes="Toggle"
                    Content="{l:Tr HideUnread}"
                    Grid.Column="2"
                    IsChecked="{Binding HidesUnread}"
                    Margin="0,0,6,0"
                    ToolTip.Tip="{l:Tr HideUnreadHint}" />
                <ToggleButton
                    Classes="Toggle"
                    Grid.Column="3"
                    IsChecked="{Binding Follow}"
                    Margin="0,0,6,0"
                    ToolTip.Tip="{l:Tr FollowHint}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <c:Icon
                            Data="{StaticResource IconChevronDown}"
                            Height="14"
                            Width="14" />
                        <TextBlock Text="{l:Tr Follow}" VerticalAlignment="Center" />
                    </StackPanel>
                </ToggleButton>
                <ToggleButton
                    Classes="Toggle"
                    Grid.Column="4"
                    IsChecked="{Binding IsFrozen}"
                    IsEnabled="{Binding IsLive}"
                    Margin="0,0,6,0"
                    ToolTip.Tip="{l:Tr FreezeHint}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <c:Icon
                            Data="{StaticResource IconPause}"
                            Height="14"
                            Width="14" />
                        <TextBlock Text="{l:Tr Freeze}" VerticalAlignment="Center" />
                    </StackPanel>
                </ToggleButton>
                <Button
                    Classes="Ghost"
                    Command="{Binding ClearCommand}"
                    Grid.Column="5"
                    Height="28"
                    Padding="8,0"
                    ToolTip.Tip="{l:Tr ClearFrames}">
                    <c:Icon
                        Data="{StaticResource IconTrash}"
                        Height="14"
                        Width="14" />
                </Button>
            </Grid>
            <TextBlock
                Classes="Caption"
                Foreground="{DynamicResource WarningColor}"
                IsVisible="{Binding CaptureProblem, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                Text="{Binding CaptureProblem}"
                TextWrapping="Wrap" />
        </StackPanel>
        <Panel>
            <TextBlock
                Classes="Small Muted"
                HorizontalAlignment="Center"
                IsVisible="{Binding IsEmpty}"
                Margin="32"
                MaxWidth="520"
                Text="{l:Tr FramesEmpty}"
                TextAlignment="Center"
                TextWrapping="Wrap"
                VerticalAlignment="Top" />
            <ScrollViewer Name="Scroller">
                <ItemsControl ItemsSource="{Binding Frames}" Margin="28,0,32,24">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <VirtualizingStackPanel />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:FrameRowViewModel">
                            <StackPanel>
                                <Border Classes="FrameRow" Tapped="OnFrameTapped">
                                    <Grid ColumnDefinitions="94,84,*,Auto,Auto">
                                        <TextBlock
                                            Classes="Mono Muted Figures"
                                            Text="{Binding Time}"
                                            VerticalAlignment="Center" />
                                        <c:StatusPill
                                            Grid.Column="1"
                                            HorizontalAlignment="Left"
                                            Text="{Binding Sender}"
                                            Tone="{Binding SenderTone}" />
                                        <TextBlock
                                            Classes="Mono"
                                            Grid.Column="2"
                                            Margin="8,0"
                                            Text="{Binding Name}"
                                            TextTrimming="CharacterEllipsis"
                                            VerticalAlignment="Center" />
                                        <TextBlock
                                            Classes="Caption Muted Figures"
                                            Grid.Column="3"
                                            Margin="0,0,12,0"
                                            Text="{Binding Size}"
                                            VerticalAlignment="Center" />
                                        <c:StatusPill
                                            Grid.Column="4"
                                            Text="{Binding Reading}"
                                            Tone="{Binding ReadingTone}" />
                                    </Grid>
                                </Border>
                                <Border Classes="Fold" IsVisible="{Binding IsExpanded}">
                                    <ItemsControl ItemsSource="{Binding Fields}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="vm:FrameFieldViewModel">
                                                <Grid ColumnDefinitions="Auto,*" Margin="{Binding Indent, Converter={x:Static c:LeftMargin.Instance}}">
                                                    <TextBlock
                                                        Classes="Mono Muted"
                                                        Classes.Note="{Binding IsNote}"
                                                        Margin="0,2,8,2"
                                                        Text="{Binding Label}" />
                                                    <SelectableTextBlock
                                                        Classes="Mono"
                                                        Grid.Column="1"
                                                        IsVisible="{Binding !IsHidden}"
                                                        Margin="0,2"
                                                        Text="{Binding Value}"
                                                        TextWrapping="Wrap" />
                                                    <TextBlock
                                                        Classes="Mono Hidden"
                                                        Grid.Column="1"
                                                        IsVisible="{Binding IsHidden}"
                                                        Margin="0,2"
                                                        Text="{Binding Value}" />
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </Border>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Panel>
    </DockPanel>
</UserControl>
