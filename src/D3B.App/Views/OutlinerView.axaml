<UserControl
    x:Class="D3B.App.Views.OutlinerView"
    x:ClassModifier="internal"
    x:DataType="vm:OutlinerViewModel"
    xmlns="https://github.com/avaloniaui"
    xmlns:c="clr-namespace:D3B.App.Controls"
    xmlns:l="clr-namespace:D3B.App.Localization"
    xmlns:vm="clr-namespace:D3B.App.ViewModels.World"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Styles>
        <Style Selector="Border.OutlinerRow">
            <Setter Property="Background" Value="{DynamicResource ClearColor}" />
            <Setter Property="CornerRadius" Value="7" />
            <Setter Property="Focusable" Value="True" />
            <Setter Property="Height" Value="30" />
            <Setter Property="Margin" Value="6,0" />
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition
                        Duration="0:0:0.12"
                        Easing="CubicEaseOut"
                        Property="Background" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Border.OutlinerRow:pointerover">
            <Setter Property="Background" Value="{DynamicResource HoverColor}" />
        </Style>
        <Style Selector="Border.OutlinerRow.Selected">
            <Setter Property="Background" Value="{DynamicResource AccentSoftColor}" />
        </Style>
        <Style Selector="Border.OutlinerRow:focus-visible">
            <Setter Property="BorderBrush" Value="{DynamicResource AccentColor}" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
        <Style Selector="Border.OutlinerRow.Dimmed">
            <Setter Property="Opacity" Value="0.55" />
        </Style>
        <Style Selector="Border.RunBadge">
            <Setter Property="BorderBrush" Value="{DynamicResource SuccessColor60}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="5,1" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="Border.RunBadge.Arrived">
            <Setter Property="Background" Value="{DynamicResource SuccessColor20}" />
        </Style>
        <Style Selector="Button.Eye">
            <Setter Property="Opacity" Value="0.35" />
        </Style>
        <Style Selector="Border.OutlinerRow:pointerover Button.Eye">
            <Setter Property="Opacity" Value="0.8" />
        </Style>
        <Style Selector="Button.Eye.Open">
            <Setter Property="Opacity" Value="0.8" />
        </Style>
    </UserControl.Styles>
    <DockPanel>
        <TextBox
            AutomationProperties.Name="{l:Tr OutlinerSearch}"
            Classes="PropertySearch"
            DockPanel.Dock="Top"
            Margin="8,8,8,6"
            Name="Search"
            PlaceholderText="{l:Tr OutlinerSearch}"
            Text="{Binding Filter}">
            <TextBox.InnerLeftContent>
                <c:Icon
                    Drawing="{StaticResource General.Search}"
                    Height="14"
                    Margin="8,0,0,0"
                    Width="14" />
            </TextBox.InnerLeftContent>
        </TextBox>
        <Panel>
            <TextBlock
                Classes="Dim"
                HorizontalAlignment="Center"
                IsVisible="{Binding IsEmpty}"
                Margin="16,30"
                Text="{l:Tr OutlinerEmpty}"
                TextAlignment="Center"
                TextWrapping="Wrap" />
            <ScrollViewer>
                <ItemsControl ItemsSource="{Binding Rows}" Name="Rows">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:OutlinerRowViewModel">
                            <Panel>
                                <Grid
                                    ColumnDefinitions="*,Auto"
                                    Height="28"
                                    IsVisible="{Binding IsHeading}"
                                    Margin="14,8,14,0">
                                    <TextBlock
                                        Classes="Dim"
                                        FontSize="11"
                                        FontWeight="SemiBold"
                                        Text="{Binding Title}"
                                        TextTrimming="CharacterEllipsis"
                                        VerticalAlignment="Center" />
                                    <TextBlock
                                        Classes="Dim Figures"
                                        FontSize="11"
                                        Grid.Column="1"
                                        Text="{Binding Count}"
                                        VerticalAlignment="Center" />
                                </Grid>
                                <Border
                                    Classes="OutlinerRow"
                                    Classes.Dimmed="{Binding IsDimmed}"
                                    Classes.Selected="{Binding IsSelected}"
                                    ContextRequested="OnContextRequested"
                                    DoubleTapped="OnRowDoubleTapped"
                                    IsVisible="{Binding IsItem}"
                                    KeyDown="OnRowKeyDown"
                                    Tapped="OnRowTapped">
                                    <Grid ColumnDefinitions="Auto,Auto,*,Auto,Auto" Margin="{Binding Indent, Converter={x:Static c:LeftMargin.Instance}}">
                                        <Button
                                            AutomationProperties.Name="{l:Tr OutlinerUnfold}"
                                            Classes="Tool Small"
                                            Command="{Binding $parent[ItemsControl].((vm:OutlinerViewModel)DataContext).ToggleExpandedCommand}"
                                            CommandParameter="{Binding}"
                                            IsVisible="{Binding CanExpand}"
                                            Width="20">
                                            <c:Icon
                                                Drawing="{StaticResource General.ChevronRight}"
                                                Height="10"
                                                RenderTransform="{Binding IsExpanded, Converter={x:Static c:ChevronTurn.Instance}}"
                                                Width="10" />
                                        </Button>
                                        <Panel
                                            Grid.Column="1"
                                            Margin="2,0,8,0"
                                            VerticalAlignment="Center">
                                            <c:Portrait
                                                Color="{Binding PortraitColor}"
                                                Head="{Binding Head}"
                                                Height="22"
                                                Initials="{Binding Initials}"
                                                IsDimmed="{Binding IsDimmed}"
                                                IsVisible="{Binding IsCharacter}"
                                                Radius="11"
                                                Width="22" />
                                            <Ellipse
                                                Fill="{Binding StateBrush}"
                                                Height="8"
                                                HorizontalAlignment="Right"
                                                IsVisible="{Binding IsCharacter}"
                                                Margin="0,0,-2,-2"
                                                Stroke="{DynamicResource RecessColor}"
                                                StrokeThickness="1.5"
                                                VerticalAlignment="Bottom"
                                                Width="8" />
                                            <c:Icon
                                                Drawing="{Binding IconKey, Converter={x:Static c:DrawingOf.Instance}}"
                                                Height="14"
                                                IsVisible="{Binding HasIcon}"
                                                Width="14" />
                                        </Panel>
                                        <StackPanel
                                            Grid.Column="2"
                                            Orientation="Horizontal"
                                            Spacing="8"
                                            VerticalAlignment="Center">
                                            <TextBlock
                                                Classes="Bright"
                                                FontSize="12.5"
                                                Text="{Binding Title}"
                                                TextTrimming="CharacterEllipsis" />
                                            <Ellipse
                                                Fill="{DynamicResource PausedColor}"
                                                Height="6"
                                                IsVisible="{Binding IsDirty}"
                                                ToolTip.Tip="{l:Tr UnsavedChanges}"
                                                VerticalAlignment="Center"
                                                Width="6" />
                                            <TextBlock
                                                Classes="Dim"
                                                FontSize="11"
                                                Text="{Binding Detail}"
                                                TextTrimming="CharacterEllipsis"
                                                VerticalAlignment="Center" />
                                            <Border
                                                Classes="RunBadge"
                                                Classes.Arrived="{Binding IsArrived}"
                                                IsVisible="{Binding IsFollowed}">
                                                <TextBlock
                                                    FontSize="10"
                                                    FontWeight="SemiBold"
                                                    Foreground="{DynamicResource SuccessColor}"
                                                    Text="{Binding Followers}" />
                                            </Border>
                                        </StackPanel>
                                        <ItemsControl
                                            Grid.Column="3"
                                            IsVisible="{Binding HasDots}"
                                            ItemsSource="{Binding Dots}"
                                            Margin="0,0,6,0"
                                            VerticalAlignment="Center">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <StackPanel Orientation="Horizontal" Spacing="3" />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="IBrush">
                                                    <Ellipse
                                                        Fill="{Binding}"
                                                        Height="6"
                                                        Width="6" />
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <Button
                                            AutomationProperties.Name="{l:Tr OutlinerEye}"
                                            Classes="Tool Small Eye"
                                            Classes.Open="{Binding IsEyeOpen}"
                                            Command="{Binding $parent[ItemsControl].((vm:OutlinerViewModel)DataContext).ToggleEyeCommand}"
                                            CommandParameter="{Binding}"
                                            Grid.Column="4"
                                            IsVisible="{Binding HasEye}"
                                            ToolTip.Tip="{l:Tr OutlinerEye}">
                                            <Viewbox Height="14" Width="14">
                                                <Canvas Height="16" Width="16">
                                                    <Path
                                                        Data="M1.5 8C3 5 5.3 3.5 8 3.5S13 5 14.5 8C13 11 10.7 12.5 8 12.5S3 11 1.5 8zM8 6.2a1.8 1.8 0 1 0 0 3.6 1.8 1.8 0 0 0 0-3.6z"
                                                        Stroke="{Binding $parent[Button].Foreground}"
                                                        StrokeJoin="Round"
                                                        StrokeLineCap="Round"
                                                        StrokeThickness="1.4" />
                                                    <Path
                                                        Data="M3 13.5L13 2.5"
                                                        IsVisible="{Binding !IsEyeOpen}"
                                                        Stroke="{Binding $parent[Button].Foreground}"
                                                        StrokeLineCap="Round"
                                                        StrokeThickness="1.4" />
                                                </Canvas>
                                            </Viewbox>
                                        </Button>
                                    </Grid>
                                </Border>
                            </Panel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Panel>
    </DockPanel>
</UserControl>
