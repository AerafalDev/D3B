<UserControl
    x:Class="D3B.App.Views.AssetsView"
    x:ClassModifier="internal"
    x:DataType="a:AssetsViewModel"
    xmlns="https://github.com/avaloniaui"
    xmlns:a="clr-namespace:D3B.App.ViewModels.Assets"
    xmlns:c="clr-namespace:D3B.App.Controls"
    xmlns:l="clr-namespace:D3B.App.Localization"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Styles>
        <Style Selector="Border.AssetRow">
            <Setter Property="Background" Value="{DynamicResource ClearColor}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ClearColor}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Height" Value="28" />
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Duration="0:0:0.12" Property="Background" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Border.AssetRow:pointerover">
            <Setter Property="Background" Value="{DynamicResource HoverColor}" />
        </Style>
        <Style Selector="Border.AssetRow.Selected">
            <Setter Property="Background" Value="{DynamicResource AccentSoftColor}" />
        </Style>
        <Style Selector="Border#Tree:focus-within Border.AssetRow.Focused">
            <Setter Property="BorderBrush" Value="{DynamicResource AccentEdgeColor}" />
        </Style>
        <Style Selector="Border.AssetRow.Cut">
            <Setter Property="Opacity" Value="0.45" />
        </Style>
        <Style Selector="Border.AssetRow.Drop">
            <Setter Property="Background" Value="{DynamicResource AccentSoftColor}" />
            <Setter Property="BorderBrush" Value="{DynamicResource AccentColor}" />
        </Style>
        <Style Selector="Border.AssetRow.Heading">
            <Setter Property="Margin" Value="0,8,0,0" />
            <Setter Property="Height" Value="30" />
        </Style>
        <Style Selector="Border.AssetRow.Heading TextBlock.AssetName">
            <Setter Property="Foreground" Value="{DynamicResource DimColor}" />
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style Selector="Border.AssetRow.Given TextBlock.AssetName">
            <Setter Property="Foreground" Value="{DynamicResource MutedColor}" />
        </Style>
        <Style Selector="Border.AssetRow.Bad TextBlock.AssetName">
            <Setter Property="Foreground" Value="#F3A19A" />
        </Style>
        <Style Selector="Border.KindSquare">
            <Setter Property="CornerRadius" Value="5" />
            <Setter Property="Height" Value="18" />
            <Setter Property="Width" Value="18" />
        </Style>
        <Style Selector="TextBox.Rename">
            <Setter Property="MinHeight" Value="22" />
            <Setter Property="Height" Value="22" />
            <Setter Property="Padding" Value="5,0" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style Selector="Button.Add">
            <Setter Property="Height" Value="28" />
            <Setter Property="Padding" Value="9,0,11,0" />
            <Setter Property="CornerRadius" Value="7" />
        </Style>
    </UserControl.Styles>
    <DockPanel>
        <Grid
            ColumnDefinitions="Auto,*"
            DockPanel.Dock="Top"
            Margin="8,8,8,6">
            <Button
                Classes="Primary Add"
                Click="OnAddClick"
                IsEnabled="{Binding IsAvailable}"
                Name="AddButton">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <c:Icon
                        Drawing="{StaticResource General.Add}"
                        Height="14"
                        Tint="White"
                        Width="14" />
                    <TextBlock Text="{l:Tr Add}" VerticalAlignment="Center" />
                </StackPanel>
            </Button>
            <TextBox
                AutomationProperties.Name="{l:Tr AssetsSearch}"
                Classes="PropertySearch"
                Grid.Column="1"
                KeyDown="OnSearchKeyDown"
                Margin="8,0,0,0"
                Name="Search"
                PlaceholderText="{l:Tr Search}"
                Text="{Binding Filter}">
                <TextBox.InnerLeftContent>
                    <c:Icon
                        Drawing="{StaticResource General.Search}"
                        Height="14"
                        Margin="8,0,0,0"
                        Width="14" />
                </TextBox.InnerLeftContent>
            </TextBox>
        </Grid>
        <Border
            Background="{DynamicResource ClearColor}"
            ContextRequested="OnTreeContextRequested"
            DragDrop.AllowDrop="True"
            Focusable="True"
            KeyDown="OnTreeKeyDown"
            Name="Tree"
            PointerPressed="OnTreePressed">
            <Panel>
                <TextBlock
                    Classes="Dim"
                    HorizontalAlignment="Center"
                    IsVisible="{Binding FindsNothing}"
                    Margin="16,30"
                    Text="{l:Tr AssetsNoMatch}"
                    TextAlignment="Center"
                    TextWrapping="Wrap"
                    VerticalAlignment="Top" />
                <TextBlock
                    Classes="Dim"
                    HorizontalAlignment="Center"
                    IsVisible="{Binding !IsAvailable}"
                    Margin="16,30"
                    Text="{l:Tr AssetsWaitHost}"
                    TextAlignment="Center"
                    TextWrapping="Wrap"
                    VerticalAlignment="Top" />
                <ScrollViewer Name="Scroller">
                    <StackPanel Margin="6,2,6,10">
                        <ItemsControl ItemsSource="{Binding Rows}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="a:AssetRowViewModel">
                                    <Border
                                        Classes="AssetRow"
                                        Classes.Bad="{Binding IsProblem}"
                                        Classes.Cut="{Binding IsCut}"
                                        Classes.Drop="{Binding IsDropTarget}"
                                        Classes.Focused="{Binding IsFocused}"
                                        Classes.Given="{Binding IsGiven}"
                                        Classes.Heading="{Binding IsGivenHeading}"
                                        Classes.Selected="{Binding IsSelected}"
                                        ContextRequested="OnRowContextRequested"
                                        PointerMoved="OnRowPointerMoved"
                                        PointerPressed="OnRowPressed"
                                        PointerReleased="OnRowReleased"
                                        ToolTip.Tip="{Binding Tip}">
                                        <Grid
                                            ColumnDefinitions="Auto,Auto,*,Auto,Auto"
                                            Margin="{Binding Indent, Converter={x:Static c:LeftMargin.Instance}}"
                                            VerticalAlignment="Center">
                                            <Border
                                                Background="{DynamicResource ClearColor}"
                                                Name="Chevron"
                                                Padding="6,0,7,0"
                                                VerticalAlignment="Stretch"
                                                Width="25">
                                                <c:Icon
                                                    Classes="Chevron"
                                                    IsVisible="{Binding Folds}"
                                                    Drawing="{StaticResource General.ChevronRight}"
                                                    Height="12"
                                                    RenderTransform="{Binding IsExpanded, Converter={x:Static c:ChevronTurn.Instance}}"
                                                    VerticalAlignment="Center"
                                                    Width="12" />
                                            </Border>
                                            <Panel
                                                Grid.Column="1"
                                                Margin="0,0,7,0"
                                                VerticalAlignment="Center">
                                                <Panel.IsVisible>
                                                    <MultiBinding Converter="{x:Static BoolConverters.Or}">
                                                        <Binding Path="IsAsset" />
                                                        <Binding Path="IsProblem" />
                                                    </MultiBinding>
                                                </Panel.IsVisible>
                                                <Border
                                                    Background="{Binding KindTint}"
                                                    Classes="KindSquare"
                                                    IsVisible="{Binding HasKind}">
                                                    <c:Icon
                                                        Drawing="{Binding Icon, Converter={x:Static c:DrawingOf.Instance}}"
                                                        Height="12"
                                                        Tint="{Binding KindBrush}"
                                                        Width="12" />
                                                </Border>
                                            </Panel>
                                            <c:Icon
                                                Drawing="{StaticResource General.Locked}"
                                                Grid.Column="1"
                                                Height="12"
                                                IsVisible="{Binding IsGivenHeading}"
                                                Margin="0,0,7,0"
                                                Width="12" />
                                            <c:Icon
                                                Drawing="{StaticResource Nodes.Folder}"
                                                Grid.Column="1"
                                                Height="16"
                                                IsVisible="{Binding IsFolder}"
                                                Margin="0,0,7,0"
                                                Width="16" />
                                            <TextBlock
                                                Classes="AssetName"
                                                Grid.Column="2"
                                                IsVisible="{Binding IsShowingName}"
                                                TextTrimming="CharacterEllipsis"
                                                VerticalAlignment="Center">
                                                <Run Text="{Binding Before}" /><Run
                                                    Background="{DynamicResource AccentEdgeColor}"
                                                    Foreground="{DynamicResource BrightColor}"
                                                    Text="{Binding Found}" /><Run Text="{Binding After}" />
                                            </TextBlock>
                                            <TextBox
                                                AttachedToVisualTree="OnRenameAttached"
                                                Classes="Rename"
                                                Grid.Column="2"
                                                IsVisible="{Binding IsRenaming}"
                                                KeyDown="OnRenameKeyDown"
                                                LostFocus="OnRenameLostFocus"
                                                Margin="-5,0,6,0"
                                                Text="{Binding EditName}" />
                                            <Ellipse
                                                Fill="{DynamicResource PausedColor}"
                                                Grid.Column="3"
                                                Height="6"
                                                IsVisible="{Binding IsUnsaved}"
                                                Margin="6,0,0,0"
                                                ToolTip.Tip="{l:Tr UnsavedChanges}"
                                                VerticalAlignment="Center"
                                                Width="6" />
                                            <TextBlock
                                                Classes="Dim Figures"
                                                FontSize="11"
                                                Grid.Column="4"
                                                IsVisible="{Binding HasCount}"
                                                Margin="8,0,8,0"
                                                Text="{Binding Count}"
                                                ToolTip.Tip="{Binding CountTip}"
                                                VerticalAlignment="Center" />
                                            <c:Icon
                                                Drawing="{StaticResource Status.Error}"
                                                Grid.Column="4"
                                                Height="14"
                                                IsVisible="{Binding IsProblem}"
                                                Margin="8,0,8,0"
                                                Width="14" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock
                            Classes="Dim"
                            IsVisible="{Binding IsProjectEmpty}"
                            Margin="10,12,10,0"
                            Text="{l:Tr AssetsEmptyProject}"
                            TextWrapping="Wrap" />
                    </StackPanel>
                </ScrollViewer>
            </Panel>
        </Border>
    </DockPanel>
</UserControl>
