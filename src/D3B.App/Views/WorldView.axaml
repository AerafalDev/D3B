<UserControl
    x:Class="D3B.App.Views.WorldView"
    x:ClassModifier="internal"
    x:DataType="vm:WorldViewportViewModel"
    xmlns="https://github.com/avaloniaui"
    xmlns:c="clr-namespace:D3B.App.Controls"
    xmlns:l="clr-namespace:D3B.App.Localization"
    xmlns:r="clr-namespace:D3B.App.ViewModels.Routes"
    xmlns:vm="clr-namespace:D3B.App.ViewModels.World"
    xmlns:w="clr-namespace:D3B.App.Controls.WorldMaps"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:z="clr-namespace:D3B.App.ViewModels.Zones">
    <UserControl.Styles>
        <Style Selector="Border.Glass">
            <Setter Property="Background" Value="#DB161619" />
            <Setter Property="BorderBrush" Value="#17FFFFFF" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="11" />
            <Setter Property="Padding" Value="3" />
            <Setter Property="BoxShadow" Value="0 8 24 0 #66000000" />
        </Style>
        <Style Selector="Border.Hud">
            <Setter Property="Background" Value="#C70E0E10" />
            <Setter Property="BorderBrush" Value="#0DFFFFFF" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="9" />
            <Setter Property="Padding" Value="10,5" />
            <Setter Property="IsHitTestVisible" Value="False" />
        </Style>
        <Style Selector="Border.PlayFrame">
            <Setter Property="BorderBrush" Value="#4ADE80" />
            <Setter Property="BorderThickness" Value="2" />
            <Setter Property="BoxShadow" Value="inset 0 0 28 0 #334ADE80" />
            <Setter Property="IsHitTestVisible" Value="False" />
        </Style>
        <Style Selector="Button.Tool.Selected">
            <Setter Property="Background" Value="{DynamicResource AccentSoftColor}" />
            <Setter Property="Foreground" Value="{DynamicResource BrightColor}" />
        </Style>
        <Style Selector="TextBox.Add">
            <Setter Property="Height" Value="30" />
            <Setter Property="MinHeight" Value="30" />
            <Setter Property="Width" Value="150" />
            <Setter Property="Padding" Value="8,0" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style Selector="TextBox.Add.Failed">
            <Setter Property="Foreground" Value="#FF9D95" />
        </Style>
        <Style Selector="Button.Row">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Height" Value="30" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Padding" Value="10,0" />
        </Style>
        <Style Selector="Button.Row:pointerover">
            <Setter Property="Background" Value="{DynamicResource HoverColor}" />
        </Style>
    </UserControl.Styles>
    <Grid Background="#0C1A1C">
        <w:WorldMapView
            AutomationProperties.Name="{l:Tr WorldMapName}"
            Hints="{Binding Hints.Visible}"
            Name="Map"
            Scene="{Binding Scene}"
            ShowGrid="{Binding ShowGrid}"
            ShowShared="{Binding ShowShared}"
            Source="{Binding Source}"
            Tool="{Binding MapTool}"
            World="{Binding Layer}" />

        <Border Classes="PlayFrame" IsVisible="{Binding IsFramed}" Name="PlayFrame" />

        <Grid
            ColumnDefinitions="Auto,*,Auto"
            Margin="12"
            VerticalAlignment="Top">
            <Border
                Classes="Glass"
                HorizontalAlignment="Left"
                VerticalAlignment="Top">
                <Button Classes="Tool" IsEnabled="{Binding HasWorlds}">
                    <StackPanel Orientation="Horizontal" Spacing="7">
                        <c:Icon
                            Drawing="{StaticResource General.Language}"
                            Height="14"
                            VerticalAlignment="Center"
                            Width="14" />
                        <TextBlock
                            Foreground="{DynamicResource BrightColor}"
                            Text="{Binding LayerName}"
                            VerticalAlignment="Center" />
                        <c:Icon
                            Drawing="{StaticResource General.ChevronDown}"
                            Height="10"
                            Opacity="0.6"
                            VerticalAlignment="Center"
                            Width="10" />
                    </StackPanel>
                    <Button.Flyout>
                        <Flyout FlyoutPresenterClasses="Bare" Placement="BottomEdgeAlignedLeft">
                            <Border Classes="MenuPopup" MinWidth="260">
                                <StackPanel Margin="4">
                                    <TextBlock
                                        Classes="Dim"
                                        FontSize="11"
                                        Margin="10,6,10,3"
                                        Text="{l:Tr RouteWorldLayer}" />
                                    <ScrollViewer MaxHeight="340">
                                        <ItemsControl ItemsSource="{Binding Worlds}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="r:WorldChoiceViewModel">
                                                    <Button Classes="Row" Click="OnWorldChosen">
                                                        <Grid ColumnDefinitions="*,Auto,18">
                                                            <TextBlock
                                                                Foreground="{DynamicResource BrightColor}"
                                                                Text="{Binding Name}"
                                                                TextTrimming="CharacterEllipsis"
                                                                VerticalAlignment="Center" />
                                                            <TextBlock
                                                                Classes="Dim"
                                                                FontSize="11"
                                                                Grid.Column="1"
                                                                Margin="12,0,0,0"
                                                                Text="{Binding Detail}"
                                                                VerticalAlignment="Center" />
                                                            <c:Icon
                                                                Drawing="{StaticResource Status.Success}"
                                                                Grid.Column="2"
                                                                Height="12"
                                                                HorizontalAlignment="Right"
                                                                IsVisible="{Binding IsChosen}"
                                                                Width="12" />
                                                        </Grid>
                                                    </Button>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>
                                    <TextBlock
                                        Classes="Dim"
                                        FontSize="11"
                                        Margin="10,6,10,6"
                                        MaxWidth="250"
                                        Text="{l:Tr RouteWorldFootnote}"
                                        TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>
                        </Flyout>
                    </Button.Flyout>
                </Button>
            </Border>

            <StackPanel
                Grid.Column="1"
                HorizontalAlignment="Center"
                Margin="12,0"
                Spacing="6"
                VerticalAlignment="Top">
                <Border Classes="Glass" HorizontalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Spacing="3">
                        <Button
                            AutomationProperties.Name="{l:Tr RouteToolSelect}"
                            Classes="Tool"
                            Classes.Selected="{Binding IsSelecting}"
                            Command="{Binding SetToolCommand}"
                            CommandParameter="{x:Static vm:WorldTool.Select}"
                            Name="SelectTool"
                            ToolTip.Tip="{l:Tr RouteToolSelect}">
                            <StackPanel Orientation="Horizontal" Spacing="7">
                                <Viewbox Height="15" Width="15">
                                    <Canvas Height="16" Width="16">
                                        <Path
                                            Data="M4 2.5l8 4.2-3.6 1.1L7 11.6z"
                                            Stroke="{Binding $parent[Button].Foreground}"
                                            StrokeJoin="Round"
                                            StrokeLineCap="Round"
                                            StrokeThickness="1.6" />
                                    </Canvas>
                                </Viewbox>
                                <TextBlock Text="{l:Tr WorldToolSelect}" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button
                            AutomationProperties.Name="{l:Tr WorldToolRouteTip}"
                            Classes="Tool"
                            Classes.Selected="{Binding IsRouting}"
                            Command="{Binding SetToolCommand}"
                            CommandParameter="{x:Static vm:WorldTool.Route}"
                            Name="RouteTool"
                            ToolTip.Tip="{l:Tr WorldToolRouteTip}">
                            <StackPanel Orientation="Horizontal" Spacing="7">
                                <Viewbox Height="15" Width="15">
                                    <Canvas Height="16" Width="16">
                                        <Path
                                            Data="M3 13c2.5 0 3-1.5 3-2.5L12.5 4a1.4 1.4 0 0 0-2-2L4 8.5C3 9 3 11 3 13z"
                                            Stroke="{Binding $parent[Button].Foreground}"
                                            StrokeJoin="Round"
                                            StrokeLineCap="Round"
                                            StrokeThickness="1.6" />
                                    </Canvas>
                                </Viewbox>
                                <TextBlock Text="{l:Tr WorldToolRoute}" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button
                            AutomationProperties.Name="{l:Tr WorldToolZoneTip}"
                            Classes="Tool"
                            Classes.Selected="{Binding IsZoning}"
                            Command="{Binding SetToolCommand}"
                            CommandParameter="{x:Static vm:WorldTool.Zone}"
                            Name="ZoneTool"
                            ToolTip.Tip="{l:Tr WorldToolZoneTip}">
                            <StackPanel Orientation="Horizontal" Spacing="7">
                                <Viewbox Height="15" Width="15">
                                    <Canvas Height="16" Width="16">
                                        <Path
                                            Data="M2.5 2.5h11v11h-11zM2.5 8h11M8 2.5v11"
                                            Stroke="{Binding $parent[Button].Foreground}"
                                            StrokeJoin="Round"
                                            StrokeLineCap="Round"
                                            StrokeThickness="1.5" />
                                    </Canvas>
                                </Viewbox>
                                <TextBlock Text="{l:Tr WorldToolZone}" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button
                            AutomationProperties.Name="{l:Tr WorldToolRecordTip}"
                            Classes="Tool"
                            IsEnabled="False"
                            Name="RecordTool"
                            ToolTip.Tip="{l:Tr WorldToolRecordTip}">
                            <StackPanel Orientation="Horizontal" Spacing="7">
                                <Ellipse
                                    Height="11"
                                    Stroke="{Binding $parent[Button].Foreground}"
                                    StrokeThickness="1.6"
                                    Width="11" />
                                <TextBlock Text="{l:Tr WorldToolRecord}" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Border
                            Background="#17FFFFFF"
                            Height="18"
                            IsVisible="{Binding ShowsAdd}"
                            Margin="3,0"
                            Width="1" />
                        <TextBox
                            AutomationProperties.Name="{l:Tr RouteAddName}"
                            Classes="Add"
                            Classes.Failed="{Binding Route.AddFailed}"
                            IsVisible="{Binding ShowsAdd}"
                            Name="AddBox"
                            PlaceholderText="{l:Tr RouteAddPlaceholder}"
                            Text="{Binding Route.AddText}"
                            ToolTip.Tip="{l:Tr RouteAddUnknown}">
                            <TextBox.KeyBindings>
                                <KeyBinding Command="{Binding Route.AddCommand}" Gesture="Enter" />
                            </TextBox.KeyBindings>
                        </TextBox>
                    </StackPanel>
                </Border>
                <Border
                    Classes="Glass"
                    HorizontalAlignment="Center"
                    IsVisible="{Binding ShowsZoneTools}"
                    Name="ZoneTools">
                    <StackPanel Orientation="Horizontal" Spacing="3">
                        <Button
                            Classes="Tool"
                            Classes.Selected="{Binding IsPainting}"
                            Command="{Binding SetZoneToolCommand}"
                            CommandParameter="{x:Static w:WorldMapTool.Trace}">
                            <TextBlock Text="{l:Tr ZoneToolPaint}" VerticalAlignment="Center" />
                        </Button>
                        <Button
                            Classes="Tool"
                            Classes.Selected="{Binding IsErasing}"
                            Command="{Binding SetZoneToolCommand}"
                            CommandParameter="{x:Static w:WorldMapTool.Erase}">
                            <TextBlock Text="{l:Tr ZoneToolErase}" VerticalAlignment="Center" />
                        </Button>
                        <Button
                            Classes="Tool"
                            Classes.Selected="{Binding IsChoosingSubAreas}"
                            Command="{Binding SetZoneToolCommand}"
                            CommandParameter="{x:Static w:WorldMapTool.Region}">
                            <TextBlock Text="{l:Tr ZoneToolSubArea}" VerticalAlignment="Center" />
                        </Button>
                    </StackPanel>
                </Border>
            </StackPanel>

            <Border
                Classes="Glass"
                Grid.Column="2"
                HorizontalAlignment="Right"
                VerticalAlignment="Top">
                <StackPanel Orientation="Horizontal" Spacing="3">
                    <Button
                        AutomationProperties.Name="{l:Tr RouteView}"
                        Classes="Tool"
                        ToolTip.Tip="{l:Tr RouteView}">
                        <StackPanel Orientation="Horizontal" Spacing="7">
                            <c:Icon
                                Drawing="{StaticResource Toolwindows.Structure}"
                                Height="14"
                                VerticalAlignment="Center"
                                Width="14" />
                            <c:Icon
                                Drawing="{StaticResource General.ChevronDown}"
                                Height="10"
                                Opacity="0.6"
                                VerticalAlignment="Center"
                                Width="10" />
                        </StackPanel>
                        <Button.Flyout>
                            <Flyout FlyoutPresenterClasses="Bare" Placement="BottomEdgeAlignedRight">
                                <Border Classes="MenuPopup" MinWidth="240">
                                    <StackPanel Margin="6" Spacing="8">
                                        <CheckBox Content="{l:Tr RouteViewGrid}" IsChecked="{Binding ShowGrid}" />
                                        <CheckBox Content="{l:Tr RouteViewShared}" IsChecked="{Binding ShowShared}" />
                                        <StackPanel IsVisible="{Binding Hints.IsAvailable}" Spacing="8">
                                            <Border
                                                Background="#17FFFFFF"
                                                Height="1"
                                                Margin="0,2" />
                                            <CheckBox Content="{l:Tr WorldHints}" IsChecked="{Binding Hints.ShowHints}" />
                                            <ItemsControl IsEnabled="{Binding Hints.ShowHints}" ItemsSource="{Binding Hints.Categories}" Margin="20,0,0,0">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate x:DataType="vm:HintCategoryViewModel">
                                                        <CheckBox IsChecked="{Binding IsOn}" Margin="0,0,0,8">
                                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                                <TextBlock Text="{Binding Name}" />
                                                                <TextBlock Classes="Dim" Text="{Binding Count}" />
                                                            </StackPanel>
                                                        </CheckBox>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </Flyout>
                        </Button.Flyout>
                    </Button>
                    <Border
                        Background="#17FFFFFF"
                        Height="18"
                        Margin="3,0"
                        Width="1" />
                    <Button
                        AutomationProperties.Name="{l:Tr RouteZoomOut}"
                        Classes="Tool Small"
                        Click="OnZoomOut"
                        ToolTip.Tip="{l:Tr RouteZoomOut}">
                        <c:Icon
                            Drawing="{StaticResource General.Remove}"
                            Height="12"
                            Width="12" />
                    </Button>
                    <TextBlock
                        Foreground="{DynamicResource BrightColor}"
                        HorizontalAlignment="Center"
                        Text="{Binding ZoomText}"
                        TextAlignment="Center"
                        VerticalAlignment="Center"
                        Width="44" />
                    <Button
                        AutomationProperties.Name="{l:Tr RouteZoomIn}"
                        Classes="Tool Small"
                        Click="OnZoomIn"
                        ToolTip.Tip="{l:Tr RouteZoomIn}">
                        <c:Icon
                            Drawing="{StaticResource General.Add}"
                            Height="12"
                            Width="12" />
                    </Button>
                    <Button
                        AutomationProperties.Name="{l:Tr RouteFit}"
                        Classes="Tool Small"
                        Click="OnFit"
                        ToolTip.Tip="{l:Tr RouteFit}">
                        <Viewbox Height="14" Width="14">
                            <Canvas Height="16" Width="16">
                                <Path
                                    Data="M3 6V3h3M13 6V3h-3M3 10v3h3M13 10v3h-3"
                                    Stroke="{Binding $parent[Button].Foreground}"
                                    StrokeJoin="Round"
                                    StrokeLineCap="Round"
                                    StrokeThickness="1.6" />
                            </Canvas>
                        </Viewbox>
                    </Button>
                </StackPanel>
            </Border>

        </Grid>

        <Border
            Classes="Glass"
            DataContext="{Binding Zone}"
            HorizontalAlignment="Left"
            IsVisible="{Binding $parent[UserControl].((vm:WorldViewportViewModel)DataContext).ShowsSubAreas}"
            Margin="12,64,12,12"
            MaxHeight="320"
            MinWidth="240"
            VerticalAlignment="Top"
            x:DataType="z:ZoneEditorViewModel">
            <StackPanel Margin="4">
                <TextBlock
                    Classes="Dim"
                    FontSize="11"
                    Margin="8,4,8,4"
                    Text="{l:Tr ZoneSubAreasTitle}" />
                <ScrollViewer MaxHeight="260">
                    <ItemsControl ItemsSource="{Binding SubAreas}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="z:ZoneSubAreaViewModel">
                                <Grid ColumnDefinitions="*,Auto,Auto" Margin="8,1,2,1" MinHeight="28">
                                    <TextBlock
                                        Foreground="{DynamicResource BrightColor}"
                                        Text="{Binding Name}"
                                        TextTrimming="CharacterEllipsis"
                                        VerticalAlignment="Center" />
                                    <TextBlock
                                        Classes="Dim"
                                        FontSize="11"
                                        Grid.Column="1"
                                        Margin="12,0,6,0"
                                        Text="{Binding Detail}"
                                        VerticalAlignment="Center" />
                                    <Button
                                        AutomationProperties.Name="{l:Tr ZoneSubAreaRemove}"
                                        Classes="Tool Small"
                                        Command="{Binding RemoveCommand}"
                                        Grid.Column="2"
                                        ToolTip.Tip="{l:Tr ZoneSubAreaRemove}">
                                        <c:Icon
                                            Drawing="{StaticResource General.Close}"
                                            Height="10"
                                            Width="10" />
                                    </Button>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </StackPanel>
        </Border>

        <Border
            Classes="Hud"
            HorizontalAlignment="Left"
            Margin="12"
            VerticalAlignment="Bottom">
            <TextBlock
                Classes="Muted"
                Text="{Binding Hud}"
                TextTrimming="CharacterEllipsis" />
        </Border>

        <Border
            Classes="Hud"
            HorizontalAlignment="Center"
            IsVisible="{Binding IsFramed}"
            Margin="12"
            VerticalAlignment="Bottom">
            <StackPanel Orientation="Horizontal" Spacing="7">
                <Ellipse
                    Fill="#4ADE80"
                    Height="8"
                    VerticalAlignment="Center"
                    Width="8" />
                <TextBlock
                    Foreground="{DynamicResource BrightColor}"
                    Text="{Binding FrameText}"
                    VerticalAlignment="Center" />
            </StackPanel>
        </Border>

        <Border
            Classes="Hud"
            HorizontalAlignment="Right"
            IsVisible="{Binding HasRoute}"
            Margin="12"
            VerticalAlignment="Bottom">
            <StackPanel Orientation="Horizontal" Spacing="14">
                <StackPanel Orientation="Horizontal" Spacing="7">
                    <Ellipse
                        Fill="#5FD3C0"
                        Height="12"
                        VerticalAlignment="Center"
                        Width="12" />
                    <TextBlock Classes="Muted" Text="{l:Tr RouteLegendStep}" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="7">
                    <Border
                        Background="#5FD3C0"
                        CornerRadius="2"
                        Height="3"
                        VerticalAlignment="Center"
                        Width="20" />
                    <TextBlock Classes="Muted" Text="{l:Tr RouteLegendPath}" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="7">
                    <Line
                        EndPoint="20,0"
                        Stroke="#EA5D52"
                        StrokeDashArray="2,1.6"
                        StrokeThickness="3"
                        VerticalAlignment="Center" />
                    <TextBlock Classes="Muted" Text="{l:Tr RouteLegendNone}" />
                </StackPanel>
            </StackPanel>
        </Border>

        <Border
            Classes="Hud"
            DataContext="{Binding Zone}"
            HorizontalAlignment="Right"
            IsVisible="{Binding $parent[UserControl].((vm:WorldViewportViewModel)DataContext).HasZone}"
            Margin="12"
            VerticalAlignment="Bottom"
            x:DataType="z:ZoneEditorViewModel">
            <StackPanel Orientation="Horizontal" Spacing="14">
                <TextBlock
                    Classes="Muted"
                    IsVisible="{Binding IsEmpty}"
                    Text="{l:Tr ZoneEmptyHint}" />
                <TextBlock
                    Classes="Muted"
                    IsVisible="{Binding !IsEmpty}"
                    Text="{Binding Summary}" />
                <StackPanel Orientation="Horizontal" Spacing="7">
                    <Border
                        Background="#A3D47B"
                        CornerRadius="2"
                        Height="12"
                        VerticalAlignment="Center"
                        Width="12" />
                    <TextBlock Classes="Muted" Text="{l:Tr ZoneLegendHeld}" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="7">
                    <Border
                        BorderBrush="#EA5D52"
                        BorderThickness="1.5"
                        CornerRadius="2"
                        Height="12"
                        VerticalAlignment="Center"
                        Width="12" />
                    <TextBlock Classes="Muted" Text="{l:Tr ZoneLegendLeftOut}" />
                </StackPanel>
            </StackPanel>
        </Border>

        <Border
            Classes="MenuPopup"
            DataContext="{Binding Choice}"
            HorizontalAlignment="Left"
            IsVisible="{Binding $parent[UserControl].((vm:WorldViewportViewModel)DataContext).HasChoice}"
            MinWidth="260"
            Name="ChoicePopup"
            VerticalAlignment="Top"
            x:DataType="r:SharedChoiceViewModel">
            <StackPanel Margin="5">
                <Grid ColumnDefinitions="*,Auto">
                    <TextBlock
                        Classes="Dim"
                        FontSize="11"
                        Margin="10,6,10,3"
                        Text="{Binding Title}" />
                    <Button
                        AutomationProperties.Name="{l:Tr Close}"
                        Classes="Tool Small"
                        Command="{Binding CloseCommand}"
                        Grid.Column="1">
                        <c:Icon
                            Drawing="{StaticResource General.Close}"
                            Height="10"
                            Width="10" />
                    </Button>
                </Grid>
                <ScrollViewer MaxHeight="320">
                    <ItemsControl ItemsSource="{Binding Items}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="r:MapChoiceViewModel">
                                <Button
                                    Classes="Row"
                                    Command="{Binding #ChoicePopup.((r:SharedChoiceViewModel)DataContext).ChooseCommand}"
                                    CommandParameter="{Binding}">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock
                                                Foreground="{DynamicResource BrightColor}"
                                                Text="{Binding Zone}"
                                                TextTrimming="CharacterEllipsis" />
                                            <TextBlock
                                                Classes="Dim"
                                                FontSize="11"
                                                Text="{Binding Kind}" />
                                        </StackPanel>
                                        <TextBlock
                                            Classes="Dim"
                                            FontSize="11"
                                            Grid.Column="1"
                                            Margin="14,0,0,0"
                                            Text="{Binding MapId}"
                                            VerticalAlignment="Center" />
                                    </Grid>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
