<UserControl
    x:Class="D3B.App.Views.SettingsView"
    x:ClassModifier="internal"
    x:DataType="vm:SettingsViewModel"
    xmlns="https://github.com/avaloniaui"
    xmlns:c="clr-namespace:D3B.App.Controls"
    xmlns:l="clr-namespace:D3B.App.Localization"
    xmlns:s="clr-namespace:D3B.App.ViewModels.AppSettings"
    xmlns:vm="clr-namespace:D3B.App.ViewModels"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Styles>
        <Style Selector="Border.Nav">
            <Setter Property="BorderBrush" Value="{DynamicResource BorderColor}" />
            <Setter Property="BorderThickness" Value="0,0,1,0" />
            <Setter Property="Padding" Value="8,12" />
        </Style>
        <Style Selector="TextBox.Find">
            <Setter Property="Height" Value="30" />
            <Setter Property="MinHeight" Value="30" />
            <Setter Property="CornerRadius" Value="7" />
            <Setter Property="Background" Value="{DynamicResource InputColor}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderColor}" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Margin" Value="2,0,2,10" />
        </Style>
        <Style Selector="Button.Section">
            <Setter Property="Theme" Value="{DynamicResource StudioButton}" />
            <Setter Property="Height" Value="30" />
            <Setter Property="Padding" Value="10,0" />
            <Setter Property="CornerRadius" Value="7" />
            <Setter Property="Foreground" Value="{DynamicResource MutedColor}" />
            <Setter Property="FontWeight" Value="Normal" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
        </Style>
        <Style Selector="Button.Section:pointerover">
            <Setter Property="Background" Value="{DynamicResource HoverColor}" />
            <Setter Property="Foreground" Value="{DynamicResource ForegroundColor}" />
        </Style>
        <Style Selector="Button.Section.On">
            <Setter Property="Background" Value="{DynamicResource RaisedColor}" />
            <Setter Property="Foreground" Value="{DynamicResource BrightColor}" />
        </Style>
        <Style Selector="Ellipse.Changed">
            <Setter Property="Width" Value="6" />
            <Setter Property="Height" Value="6" />
            <Setter Property="Fill" Value="{DynamicResource AccentColor}" />
            <Setter Property="HorizontalAlignment" Value="Right" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="TextBlock.SectionHeading">
            <Setter Property="FontSize" Value="18" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource BrightColor}" />
            <Setter Property="LetterSpacing" Value="-0.18" />
            <Setter Property="Margin" Value="0,0,0,4" />
        </Style>
        <Style Selector="TextBlock.SectionLead">
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="Foreground" Value="{DynamicResource DimColor}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style Selector="StackPanel.Group">
            <Setter Property="Margin" Value="0,22,0,0" />
        </Style>
        <Style Selector="Grid.GroupTitle">
            <Setter Property="Margin" Value="0,0,0,6" />
            <Setter Property="MinHeight" Value="20" />
        </Style>
        <Style Selector="TextBlock.GroupTitle">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource MutedColor}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="Button.Link">
            <Setter Property="Theme" Value="{DynamicResource StudioButton}" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Foreground" Value="{DynamicResource AccentColor}" />
            <Setter Property="FontWeight" Value="Normal" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="HorizontalAlignment" Value="Right" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="Button.Link:pointerover">
            <Setter Property="Foreground" Value="{DynamicResource AccentHoverColor}" />
        </Style>
        <Style Selector="Border.SRow">
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="MinHeight" Value="52" />
            <Setter Property="Background" Value="{DynamicResource ClearColor}" />
        </Style>
        <Style Selector="Border.SRow:pointerover">
            <Setter Property="Background" Value="#05FFFFFF" />
        </Style>
        <Style Selector="Border.Rule">
            <Setter Property="Height" Value="1" />
            <Setter Property="Background" Value="{DynamicResource BorderColor}" />
            <Setter Property="VerticalAlignment" Value="Top" />
        </Style>
        <Style Selector="StackPanel.SRows > Border.SRow:nth-child(1) Border.Rule, ItemsControl.SRows > ContentPresenter:nth-child(1) Border.Rule">
            <Setter Property="IsVisible" Value="False" />
        </Style>
        <Style Selector="Border.Bar">
            <Setter Property="Width" Value="2" />
            <Setter Property="CornerRadius" Value="1" />
            <Setter Property="Margin" Value="0,10" />
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="Background" Value="{DynamicResource AccentColor}" />
        </Style>
        <Style Selector="Grid.RowBody">
            <Setter Property="Margin" Value="12,8" />
            <Setter Property="ColumnSpacing" Value="24" />
        </Style>
        <Style Selector="TextBlock.RowTitle">
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="Foreground" Value="{DynamicResource ForegroundColor}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="TextBlock.RowLine">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{DynamicResource DimColor}" />
            <Setter Property="Margin" Value="0,2,0,0" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style Selector="Border.Badge">
            <Setter Property="Height" Value="20" />
            <Setter Property="Padding" Value="8,0" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Background" Value="#1FE9AD3C" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="8,0,0,0" />
        </Style>
        <Style Selector="Border.Badge > TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="#F0C674" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="Border.Number">
            <Setter Property="Height" Value="28" />
            <Setter Property="CornerRadius" Value="7" />
            <Setter Property="Background" Value="{DynamicResource FieldColor}" />
            <Setter Property="ClipToBounds" Value="True" />
        </Style>
        <Style Selector="Border.Number NumericUpDown">
            <Setter Property="Width" Value="64" />
            <Setter Property="Height" Value="28" />
            <Setter Property="MinHeight" Value="28" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="8,0,4,0" />
            <Setter Property="ShowButtonSpinner" Value="False" />
            <Setter Property="HorizontalContentAlignment" Value="Right" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Foreground" Value="{DynamicResource BrightColor}" />
        </Style>
        <Style Selector="Border.Number NumericUpDown TextBox">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="MinHeight" Value="28" />
        </Style>
        <Style Selector="Border.Number TextBlock.Unit">
            <Setter Property="Foreground" Value="{DynamicResource DimColor}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Margin" Value="2,0,8,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="Button.Step">
            <Setter Property="Theme" Value="{DynamicResource StudioButton}" />
            <Setter Property="Width" Value="22" />
            <Setter Property="Height" Value="28" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="CornerRadius" Value="0" />
            <Setter Property="BorderThickness" Value="1,0,0,0" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderColor}" />
            <Setter Property="Foreground" Value="{DynamicResource MutedColor}" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="FontWeight" Value="Normal" />
        </Style>
        <Style Selector="Button.Step:pointerover">
            <Setter Property="Background" Value="{DynamicResource HoverColor}" />
            <Setter Property="Foreground" Value="{DynamicResource BrightColor}" />
        </Style>
        <Style Selector="Button.Step:disabled">
            <Setter Property="Opacity" Value="0.4" />
        </Style>
        <Style Selector="Button.Reset">
            <Setter Property="Theme" Value="{DynamicResource StudioButton}" />
            <Setter Property="Width" Value="24" />
            <Setter Property="Height" Value="24" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="Opacity" Value="0" />
            <Setter Property="IsHitTestVisible" Value="False" />
        </Style>
        <Style Selector="Button.Reset.Shown">
            <Setter Property="Opacity" Value="1" />
            <Setter Property="IsHitTestVisible" Value="True" />
        </Style>
        <Style Selector="Button.Reset.Shown:pointerover">
            <Setter Property="Background" Value="#24E9AD3C" />
        </Style>
        <Style Selector="Border.Path">
            <Setter Property="Height" Value="28" />
            <Setter Property="MaxWidth" Value="360" />
            <Setter Property="HorizontalAlignment" Value="Right" />
            <Setter Property="CornerRadius" Value="7" />
            <Setter Property="Padding" Value="10,0,3,0" />
            <Setter Property="Background" Value="{DynamicResource FieldColor}" />
        </Style>
        <Style Selector="Border.Path TextBlock">
            <Setter Property="FontFamily" Value="Cascadia Mono, Consolas, Courier New" />
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="Foreground" Value="{DynamicResource MutedColor}" />
            <Setter Property="TextTrimming" Value="PrefixCharacterEllipsis" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="Button.Tiny">
            <Setter Property="Theme" Value="{DynamicResource StudioButton}" />
            <Setter Property="Width" Value="22" />
            <Setter Property="Height" Value="22" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
        </Style>
        <Style Selector="Button.Tiny.Wide">
            <Setter Property="Width" Value="26" />
            <Setter Property="Height" Value="26" />
            <Setter Property="CornerRadius" Value="7" />
        </Style>
        <Style Selector="Button.Tiny:pointerover">
            <Setter Property="Background" Value="{DynamicResource HoverColor}" />
        </Style>
        <Style Selector="Button.Tiny:disabled">
            <Setter Property="Opacity" Value="0.4" />
        </Style>
        <Style Selector="Button.Ghost">
            <Setter Property="Theme" Value="{DynamicResource StudioButton}" />
            <Setter Property="Height" Value="30" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Background" Value="{DynamicResource FieldColor}" />
            <Setter Property="Foreground" Value="{DynamicResource ForegroundColor}" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
        </Style>
        <Style Selector="Button.Ghost:pointerover">
            <Setter Property="Background" Value="{DynamicResource RaisedColor}" />
        </Style>
        <Style Selector="Button.Accent">
            <Setter Property="Theme" Value="{DynamicResource StudioButton}" />
            <Setter Property="Height" Value="30" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Background" Value="{DynamicResource AccentColor}" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
        </Style>
        <Style Selector="Button.Accent:pointerover">
            <Setter Property="Background" Value="{DynamicResource AccentHoverColor}" />
        </Style>
        <Style Selector="Border.About">
            <Setter Property="Padding" Value="16" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Background" Value="{DynamicResource CardBackgroundColor}" />
        </Style>
        <Style Selector="Border.About Button.Ghost">
            <Setter Property="Background" Value="{DynamicResource RaisedColor}" />
        </Style>
        <Style Selector="Border.About Button.Ghost:pointerover">
            <Setter Property="Background" Value="{DynamicResource HoverColor}" />
        </Style>
        <Style Selector="CheckBox">
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
    </UserControl.Styles>
    <UserControl.DataTemplates>
        <DataTemplate x:DataType="vm:DelayViewModel">
            <Border Classes="SRow" IsVisible="{Binding IsShown}">
                <Panel>
                    <Border Classes="Rule" />
                    <Border Classes="Bar" IsVisible="{Binding IsRaised}" />
                    <Grid Classes="RowBody" ColumnDefinitions="*,Auto">
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Classes="RowTitle" Text="{Binding Label}" />
                            <TextBlock Classes="RowLine" Text="{Binding Detail}" />
                        </StackPanel>
                        <StackPanel
                            Grid.Column="1"
                            Orientation="Horizontal"
                            Spacing="8"
                            VerticalAlignment="Center">
                            <Border Classes="Number" ToolTip.Tip="{Binding MostText}">
                                <StackPanel Orientation="Horizontal">
                                    <NumericUpDown
                                        AutomationProperties.Name="{Binding Label}"
                                        FormatString="0.0"
                                        Increment="{Binding Increment}"
                                        Maximum="{Binding Maximum}"
                                        Minimum="{Binding Minimum}"
                                        NumberFormat="{Binding NumberFormat}"
                                        Value="{Binding Value}" />
                                    <TextBlock Classes="Unit" Text="s" />
                                    <Button
                                        AutomationProperties.Name="−"
                                        Classes="Step"
                                        Command="{Binding DecreaseCommand}"
                                        Content="−" />
                                    <Button
                                        AutomationProperties.Name="+"
                                        Classes="Step"
                                        Command="{Binding IncreaseCommand}"
                                        Content="+" />
                                </StackPanel>
                            </Border>
                            <Button
                                AutomationProperties.Name="{Binding ResetText}"
                                Classes="Reset"
                                Classes.Shown="{Binding IsRaised}"
                                Command="{Binding ResetCommand}"
                                ToolTip.Tip="{Binding ResetText}">
                                <c:Icon
                                    Drawing="{StaticResource General.Reset}"
                                    Height="13"
                                    Tint="#E9AD3C"
                                    Width="13" />
                            </Button>
                        </StackPanel>
                    </Grid>
                </Panel>
            </Border>
        </DataTemplate>
    </UserControl.DataTemplates>
    <Grid ColumnDefinitions="220,*">
        <Border Classes="Nav">
            <StackPanel>
                <TextBox
                    AutomationProperties.Name="{l:Tr SettingsSearch}"
                    Classes="Find"
                    Text="{Binding Filter}"
                    PlaceholderText="{l:Tr SettingsSearch}">
                    <TextBox.InnerLeftContent>
                        <c:Icon
                            Drawing="{StaticResource General.Search}"
                            Height="14"
                            Margin="8,0,0,0"
                            Width="14" />
                    </TextBox.InnerLeftContent>
                </TextBox>
                <Button
                    Classes="Section"
                    Classes.On="{Binding Bots.IsSelected}"
                    Command="{Binding ChooseCommand}"
                    CommandParameter="{x:Static s:SettingsSection.Bots}"
                    IsVisible="{Binding Bots.IsShown}">
                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="9">
                        <c:Icon
                            Drawing="{StaticResource Toolwindows.Run}"
                            Height="14"
                            Width="14" />
                        <TextBlock
                            Grid.Column="1"
                            Text="{Binding Bots.Title}"
                            VerticalAlignment="Center" />
                        <Ellipse
                            Classes="Changed"
                            Grid.Column="2"
                            IsVisible="{Binding Bots.HasChanges}"
                            ToolTip.Tip="{l:Tr SettingsChanged}" />
                    </Grid>
                </Button>
                <Button
                    Classes="Section"
                    Classes.On="{Binding Network.IsSelected}"
                    Command="{Binding ChooseCommand}"
                    CommandParameter="{x:Static s:SettingsSection.Network}"
                    IsVisible="{Binding Network.IsShown}">
                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="9">
                        <c:Icon
                            Drawing="{StaticResource Toolwindows.Web}"
                            Height="14"
                            Width="14" />
                        <TextBlock
                            Grid.Column="1"
                            Text="{Binding Network.Title}"
                            VerticalAlignment="Center" />
                        <Ellipse
                            Classes="Changed"
                            Grid.Column="2"
                            IsVisible="{Binding Network.HasChanges}"
                            ToolTip.Tip="{l:Tr SettingsChanged}" />
                    </Grid>
                </Button>
                <Button
                    Classes="Section"
                    Classes.On="{Binding Appearance.IsSelected}"
                    Command="{Binding ChooseCommand}"
                    CommandParameter="{x:Static s:SettingsSection.Appearance}"
                    IsVisible="{Binding Appearance.IsShown}">
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="9">
                        <c:Icon
                            Drawing="{StaticResource Toolwindows.Palette}"
                            Height="14"
                            Width="14" />
                        <TextBlock
                            Grid.Column="1"
                            Text="{Binding Appearance.Title}"
                            VerticalAlignment="Center" />
                    </Grid>
                </Button>
                <Button
                    Classes="Section"
                    Classes.On="{Binding Files.IsSelected}"
                    Command="{Binding ChooseCommand}"
                    CommandParameter="{x:Static s:SettingsSection.Files}"
                    IsVisible="{Binding Files.IsShown}">
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="9">
                        <c:Icon
                            Drawing="{StaticResource Nodes.Folder}"
                            Height="14"
                            Width="14" />
                        <TextBlock
                            Grid.Column="1"
                            Text="{Binding Files.Title}"
                            VerticalAlignment="Center" />
                    </Grid>
                </Button>
                <Button
                    Classes="Section"
                    Classes.On="{Binding About.IsSelected}"
                    Command="{Binding ChooseCommand}"
                    CommandParameter="{x:Static s:SettingsSection.About}"
                    IsVisible="{Binding About.IsShown}">
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="9">
                        <c:Icon
                            Drawing="{StaticResource Status.InfoOutline}"
                            Height="14"
                            Width="14" />
                        <TextBlock
                            Grid.Column="1"
                            Text="{Binding About.Title}"
                            VerticalAlignment="Center" />
                    </Grid>
                </Button>
                <TextBlock
                    Classes="Dim"
                    IsVisible="{Binding HasNoMatch}"
                    Margin="10,8"
                    Text="{l:Tr SettingsNoMatch}"
                    TextWrapping="Wrap" />
            </StackPanel>
        </Border>
        <ScrollViewer Grid.Column="1" Name="Body">
            <!--  The body fills the tab up to 720 pixels, then stays on the left as the mockup's.  -->
            <Grid Margin="32,22,32,40">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition MaxWidth="720" Width="*" />
                    <ColumnDefinition Width="0" />
                </Grid.ColumnDefinitions>
                <StackPanel IsVisible="{Binding !HasNoMatch}">
                    <TextBlock Classes="SectionHeading" Text="{Binding Selected.Title}" />
                    <TextBlock Classes="SectionLead" Text="{Binding Selected.Lead}" />

                    <!--  Bots  -->
                    <StackPanel IsVisible="{Binding Bots.IsSelected}">
                        <StackPanel Classes="Group" IsVisible="{Binding Display.IsShown}">
                            <Grid Classes="GroupTitle">
                                <TextBlock Classes="GroupTitle" Text="{l:Tr SettingsClient}" />
                            </Grid>
                            <Border Classes="SRow">
                                <Panel>
                                    <Border Classes="Bar" IsVisible="{Binding Display.IsRaised}" />
                                    <Grid Classes="RowBody" ColumnDefinitions="*,Auto">
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Classes="RowTitle" Text="{Binding Display.Label}" />
                                            <TextBlock Classes="RowLine" Text="{Binding Display.Detail}" />
                                        </StackPanel>
                                        <StackPanel
                                            Grid.Column="1"
                                            Orientation="Horizontal"
                                            Spacing="8"
                                            VerticalAlignment="Center">
                                            <Slider
                                                AutomationProperties.Name="{Binding Display.Label}"
                                                IsSnapToTickEnabled="True"
                                                Maximum="{Binding Display.SliderMaximum}"
                                                Minimum="{Binding Display.SliderMinimum}"
                                                TickFrequency="{Binding Display.SliderStep}"
                                                ToolTip.Tip="{Binding Display.MostText}"
                                                Value="{Binding Display.Slider}"
                                                VerticalAlignment="Center"
                                                Width="180" />
                                            <TextBlock
                                                Classes="Bright Figures"
                                                MinWidth="44"
                                                Text="{Binding Display.ValueText}"
                                                TextAlignment="Right"
                                                VerticalAlignment="Center" />
                                            <Button
                                                AutomationProperties.Name="{Binding Display.ResetText}"
                                                Classes="Reset"
                                                Classes.Shown="{Binding Display.IsRaised}"
                                                Command="{Binding Display.ResetCommand}"
                                                ToolTip.Tip="{Binding Display.ResetText}">
                                                <c:Icon
                                                    Drawing="{StaticResource General.Reset}"
                                                    Height="13"
                                                    Tint="#E9AD3C"
                                                    Width="13" />
                                            </Button>
                                        </StackPanel>
                                    </Grid>
                                </Panel>
                            </Border>
                        </StackPanel>
                        <StackPanel Classes="Group" IsVisible="{Binding IsBankingShown}">
                            <Grid Classes="GroupTitle">
                                <TextBlock Classes="GroupTitle" Text="{l:Tr GroupBanking}" />
                            </Grid>
                            <StackPanel Classes="SRows">
                                <Border Classes="SRow" IsVisible="{Binding BankFullAtRow.IsShown}">
                                    <Panel>
                                        <Border Classes="Rule" />
                                        <Border Classes="Bar" IsVisible="{Binding IsBankFullAtChanged}" />
                                        <Grid Classes="RowBody" ColumnDefinitions="*,Auto">
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Classes="RowTitle" Text="{Binding BankFullAtRow.Label}" />
                                                <TextBlock Classes="RowLine" Text="{Binding BankFullAtRow.Detail}" />
                                            </StackPanel>
                                            <StackPanel
                                                Grid.Column="1"
                                                Orientation="Horizontal"
                                                Spacing="8"
                                                VerticalAlignment="Center">
                                                <Border Classes="Number">
                                                    <StackPanel Orientation="Horizontal">
                                                        <NumericUpDown
                                                            AutomationProperties.Name="{Binding BankFullAtRow.Label}"
                                                            FormatString="0"
                                                            Increment="1"
                                                            Maximum="{Binding BankFullAtMaximum}"
                                                            Minimum="{Binding BankFullAtMinimum}"
                                                            Value="{Binding BankFullAt}" />
                                                        <TextBlock Classes="Unit" Text="%" />
                                                    </StackPanel>
                                                </Border>
                                                <Button
                                                    AutomationProperties.Name="{l:Tr ResetDefault}"
                                                    Classes="Reset"
                                                    Classes.Shown="{Binding IsBankFullAtChanged}"
                                                    Command="{Binding ResetBankFullAtCommand}"
                                                    ToolTip.Tip="{l:Tr ResetDefault}">
                                                    <c:Icon
                                                        Drawing="{StaticResource General.Reset}"
                                                        Height="13"
                                                        Tint="#E9AD3C"
                                                        Width="13" />
                                                </Button>
                                            </StackPanel>
                                        </Grid>
                                    </Panel>
                                </Border>
                                <Border Classes="SRow" IsVisible="{Binding BankZaapsRow.IsShown}">
                                    <Panel>
                                        <Border Classes="Rule" />
                                        <Border Classes="Bar" IsVisible="{Binding IsBankZaapsOff}" />
                                        <Grid Classes="RowBody" ColumnDefinitions="*,Auto">
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Classes="RowTitle" Text="{Binding BankZaapsRow.Label}" />
                                                <TextBlock Classes="RowLine" Text="{Binding BankZaapsRow.Detail}" />
                                            </StackPanel>
                                            <StackPanel
                                                Grid.Column="1"
                                                Orientation="Horizontal"
                                                Spacing="8"
                                                VerticalAlignment="Center">
                                                <CheckBox AutomationProperties.Name="{Binding BankZaapsRow.Label}" IsChecked="{Binding BankUseZaaps}" />
                                                <Button
                                                    AutomationProperties.Name="{l:Tr ResetDefault}"
                                                    Classes="Reset"
                                                    Classes.Shown="{Binding IsBankZaapsOff}"
                                                    Command="{Binding ResetBankZaapsCommand}"
                                                    ToolTip.Tip="{l:Tr ResetDefault}">
                                                    <c:Icon
                                                        Drawing="{StaticResource General.Reset}"
                                                        Height="13"
                                                        Tint="#E9AD3C"
                                                        Width="13" />
                                                </Button>
                                            </StackPanel>
                                        </Grid>
                                    </Panel>
                                </Border>
                            </StackPanel>
                        </StackPanel>
                        <StackPanel Classes="Group">
                            <Grid Classes="GroupTitle" ColumnDefinitions="*,Auto">
                                <TextBlock
                                    Classes="GroupTitle"
                                    Text="{l:Tr GroupBotDelays}"
                                    ToolTip.Tip="{l:Tr SettingsDelaysDetail}" />
                                <Button
                                    Classes="Link"
                                    Command="{Binding RestoreDelaysCommand}"
                                    Content="{l:Tr RestoreAllDelays}"
                                    Grid.Column="1"
                                    IsVisible="{Binding HasRaisedDelays}" />
                            </Grid>
                            <ItemsControl Classes="SRows" ItemsSource="{Binding BotWaits}" />
                        </StackPanel>
                        <StackPanel Classes="Group">
                            <Grid Classes="GroupTitle" ColumnDefinitions="Auto,Auto">
                                <TextBlock Classes="GroupTitle" Text="{l:Tr GroupRelayDelays}" />
                                <Border Classes="Badge" Grid.Column="1">
                                    <TextBlock Text="{l:Tr AppliesNextStart}" />
                                </Border>
                            </Grid>
                            <ItemsControl Classes="SRows" ItemsSource="{Binding RelayWaits}" />
                        </StackPanel>
                    </StackPanel>

                    <!--  Network  -->
                    <StackPanel Classes="Group" IsVisible="{Binding Network.IsSelected}">
                        <Grid Classes="GroupTitle">
                            <TextBlock Classes="GroupTitle" Text="{l:Tr GroupCaptures}" />
                        </Grid>
                        <StackPanel Classes="SRows">
                            <Border Classes="SRow" IsVisible="{Binding Captures.IsShown}">
                                <Panel>
                                    <Border Classes="Rule" />
                                    <Border Classes="Bar" IsVisible="{Binding RecordsCaptures}" />
                                    <Grid Classes="RowBody" ColumnDefinitions="*,Auto">
                                        <StackPanel VerticalAlignment="Center">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Classes="RowTitle" Text="{Binding Captures.Label}" />
                                                <Border Classes="Badge">
                                                    <TextBlock Text="{l:Tr AppliesNextStart}" />
                                                </Border>
                                            </StackPanel>
                                            <TextBlock Classes="RowLine" Text="{Binding Captures.Detail}" />
                                            <TextBlock
                                                Classes="RowLine"
                                                IsVisible="{Binding CapturesNow, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                                                Text="{Binding CapturesNow}"
                                                TextTrimming="CharacterEllipsis"
                                                TextWrapping="NoWrap"
                                                ToolTip.Tip="{Binding CapturesNow}" />
                                        </StackPanel>
                                        <StackPanel
                                            Grid.Column="1"
                                            Orientation="Horizontal"
                                            Spacing="8"
                                            VerticalAlignment="Center">
                                            <CheckBox AutomationProperties.Name="{Binding Captures.Label}" IsChecked="{Binding RecordsCaptures}" />
                                            <Button
                                                AutomationProperties.Name="{l:Tr ResetDefault}"
                                                Classes="Reset"
                                                Classes.Shown="{Binding RecordsCaptures}"
                                                Command="{Binding ResetCapturesCommand}"
                                                ToolTip.Tip="{l:Tr ResetDefault}">
                                                <c:Icon
                                                    Drawing="{StaticResource General.Reset}"
                                                    Height="13"
                                                    Tint="#E9AD3C"
                                                    Width="13" />
                                            </Button>
                                        </StackPanel>
                                    </Grid>
                                </Panel>
                            </Border>
                            <Border Classes="SRow" IsVisible="{Binding CapturesFolder.IsShown}">
                                <Panel>
                                    <Border Classes="Rule" />
                                    <Grid Classes="RowBody" ColumnDefinitions="*,1.6*">
                                        <TextBlock Classes="RowTitle" Text="{Binding CapturesFolder.Label}" />
                                        <Grid
                                            ColumnDefinitions="*,Auto"
                                            ColumnSpacing="6"
                                            Grid.Column="1"
                                            HorizontalAlignment="Right"
                                            VerticalAlignment="Center">
                                            <Border Classes="Path">
                                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6">
                                                    <TextBlock Text="{Binding CapturesPath}" ToolTip.Tip="{Binding CapturesPath}" />
                                                    <Button
                                                        AutomationProperties.Name="{l:Tr CopyPath}"
                                                        Classes="Tiny"
                                                        Click="OnCopyPathClick"
                                                        Grid.Column="1"
                                                        Tag="{Binding CapturesPath}"
                                                        ToolTip.Tip="{l:Tr CopyPath}">
                                                        <c:Icon
                                                            Drawing="{StaticResource General.Copy}"
                                                            Height="13"
                                                            Width="13" />
                                                    </Button>
                                                </Grid>
                                            </Border>
                                            <Button
                                                AutomationProperties.Name="{l:Tr OpenFolder}"
                                                Classes="Tiny Wide"
                                                Grid.Column="1"
                                                Command="{Binding OpenPathCommand}"
                                                CommandParameter="{Binding CapturesPath}"
                                                ToolTip.Tip="{l:Tr OpenFolder}">
                                                <c:Icon
                                                    Drawing="{StaticResource Nodes.Folder}"
                                                    Height="14"
                                                    Width="14" />
                                            </Button>
                                        </Grid>
                                    </Grid>
                                </Panel>
                            </Border>
                        </StackPanel>
                    </StackPanel>

                    <!--  Appearance  -->
                    <StackPanel Classes="Group" IsVisible="{Binding Appearance.IsSelected}">
                        <Grid Classes="GroupTitle">
                            <TextBlock Classes="GroupTitle" Text="{l:Tr GroupInterface}" />
                        </Grid>
                        <StackPanel Classes="SRows">
                            <Border Classes="SRow" IsVisible="{Binding Language.IsShown}">
                                <Panel>
                                    <Border Classes="Rule" />
                                    <Grid Classes="RowBody" ColumnDefinitions="*,Auto">
                                        <TextBlock Classes="RowTitle" Text="{Binding Language.Label}" />
                                        <Border Classes="Segmented" Grid.Column="1">
                                            <StackPanel Orientation="Horizontal" Spacing="2">
                                                <Button
                                                    Classes="Segment"
                                                    Classes.Selected="{Binding IsFrench}"
                                                    Command="{Binding UseFrenchCommand}"
                                                    Content="Français" />
                                                <Button
                                                    Classes="Segment"
                                                    Classes.Selected="{Binding IsEnglish}"
                                                    Command="{Binding UseEnglishCommand}"
                                                    Content="English" />
                                            </StackPanel>
                                        </Border>
                                    </Grid>
                                </Panel>
                            </Border>
                            <Border Classes="SRow" IsVisible="{Binding Layout.IsShown}">
                                <Panel>
                                    <Border Classes="Rule" />
                                    <Grid Classes="RowBody" ColumnDefinitions="*,Auto">
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Classes="RowTitle" Text="{Binding Layout.Label}" />
                                            <TextBlock Classes="RowLine" Text="{Binding Layout.Detail}" />
                                        </StackPanel>
                                        <Button
                                            Classes="Ghost"
                                            Command="{Binding ResetLayoutToDefaultCommand}"
                                            Content="{l:Tr ResetDefault}"
                                            Grid.Column="1"
                                            VerticalAlignment="Center" />
                                    </Grid>
                                </Panel>
                            </Border>
                        </StackPanel>
                    </StackPanel>

                    <!--  Files  -->
                    <StackPanel Classes="Group" IsVisible="{Binding Files.IsSelected}">
                        <Grid Classes="GroupTitle">
                            <TextBlock Classes="GroupTitle" Text="{l:Tr GroupLocations}" />
                        </Grid>
                        <StackPanel Classes="SRows">
                            <Border Classes="SRow" IsVisible="{Binding Project.IsShown}">
                                <Panel>
                                    <Border Classes="Rule" />
                                    <Grid Classes="RowBody" ColumnDefinitions="*,1.6*">
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Classes="RowTitle" Text="{Binding Project.Label}" />
                                            <TextBlock Classes="RowLine" Text="{Binding Project.Detail}" />
                                        </StackPanel>
                                        <Grid
                                            ColumnDefinitions="*,Auto"
                                            ColumnSpacing="6"
                                            Grid.Column="1"
                                            HorizontalAlignment="Right"
                                            VerticalAlignment="Center">
                                            <Border Classes="Path">
                                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6">
                                                    <TextBlock Text="{Binding ProjectPath}" ToolTip.Tip="{Binding ProjectPath}" />
                                                    <Button
                                                        AutomationProperties.Name="{l:Tr CopyPath}"
                                                        Classes="Tiny"
                                                        Click="OnCopyPathClick"
                                                        Grid.Column="1"
                                                        Tag="{Binding ProjectPath}"
                                                        ToolTip.Tip="{l:Tr CopyPath}">
                                                        <c:Icon
                                                            Drawing="{StaticResource General.Copy}"
                                                            Height="13"
                                                            Width="13" />
                                                    </Button>
                                                </Grid>
                                            </Border>
                                            <Button
                                                AutomationProperties.Name="{l:Tr OpenFolder}"
                                                Classes="Tiny Wide"
                                                Grid.Column="1"
                                                Command="{Binding OpenPathCommand}"
                                                CommandParameter="{Binding ProjectPath}"
                                                ToolTip.Tip="{l:Tr OpenFolder}">
                                                <c:Icon
                                                    Drawing="{StaticResource Nodes.Folder}"
                                                    Height="14"
                                                    Width="14" />
                                            </Button>
                                        </Grid>
                                    </Grid>
                                </Panel>
                            </Border>
                            <Border Classes="SRow" IsVisible="{Binding Database.IsShown}">
                                <Panel>
                                    <Border Classes="Rule" />
                                    <Grid Classes="RowBody" ColumnDefinitions="*,1.6*">
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Classes="RowTitle" Text="{Binding Database.Label}" />
                                            <TextBlock Classes="RowLine" Text="{Binding Database.Detail}" />
                                        </StackPanel>
                                        <Grid
                                            ColumnDefinitions="*,Auto"
                                            ColumnSpacing="6"
                                            Grid.Column="1"
                                            HorizontalAlignment="Right"
                                            VerticalAlignment="Center">
                                            <Border Classes="Path">
                                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6">
                                                    <TextBlock Text="{Binding DatabasePath}" ToolTip.Tip="{Binding DatabasePath}" />
                                                    <Button
                                                        AutomationProperties.Name="{l:Tr CopyPath}"
                                                        Classes="Tiny"
                                                        Click="OnCopyPathClick"
                                                        Grid.Column="1"
                                                        Tag="{Binding DatabasePath}"
                                                        ToolTip.Tip="{l:Tr CopyPath}">
                                                        <c:Icon
                                                            Drawing="{StaticResource General.Copy}"
                                                            Height="13"
                                                            Width="13" />
                                                    </Button>
                                                </Grid>
                                            </Border>
                                            <Button
                                                AutomationProperties.Name="{l:Tr OpenFolder}"
                                                Classes="Tiny Wide"
                                                Grid.Column="1"
                                                Command="{Binding OpenPathCommand}"
                                                CommandParameter="{Binding DatabasePath}"
                                                ToolTip.Tip="{l:Tr OpenFolder}">
                                                <c:Icon
                                                    Drawing="{StaticResource Nodes.Folder}"
                                                    Height="14"
                                                    Width="14" />
                                            </Button>
                                        </Grid>
                                    </Grid>
                                </Panel>
                            </Border>
                            <Border Classes="SRow" IsVisible="{Binding ClientData.IsShown}">
                                <Panel>
                                    <Border Classes="Rule" />
                                    <Grid Classes="RowBody" ColumnDefinitions="*,1.6*">
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Classes="RowTitle" Text="{Binding ClientData.Label}" />
                                            <TextBlock Classes="RowLine" Text="{Binding ClientData.Detail}" />
                                        </StackPanel>
                                        <Grid
                                            ColumnDefinitions="*,Auto"
                                            ColumnSpacing="6"
                                            Grid.Column="1"
                                            HorizontalAlignment="Right"
                                            VerticalAlignment="Center">
                                            <Border Classes="Path">
                                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6">
                                                    <TextBlock Text="{Binding ClientDataPath}" ToolTip.Tip="{Binding ClientDataPath}" />
                                                    <Button
                                                        AutomationProperties.Name="{l:Tr CopyPath}"
                                                        Classes="Tiny"
                                                        Click="OnCopyPathClick"
                                                        Grid.Column="1"
                                                        IsEnabled="{Binding IsPackKnown}"
                                                        Tag="{Binding ClientDataPath}"
                                                        ToolTip.Tip="{l:Tr CopyPath}">
                                                        <c:Icon
                                                            Drawing="{StaticResource General.Copy}"
                                                            Height="13"
                                                            Width="13" />
                                                    </Button>
                                                </Grid>
                                            </Border>
                                            <Button
                                                AutomationProperties.Name="{l:Tr OpenFolder}"
                                                Classes="Tiny Wide"
                                                Grid.Column="1"
                                                Command="{Binding OpenPathCommand}"
                                                CommandParameter="{Binding ClientDataPath}"
                                                IsEnabled="{Binding IsPackKnown}"
                                                ToolTip.Tip="{l:Tr OpenFolder}">
                                                <c:Icon
                                                    Drawing="{StaticResource Nodes.Folder}"
                                                    Height="14"
                                                    Width="14" />
                                            </Button>
                                        </Grid>
                                    </Grid>
                                </Panel>
                            </Border>
                            <Border Classes="SRow" IsVisible="{Binding Preferences.IsShown}">
                                <Panel>
                                    <Border Classes="Rule" />
                                    <Grid Classes="RowBody" ColumnDefinitions="*,1.6*">
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Classes="RowTitle" Text="{Binding Preferences.Label}" />
                                            <TextBlock Classes="RowLine" Text="{Binding Preferences.Detail}" />
                                        </StackPanel>
                                        <Grid
                                            ColumnDefinitions="*,Auto"
                                            ColumnSpacing="6"
                                            Grid.Column="1"
                                            HorizontalAlignment="Right"
                                            VerticalAlignment="Center">
                                            <Border Classes="Path">
                                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6">
                                                    <TextBlock Text="{Binding SettingsPath}" ToolTip.Tip="{Binding SettingsPath}" />
                                                    <Button
                                                        AutomationProperties.Name="{l:Tr CopyPath}"
                                                        Classes="Tiny"
                                                        Click="OnCopyPathClick"
                                                        Grid.Column="1"
                                                        Tag="{Binding SettingsPath}"
                                                        ToolTip.Tip="{l:Tr CopyPath}">
                                                        <c:Icon
                                                            Drawing="{StaticResource General.Copy}"
                                                            Height="13"
                                                            Width="13" />
                                                    </Button>
                                                </Grid>
                                            </Border>
                                            <Button
                                                AutomationProperties.Name="{l:Tr OpenFolder}"
                                                Classes="Tiny Wide"
                                                Grid.Column="1"
                                                Command="{Binding OpenPathCommand}"
                                                CommandParameter="{Binding SettingsPath}"
                                                ToolTip.Tip="{l:Tr OpenFolder}">
                                                <c:Icon
                                                    Drawing="{StaticResource Nodes.Folder}"
                                                    Height="14"
                                                    Width="14" />
                                            </Button>
                                        </Grid>
                                    </Grid>
                                </Panel>
                            </Border>
                        </StackPanel>
                    </StackPanel>

                    <!--  About  -->
                    <StackPanel IsVisible="{Binding About.IsSelected}" Margin="0,18,0,0">
                        <Border Classes="About" IsVisible="{Binding Version.IsShown}">
                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="16">
                                <Image
                                    Height="56"
                                    Source="/Assets/d3b.png"
                                    VerticalAlignment="Center"
                                    Width="56" />
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock
                                        FontSize="15"
                                        FontWeight="SemiBold"
                                        Foreground="{DynamicResource BrightColor}"
                                        Text="{Binding Updates.Version, StringFormat='D3B {0}'}" />
                                    <TextBlock
                                        Classes="Dim"
                                        Margin="0,2,0,0"
                                        Text="{Binding ClientLine}"
                                        TextWrapping="Wrap" />
                                    <TextBlock
                                        Classes="Dim"
                                        Classes.Ready="{Binding Updates.IsReady}"
                                        IsVisible="{Binding Updates.StatusText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                                        Margin="0,2,0,0"
                                        Text="{Binding Updates.StatusText}"
                                        TextWrapping="Wrap">
                                        <TextBlock.Styles>
                                            <Style Selector="TextBlock.Ready">
                                                <Setter Property="Foreground" Value="#8FE3A2" />
                                            </Style>
                                        </TextBlock.Styles>
                                    </TextBlock>
                                </StackPanel>
                                <Panel Grid.Column="2" VerticalAlignment="Center">
                                    <Button
                                        Classes="Ghost"
                                        Command="{Binding Updates.CheckCommand}"
                                        Content="{l:Tr UpdateCheck}"
                                        IsVisible="{Binding !Updates.IsReady}" />
                                    <Button
                                        Classes="Accent"
                                        Command="{Binding Updates.RestartCommand}"
                                        Content="{l:Tr UpdateRestart}"
                                        IsVisible="{Binding Updates.IsReady}" />
                                </Panel>
                            </Grid>
                        </Border>
                        <StackPanel Classes="Group SRows">
                            <Border Classes="SRow" IsVisible="{Binding Licences.IsShown}">
                                <Panel>
                                    <Grid Classes="RowBody" ColumnDefinitions="*,Auto">
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Classes="RowTitle" Text="{Binding Licences.Label}" />
                                            <TextBlock Classes="RowLine" Text="{Binding Licences.Detail}" />
                                        </StackPanel>
                                        <Button
                                            Classes="Ghost"
                                            Command="{Binding OpenLicencesCommand}"
                                            Content="{l:Tr Open}"
                                            Grid.Column="1"
                                            ToolTip.Tip="{Binding LicencesPath}"
                                            VerticalAlignment="Center" />
                                    </Grid>
                                </Panel>
                            </Border>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </ScrollViewer>
    </Grid>
</UserControl>
