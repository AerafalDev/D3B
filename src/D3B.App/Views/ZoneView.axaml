<UserControl
    x:Class="D3B.App.Views.ZoneView"
    x:ClassModifier="internal"
    x:DataType="vm:ZoneEditorViewModel"
    xmlns="https://github.com/avaloniaui"
    xmlns:c="clr-namespace:D3B.App.Controls"
    xmlns:l="clr-namespace:D3B.App.Localization"
    xmlns:r="clr-namespace:D3B.App.ViewModels.Routes"
    xmlns:vm="clr-namespace:D3B.App.ViewModels.Zones"
    xmlns:w="clr-namespace:D3B.App.Controls.WorldMaps"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Styles>
        <Style Selector="Border.Glass">
            <Setter Property="Background" Value="#DB161619" />
            <Setter Property="BorderBrush" Value="#17FFFFFF" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="11" />
            <Setter Property="Padding" Value="3" />
            <Setter Property="BoxShadow" Value="0 8 24 0 #66000000" />
        </Style>
        <Style Selector="Border.Hud">
            <Setter Property="Background" Value="#C70E0E10" />
            <Setter Property="BorderBrush" Value="#0DFFFFFF" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="9" />
            <Setter Property="Padding" Value="10,5" />
            <Setter Property="IsHitTestVisible" Value="False" />
        </Style>
        <Style Selector="Button.Tool.Selected">
            <Setter Property="Background" Value="{DynamicResource AccentSoftColor}" />
            <Setter Property="Foreground" Value="{DynamicResource BrightColor}" />
        </Style>
        <Style Selector="Button.Row">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Height" Value="30" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Padding" Value="10,0" />
        </Style>
        <Style Selector="Button.Row:pointerover">
            <Setter Property="Background" Value="{DynamicResource HoverColor}" />
        </Style>
    </UserControl.Styles>
    <Grid Background="#0C1A1C">
        <w:WorldMapView
            AutomationProperties.Name="{l:Tr ZoneMapName}"
            Name="Map"
            Scene="{Binding Scene}"
            ShowGrid="{Binding ShowGrid}"
            ShowShared="False"
            Source="{Binding Source}"
            Tool="{Binding Tool}"
            World="{Binding Layer}" />

        <Border
            Classes="Glass"
            HorizontalAlignment="Left"
            Margin="12"
            VerticalAlignment="Top">
            <Button Classes="Tool" IsEnabled="{Binding HasWorlds}">
                <StackPanel Orientation="Horizontal" Spacing="7">
                    <c:Icon
                        Drawing="{StaticResource General.Language}"
                        Height="14"
                        VerticalAlignment="Center"
                        Width="14" />
                    <TextBlock
                        Foreground="{DynamicResource BrightColor}"
                        Text="{Binding LayerName}"
                        VerticalAlignment="Center" />
                    <c:Icon
                        Drawing="{StaticResource General.ChevronDown}"
                        Height="10"
                        Opacity="0.6"
                        VerticalAlignment="Center"
                        Width="10" />
                </StackPanel>
                <Button.Flyout>
                    <Flyout FlyoutPresenterClasses="Bare" Placement="BottomEdgeAlignedLeft">
                        <Border Classes="MenuPopup" MinWidth="260">
                            <StackPanel Margin="4">
                                <TextBlock
                                    Classes="Dim"
                                    FontSize="11"
                                    Margin="10,6,10,3"
                                    Text="{l:Tr RouteWorldLayer}" />
                                <ScrollViewer MaxHeight="340">
                                    <ItemsControl ItemsSource="{Binding Worlds}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="r:WorldChoiceViewModel">
                                                <Button Classes="Row" Click="OnWorldChosen">
                                                    <Grid ColumnDefinitions="*,Auto,18">
                                                        <TextBlock
                                                            Foreground="{DynamicResource BrightColor}"
                                                            Text="{Binding Name}"
                                                            TextTrimming="CharacterEllipsis"
                                                            VerticalAlignment="Center" />
                                                        <TextBlock
                                                            Classes="Dim"
                                                            FontSize="11"
                                                            Grid.Column="1"
                                                            Margin="12,0,0,0"
                                                            Text="{Binding Detail}"
                                                            VerticalAlignment="Center" />
                                                        <c:Icon
                                                            Drawing="{StaticResource Status.Success}"
                                                            Grid.Column="2"
                                                            Height="12"
                                                            HorizontalAlignment="Right"
                                                            IsVisible="{Binding IsChosen}"
                                                            Width="12" />
                                                    </Grid>
                                                </Button>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                                <TextBlock
                                    Classes="Dim"
                                    FontSize="11"
                                    Margin="10,6,10,6"
                                    MaxWidth="250"
                                    Text="{l:Tr RouteWorldFootnote}"
                                    TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>
                    </Flyout>
                </Button.Flyout>
            </Button>
        </Border>

        <Border
            Classes="Glass"
            HorizontalAlignment="Center"
            Margin="0,12,0,0"
            VerticalAlignment="Top">
            <StackPanel Orientation="Horizontal" Spacing="3">
                <Button
                    AutomationProperties.Name="{l:Tr ZoneToolSelect}"
                    Classes="Tool"
                    Classes.Selected="{Binding IsSelecting}"
                    Command="{Binding SetToolCommand}"
                    CommandParameter="{x:Static w:WorldMapTool.Select}"
                    ToolTip.Tip="{l:Tr ZoneToolSelect}">
                    <Viewbox Height="15" Width="15">
                        <Canvas Height="16" Width="16">
                            <Path
                                Data="M4 2.5l8 4.2-3.6 1.1L7 11.6z"
                                Stroke="{Binding $parent[Button].Foreground}"
                                StrokeJoin="Round"
                                StrokeLineCap="Round"
                                StrokeThickness="1.6" />
                        </Canvas>
                    </Viewbox>
                </Button>
                <Button
                    AutomationProperties.Name="{l:Tr ZoneToolPaintTip}"
                    Classes="Tool"
                    Classes.Selected="{Binding IsPainting}"
                    Command="{Binding SetToolCommand}"
                    CommandParameter="{x:Static w:WorldMapTool.Trace}"
                    ToolTip.Tip="{l:Tr ZoneToolPaintTip}">
                    <StackPanel Orientation="Horizontal" Spacing="7">
                        <Viewbox Height="15" Width="15">
                            <Canvas Height="16" Width="16">
                                <Path
                                    Data="M3 13c2.5 0 3-1.5 3-2.5L12.5 4a1.4 1.4 0 0 0-2-2L4 8.5C3 9 3 11 3 13z"
                                    Stroke="{Binding $parent[Button].Foreground}"
                                    StrokeJoin="Round"
                                    StrokeLineCap="Round"
                                    StrokeThickness="1.6" />
                            </Canvas>
                        </Viewbox>
                        <TextBlock Text="{l:Tr ZoneToolPaint}" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <Button
                    AutomationProperties.Name="{l:Tr ZoneToolEraseTip}"
                    Classes="Tool"
                    Classes.Selected="{Binding IsErasing}"
                    Command="{Binding SetToolCommand}"
                    CommandParameter="{x:Static w:WorldMapTool.Erase}"
                    ToolTip.Tip="{l:Tr ZoneToolEraseTip}">
                    <StackPanel Orientation="Horizontal" Spacing="7">
                        <Viewbox Height="15" Width="15">
                            <Canvas Height="16" Width="16">
                                <Path
                                    Data="M6 13.5h7M3.2 10.3l5.7-6.6a1.4 1.4 0 0 1 2 0l1.9 1.9a1.4 1.4 0 0 1 0 2L9.4 11.5H6z"
                                    Stroke="{Binding $parent[Button].Foreground}"
                                    StrokeJoin="Round"
                                    StrokeLineCap="Round"
                                    StrokeThickness="1.6" />
                            </Canvas>
                        </Viewbox>
                        <TextBlock Text="{l:Tr ZoneToolErase}" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <Button
                    AutomationProperties.Name="{l:Tr ZoneToolSubAreaTip}"
                    Classes="Tool"
                    Classes.Selected="{Binding IsChoosingSubAreas}"
                    Command="{Binding SetToolCommand}"
                    CommandParameter="{x:Static w:WorldMapTool.Region}"
                    ToolTip.Tip="{l:Tr ZoneToolSubAreaTip}">
                    <StackPanel Orientation="Horizontal" Spacing="7">
                        <Viewbox Height="15" Width="15">
                            <Canvas Height="16" Width="16">
                                <Path
                                    Data="M2.5 2.5h4v4h-4zM9.5 2.5h4v4h-4zM2.5 9.5h4v4h-4zM9.5 9.5h4v4h-4z"
                                    Stroke="{Binding $parent[Button].Foreground}"
                                    StrokeJoin="Round"
                                    StrokeLineCap="Round"
                                    StrokeThickness="1.6" />
                            </Canvas>
                        </Viewbox>
                        <TextBlock Text="{l:Tr ZoneToolSubArea}" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Border>

        <Border
            Classes="Glass"
            HorizontalAlignment="Right"
            Margin="12"
            VerticalAlignment="Top">
            <StackPanel Orientation="Horizontal" Spacing="3">
                <Button Classes="Tool">
                    <StackPanel Orientation="Horizontal" Spacing="7">
                        <c:Icon
                            Drawing="{StaticResource Toolwindows.Structure}"
                            Height="14"
                            VerticalAlignment="Center"
                            Width="14" />
                        <TextBlock Text="{l:Tr RouteView}" VerticalAlignment="Center" />
                        <c:Icon
                            Drawing="{StaticResource General.ChevronDown}"
                            Height="10"
                            Opacity="0.6"
                            VerticalAlignment="Center"
                            Width="10" />
                    </StackPanel>
                    <Button.Flyout>
                        <Flyout FlyoutPresenterClasses="Bare" Placement="BottomEdgeAlignedRight">
                            <Border Classes="MenuPopup" MinWidth="240">
                                <StackPanel Margin="6" Spacing="8">
                                    <CheckBox Content="{l:Tr RouteViewGrid}" IsChecked="{Binding ShowGrid}" />
                                </StackPanel>
                            </Border>
                        </Flyout>
                    </Button.Flyout>
                </Button>
                <Border
                    Background="#17FFFFFF"
                    Height="18"
                    Margin="3,0"
                    Width="1" />
                <Button
                    AutomationProperties.Name="{l:Tr RouteZoomOut}"
                    Classes="Tool Small"
                    Click="OnZoomOut"
                    ToolTip.Tip="{l:Tr RouteZoomOut}">
                    <c:Icon
                        Drawing="{StaticResource General.Remove}"
                        Height="12"
                        Width="12" />
                </Button>
                <TextBlock
                    Foreground="{DynamicResource BrightColor}"
                    HorizontalAlignment="Center"
                    Text="{Binding ZoomText}"
                    TextAlignment="Center"
                    VerticalAlignment="Center"
                    Width="44" />
                <Button
                    AutomationProperties.Name="{l:Tr RouteZoomIn}"
                    Classes="Tool Small"
                    Click="OnZoomIn"
                    ToolTip.Tip="{l:Tr RouteZoomIn}">
                    <c:Icon
                        Drawing="{StaticResource General.Add}"
                        Height="12"
                        Width="12" />
                </Button>
                <Button
                    AutomationProperties.Name="{l:Tr RouteFit}"
                    Classes="Tool Small"
                    Click="OnFit"
                    ToolTip.Tip="{l:Tr RouteFit}">
                    <Viewbox Height="14" Width="14">
                        <Canvas Height="16" Width="16">
                            <Path
                                Data="M3 6V3h3M13 6V3h-3M3 10v3h3M13 10v3h-3"
                                Stroke="{Binding $parent[Button].Foreground}"
                                StrokeJoin="Round"
                                StrokeLineCap="Round"
                                StrokeThickness="1.6" />
                        </Canvas>
                    </Viewbox>
                </Button>
            </StackPanel>
        </Border>

        <Border
            Classes="Glass"
            HorizontalAlignment="Left"
            IsVisible="{Binding HasSubAreas}"
            Margin="12,64,12,12"
            MaxHeight="320"
            MinWidth="240"
            VerticalAlignment="Top">
            <StackPanel Margin="4">
                <TextBlock
                    Classes="Dim"
                    FontSize="11"
                    Margin="8,4,8,4"
                    Text="{l:Tr ZoneSubAreasTitle}" />
                <ScrollViewer MaxHeight="260">
                    <ItemsControl ItemsSource="{Binding SubAreas}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:ZoneSubAreaViewModel">
                                <Grid ColumnDefinitions="*,Auto,Auto" Margin="8,1,2,1" MinHeight="28">
                                    <TextBlock
                                        Foreground="{DynamicResource BrightColor}"
                                        Text="{Binding Name}"
                                        TextTrimming="CharacterEllipsis"
                                        VerticalAlignment="Center" />
                                    <TextBlock
                                        Classes="Dim"
                                        FontSize="11"
                                        Grid.Column="1"
                                        Margin="12,0,6,0"
                                        Text="{Binding Detail}"
                                        VerticalAlignment="Center" />
                                    <Button
                                        AutomationProperties.Name="{l:Tr ZoneSubAreaRemove}"
                                        Classes="Tool Small"
                                        Command="{Binding RemoveCommand}"
                                        Grid.Column="2"
                                        ToolTip.Tip="{l:Tr ZoneSubAreaRemove}">
                                        <c:Icon
                                            Drawing="{StaticResource General.Close}"
                                            Height="10"
                                            Width="10" />
                                    </Button>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </StackPanel>
        </Border>

        <Border
            Classes="Hud"
            HorizontalAlignment="Left"
            Margin="12"
            VerticalAlignment="Bottom">
            <TextBlock
                Classes="Muted"
                Text="{Binding Hud}"
                TextTrimming="CharacterEllipsis" />
        </Border>

        <Border
            Classes="Hud"
            HorizontalAlignment="Right"
            Margin="12"
            VerticalAlignment="Bottom">
            <StackPanel Orientation="Horizontal" Spacing="14">
                <TextBlock
                    Classes="Muted"
                    IsVisible="{Binding IsEmpty}"
                    Text="{l:Tr ZoneEmptyHint}" />
                <TextBlock
                    Classes="Muted"
                    IsVisible="{Binding !IsEmpty}"
                    Text="{Binding Summary}" />
                <StackPanel Orientation="Horizontal" Spacing="7">
                    <Border
                        Background="#A3D47B"
                        CornerRadius="2"
                        Height="12"
                        VerticalAlignment="Center"
                        Width="12" />
                    <TextBlock Classes="Muted" Text="{l:Tr ZoneLegendHeld}" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="7">
                    <Border
                        BorderBrush="#EA5D52"
                        BorderThickness="1.5"
                        CornerRadius="2"
                        Height="12"
                        VerticalAlignment="Center"
                        Width="12" />
                    <TextBlock Classes="Muted" Text="{l:Tr ZoneLegendLeftOut}" />
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
