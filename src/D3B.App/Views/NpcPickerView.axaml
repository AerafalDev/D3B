<UserControl
    x:Class="D3B.App.Views.NpcPickerView"
    x:ClassModifier="internal"
    x:DataType="s:NpcPickerViewModel"
    xmlns="https://github.com/avaloniaui"
    xmlns:s="clr-namespace:D3B.App.ViewModels.Settings"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.KeyBindings>
        <KeyBinding Command="{Binding CancelCommand}" Gesture="Escape" />
    </UserControl.KeyBindings>
    <StackPanel Margin="24" Spacing="14">
        <TextBlock Classes="Title" Text="{Binding Title}" />
        <TextBlock
            Classes="Muted"
            IsVisible="{Binding IsEmpty}"
            Text="{Binding NoneText}"
            TextWrapping="Wrap" />
        <ItemsControl ItemsSource="{Binding Npcs}">
            <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="s:NpcChoiceViewModel">
                    <Button
                        AutomationProperties.Name="{Binding Name}"
                        Classes="Outline"
                        Command="{Binding ChooseCommand}"
                        Height="NaN"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Left"
                        Margin="0,0,0,6"
                        MinHeight="48"
                        Padding="12,6">
                        <StackPanel Spacing="1">
                            <TextBlock Classes="Bright" Text="{Binding Name}" />
                            <TextBlock
                                Classes="Dim"
                                FontSize="11.5"
                                Text="{Binding Detail}"
                                TextWrapping="Wrap" />
                        </StackPanel>
                    </Button>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
        <StackPanel
            HorizontalAlignment="Right"
            Orientation="Horizontal"
            Spacing="8">
            <Button
                Classes="Outline"
                Command="{Binding ClearCommand}"
                Content="{Binding ClearText}"
                IsVisible="{Binding CanClear}" />
            <Button
                Classes="Outline"
                Command="{Binding CancelCommand}"
                Content="{Binding CancelText}" />
        </StackPanel>
    </StackPanel>
</UserControl>
