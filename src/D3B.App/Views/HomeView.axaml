<UserControl
    x:Class="D3B.App.Views.HomeView"
    x:ClassModifier="internal"
    x:DataType="vm:MainViewModel"
    xmlns="https://github.com/avaloniaui"
    xmlns:c="clr-namespace:D3B.App.Controls"
    xmlns:home="clr-namespace:D3B.App.ViewModels.Home"
    xmlns:l="clr-namespace:D3B.App.Localization"
    xmlns:shadui="clr-namespace:ShadUI;assembly=ShadUI"
    xmlns:vm="clr-namespace:D3B.App.ViewModels"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Styles>
        <Style Selector="TextBlock.KeyName">
            <Setter Property="Foreground" Value="{DynamicResource MutedColor}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="StackPanel.Keys">
            <Setter Property="Orientation" Value="Horizontal" />
            <Setter Property="Spacing" Value="3" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="TextBlock.CardTitle">
            <Setter Property="Foreground" Value="{DynamicResource DimColor}" />
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style Selector="Button.HomeRow">
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Padding" Value="8,6" />
            <Setter Property="Height" Value="44" />
        </Style>
        <Style Selector="Border.KindSquare">
            <Setter Property="CornerRadius" Value="5" />
            <Setter Property="Height" Value="22" />
            <Setter Property="Width" Value="22" />
        </Style>
    </UserControl.Styles>
    <Panel ClipToBounds="True">
        <!--  The mockup's dotted ground, faded towards the edges, and a faint green glow behind the logo.  -->
        <Border IsHitTestVisible="False">
            <Border.Background>
                <VisualBrush
                    DestinationRect="0,0,22,22"
                    SourceRect="0,0,22,22"
                    Stretch="None"
                    TileMode="Tile">
                    <VisualBrush.Visual>
                        <Canvas Height="22" Width="22">
                            <Ellipse
                                Canvas.Left="10"
                                Canvas.Top="10"
                                Fill="#24242A"
                                Height="2.2"
                                Width="2.2" />
                        </Canvas>
                    </VisualBrush.Visual>
                </VisualBrush>
            </Border.Background>
            <Border.OpacityMask>
                <RadialGradientBrush Center="50%,30%" GradientOrigin="50%,30%" RadiusX="65%" RadiusY="65%">
                    <GradientStop Color="Black" Offset="0" />
                    <GradientStop Color="Transparent" Offset="1" />
                </RadialGradientBrush>
            </Border.OpacityMask>
        </Border>
        <Ellipse
            Height="420"
            HorizontalAlignment="Center"
            IsHitTestVisible="False"
            Margin="0,-200,0,0"
            VerticalAlignment="Top"
            Width="420">
            <Ellipse.Fill>
                <RadialGradientBrush>
                    <GradientStop Color="#1746B432" Offset="0" />
                    <GradientStop Color="#0046B432" Offset="0.65" />
                </RadialGradientBrush>
            </Ellipse.Fill>
        </Ellipse>
        <ScrollViewer HorizontalScrollBarVisibility="Disabled">
            <StackPanel
                HorizontalAlignment="Stretch"
                Margin="24,32"
                MaxWidth="760"
                Spacing="24">

                <!--  Who it is, and where the host stands.  -->
                <StackPanel
                    HorizontalAlignment="Center"
                    Orientation="Horizontal"
                    Spacing="16">
                    <Image
                        Height="64"
                        RenderOptions.BitmapInterpolationMode="HighQuality"
                        Source="/Assets/d3b.png"
                        Width="64">
                        <Image.Effect>
                            <DropShadowEffect
                                BlurRadius="30"
                                Color="#4046AA28"
                                OffsetX="0"
                                OffsetY="10" />
                        </Image.Effect>
                    </Image>
                    <StackPanel Spacing="4" VerticalAlignment="Center">
                        <TextBlock
                            Classes="Bright"
                            FontSize="21"
                            FontWeight="SemiBold"
                            LetterSpacing="-0.4"
                            Text="D3B Studio" />
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <TextBlock
                                Classes="Dim Figures"
                                FontSize="12"
                                Text="{Binding VersionText}"
                                VerticalAlignment="Center" />
                            <c:StatusPill
                                Text="{Binding HostTitle}"
                                Tone="{Binding HostTone}"
                                VerticalAlignment="Center" />
                        </StackPanel>
                    </StackPanel>
                </StackPanel>

                <StackPanel
                    HorizontalAlignment="Center"
                    IsVisible="{Binding IsStarting}"
                    Orientation="Horizontal"
                    Spacing="8">
                    <shadui:Loading Height="14" Width="14" />
                    <TextBlock Classes="Muted" Text="{l:Tr HostStartingDetail}" />
                </StackPanel>

                <Border
                    Classes="Banner Info"
                    IsVisible="{Binding IsMissingBuild}"
                    Padding="16">
                    <StackPanel Spacing="12">
                        <TextBlock
                            Classes="Bright"
                            FontWeight="SemiBold"
                            Text="{l:Tr MissingBuildTitle}" />
                        <TextBlock Text="{Binding MissingBuildText}" TextWrapping="Wrap" />
                        <c:StatusPill Text="{Binding Updates.StatusText}" Tone="{Binding Updates.StatusTone}" />
                        <StackPanel
                            HorizontalAlignment="Right"
                            Orientation="Horizontal"
                            Spacing="8">
                            <Button
                                Classes="Outline"
                                Command="{Binding Updates.CheckCommand}"
                                Content="{l:Tr UpdateCheck}" />
                            <Button
                                Classes="Primary"
                                Command="{Binding Updates.RestartCommand}"
                                Content="{l:Tr UpdateNow}"
                                IsVisible="{Binding Updates.IsReady}" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border Classes="Banner Danger" Padding="16">
                    <Border.IsVisible>
                        <MultiBinding Converter="{x:Static BoolConverters.And}">
                            <Binding Path="IsFailed" />
                            <Binding Path="!IsMissingBuild" />
                        </MultiBinding>
                    </Border.IsVisible>
                    <StackPanel Spacing="12">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <c:Icon Drawing="{StaticResource Status.Error}" VerticalAlignment="Center" />
                            <TextBlock
                                Classes="Bright"
                                FontWeight="SemiBold"
                                Text="{l:Tr HostFailedTitle}"
                                VerticalAlignment="Center" />
                        </StackPanel>
                        <Border Classes="Code">
                            <SelectableTextBlock
                                Classes="Mono"
                                Text="{Binding HostFailure}"
                                TextWrapping="Wrap" />
                        </Border>
                        <Button
                            Classes="Outline"
                            Click="OnCopyFailureClick"
                            HorizontalAlignment="Right">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <c:Icon Drawing="{StaticResource General.Copy}" />
                                <TextBlock Text="{l:Tr Copy}" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Border>

                <!--  Where to start.  -->
                <StackPanel IsVisible="{Binding !IsFailed}" Spacing="24">
                    <StackPanel Spacing="8">
                        <TextBlock Classes="CardTitle" Text="{l:Tr HomeQuickActions}" />
                        <WrapPanel>
                            <WrapPanel.Styles>
                                <Style Selector="WrapPanel > Button">
                                    <Setter Property="Margin" Value="0,0,8,8" />
                                </Style>
                            </WrapPanel.Styles>
                            <Button
                                Classes="Outline"
                                Command="{Binding Home.NewProfileCommand}"
                                IsEnabled="{Binding IsRunning}">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <c:Icon Drawing="{StaticResource Nodes.Template}" />
                                    <TextBlock Text="{l:Tr HomeNewProfile}" />
                                </StackPanel>
                            </Button>
                            <Button
                                Classes="Outline"
                                Command="{Binding Home.NewRouteCommand}"
                                IsEnabled="{Binding IsRunning}">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <c:Icon Drawing="{StaticResource General.Vcs}" />
                                    <TextBlock Text="{l:Tr HomeNewRoute}" />
                                </StackPanel>
                            </Button>
                            <Button
                                Classes="Outline"
                                Command="{Binding Home.NewZoneCommand}"
                                IsEnabled="{Binding IsRunning}">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <c:Icon Drawing="{StaticResource Actions.SelectAll}" />
                                    <TextBlock Text="{l:Tr HomeNewZone}" />
                                </StackPanel>
                            </Button>
                            <Button
                                Classes="Outline"
                                Command="{Binding Home.ProjectFolderCommand}"
                                IsEnabled="{Binding IsRunning}">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <c:Icon Drawing="{StaticResource Nodes.Folder}" />
                                    <TextBlock Text="{l:Tr HomeProjectFolder}" />
                                </StackPanel>
                            </Button>
                            <Button Classes="Outline" Command="{Binding Home.SettingsCommand}">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <c:Icon Drawing="{StaticResource General.Settings}" />
                                    <TextBlock Text="{l:Tr HomeSettings}" />
                                </StackPanel>
                            </Button>
                        </WrapPanel>
                    </StackPanel>

                    <Grid ColumnDefinitions="*,16,*">
                        <Border Classes="Card" Padding="12">
                            <StackPanel Spacing="8">
                                <TextBlock
                                    Classes="CardTitle"
                                    Margin="8,4,0,0"
                                    Text="{l:Tr HomeCharacters}" />
                                <TextBlock
                                    Classes="Muted"
                                    IsVisible="{Binding Home.HasNoCharacters}"
                                    Margin="8,0,8,8"
                                    Text="{l:Tr HomeNoCharacters}"
                                    TextWrapping="Wrap" />
                                <ItemsControl ItemsSource="{Binding Home.Characters}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="home:HomeCharacterViewModel">
                                            <Button
                                                Classes="Ghost HomeRow"
                                                Command="{Binding ChooseCommand}"
                                                DoubleTapped="OnCharacterDoubleTapped">
                                                <Grid ColumnDefinitions="Auto,*">
                                                    <Panel Margin="0,0,10,0" VerticalAlignment="Center">
                                                        <c:Portrait
                                                            Color="{Binding PortraitColor}"
                                                            Head="{Binding Head}"
                                                            Height="28"
                                                            Initials="{Binding Initials}"
                                                            IsDimmed="{Binding IsDimmed}"
                                                            Radius="14"
                                                            Width="28" />
                                                        <Ellipse
                                                            Fill="{Binding StateBrush}"
                                                            Height="9"
                                                            HorizontalAlignment="Right"
                                                            IsVisible="{Binding !IsDimmed}"
                                                            Margin="0,0,-2,-2"
                                                            Stroke="{DynamicResource CardBackgroundColor}"
                                                            StrokeThickness="1.5"
                                                            VerticalAlignment="Bottom"
                                                            Width="9" />
                                                    </Panel>
                                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                        <TextBlock
                                                            Classes="Bright"
                                                            FontSize="12.5"
                                                            Text="{Binding Name}"
                                                            TextTrimming="CharacterEllipsis" />
                                                        <TextBlock
                                                            Classes="Dim"
                                                            FontSize="11"
                                                            Text="{Binding Detail}"
                                                            TextTrimming="CharacterEllipsis" />
                                                    </StackPanel>
                                                </Grid>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>

                        <Border
                            Classes="Card"
                            Grid.Column="2"
                            Padding="12">
                            <StackPanel Spacing="8">
                                <TextBlock
                                    Classes="CardTitle"
                                    Margin="8,4,0,0"
                                    Text="{l:Tr HomeRecent}" />
                                <TextBlock
                                    Classes="Muted"
                                    IsVisible="{Binding Home.HasNoRecents}"
                                    Margin="8,0,8,8"
                                    Text="{l:Tr HomeNoRecent}"
                                    TextWrapping="Wrap" />
                                <ItemsControl ItemsSource="{Binding Home.Recents}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="home:HomeRecentViewModel">
                                            <Button
                                                Classes="Ghost HomeRow"
                                                Command="{Binding OpenCommand}">
                                                <Grid ColumnDefinitions="Auto,*,Auto">
                                                    <Border
                                                        Background="{Binding KindTint}"
                                                        Classes="KindSquare"
                                                        Margin="0,0,10,0"
                                                        VerticalAlignment="Center">
                                                        <c:Icon
                                                            Drawing="{Binding Icon, Converter={x:Static c:DrawingOf.Instance}}"
                                                            Height="12"
                                                            Tint="{Binding KindBrush}"
                                                            Width="12" />
                                                    </Border>
                                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                        <TextBlock
                                                            Classes="Bright"
                                                            FontSize="12.5"
                                                            Text="{Binding Name}"
                                                            TextTrimming="CharacterEllipsis" />
                                                        <TextBlock
                                                            Classes="Dim"
                                                            FontSize="11"
                                                            Text="{Binding Kind}" />
                                                    </StackPanel>
                                                    <TextBlock
                                                        Classes="Dim Figures"
                                                        FontSize="11"
                                                        Grid.Column="2"
                                                        Margin="8,0,0,0"
                                                        Text="{Binding When}"
                                                        VerticalAlignment="Center" />
                                                </Grid>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <StackPanel Spacing="8">
                        <TextBlock Classes="CardTitle" Text="{l:Tr HomeShortcuts}" />
                        <WrapPanel>
                            <StackPanel
                                Margin="0,0,24,8"
                                Orientation="Horizontal"
                                Spacing="8">
                                <TextBlock Classes="KeyName" Text="{l:Tr HomeSearch}" />
                                <StackPanel Classes="Keys">
                                    <Border Classes="Key">
                                        <TextBlock Text="Ctrl" />
                                    </Border>
                                    <Border Classes="Key">
                                        <TextBlock Text="K" />
                                    </Border>
                                </StackPanel>
                            </StackPanel>
                            <StackPanel
                                Margin="0,0,24,8"
                                Orientation="Horizontal"
                                Spacing="8">
                                <TextBlock Classes="KeyName" Text="{l:Tr HomeAssets}" />
                                <StackPanel Classes="Keys">
                                    <Border Classes="Key">
                                        <TextBlock Text="Ctrl" />
                                    </Border>
                                    <Border Classes="Key">
                                        <TextBlock Text="{l:Tr KeySpace}" />
                                    </Border>
                                </StackPanel>
                            </StackPanel>
                            <StackPanel
                                Margin="0,0,24,8"
                                Orientation="Horizontal"
                                Spacing="8">
                                <TextBlock Classes="KeyName" Text="{l:Tr HomeJournal}" />
                                <StackPanel Classes="Keys">
                                    <Border Classes="Key">
                                        <TextBlock Text="Ctrl" />
                                    </Border>
                                    <Border Classes="Key">
                                        <TextBlock Text="J" />
                                    </Border>
                                </StackPanel>
                            </StackPanel>
                            <StackPanel
                                Margin="0,0,24,8"
                                Orientation="Horizontal"
                                Spacing="8">
                                <TextBlock Classes="KeyName" Text="{l:Tr HomePlay}" />
                                <StackPanel Classes="Keys">
                                    <Border Classes="Key">
                                        <TextBlock Text="F5" />
                                    </Border>
                                </StackPanel>
                            </StackPanel>
                        </WrapPanel>
                    </StackPanel>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Panel>
</UserControl>
