<UserControl
    x:Class="D3B.App.Views.HomeView"
    x:ClassModifier="internal"
    x:DataType="vm:MainViewModel"
    xmlns="https://github.com/avaloniaui"
    xmlns:c="clr-namespace:D3B.App.Controls"
    xmlns:home="clr-namespace:D3B.App.ViewModels.Home"
    xmlns:l="clr-namespace:D3B.App.Localization"
    xmlns:shadui="clr-namespace:ShadUI;assembly=ShadUI"
    xmlns:vm="clr-namespace:D3B.App.ViewModels"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Styles>
        <Style Selector="TextBlock.KeyName">
            <Setter Property="Foreground" Value="{DynamicResource MutedColor}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="StackPanel.Keys">
            <Setter Property="Orientation" Value="Horizontal" />
            <Setter Property="Spacing" Value="3" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="TextBlock.CardTitle">
            <Setter Property="Foreground" Value="{DynamicResource DimColor}" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style Selector="Button.HomeRow">
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Padding" Value="8,6" />
            <Setter Property="Height" Value="44" />
        </Style>
        <Style Selector="Border.Step">
            <Setter Property="Width" Value="22" />
            <Setter Property="Height" Value="22" />
            <Setter Property="CornerRadius" Value="11" />
            <Setter Property="Background" Value="{DynamicResource AccentSoftColor}" />
        </Style>
        <Style Selector="Border.Step > TextBlock">
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource BrightColor}" />
        </Style>
        <Style Selector="Border.CharacterCard">
            <Setter Property="Padding" Value="0" />
        </Style>
        <Style Selector="Button.CardFace">
            <Setter Property="Theme" Value="{DynamicResource StudioButton}" />
            <Setter Property="Height" Value="70" />
            <Setter Property="MinHeight" Value="70" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Background" Value="{DynamicResource ClearColor}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FontWeight" Value="Normal" />
        </Style>
        <Style Selector="Button.CardFace:pointerover">
            <Setter Property="Background" Value="{DynamicResource HoverColor}" />
        </Style>
        <Style Selector="Border.KindSquare">
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Height" Value="22" />
            <Setter Property="Width" Value="22" />
        </Style>
    </UserControl.Styles>
    <Panel ClipToBounds="True">
        <!--  The mockup's dotted ground, faded towards the edges, and a faint green glow behind the logo.  -->
        <Border IsHitTestVisible="False">
            <Border.Background>
                <VisualBrush
                    DestinationRect="0,0,22,22"
                    SourceRect="0,0,22,22"
                    Stretch="None"
                    TileMode="Tile">
                    <VisualBrush.Visual>
                        <Canvas Height="22" Width="22">
                            <Ellipse
                                Canvas.Left="10"
                                Canvas.Top="10"
                                Fill="{DynamicResource GridDotColor}"
                                Height="2.2"
                                Width="2.2" />
                        </Canvas>
                    </VisualBrush.Visual>
                </VisualBrush>
            </Border.Background>
            <Border.OpacityMask>
                <RadialGradientBrush Center="50%,30%" GradientOrigin="50%,30%" RadiusX="65%" RadiusY="65%">
                    <GradientStop Color="Black" Offset="0" />
                    <GradientStop Color="Transparent" Offset="1" />
                </RadialGradientBrush>
            </Border.OpacityMask>
        </Border>
        <Ellipse
            Height="420"
            HorizontalAlignment="Center"
            IsHitTestVisible="False"
            Margin="0,-200,0,0"
            VerticalAlignment="Top"
            Width="420">
            <Ellipse.Fill>
                <RadialGradientBrush>
                    <GradientStop Color="#1746B432" Offset="0" />
                    <GradientStop Color="#0046B432" Offset="0.65" />
                </RadialGradientBrush>
            </Ellipse.Fill>
        </Ellipse>
        <ScrollViewer HorizontalScrollBarVisibility="Disabled">
            <StackPanel
                HorizontalAlignment="Stretch"
                Margin="24,32"
                MaxWidth="760"
                Spacing="24">

                <!--  Who it is, and where the host stands.  -->
                <StackPanel
                    HorizontalAlignment="Center"
                    Orientation="Horizontal"
                    Spacing="16">
                    <Image
                        Height="64"
                        RenderOptions.BitmapInterpolationMode="HighQuality"
                        Source="/Assets/d3b.png"
                        Width="64">
                        <Image.Effect>
                            <DropShadowEffect
                                BlurRadius="30"
                                Color="#4046AA28"
                                OffsetX="0"
                                OffsetY="10" />
                        </Image.Effect>
                    </Image>
                    <StackPanel Spacing="4" VerticalAlignment="Center">
                        <TextBlock
                            Classes="Bright"
                            FontSize="22"
                            FontWeight="SemiBold"
                            LetterSpacing="-0.4"
                            Text="D3B Studio" />
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <TextBlock
                                Classes="Dim Figures"
                                FontSize="12"
                                Text="{Binding VersionText}"
                                VerticalAlignment="Center" />
                            <c:StatusPill
                                Text="{Binding HostTitle}"
                                Tone="{Binding HostTone}"
                                VerticalAlignment="Center" />
                        </StackPanel>
                    </StackPanel>
                </StackPanel>

                <StackPanel
                    HorizontalAlignment="Center"
                    IsVisible="{Binding IsStarting}"
                    Orientation="Horizontal"
                    Spacing="8">
                    <shadui:Loading Height="14" Width="14" />
                    <TextBlock Classes="Muted" Text="{l:Tr HostStartingDetail}" />
                </StackPanel>

                <Border
                    Classes="Banner Info"
                    IsVisible="{Binding IsMissingBuild}"
                    Padding="16">
                    <StackPanel Spacing="12">
                        <TextBlock
                            Classes="Bright"
                            FontWeight="SemiBold"
                            Text="{l:Tr MissingBuildTitle}" />
                        <TextBlock Text="{Binding MissingBuildText}" TextWrapping="Wrap" />
                        <c:StatusPill Text="{Binding Updates.StatusText}" Tone="{Binding Updates.StatusTone}" />
                        <StackPanel
                            HorizontalAlignment="Right"
                            Orientation="Horizontal"
                            Spacing="8">
                            <Button
                                Classes="Outline"
                                Command="{Binding Updates.CheckCommand}"
                                Content="{l:Tr UpdateCheck}" />
                            <Button
                                Classes="Primary"
                                Command="{Binding Updates.RestartCommand}"
                                Content="{l:Tr UpdateNow}"
                                IsVisible="{Binding Updates.IsReady}" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border Classes="Banner Danger" Padding="16">
                    <Border.IsVisible>
                        <MultiBinding Converter="{x:Static BoolConverters.And}">
                            <Binding Path="IsFailed" />
                            <Binding Path="!IsMissingBuild" />
                        </MultiBinding>
                    </Border.IsVisible>
                    <StackPanel Spacing="12">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <c:Icon Drawing="{StaticResource Status.Error}" VerticalAlignment="Center" />
                            <TextBlock
                                Classes="Bright"
                                FontWeight="SemiBold"
                                Text="{l:Tr HostFailedTitle}"
                                VerticalAlignment="Center" />
                        </StackPanel>
                        <Border Classes="Code">
                            <SelectableTextBlock
                                Classes="Mono"
                                Text="{Binding HostFailure}"
                                TextWrapping="Wrap" />
                        </Border>
                        <Button
                            Classes="Outline"
                            Click="OnCopyFailureClick"
                            HorizontalAlignment="Right">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <c:Icon Drawing="{StaticResource General.Copy}" />
                                <TextBlock Text="{l:Tr Copy}" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Border>

                <Border
                    Classes="Banner Info"
                    IsVisible="{Binding Home.Notice.IsShown}"
                    Padding="16">
                    <StackPanel Spacing="12">
                        <TextBlock
                            Classes="Bright"
                            FontWeight="SemiBold"
                            Text="{l:Tr CapturesNoticeTitle}" />
                        <TextBlock Text="{Binding Home.Notice.Text}" TextWrapping="Wrap" />
                        <StackPanel
                            HorizontalAlignment="Right"
                            Orientation="Horizontal"
                            Spacing="8">
                            <Button
                                Classes="Outline"
                                Command="{Binding Home.Notice.OpenSettingsCommand}"
                                Content="{l:Tr CapturesNoticeSettings}" />
                            <Button
                                Classes="Primary"
                                Command="{Binding Home.Notice.UnderstandCommand}"
                                Content="{l:Tr CapturesNoticeUnderstood}" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!--  The characters first, a card each: a click opens its tab, its button plays or pauses it (D514).  -->
                <StackPanel IsVisible="{Binding !IsFailed}" Spacing="24">
                    <StackPanel Spacing="8">
                        <TextBlock Classes="CardTitle" Text="{l:Tr HomeCharacters}" />
                        <Border
                            Classes="Card"
                            IsVisible="{Binding Home.HasNoCharacters}"
                            Padding="20">
                            <StackPanel Spacing="12">
                                <TextBlock
                                    Classes="Bright"
                                    FontWeight="SemiBold"
                                    Text="{l:Tr HomeStartTitle}" />
                                <StackPanel Spacing="8">
                                    <StackPanel Orientation="Horizontal" Spacing="10">
                                        <Border Classes="Step">
                                            <TextBlock Text="1" />
                                        </Border>
                                        <TextBlock
                                            Text="{l:Tr HomeStartLaunch}"
                                            TextWrapping="Wrap"
                                            VerticalAlignment="Center" />
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Spacing="10">
                                        <Border Classes="Step">
                                            <TextBlock Text="2" />
                                        </Border>
                                        <TextBlock
                                            Text="{l:Tr HomeStartChoose}"
                                            TextWrapping="Wrap"
                                            VerticalAlignment="Center" />
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Spacing="10">
                                        <Border Classes="Step">
                                            <TextBlock Text="3" />
                                        </Border>
                                        <TextBlock
                                            Text="{l:Tr HomeStartPlay}"
                                            TextWrapping="Wrap"
                                            VerticalAlignment="Center" />
                                    </StackPanel>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                        <ItemsControl ItemsSource="{Binding Home.Characters}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel ItemSpacing="12" LineSpacing="12" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="home:HomeCharacterViewModel">
                                    <Border
                                        Classes="Card CharacterCard"
                                        Classes.Dimmed="{Binding IsDimmed}"
                                        Width="236">
                                        <Grid ColumnDefinitions="*,Auto">
                                            <Button
                                                Classes="CardFace"
                                                Command="{Binding OpenCommand}"
                                                ToolTip.Tip="{l:Tr HomeOpenCharacter}">
                                                <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto">
                                                    <Panel
                                                        Grid.RowSpan="3"
                                                        Margin="0,0,10,0"
                                                        VerticalAlignment="Center">
                                                        <c:Portrait
                                                            Color="{Binding PortraitColor}"
                                                            Head="{Binding Head}"
                                                            Height="36"
                                                            Initials="{Binding Initials}"
                                                            IsDimmed="{Binding IsDimmed}"
                                                            Radius="10"
                                                            Width="36" />
                                                        <Ellipse
                                                            Fill="{Binding StateBrush}"
                                                            Height="10"
                                                            HorizontalAlignment="Right"
                                                            IsVisible="{Binding IsOnline}"
                                                            Margin="0,0,-2,-2"
                                                            Stroke="{DynamicResource CardBackgroundColor}"
                                                            StrokeThickness="1.5"
                                                            VerticalAlignment="Bottom"
                                                            Width="10" />
                                                    </Panel>
                                                    <TextBlock
                                                        Classes="Bright"
                                                        FontSize="12.5"
                                                        FontWeight="SemiBold"
                                                        Grid.Column="1"
                                                        Text="{Binding Name}"
                                                        TextTrimming="CharacterEllipsis" />
                                                    <TextBlock
                                                        Classes="Dim"
                                                        FontSize="11"
                                                        Grid.Column="1"
                                                        Grid.Row="1"
                                                        Text="{Binding Detail}"
                                                        TextTrimming="CharacterEllipsis"
                                                        ToolTip.Tip="{Binding Detail}" />
                                                    <StackPanel
                                                        Grid.Column="1"
                                                        Grid.Row="2"
                                                        IsVisible="{Binding IsOnline}"
                                                        Margin="0,2,0,0"
                                                        Orientation="Horizontal"
                                                        Spacing="5">
                                                        <c:Icon
                                                            Drawing="{StaticResource Nodes.Template}"
                                                            Height="11"
                                                            Tint="{DynamicResource ProfileTintColor}"
                                                            VerticalAlignment="Center"
                                                            Width="11" />
                                                        <TextBlock
                                                            Classes="Muted"
                                                            FontSize="11"
                                                            Text="{Binding Profile}"
                                                            TextTrimming="CharacterEllipsis" />
                                                    </StackPanel>
                                                </Grid>
                                            </Button>
                                            <Button
                                                AutomationProperties.Name="{Binding PlayTip}"
                                                Classes="Tool Run"
                                                Command="{Binding PlayOrPauseCommand}"
                                                Grid.Column="1"
                                                IsEnabled="{Binding CanPlayOrPause}"
                                                IsVisible="{Binding IsOnline}"
                                                Margin="4,0,8,0"
                                                ToolTip.ShowOnDisabled="True"
                                                ToolTip.Tip="{Binding PlayTip}"
                                                VerticalAlignment="Center">
                                                <Panel>
                                                    <c:Icon Drawing="{StaticResource Run.Run}" IsVisible="{Binding !IsPlaying}" />
                                                    <c:Icon Drawing="{StaticResource Run.Pause}" IsVisible="{Binding IsPlaying}" />
                                                </Panel>
                                            </Button>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>

                    <!--  What to make: a profile, a route, a zone. The settings and the project's folder are the activity bar's and File's.  -->
                    <StackPanel Spacing="8">
                        <TextBlock Classes="CardTitle" Text="{l:Tr HomeMake}" />
                        <WrapPanel ItemSpacing="8" LineSpacing="8">
                            <Button
                                Classes="Outline"
                                Command="{Binding Home.NewProfileCommand}"
                                IsEnabled="{Binding IsRunning}">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <c:Icon Drawing="{StaticResource Nodes.Template}" />
                                    <TextBlock Text="{l:Tr HomeNewProfile}" />
                                </StackPanel>
                            </Button>
                            <Button
                                Classes="Outline"
                                Command="{Binding Home.NewRouteCommand}"
                                IsEnabled="{Binding IsRunning}">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <c:Icon Drawing="{StaticResource General.Vcs}" />
                                    <TextBlock Text="{l:Tr HomeNewRoute}" />
                                </StackPanel>
                            </Button>
                            <Button
                                Classes="Outline"
                                Command="{Binding Home.NewZoneCommand}"
                                IsEnabled="{Binding IsRunning}">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <c:Icon Drawing="{StaticResource Actions.SelectAll}" />
                                    <TextBlock Text="{l:Tr HomeNewZone}" />
                                </StackPanel>
                            </Button>
                        </WrapPanel>
                    </StackPanel>

                    <Border Classes="Card" Padding="12">
                        <StackPanel Spacing="8">
                            <TextBlock
                                Classes="CardTitle"
                                Margin="8,4,0,0"
                                Text="{l:Tr HomeRecent}" />
                            <TextBlock
                                Classes="Muted"
                                IsVisible="{Binding Home.HasNoRecents}"
                                Margin="8,0,8,8"
                                Text="{l:Tr HomeNoRecent}"
                                TextWrapping="Wrap" />
                            <ItemsControl ItemsSource="{Binding Home.Recents}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="home:HomeRecentViewModel">
                                        <Button
                                            Classes="Ghost HomeRow"
                                            Command="{Binding OpenCommand}">
                                            <Grid ColumnDefinitions="Auto,*,Auto">
                                                <Border
                                                    Background="{Binding KindTint}"
                                                    Classes="KindSquare"
                                                    Margin="0,0,10,0"
                                                    VerticalAlignment="Center">
                                                    <c:Icon
                                                        Drawing="{Binding Icon, Converter={x:Static c:DrawingOf.Instance}}"
                                                        Height="12"
                                                        Tint="{Binding KindBrush}"
                                                        Width="12" />
                                                </Border>
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                    <TextBlock
                                                        Classes="Bright"
                                                        FontSize="12.5"
                                                        Text="{Binding Name}"
                                                        TextTrimming="CharacterEllipsis" />
                                                    <TextBlock
                                                        Classes="Dim"
                                                        FontSize="11"
                                                        Text="{Binding Kind}" />
                                                </StackPanel>
                                                <TextBlock
                                                    Classes="Dim Figures"
                                                    FontSize="11"
                                                    Grid.Column="2"
                                                    Margin="8,0,0,0"
                                                    Text="{Binding When}"
                                                    VerticalAlignment="Center" />
                                            </Grid>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <StackPanel Spacing="8">
                        <TextBlock Classes="CardTitle" Text="{l:Tr HomeShortcuts}" />
                        <WrapPanel ItemSpacing="24" LineSpacing="8">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock Classes="KeyName" Text="{l:Tr HomeSearch}" />
                                <StackPanel Classes="Keys">
                                    <Border Classes="Key">
                                        <TextBlock Text="Ctrl" />
                                    </Border>
                                    <Border Classes="Key">
                                        <TextBlock Text="K" />
                                    </Border>
                                </StackPanel>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock Classes="KeyName" Text="{l:Tr PanelSide}" />
                                <StackPanel Classes="Keys">
                                    <Border Classes="Key">
                                        <TextBlock Text="Ctrl" />
                                    </Border>
                                    <Border Classes="Key">
                                        <TextBlock Text="B" />
                                    </Border>
                                </StackPanel>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock Classes="KeyName" Text="{l:Tr PanelBottom}" />
                                <StackPanel Classes="Keys">
                                    <Border Classes="Key">
                                        <TextBlock Text="Ctrl" />
                                    </Border>
                                    <Border Classes="Key">
                                        <TextBlock Text="J" />
                                    </Border>
                                </StackPanel>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock Classes="KeyName" Text="{l:Tr HomePlay}" />
                                <StackPanel Classes="Keys">
                                    <Border Classes="Key">
                                        <TextBlock Text="F5" />
                                    </Border>
                                </StackPanel>
                            </StackPanel>
                        </WrapPanel>
                    </StackPanel>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Panel>
</UserControl>
