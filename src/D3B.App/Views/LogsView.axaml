<UserControl
    x:Class="D3B.App.Views.LogsView"
    x:ClassModifier="internal"
    x:DataType="vm:LogsViewModel"
    xmlns="https://github.com/avaloniaui"
    xmlns:c="clr-namespace:D3B.App.Controls"
    xmlns:l="clr-namespace:D3B.App.Localization"
    xmlns:vm="clr-namespace:D3B.App.ViewModels.Logs"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Styles>
        <Style Selector="TextBlock.Message">
            <Setter Property="Foreground" Value="{DynamicResource ForegroundColor}" />
        </Style>
        <Style Selector="TextBlock.Message.Warning">
            <Setter Property="Foreground" Value="#F0C674" />
        </Style>
        <Style Selector="TextBlock.Message.Error">
            <Setter Property="Foreground" Value="#F3A19A" />
        </Style>
    </UserControl.Styles>
    <DockPanel>
        <Border Classes="Toolbar" DockPanel.Dock="Top">
            <Grid ColumnDefinitions="Auto,Auto,*,Auto" ColumnSpacing="6">
                    <Button AutomationProperties.Name="{l:Tr LogsSource}" Classes="Dd">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <TextBlock
                                Text="{Binding Source.Name, FallbackValue=''}"
                                TextTrimming="CharacterEllipsis"
                                VerticalAlignment="Center" />
                            <c:Icon
                                Drawing="{StaticResource General.ChevronDown}"
                                Height="10"
                                Opacity="0.6"
                                VerticalAlignment="Center"
                                Width="10" />
                        </StackPanel>
                        <Button.Flyout>
                            <Flyout FlyoutPresenterClasses="Bare" Placement="BottomEdgeAlignedLeft">
                                <Border Classes="MenuPopup" MinWidth="220">
                                    <ItemsControl ItemsSource="{Binding Sources}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="vm:LogSourceViewModel">
                                                <Button
                                                    Classes="MenuRow"
                                                    Classes.On="{Binding IsSelected}"
                                                    Click="OnMenuRowClick"
                                                    Command="{Binding SelectCommand}">
                                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                                        <c:StatusPill
                                                            Classes="Dot"
                                                            IsVisible="{Binding IsBot}"
                                                            Tone="{Binding Tone}" />
                                                        <TextBlock
                                                            Text="{Binding Name}"
                                                            TextTrimming="CharacterEllipsis"
                                                            VerticalAlignment="Center" />
                                                    </StackPanel>
                                                </Button>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </Border>
                            </Flyout>
                        </Button.Flyout>
                    </Button>
                    <Border Classes="Segs" Grid.Column="1">
                        <StackPanel>
                            <Button
                                Classes="Seg"
                                Classes.On="{Binding IsAllLevels}"
                                Command="{Binding ShowAllLevelsCommand}"
                                Content="{l:Tr LevelAll}" />
                            <Button
                                Classes="Seg"
                                Classes.On="{Binding IsInfos}"
                                Command="{Binding ShowInfosCommand}"
                                Content="{l:Tr LevelInfos}" />
                            <Button
                                Classes="Seg"
                                Classes.On="{Binding IsWarnings}"
                                Command="{Binding ShowWarningsCommand}"
                                Content="{l:Tr LevelWarnings}" />
                            <Button
                                Classes="Seg"
                                Classes.On="{Binding IsErrors}"
                                Command="{Binding ShowErrorsCommand}"
                                Content="{l:Tr LevelErrors}" />
                        </StackPanel>
                    </Border>
                    <TextBox
                        AutomationProperties.Name="{l:Tr LogsSearch}"
                        Classes="Find"
                        Grid.Column="2"
                        HorizontalAlignment="Left"
                        PlaceholderText="{l:Tr Filter}"
                        Text="{Binding Search}"
                        ToolTip.Tip="{Binding Summary}">
                        <TextBox.InnerLeftContent>
                            <c:Icon
                                Drawing="{StaticResource General.Search}"
                                Height="14"
                                Margin="8,0,2,0"
                                Width="14" />
                        </TextBox.InnerLeftContent>
                    </TextBox>
                <StackPanel Grid.Column="3">
                    <Button
                        AutomationProperties.Name="{l:Tr Follow}"
                        Classes="Ib"
                        Classes.On="{Binding Follow}"
                        Command="{Binding ToggleFollowCommand}"
                        ToolTip.Tip="{l:Tr FollowHint}">
                        <c:Icon Drawing="{StaticResource General.ScrollDown}" />
                    </Button>
                    <Button
                        AutomationProperties.Name="{l:Tr Copy}"
                        Classes="Ib"
                        Click="OnCopyClick"
                        ToolTip.Tip="{l:Tr CopyLinesHint}">
                        <c:Icon Drawing="{StaticResource General.Copy}" />
                    </Button>
                </StackPanel>
            </Grid>
        </Border>
        <Panel>
            <TextBlock
                Classes="Empty"
                IsVisible="{Binding IsEmpty}"
                Text="{l:Tr LogsEmpty}" />
            <ScrollViewer Name="Scroller">
                <ItemsControl ItemsSource="{Binding Lines}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <VirtualizingStackPanel />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:LogLineViewModel">
                            <Border Classes="Line" ToolTip.Tip="{Binding More}">
                                <Grid ColumnDefinitions="62,18,Auto,*,Auto" ColumnSpacing="8">
                                    <TextBlock Classes="Time" Text="{Binding Time}" />
                                    <Panel Grid.Column="1" VerticalAlignment="Center">
                                        <c:Icon
                                            Drawing="{StaticResource Status.Info}"
                                            Height="14"
                                            IsVisible="{Binding IsInfo}"
                                            Width="14" />
                                        <c:Icon
                                            Drawing="{StaticResource Status.Warning}"
                                            Height="14"
                                            IsVisible="{Binding IsWarning}"
                                            Width="14" />
                                        <c:Icon
                                            Drawing="{StaticResource Status.Error}"
                                            Height="14"
                                            IsVisible="{Binding IsError}"
                                            Width="14" />
                                    </Panel>
                                    <StackPanel
                                        Grid.Column="2"
                                        IsVisible="{Binding HasWho}"
                                        Orientation="Horizontal"
                                        Spacing="6"
                                        Width="120">
                                        <c:Portrait
                                            Color="{Binding Who.Color}"
                                            Head="{Binding Who.Head}"
                                            Height="16"
                                            Initials="{Binding Who.Initials}"
                                            Radius="4"
                                            VerticalAlignment="Center"
                                            Width="16" />
                                        <TextBlock
                                            Classes="Muted"
                                            MaxWidth="98"
                                            Text="{Binding Who.Name}"
                                            TextTrimming="CharacterEllipsis"
                                            VerticalAlignment="Center" />
                                    </StackPanel>
                                    <SelectableTextBlock
                                        Classes="Message"
                                        Classes.Error="{Binding IsError}"
                                        Classes.Warning="{Binding IsWarning}"
                                        Grid.Column="3"
                                        Margin="{Binding Indent, Converter={x:Static c:LeftMargin.Instance}}"
                                        Text="{Binding Text}"
                                        TextTrimming="CharacterEllipsis"
                                        VerticalAlignment="Center" />
                                    <TextBlock
                                        Classes="Dim"
                                        FontSize="11.5"
                                        Grid.Column="4"
                                        Text="{Binding Detail}"
                                        VerticalAlignment="Center" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Panel>
    </DockPanel>
</UserControl>
