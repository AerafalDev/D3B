<UserControl
    x:Class="D3B.App.Views.LogsView"
    x:ClassModifier="internal"
    x:DataType="vm:LogsViewModel"
    xmlns="https://github.com/avaloniaui"
    xmlns:c="clr-namespace:D3B.App.Controls"
    xmlns:l="clr-namespace:D3B.App.Localization"
    xmlns:shadui="clr-namespace:ShadUI;assembly=ShadUI"
    xmlns:vm="clr-namespace:D3B.App.ViewModels.Logs"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Styles>
        <Style Selector="Border.LogLine">
            <Setter Property="BorderBrush" Value="{DynamicResource BorderColor}" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
            <Setter Property="Padding" Value="4,8" />
        </Style>
    </UserControl.Styles>
    <c:AppPage Scrolls="False" Title="{l:Tr Logs}">
        <c:AppPage.Actions>
            <ComboBox
                AutomationProperties.Name="{l:Tr LogsSource}"
                ItemsSource="{Binding Sources}"
                SelectedItem="{Binding Chosen}"
                Width="220">
                <ComboBox.ItemTemplate>
                    <DataTemplate x:DataType="vm:LogSourceViewModel">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <c:StatusPill
                                Classes="Dot"
                                IsVisible="{Binding IsBot}"
                                Tone="{Binding Tone}" />
                            <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>
        </c:AppPage.Actions>
        <Grid RowDefinitions="Auto,*">
            <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto" Margin="0,0,0,16">
                <Border Classes="Segmented">
                    <StackPanel Orientation="Horizontal" Spacing="2">
                        <Button
                            Classes="Segment"
                            Classes.Selected="{Binding IsAllLevels}"
                            Command="{Binding ShowAllLevelsCommand}"
                            Content="{l:Tr LevelAll}" />
                        <Button
                            Classes="Segment"
                            Classes.Selected="{Binding IsProblems}"
                            Command="{Binding ShowProblemsCommand}"
                            Content="{l:Tr LevelProblems}" />
                        <Button
                            Classes="Segment"
                            Classes.Selected="{Binding IsErrors}"
                            Command="{Binding ShowErrorsCommand}"
                            Content="{l:Tr LevelErrors}" />
                    </StackPanel>
                </Border>
                <TextBox
                    AutomationProperties.Name="{l:Tr LogsSearch}"
                    Grid.Column="1"
                    Margin="12,0"
                    MaxWidth="400"
                    HorizontalAlignment="Left"
                    MinWidth="240"
                    PlaceholderText="{l:Tr LogsSearch}"
                    Text="{Binding Search}"
                    shadui:TextBoxAssist.Clearable="True" />
                <TextBlock
                    Classes="Caption Muted Figures"
                    Grid.Column="2"
                    Margin="0,0,12,0"
                    Text="{Binding Summary}"
                    VerticalAlignment="Center" />
                <ToggleButton
                    AutomationProperties.Name="{l:Tr Follow}"
                    Classes="Ghost IconButton"
                    Grid.Column="3"
                    IsChecked="{Binding Follow}"
                    ToolTip.Tip="{l:Tr FollowHint}">
                    <c:Icon Data="{StaticResource IconFollow}" />
                </ToggleButton>
                <Button
                    AutomationProperties.Name="{l:Tr Copy}"
                    Classes="Ghost IconButton"
                    Click="OnCopyClick"
                    Grid.Column="4"
                    Margin="4,0,0,0"
                    ToolTip.Tip="{l:Tr CopyLinesHint}">
                    <c:Icon Data="{StaticResource IconCopy}" />
                </Button>
            </Grid>
            <Panel Grid.Row="1">
                <TextBlock
                    Classes="Muted"
                    HorizontalAlignment="Center"
                    IsVisible="{Binding IsEmpty}"
                    Margin="0,32,0,0"
                    Text="{l:Tr LogsEmpty}"
                    TextAlignment="Center"
                    TextWrapping="Wrap" />
                <ScrollViewer Name="Scroller">
                    <ItemsControl ItemsSource="{Binding Lines}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <VirtualizingStackPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:LogLineViewModel">
                                <Border Classes="LogLine" ToolTip.Tip="{Binding More}">
                                    <Grid ColumnDefinitions="72,24,Auto,*,Auto">
                                        <TextBlock
                                            Classes="Mono Muted Figures"
                                            Text="{Binding Time}"
                                            VerticalAlignment="Center" />
                                        <c:Icon
                                            Data="{Binding Mark, Converter={x:Static c:IconOf.Instance}}"
                                            Grid.Column="1"
                                            HorizontalAlignment="Left"
                                            Tone="{Binding Tone}"
                                            VerticalAlignment="Center" />
                                        <c:StatusPill
                                            Classes="Plain"
                                            Grid.Column="2"
                                            IsVisible="{Binding Source, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                                            Margin="0,0,12,0"
                                            MaxWidth="160"
                                            Text="{Binding Source}" />
                                        <SelectableTextBlock
                                            Grid.Column="3"
                                            Margin="{Binding Indent, Converter={x:Static c:LeftMargin.Instance}}"
                                            Text="{Binding Text}"
                                            TextWrapping="Wrap"
                                            VerticalAlignment="Center" />
                                        <TextBlock
                                            Classes="Caption Muted Figures"
                                            Grid.Column="4"
                                            Margin="12,0,0,0"
                                            Text="{Binding Detail}"
                                            VerticalAlignment="Center" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Panel>
        </Grid>
    </c:AppPage>
</UserControl>
