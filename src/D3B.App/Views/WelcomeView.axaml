<UserControl
    x:Class="D3B.App.Views.WelcomeView"
    x:ClassModifier="internal"
    x:DataType="vm:MainViewModel"
    xmlns="https://github.com/avaloniaui"
    xmlns:c="clr-namespace:D3B.App.Controls"
    xmlns:l="clr-namespace:D3B.App.Localization"
    xmlns:shadui="clr-namespace:ShadUI;assembly=ShadUI"
    xmlns:vm="clr-namespace:D3B.App.ViewModels"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Styles>
        <Style Selector="TextBlock.KeyName">
            <Setter Property="Foreground" Value="{DynamicResource MutedColor}" />
            <Setter Property="HorizontalAlignment" Value="Right" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="StackPanel.Keys">
            <Setter Property="Orientation" Value="Horizontal" />
            <Setter Property="Spacing" Value="3" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
    </UserControl.Styles>
    <Panel ClipToBounds="True">
        <!--  The mockup's dotted ground, faded towards the edges, and a faint green glow behind the logo.  -->
        <Border IsHitTestVisible="False">
            <Border.Background>
                <VisualBrush
                    DestinationRect="0,0,22,22"
                    SourceRect="0,0,22,22"
                    Stretch="None"
                    TileMode="Tile">
                    <VisualBrush.Visual>
                        <Canvas Height="22" Width="22">
                            <Ellipse
                                Canvas.Left="10"
                                Canvas.Top="10"
                                Fill="#24242A"
                                Height="2.2"
                                Width="2.2" />
                        </Canvas>
                    </VisualBrush.Visual>
                </VisualBrush>
            </Border.Background>
            <Border.OpacityMask>
                <RadialGradientBrush Center="50%,45%" GradientOrigin="50%,45%" RadiusX="65%" RadiusY="65%">
                    <GradientStop Color="Black" Offset="0" />
                    <GradientStop Color="Transparent" Offset="1" />
                </RadialGradientBrush>
            </Border.OpacityMask>
        </Border>
        <Ellipse
            Height="420"
            HorizontalAlignment="Center"
            IsHitTestVisible="False"
            Margin="0,-80,0,0"
            VerticalAlignment="Center"
            Width="420">
            <Ellipse.Fill>
                <RadialGradientBrush>
                    <GradientStop Color="#1746B432" Offset="0" />
                    <GradientStop Color="#0046B432" Offset="0.65" />
                </RadialGradientBrush>
            </Ellipse.Fill>
        </Ellipse>
        <ScrollViewer HorizontalScrollBarVisibility="Disabled">
            <StackPanel
                HorizontalAlignment="Center"
                Margin="24"
                MaxWidth="560"
                Spacing="4"
                VerticalAlignment="Center">
                <Image
                    Height="92"
                    HorizontalAlignment="Center"
                    Margin="0,0,0,14"
                    RenderOptions.BitmapInterpolationMode="HighQuality"
                    Source="/Assets/d3b.png"
                    Width="92">
                    <Image.Effect>
                        <DropShadowEffect
                            BlurRadius="30"
                            Color="#4046AA28"
                            OffsetX="0"
                            OffsetY="14" />
                    </Image.Effect>
                </Image>
                <TextBlock
                    Classes="Bright"
                    FontSize="21"
                    FontWeight="SemiBold"
                    HorizontalAlignment="Center"
                    LetterSpacing="-0.4"
                    Text="D3B Studio" />
                <TextBlock
                    Classes="Dim Figures"
                    FontSize="12"
                    HorizontalAlignment="Center"
                    Text="{Binding VersionText}" />

                <Grid
                    ColumnDefinitions="Auto,Auto"
                    HorizontalAlignment="Center"
                    IsVisible="{Binding !IsFailed}"
                    Margin="0,28,0,0"
                    RowDefinitions="Auto,Auto,Auto,Auto">
                    <Grid.Styles>
                        <Style Selector="Grid > StackPanel.Keys">
                            <Setter Property="Margin" Value="24,5,0,5" />
                        </Style>
                    </Grid.Styles>
                    <TextBlock Classes="KeyName" Text="{l:Tr WelcomeSearch}" />
                    <StackPanel Classes="Keys" Grid.Column="1">
                        <Border Classes="Key">
                            <TextBlock Text="Ctrl" />
                        </Border>
                        <Border Classes="Key">
                            <TextBlock Text="K" />
                        </Border>
                    </StackPanel>
                    <TextBlock
                        Classes="KeyName"
                        Grid.Row="1"
                        Text="{l:Tr WelcomeAssets}" />
                    <StackPanel
                        Classes="Keys"
                        Grid.Column="1"
                        Grid.Row="1">
                        <Border Classes="Key">
                            <TextBlock Text="Ctrl" />
                        </Border>
                        <Border Classes="Key">
                            <TextBlock Text="{l:Tr KeySpace}" />
                        </Border>
                    </StackPanel>
                    <TextBlock
                        Classes="KeyName"
                        Grid.Row="2"
                        Text="{l:Tr WelcomeJournal}" />
                    <StackPanel
                        Classes="Keys"
                        Grid.Column="1"
                        Grid.Row="2">
                        <Border Classes="Key">
                            <TextBlock Text="Ctrl" />
                        </Border>
                        <Border Classes="Key">
                            <TextBlock Text="J" />
                        </Border>
                    </StackPanel>
                    <TextBlock
                        Classes="KeyName"
                        Grid.Row="3"
                        Text="{l:Tr WelcomePlay}" />
                    <StackPanel
                        Classes="Keys"
                        Grid.Column="1"
                        Grid.Row="3">
                        <Border Classes="Key">
                            <TextBlock Text="F5" />
                        </Border>
                    </StackPanel>
                </Grid>

                <StackPanel
                    HorizontalAlignment="Center"
                    IsVisible="{Binding IsStarting}"
                    Margin="0,24,0,0"
                    Orientation="Horizontal"
                    Spacing="8">
                    <shadui:Loading Height="14" Width="14" />
                    <TextBlock Classes="Muted" Text="{l:Tr HostStartingDetail}" />
                </StackPanel>

                <Border
                    Classes="Banner Info"
                    IsVisible="{Binding IsMissingBuild}"
                    Margin="0,24,0,0"
                    Padding="16">
                    <StackPanel Spacing="12">
                        <TextBlock
                            Classes="Bright"
                            FontWeight="SemiBold"
                            Text="{l:Tr MissingBuildTitle}" />
                        <TextBlock Text="{Binding MissingBuildText}" TextWrapping="Wrap" />
                        <c:StatusPill Text="{Binding Updates.StatusText}" Tone="{Binding Updates.StatusTone}" />
                        <StackPanel
                            HorizontalAlignment="Right"
                            Orientation="Horizontal"
                            Spacing="8">
                            <Button
                                Classes="Outline"
                                Command="{Binding Updates.CheckCommand}"
                                Content="{l:Tr UpdateCheck}" />
                            <Button
                                Classes="Primary"
                                Command="{Binding Updates.RestartCommand}"
                                Content="{l:Tr UpdateNow}"
                                IsVisible="{Binding Updates.IsReady}" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border
                    Classes="Banner Danger"
                    Margin="0,24,0,0"
                    Padding="16">
                    <Border.IsVisible>
                        <MultiBinding Converter="{x:Static BoolConverters.And}">
                            <Binding Path="IsFailed" />
                            <Binding Path="!IsMissingBuild" />
                        </MultiBinding>
                    </Border.IsVisible>
                    <StackPanel Spacing="12">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <c:Icon Drawing="{StaticResource Status.Error}" VerticalAlignment="Center" />
                            <TextBlock
                                Classes="Bright"
                                FontWeight="SemiBold"
                                Text="{l:Tr HostFailedTitle}"
                                VerticalAlignment="Center" />
                        </StackPanel>
                        <Border Classes="Code">
                            <SelectableTextBlock
                                Classes="Mono"
                                Text="{Binding HostFailure}"
                                TextWrapping="Wrap" />
                        </Border>
                        <Button
                            Classes="Outline"
                            Click="OnCopyFailureClick"
                            HorizontalAlignment="Right">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <c:Icon Drawing="{StaticResource General.Copy}" />
                                <TextBlock Text="{l:Tr Copy}" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Panel>
</UserControl>
