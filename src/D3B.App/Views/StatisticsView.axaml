<UserControl
    x:Class="D3B.App.Views.StatisticsView"
    x:ClassModifier="internal"
    x:DataType="vm:StatisticsViewModel"
    xmlns="https://github.com/avaloniaui"
    xmlns:c="clr-namespace:D3B.App.Controls"
    xmlns:l="clr-namespace:D3B.App.Localization"
    xmlns:vm="clr-namespace:D3B.App.ViewModels.Statistics"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Styles>
        <Style Selector="Border.Stat">
            <Setter Property="Background" Value="{DynamicResource CardBackgroundColor}" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="12" />
        </Style>
        <Style Selector="TextBlock.StatTitle">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource BrightColor}" />
            <Setter Property="FontSize" Value="12" />
        </Style>
        <Style Selector="TextBlock.StatAside">
            <Setter Property="Foreground" Value="{DynamicResource DimColor}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="HorizontalAlignment" Value="Right" />
            <Setter Property="FontFeatures" Value="+tnum" />
        </Style>
        <Style Selector="Border.ItemSquare">
            <Setter Property="Width" Value="22" />
            <Setter Property="Height" Value="22" />
            <Setter Property="CornerRadius" Value="5" />
            <Setter Property="Background" Value="{DynamicResource RaisedColor}" />
            <Setter Property="BorderBrush" Value="#14FFFFFF" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
        <Style Selector="TextBlock.Count">
            <Setter Property="Foreground" Value="{DynamicResource BrightColor}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="HorizontalAlignment" Value="Right" />
            <Setter Property="FontFeatures" Value="+tnum" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="TextBlock.Rate">
            <Setter Property="Foreground" Value="{DynamicResource DimColor}" />
            <Setter Property="HorizontalAlignment" Value="Right" />
            <Setter Property="FontFeatures" Value="+tnum" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="Border.RunRow">
            <Setter Property="Padding" Value="4,6" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="Border.RunRow:pointerover">
            <Setter Property="Background" Value="#08FFFFFF" />
        </Style>
        <Style Selector="TextBlock.RunEnd">
            <Setter Property="Foreground" Value="{DynamicResource MutedColor}" />
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="FontFeatures" Value="+tnum" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="TextBlock.RunEnd.Live">
            <Setter Property="Foreground" Value="#8FE3A2" />
        </Style>
        <Style Selector="TextBlock.RunEnd.Failed">
            <Setter Property="Foreground" Value="#F3A19A" />
        </Style>
    </UserControl.Styles>
    <DockPanel>
        <Border Classes="Toolbar" DockPanel.Dock="Top">
            <Grid ColumnDefinitions="*">
                <StackPanel IsEnabled="{Binding IsAvailable}">
                    <Button AutomationProperties.Name="{l:Tr Characters}" Classes="Dd">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <TextBlock
                                Text="{Binding SelectedCharacter.Name, FallbackValue={l:Tr StatisticsEveryCharacter}}"
                                TextTrimming="CharacterEllipsis"
                                VerticalAlignment="Center" />
                            <c:Icon
                                Drawing="{StaticResource General.ChevronDown}"
                                Height="10"
                                Opacity="0.6"
                                VerticalAlignment="Center"
                                Width="10" />
                        </StackPanel>
                        <Button.Flyout>
                            <Flyout FlyoutPresenterClasses="Bare" Placement="BottomEdgeAlignedLeft">
                                <Border Classes="MenuPopup" MinWidth="220">
                                    <ItemsControl ItemsSource="{Binding Characters}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="vm:StatisticsCharacterViewModel">
                                                <Button
                                                    Classes="MenuRow"
                                                    Classes.On="{Binding IsSelected}"
                                                    Click="OnMenuRowClick"
                                                    Command="{Binding SelectCommand}"
                                                    Content="{Binding Name}" />
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </Border>
                            </Flyout>
                        </Button.Flyout>
                    </Button>
                    <Border Classes="Segs">
                        <StackPanel>
                            <Button
                                Classes="Seg"
                                Classes.On="{Binding IsToday}"
                                Command="{Binding ShowTodayCommand}"
                                Content="{l:Tr StatisticsToday}" />
                            <Button
                                Classes="Seg"
                                Classes.On="{Binding IsWeek}"
                                Command="{Binding ShowWeekCommand}"
                                Content="{l:Tr StatisticsWeek}" />
                            <Button
                                Classes="Seg"
                                Classes.On="{Binding IsAll}"
                                Command="{Binding ShowAllCommand}"
                                Content="{l:Tr StatisticsAll}" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>
        <Panel>
            <TextBlock
                Classes="Empty"
                IsVisible="{Binding !IsAvailable}"
                Text="{l:Tr StatisticsUnavailable}" />
            <TextBlock
                Classes="Empty"
                Text="{l:Tr StatisticsEmpty}">
                <TextBlock.IsVisible>
                    <MultiBinding Converter="{x:Static BoolConverters.And}">
                        <Binding Path="IsAvailable" />
                        <Binding Path="IsEmpty" />
                    </MultiBinding>
                </TextBlock.IsVisible>
            </TextBlock>
            <ScrollViewer>
                <ScrollViewer.IsVisible>
                    <MultiBinding Converter="{x:Static BoolConverters.And}">
                        <Binding Path="IsAvailable" />
                        <Binding Path="!IsEmpty" />
                    </MultiBinding>
                </ScrollViewer.IsVisible>
                <Grid
                    ColumnDefinitions="1.2*,1*"
                    ColumnSpacing="10"
                    Margin="10"
                    VerticalAlignment="Top">
                    <Border Classes="Stat" VerticalAlignment="Top">
                        <StackPanel Spacing="10">
                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                                <TextBlock Classes="StatTitle" Text="{l:Tr StatisticsResources}" />
                                <TextBlock
                                    Classes="StatAside"
                                    Grid.Column="1"
                                    Text="{Binding Summary}"
                                    TextTrimming="CharacterEllipsis" />
                            </Grid>
                            <ItemsControl ItemsSource="{Binding Resources}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Spacing="7" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:StatisticsResourceViewModel">
                                        <Grid ColumnDefinitions="22,90,*,54,54" ColumnSpacing="8">
                                            <Border Classes="ItemSquare">
                                                <Image
                                                    IsVisible="{Binding HasIcon}"
                                                    Margin="2"
                                                    RenderOptions.BitmapInterpolationMode="HighQuality"
                                                    Source="{Binding Icon}" />
                                            </Border>
                                            <TextBlock
                                                Grid.Column="1"
                                                Text="{Binding Name}"
                                                TextTrimming="CharacterEllipsis"
                                                VerticalAlignment="Center" />
                                            <c:ShareBar
                                                Fill="#7FA7FF"
                                                Grid.Column="2"
                                                Height="5"
                                                Track="#12FFFFFF"
                                                Value="{Binding Share}"
                                                VerticalAlignment="Center" />
                                            <TextBlock
                                                Classes="Count"
                                                Grid.Column="3"
                                                Text="{Binding Count}" />
                                            <TextBlock
                                                Classes="Rate"
                                                Grid.Column="4"
                                                Text="{Binding Rate}" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <Grid
                                ColumnDefinitions="Auto,*"
                                ColumnSpacing="8"
                                IsVisible="{Binding LevelsDetail, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                                <TextBlock Classes="Bright" Text="{Binding LevelsValue}" />
                                <TextBlock
                                    Classes="Dim"
                                    Grid.Column="1"
                                    Text="{Binding LevelsDetail}"
                                    TextTrimming="CharacterEllipsis" />
                            </Grid>
                        </StackPanel>
                    </Border>
                    <Border
                        Classes="Stat"
                        Grid.Column="1"
                        VerticalAlignment="Top">
                        <StackPanel Spacing="10">
                            <Grid ColumnDefinitions="Auto,*">
                                <TextBlock Classes="StatTitle" Text="{l:Tr StatisticsRuns}" />
                                <TextBlock
                                    Classes="StatAside"
                                    Grid.Column="1"
                                    Text="{Binding Runs.Count}" />
                            </Grid>
                            <ItemsControl ItemsSource="{Binding Runs}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Spacing="2" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:StatisticsRunViewModel">
                                        <Border Classes="RunRow">
                                            <Grid ColumnDefinitions="18,*,Auto" ColumnSpacing="8">
                                                <c:Portrait
                                                    Color="{Binding Color}"
                                                    Head="{Binding Head}"
                                                    Height="18"
                                                    Initials="{Binding Initials}"
                                                    Radius="5"
                                                    VerticalAlignment="Center"
                                                    Width="18" />
                                                <StackPanel Grid.Column="1">
                                                    <TextBlock
                                                        FontWeight="Medium"
                                                        Text="{Binding Title}"
                                                        TextTrimming="CharacterEllipsis" />
                                                    <TextBlock
                                                        Classes="Dim"
                                                        FontSize="11"
                                                        Text="{Binding Detail}"
                                                        TextTrimming="CharacterEllipsis" />
                                                </StackPanel>
                                                <TextBlock
                                                    Classes="RunEnd"
                                                    Classes.Failed="{Binding IsFailed}"
                                                    Classes.Live="{Binding IsLive}"
                                                    Grid.Column="2"
                                                    Text="{Binding End}" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </Grid>
            </ScrollViewer>
        </Panel>
    </DockPanel>
</UserControl>
