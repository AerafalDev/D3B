<UserControl
    x:Class="D3B.App.Views.QuestionView"
    x:ClassModifier="internal"
    x:DataType="vm:QuestionViewModel"
    xmlns="https://github.com/avaloniaui"
    xmlns:vm="clr-namespace:D3B.App.ViewModels"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.KeyBindings>
        <KeyBinding Command="{Binding CancelCommand}" Gesture="Escape" />
    </UserControl.KeyBindings>
    <StackPanel Margin="24" Spacing="16">
        <StackPanel Spacing="8">
            <TextBlock
                Classes="Title"
                Text="{Binding Title}"
                TextWrapping="Wrap" />
            <TextBlock
                Classes="Muted"
                IsVisible="{Binding HasMessage}"
                Text="{Binding Message}"
                TextWrapping="Wrap" />
        </StackPanel>
        <StackPanel
            HorizontalAlignment="Right"
            Orientation="Horizontal"
            Spacing="8">
            <Button
                Classes="Outline"
                Command="{Binding CancelCommand}"
                Content="{Binding CancelText}" />
            <Button
                Classes="Outline"
                Command="{Binding OtherCommand}"
                Content="{Binding OtherText}"
                IsVisible="{Binding HasOther}" />
            <Button
                Classes="Destructive"
                Command="{Binding ConfirmCommand}"
                Content="{Binding ConfirmText}"
                IsDefault="True"
                IsVisible="{Binding IsDestructive}" />
            <Button
                Classes="Primary"
                Command="{Binding ConfirmCommand}"
                Content="{Binding ConfirmText}"
                IsDefault="True"
                IsVisible="{Binding !IsDestructive}" />
        </StackPanel>
    </StackPanel>
</UserControl>
