<UserControl
    x:Class="D3B.App.Views.AccountsView"
    x:ClassModifier="internal"
    x:DataType="vm:AccountsViewModel"
    xmlns="https://github.com/avaloniaui"
    xmlns:c="clr-namespace:D3B.App.Controls"
    xmlns:l="clr-namespace:D3B.App.Localization"
    xmlns:shadui="clr-namespace:ShadUI;assembly=ShadUI"
    xmlns:vm="clr-namespace:D3B.App.ViewModels"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Styles>
        <Style Selector="Border.CharacterRow">
            <Setter Property="BorderBrush" Value="{DynamicResource BorderColor}" />
            <Setter Property="BorderThickness" Value="0,1,0,0" />
            <Setter Property="Padding" Value="20,12" />
        </Style>
        <Style Selector="Border.Confirm">
            <Setter Property="Background" Value="{DynamicResource ErrorColor5}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ErrorColor60}" />
            <Setter Property="BorderThickness" Value="0,1,0,0" />
            <Setter Property="Padding" Value="20,12" />
        </Style>
    </UserControl.Styles>
    <Panel>
        <Border
            Classes="Banner Danger"
            HorizontalAlignment="Center"
            IsVisible="{Binding !IsAvailable}"
            Margin="40"
            MaxWidth="560"
            VerticalAlignment="Center">
            <TextBlock
                Classes="Small"
                Text="{l:Tr StorageUnavailable}"
                TextWrapping="Wrap" />
        </Border>
        <DockPanel IsVisible="{Binding IsAvailable}">
            <StackPanel Classes="PageHeader" DockPanel.Dock="Top">
                <TextBlock Classes="PageTitle" Text="{l:Tr Accounts}" />
                <TextBlock Classes="Small Muted" Text="{Binding Summary}" />
            </StackPanel>
            <Panel>
                <StackPanel
                    HorizontalAlignment="Center"
                    IsVisible="{Binding IsEmpty}"
                    Margin="32"
                    MaxWidth="440"
                    Spacing="18"
                    VerticalAlignment="Center">
                    <Border
                        Background="{DynamicResource CardBackgroundColor}"
                        BorderBrush="{DynamicResource BorderColor}"
                        BorderThickness="1"
                        CornerRadius="16"
                        Height="60"
                        HorizontalAlignment="Center"
                        Width="60">
                        <c:Icon
                            Classes="Muted"
                            Data="{StaticResource IconUsers}"
                            Height="28"
                            Width="28" />
                    </Border>
                    <StackPanel Spacing="8">
                        <TextBlock
                            Classes="h3"
                            HorizontalAlignment="Center"
                            Text="{l:Tr NoAccountTitle}" />
                        <TextBlock
                            Classes="Small Muted"
                            Text="{l:Tr NoAccountDetail}"
                            TextAlignment="Center"
                            TextWrapping="Wrap" />
                        <TextBlock
                            Classes="Caption Muted"
                            Text="{l:Tr AccountsHint}"
                            TextAlignment="Center"
                            TextWrapping="Wrap" />
                    </StackPanel>
                </StackPanel>
                <ScrollViewer IsVisible="{Binding !IsEmpty}">
                    <Grid>
                    <Grid.ColumnDefinitions>
                    <ColumnDefinition MaxWidth="964" Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                    <StackPanel Margin="32,0,32,32" Spacing="16">
                        <TextBlock
                            Classes="Caption Muted"
                            Text="{l:Tr AccountsHint}"
                            TextWrapping="Wrap" />
                        <TextBlock
                            Classes="Caption"
                            Foreground="{DynamicResource ErrorColor}"
                            IsVisible="{Binding HasError}"
                            Text="{Binding Error}"
                            TextWrapping="Wrap" />
                        <ItemsControl ItemsSource="{Binding Items}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Spacing="16" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:AccountViewModel">
                                    <Border Classes="Plate">
                                        <StackPanel>
                                            <Grid ColumnDefinitions="*,Auto,Auto" Margin="20,16,14,16">
                                                <StackPanel Spacing="2" VerticalAlignment="Center">
                                                    <StackPanel Orientation="Horizontal" Spacing="4">
                                                        <TextBlock
                                                            FontSize="16"
                                                            FontWeight="SemiBold"
                                                            Text="{Binding Nickname}"
                                                            TextTrimming="CharacterEllipsis" />
                                                        <TextBlock
                                                            Classes="Muted"
                                                            FontSize="16"
                                                            Text="{Binding Tag}" />
                                                    </StackPanel>
                                                    <TextBlock Classes="Caption Muted" Text="{Binding Seen}" />
                                                </StackPanel>
                                                <c:StatusPill
                                                    Grid.Column="1"
                                                    Margin="12,0"
                                                    Text="{Binding Subscription}"
                                                    Tone="{Binding SubscriptionTone}" />
                                                <Button
                                                    Classes="Ghost"
                                                    Command="{Binding AskForgetCommand}"
                                                    CornerRadius="{DynamicResource MdCornerRadius}"
                                                    Grid.Column="2"
                                                    Height="32"
                                                    Padding="0"
                                                    ToolTip.Tip="{l:Tr Forget}"
                                                    Width="32">
                                                    <c:Icon
                                                        Classes="Muted"
                                                        Data="{StaticResource IconTrash}"
                                                        Height="15"
                                                        Width="15" />
                                                </Button>
                                            </Grid>
                                            <Border Classes="Confirm" IsVisible="{Binding IsConfirmingForget}">
                                                <Grid ColumnDefinitions="*,Auto,Auto">
                                                    <TextBlock
                                                        Classes="Small"
                                                        Text="{l:Tr ForgetDetail}"
                                                        TextWrapping="Wrap"
                                                        VerticalAlignment="Center" />
                                                    <Button
                                                        Classes="Outline"
                                                        Command="{Binding KeepItCommand}"
                                                        Content="{l:Tr Cancel}"
                                                        Grid.Column="1"
                                                        Margin="12,0,8,0" />
                                                    <Button
                                                        Classes="Destructive"
                                                        Command="{Binding ForgetCommand}"
                                                        Content="{l:Tr ForgetConfirm}"
                                                        Grid.Column="2" />
                                                </Grid>
                                            </Border>
                                            <ItemsControl ItemsSource="{Binding Characters}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate x:DataType="vm:CharacterRowViewModel">
                                                        <Border Classes="CharacterRow">
                                                            <Grid ColumnDefinitions="Auto,*,220,Auto">
                                                                <Panel
                                                                    Height="34"
                                                                    VerticalAlignment="Center"
                                                                    Width="34">
                                                                    <shadui:Avatar
                                                                        Fallback="{Binding Initials}"
                                                                        Height="32"
                                                                        HorizontalAlignment="Left"
                                                                        VerticalAlignment="Top"
                                                                        Width="32" />
                                                                    <Border
                                                                        Background="{DynamicResource CardBackgroundColor}"
                                                                        CornerRadius="6"
                                                                        Height="12"
                                                                        HorizontalAlignment="Right"
                                                                        VerticalAlignment="Bottom"
                                                                        Width="12">
                                                                        <c:StatusPill
                                                                            Classes="Dot"
                                                                            HorizontalAlignment="Center"
                                                                            Tone="{Binding Tone}" />
                                                                    </Border>
                                                                </Panel>
                                                                <StackPanel
                                                                    Grid.Column="1"
                                                                    Margin="12,0"
                                                                    Spacing="1"
                                                                    VerticalAlignment="Center">
                                                                    <TextBlock
                                                                        Classes="Small"
                                                                        FontWeight="SemiBold"
                                                                        Text="{Binding Name}"
                                                                        TextTrimming="CharacterEllipsis" />
                                                                    <TextBlock
                                                                        Classes="Caption Muted"
                                                                        Text="{Binding Detail}"
                                                                        TextTrimming="CharacterEllipsis" />
                                                                </StackPanel>
                                                                <ComboBox
                                                                    Grid.Column="2"
                                                                    HorizontalAlignment="Stretch"
                                                                    ItemsSource="{Binding Profiles}"
                                                                    SelectedItem="{Binding SelectedProfile}"
                                                                    VerticalAlignment="Center">
                                                                    <ComboBox.ItemTemplate>
                                                                        <DataTemplate x:DataType="vm:ProfileOptionViewModel">
                                                                            <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                                                                        </DataTemplate>
                                                                    </ComboBox.ItemTemplate>
                                                                </ComboBox>
                                                                <StackPanel
                                                                    Grid.Column="3"
                                                                    Margin="16,0,0,0"
                                                                    Orientation="Horizontal"
                                                                    Spacing="8"
                                                                    ToolTip.Tip="{l:Tr StartsOnConnectionHint}"
                                                                    VerticalAlignment="Center">
                                                                    <ToggleSwitch
                                                                        IsChecked="{Binding StartsOnConnection}"
                                                                        IsEnabled="{Binding HasProfile}"
                                                                        OffContent=""
                                                                        OnContent=""
                                                                        VerticalAlignment="Center" />
                                                                    <TextBlock
                                                                        Classes="Caption"
                                                                        Classes.Muted="{Binding !HasProfile}"
                                                                        Text="{l:Tr StartsOnConnection}"
                                                                        VerticalAlignment="Center" />
                                                                </StackPanel>
                                                            </Grid>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                    </Grid>
                </ScrollViewer>
            </Panel>
        </DockPanel>
    </Panel>
</UserControl>
