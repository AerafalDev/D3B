<UserControl
    x:Class="D3B.App.Views.RepliesPickerView"
    x:ClassModifier="internal"
    x:DataType="s:RepliesPickerViewModel"
    xmlns="https://github.com/avaloniaui"
    xmlns:s="clr-namespace:D3B.App.ViewModels.Settings"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.KeyBindings>
        <KeyBinding Command="{Binding CancelCommand}" Gesture="Escape" />
    </UserControl.KeyBindings>
    <StackPanel Margin="24" Spacing="14">
        <TextBlock Classes="Title" Text="{Binding Title}" />
        <ItemsControl ItemsSource="{Binding Given}">
            <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="x:String">
                    <TextBlock
                        Classes="Muted"
                        Margin="0,0,0,2"
                        Text="{Binding}"
                        TextWrapping="Wrap" />
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
        <TextBlock
            Classes="Bright"
            IsVisible="{Binding HasChoices}"
            MaxWidth="480"
            Text="{Binding Question}"
            TextWrapping="Wrap" />
        <TextBlock
            Classes="Dim"
            Text="{Binding Status}"
            TextWrapping="Wrap" />
        <ItemsControl ItemsSource="{Binding Choices}">
            <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="s:ReplyChoiceViewModel">
                    <Button
                        AutomationProperties.Name="{Binding Name}"
                        Classes="Outline"
                        Command="{Binding ChooseCommand}"
                        Height="NaN"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Left"
                        Margin="0,0,0,6"
                        MinHeight="48"
                        Padding="12,6">
                        <StackPanel Spacing="1">
                            <TextBlock
                                Classes="Bright"
                                MaxWidth="460"
                                Text="{Binding Name}"
                                TextWrapping="Wrap" />
                            <TextBlock
                                Classes="Dim"
                                FontSize="11.5"
                                Text="{Binding Outcome}"
                                TextWrapping="Wrap" />
                        </StackPanel>
                    </Button>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
        <StackPanel
            HorizontalAlignment="Right"
            Orientation="Horizontal"
            Spacing="8">
            <Button
                Classes="Outline"
                Command="{Binding BackCommand}"
                Content="{Binding BackText}"
                IsEnabled="{Binding CanGoBack}" />
            <Button
                Classes="Outline"
                Command="{Binding CancelCommand}"
                Content="{Binding CancelText}" />
            <Button
                Classes="Primary"
                Command="{Binding DoneCommand}"
                Content="{Binding DoneText}" />
        </StackPanel>
    </StackPanel>
</UserControl>
