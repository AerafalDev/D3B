<UserControl
    x:Class="D3B.App.Views.BottomPanelView"
    x:ClassModifier="internal"
    x:DataType="b:BottomPanelViewModel"
    xmlns="https://github.com/avaloniaui"
    xmlns:b="clr-namespace:D3B.App.ViewModels.Bottom"
    xmlns:c="clr-namespace:D3B.App.Controls"
    xmlns:l="clr-namespace:D3B.App.Localization"
    xmlns:studio="clr-namespace:D3B.App.ViewModels.Studio"
    xmlns:views="clr-namespace:D3B.App.Views"
    xmlns:vm="clr-namespace:D3B.App.ViewModels"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!--  The toolbars' pieces every tab shares, as the mockup's .btool, .dd, .segs, .ib and search (D327).  -->
    <UserControl.Styles>
        <Style Selector="Border.Toolbar">
            <Setter Property="Padding" Value="8,6" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderColor}" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
        </Style>
        <Style Selector="Border.Toolbar > Grid > StackPanel">
            <Setter Property="Orientation" Value="Horizontal" />
            <Setter Property="Spacing" Value="6" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="Button.Dd">
            <Setter Property="Theme" Value="{DynamicResource StudioButton}" />
            <Setter Property="Height" Value="26" />
            <Setter Property="MinHeight" Value="26" />
            <Setter Property="Padding" Value="8,0" />
            <Setter Property="CornerRadius" Value="7" />
            <Setter Property="Background" Value="{DynamicResource FieldColor}" />
            <Setter Property="Foreground" Value="{DynamicResource ForegroundColor}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="Normal" />
            <Setter Property="MaxWidth" Value="240" />
        </Style>
        <Style Selector="Button.Dd:pointerover">
            <Setter Property="Background" Value="{DynamicResource RaisedColor}" />
        </Style>
        <Style Selector="Button.Dd:disabled">
            <Setter Property="Opacity" Value="0.5" />
        </Style>
        <Style Selector="Border.Segs">
            <Setter Property="Background" Value="{DynamicResource FieldColor}" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="2" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="Border.Segs > StackPanel">
            <Setter Property="Orientation" Value="Horizontal" />
            <Setter Property="Spacing" Value="2" />
        </Style>
        <Style Selector="Button.Seg">
            <Setter Property="Theme" Value="{DynamicResource StudioButton}" />
            <Setter Property="Height" Value="22" />
            <Setter Property="MinHeight" Value="22" />
            <Setter Property="Padding" Value="9,0" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Foreground" Value="{DynamicResource MutedColor}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="Normal" />
        </Style>
        <Style Selector="Button.Seg:pointerover">
            <Setter Property="Foreground" Value="{DynamicResource ForegroundColor}" />
        </Style>
        <Style Selector="Button.Seg.On">
            <Setter Property="Background" Value="{DynamicResource RaisedColor}" />
            <Setter Property="Foreground" Value="{DynamicResource BrightColor}" />
        </Style>
        <Style Selector="Button.Ib">
            <Setter Property="Theme" Value="{DynamicResource StudioButton}" />
            <Setter Property="Width" Value="26" />
            <Setter Property="Height" Value="26" />
            <Setter Property="MinHeight" Value="26" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="CornerRadius" Value="7" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="Foreground" Value="{DynamicResource MutedColor}" />
        </Style>
        <Style Selector="Button.Ib:pointerover">
            <Setter Property="Background" Value="{DynamicResource HoverColor}" />
            <Setter Property="Foreground" Value="{DynamicResource BrightColor}" />
        </Style>
        <Style Selector="Button.Ib.On">
            <Setter Property="Background" Value="{DynamicResource AccentSoftColor}" />
            <Setter Property="Foreground" Value="{DynamicResource AccentTextColor}" />
        </Style>
        <Style Selector="Button.Ib:disabled">
            <Setter Property="Opacity" Value="0.4" />
        </Style>
        <Style Selector="Button.Ib c|Icon">
            <Setter Property="Width" Value="14" />
            <Setter Property="Height" Value="14" />
        </Style>
        <Style Selector="TextBox.Find">
            <Setter Property="Height" Value="26" />
            <Setter Property="MinHeight" Value="26" />
            <Setter Property="MinWidth" Value="100" />
            <Setter Property="MaxWidth" Value="240" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="Padding" Value="4,0,8,0" />
            <Setter Property="CornerRadius" Value="7" />
            <Setter Property="Background" Value="{DynamicResource FieldColor}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style Selector="Button.MenuRow">
            <Setter Property="Theme" Value="{DynamicResource StudioButton}" />
            <Setter Property="Height" Value="30" />
            <Setter Property="MinHeight" Value="30" />
            <Setter Property="Padding" Value="8,0" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="FontWeight" Value="Normal" />
        </Style>
        <Style Selector="Button.MenuRow:pointerover">
            <Setter Property="Background" Value="{DynamicResource HoverColor}" />
        </Style>
        <Style Selector="Button.MenuRow.On">
            <Setter Property="Background" Value="{DynamicResource AccentSoftColor}" />
        </Style>
        <Style Selector="FlyoutPresenter.Bare">
            <Setter Property="Background" Value="{DynamicResource ClearColor}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="MaxWidth" Value="400" />
        </Style>
        <Style Selector="Border.Count">
            <Setter Property="MinWidth" Value="16" />
            <Setter Property="Height" Value="16" />
            <Setter Property="Padding" Value="5,0" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="Border.Count > TextBlock">
            <Setter Property="FontSize" Value="10.5" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="Border.Count.Error">
            <Setter Property="Background" Value="#2EEA5D52" />
        </Style>
        <Style Selector="Border.Count.Error > TextBlock">
            <Setter Property="Foreground" Value="#F3A19A" />
        </Style>
        <Style Selector="Border.Count.Warning">
            <Setter Property="Background" Value="#29E9AD3C" />
        </Style>
        <Style Selector="Border.Count.Warning > TextBlock">
            <Setter Property="Foreground" Value="#F0C674" />
        </Style>
        <Style Selector="Border.Line">
            <Setter Property="MinHeight" Value="26" />
            <Setter Property="Padding" Value="10,0" />
            <Setter Property="BorderBrush" Value="#06FFFFFF" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="Border.Line:pointerover">
            <Setter Property="Background" Value="#06FFFFFF" />
        </Style>
        <Style Selector="TextBlock.Time">
            <Setter Property="Foreground" Value="{DynamicResource DimColor}" />
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="FontFeatures" Value="+tnum" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="TextBlock.Empty">
            <Setter Property="Foreground" Value="{DynamicResource DimColor}" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextAlignment" Value="Center" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="MaxWidth" Value="360" />
        </Style>
    </UserControl.Styles>
    <DockPanel>
        <Border Classes="Strip" DockPanel.Dock="Top">
            <Grid ColumnDefinitions="*,Auto">
                <StackPanel Orientation="Horizontal" Spacing="2">
                    <Border
                        Classes="TabHost"
                        Classes.On="{Binding IsSequencerShown}"
                        IsVisible="{Binding HasSequencer}">
                        <Button
                            Classes="TabFace Plain"
                            Command="{Binding ShowCommand}"
                            CommandParameter="{x:Static studio:BottomTab.Sequencer}">
                            <StackPanel Orientation="Horizontal" Spacing="7">
                                <c:Icon
                                    Drawing="{StaticResource Toolwindows.Structure}"
                                    Height="14"
                                    Width="14" />
                                <TextBlock Classes="TabTitle" Text="{l:Tr BottomSequencer}" />
                            </StackPanel>
                        </Button>
                    </Border>
                    <Border Classes="TabHost" Classes.On="{Binding IsJournalShown}">
                        <Button
                            Classes="TabFace Plain"
                            Command="{Binding ShowCommand}"
                            CommandParameter="{x:Static studio:BottomTab.Journal}">
                            <StackPanel Orientation="Horizontal" Spacing="7">
                                <c:Icon
                                    Drawing="{StaticResource Toolwindows.Messages}"
                                    Height="14"
                                    Width="14" />
                                <TextBlock Classes="TabTitle" Text="{l:Tr BottomJournal}" />
                            </StackPanel>
                        </Button>
                    </Border>
                    <Border Classes="TabHost" Classes.On="{Binding IsTraceShown}">
                        <Button
                            Classes="TabFace Plain"
                            Command="{Binding ShowCommand}"
                            CommandParameter="{x:Static studio:BottomTab.Trace}">
                            <StackPanel Orientation="Horizontal" Spacing="7">
                                <c:Icon
                                    Drawing="{StaticResource Toolwindows.Run}"
                                    Height="14"
                                    Width="14" />
                                <TextBlock Classes="TabTitle" Text="{l:Tr BottomTrace}" />
                            </StackPanel>
                        </Button>
                    </Border>
                    <Border Classes="TabHost" Classes.On="{Binding IsProblemsShown}">
                        <Button
                            Classes="TabFace Plain"
                            Command="{Binding ShowCommand}"
                            CommandParameter="{x:Static studio:BottomTab.Problems}">
                            <StackPanel Orientation="Horizontal" Spacing="7">
                                <c:Icon
                                    Drawing="{StaticResource Toolwindows.Problems}"
                                    Height="14"
                                    Width="14" />
                                <TextBlock Classes="TabTitle" Text="{l:Tr BottomProblems}" />
                            <Border
                                Classes="Count Error"
                                IsVisible="{Binding Problems.HasErrors}"
                                ToolTip.Tip="{l:Tr ProblemsErrorsTip}">
                                <TextBlock Text="{Binding Problems.Errors}" />
                            </Border>
                            <Border
                                Classes="Count Warning"
                                IsVisible="{Binding Problems.HasWarnings}"
                                ToolTip.Tip="{l:Tr ProblemsWarningsTip}">
                                <TextBlock Text="{Binding Problems.Warnings}" />
                            </Border>
                            </StackPanel>
                        </Button>
                    </Border>
                    <Border Classes="TabHost" Classes.On="{Binding IsProtocolShown}">
                        <Button
                            Classes="TabFace Plain"
                            Command="{Binding ShowCommand}"
                            CommandParameter="{x:Static studio:BottomTab.Protocol}">
                            <StackPanel Orientation="Horizontal" Spacing="7">
                                <c:Icon
                                    Drawing="{StaticResource Toolwindows.Web}"
                                    Height="14"
                                    Width="14" />
                                <TextBlock Classes="TabTitle" Text="{l:Tr BottomProtocol}" />
                            </StackPanel>
                        </Button>
                    </Border>
                    <Border Classes="TabHost" Classes.On="{Binding IsStatisticsShown}">
                        <Button
                            Classes="TabFace Plain"
                            Command="{Binding ShowCommand}"
                            CommandParameter="{x:Static studio:BottomTab.Statistics}">
                            <StackPanel Orientation="Horizontal" Spacing="7">
                                <c:Icon
                                    Drawing="{StaticResource Toolwindows.Profiler}"
                                    Height="14"
                                    Width="14" />
                                <TextBlock Classes="TabTitle" Text="{l:Tr BottomStatistics}" />
                            </StackPanel>
                        </Button>
                    </Border>
                </StackPanel>
                <Button
                    Classes="Tool Small"
                    Command="{Binding CloseCommand}"
                    Grid.Column="1"
                    VerticalAlignment="Center">
                    <ToolTip.Tip>
                        <c:KeyTip Keys="Ctrl J" Text="{l:Tr Close}" />
                    </ToolTip.Tip>
                    <c:Icon
                        Drawing="{StaticResource General.Close}"
                        Height="12"
                        Width="12" />
                </Button>
            </Grid>
        </Border>
        <Panel>
            <views:SequencerView DataContext="{Binding Sequencer}" IsVisible="{Binding $parent[UserControl].((b:BottomPanelViewModel)DataContext).IsSequencerShown}" />
            <views:LogsView DataContext="{Binding Logs}" IsVisible="{Binding $parent[UserControl].((b:BottomPanelViewModel)DataContext).IsJournalShown}" />
            <views:TraceView DataContext="{Binding Trace}" IsVisible="{Binding $parent[UserControl].((b:BottomPanelViewModel)DataContext).IsTraceShown}" />
            <views:ProblemsView DataContext="{Binding Problems}" IsVisible="{Binding $parent[UserControl].((b:BottomPanelViewModel)DataContext).IsProblemsShown}" />
            <views:InspectorView DataContext="{Binding Inspector}" IsVisible="{Binding $parent[UserControl].((b:BottomPanelViewModel)DataContext).IsProtocolShown}" />
            <views:StatisticsView DataContext="{Binding Statistics}" IsVisible="{Binding $parent[UserControl].((b:BottomPanelViewModel)DataContext).IsStatisticsShown}" />
            <Border Background="{DynamicResource PanelColor}">
                <Border.IsVisible>
                    <MultiBinding Converter="{x:Static BoolConverters.And}">
                        <Binding Path="$parent[Window].((vm:MainViewModel)DataContext).IsNotRunning" />
                        <Binding Path="!IsProblemsShown" />
                    </MultiBinding>
                </Border.IsVisible>
                <views:HostStateView DataContext="{Binding $parent[Window].((vm:MainViewModel)DataContext)}" />
            </Border>
        </Panel>
    </DockPanel>
</UserControl>
