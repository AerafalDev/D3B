<UserControl
    x:Class="D3B.App.Views.BottomPanelView"
    x:ClassModifier="internal"
    x:DataType="b:BottomPanelViewModel"
    xmlns="https://github.com/avaloniaui"
    xmlns:b="clr-namespace:D3B.App.ViewModels.Bottom"
    xmlns:c="clr-namespace:D3B.App.Controls"
    xmlns:l="clr-namespace:D3B.App.Localization"
    xmlns:studio="clr-namespace:D3B.App.ViewModels.Studio"
    xmlns:views="clr-namespace:D3B.App.Views"
    xmlns:vm="clr-namespace:D3B.App.ViewModels"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <DockPanel>
        <Border Classes="Strip" DockPanel.Dock="Top">
            <Grid ColumnDefinitions="*,Auto">
                <StackPanel Orientation="Horizontal" Spacing="2">
                    <Border Classes="TabHost" Classes.On="{Binding IsJournalShown}">
                        <Button
                            Classes="TabFace Plain"
                            Command="{Binding ShowCommand}"
                            CommandParameter="{x:Static studio:BottomTab.Journal}">
                            <StackPanel Orientation="Horizontal" Spacing="7">
                                <c:Icon
                                    Drawing="{StaticResource Toolwindows.Messages}"
                                    Height="14"
                                    Width="14" />
                                <TextBlock Classes="TabTitle" Text="{l:Tr BottomJournal}" />
                            </StackPanel>
                        </Button>
                    </Border>
                    <Border Classes="TabHost" Classes.On="{Binding IsTraceShown}">
                        <Button
                            Classes="TabFace Plain"
                            Command="{Binding ShowCommand}"
                            CommandParameter="{x:Static studio:BottomTab.Trace}">
                            <StackPanel Orientation="Horizontal" Spacing="7">
                                <c:Icon
                                    Drawing="{StaticResource Toolwindows.Run}"
                                    Height="14"
                                    Width="14" />
                                <TextBlock Classes="TabTitle" Text="{l:Tr BottomTrace}" />
                            </StackPanel>
                        </Button>
                    </Border>
                    <Border Classes="TabHost" Classes.On="{Binding IsProblemsShown}">
                        <Button
                            Classes="TabFace Plain"
                            Command="{Binding ShowCommand}"
                            CommandParameter="{x:Static studio:BottomTab.Problems}">
                            <StackPanel Orientation="Horizontal" Spacing="7">
                                <c:Icon
                                    Drawing="{StaticResource Toolwindows.Problems}"
                                    Height="14"
                                    Width="14" />
                                <TextBlock Classes="TabTitle" Text="{l:Tr BottomProblems}" />
                            </StackPanel>
                        </Button>
                    </Border>
                    <Border Classes="TabHost" Classes.On="{Binding IsProtocolShown}">
                        <Button
                            Classes="TabFace Plain"
                            Command="{Binding ShowCommand}"
                            CommandParameter="{x:Static studio:BottomTab.Protocol}">
                            <StackPanel Orientation="Horizontal" Spacing="7">
                                <c:Icon
                                    Drawing="{StaticResource Toolwindows.Web}"
                                    Height="14"
                                    Width="14" />
                                <TextBlock Classes="TabTitle" Text="{l:Tr BottomProtocol}" />
                            </StackPanel>
                        </Button>
                    </Border>
                    <Border Classes="TabHost" Classes.On="{Binding IsStatisticsShown}">
                        <Button
                            Classes="TabFace Plain"
                            Command="{Binding ShowCommand}"
                            CommandParameter="{x:Static studio:BottomTab.Statistics}">
                            <StackPanel Orientation="Horizontal" Spacing="7">
                                <c:Icon
                                    Drawing="{StaticResource Toolwindows.Profiler}"
                                    Height="14"
                                    Width="14" />
                                <TextBlock Classes="TabTitle" Text="{l:Tr BottomStatistics}" />
                            </StackPanel>
                        </Button>
                    </Border>
                </StackPanel>
                <Button
                    Classes="Tool Small"
                    Command="{Binding CloseCommand}"
                    Grid.Column="1"
                    VerticalAlignment="Center">
                    <ToolTip.Tip>
                        <c:KeyTip Keys="Ctrl J" Text="{l:Tr Close}" />
                    </ToolTip.Tip>
                    <c:Icon
                        Drawing="{StaticResource General.Close}"
                        Height="12"
                        Width="12" />
                </Button>
            </Grid>
        </Border>
        <Panel>
            <views:LogsView DataContext="{Binding Logs}" IsVisible="{Binding $parent[UserControl].((b:BottomPanelViewModel)DataContext).IsJournalShown}" />
            <views:InspectorView DataContext="{Binding Inspector}" IsVisible="{Binding $parent[UserControl].((b:BottomPanelViewModel)DataContext).IsProtocolShown}" />
            <views:StatisticsView DataContext="{Binding Statistics}" IsVisible="{Binding $parent[UserControl].((b:BottomPanelViewModel)DataContext).IsStatisticsShown}" />
            <StackPanel
                HorizontalAlignment="Center"
                IsVisible="{Binding IsTraceShown}"
                MaxWidth="320"
                Spacing="6"
                VerticalAlignment="Center">
                <TextBlock
                    Classes="Muted"
                    HorizontalAlignment="Center"
                    Text="{l:Tr TraceEmptyTitle}" />
                <TextBlock
                    Classes="Dim"
                    HorizontalAlignment="Center"
                    Text="{l:Tr TraceEmptyText}"
                    TextAlignment="Center"
                    TextWrapping="Wrap" />
            </StackPanel>
            <StackPanel
                HorizontalAlignment="Center"
                IsVisible="{Binding IsProblemsShown}"
                Orientation="Horizontal"
                Spacing="8"
                VerticalAlignment="Center">
                <c:Icon Drawing="{StaticResource Status.Success}" VerticalAlignment="Center" />
                <TextBlock
                    Classes="Muted"
                    Text="{l:Tr ProblemsEmpty}"
                    VerticalAlignment="Center" />
            </StackPanel>
            <Border Background="{DynamicResource PanelColor}">
                <Border.IsVisible>
                    <MultiBinding Converter="{x:Static BoolConverters.And}">
                        <Binding Path="$parent[Window].((vm:MainViewModel)DataContext).IsNotRunning" />
                        <MultiBinding Converter="{x:Static BoolConverters.Or}">
                            <Binding Path="IsJournalShown" />
                            <Binding Path="IsProtocolShown" />
                            <Binding Path="IsStatisticsShown" />
                        </MultiBinding>
                    </MultiBinding>
                </Border.IsVisible>
                <views:HostStateView DataContext="{Binding $parent[Window].((vm:MainViewModel)DataContext)}" />
            </Border>
        </Panel>
    </DockPanel>
</UserControl>
