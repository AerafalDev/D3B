<UserControl
    x:Class="D3B.App.Views.TraceView"
    x:ClassModifier="internal"
    x:DataType="b:TraceViewModel"
    xmlns="https://github.com/avaloniaui"
    xmlns:b="clr-namespace:D3B.App.ViewModels.Bottom"
    xmlns:c="clr-namespace:D3B.App.Controls"
    xmlns:l="clr-namespace:D3B.App.Localization"
    xmlns:logs="clr-namespace:D3B.App.ViewModels.Logs"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Styles>
        <Style Selector="Border.Line.Trace">
            <Setter Property="MinHeight" Value="28" />
        </Style>
        <Style Selector="Ellipse.TraceDot">
            <Setter Property="Width" Value="8" />
            <Setter Property="Height" Value="8" />
            <Setter Property="Fill" Value="{DynamicResource MutedColor}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="Ellipse.TraceDot.Playing">
            <Setter Property="Fill" Value="{DynamicResource PlayingColor}" />
        </Style>
        <Style Selector="Ellipse.TraceDot.Cut">
            <Setter Property="Fill" Value="{DynamicResource ErrorColor}" />
        </Style>
        <Style Selector="Border.Pill">
            <Setter Property="CornerRadius" Value="9" />
            <Setter Property="Padding" Value="7,1" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Background" Value="#0FFFFFFF" />
        </Style>
        <Style Selector="Border.Pill > TextBlock">
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="Foreground" Value="{DynamicResource MutedColor}" />
        </Style>
        <Style Selector="Border.Pill.Good">
            <Setter Property="Background" Value="#1F3ECF5C" />
        </Style>
        <Style Selector="Border.Pill.Good > TextBlock">
            <Setter Property="Foreground" Value="#8FE3A2" />
        </Style>
        <Style Selector="Border.Pill.Bad">
            <Setter Property="Background" Value="#24EA5D52" />
        </Style>
        <Style Selector="Border.Pill.Bad > TextBlock">
            <Setter Property="Foreground" Value="#F3A19A" />
        </Style>
    </UserControl.Styles>
    <DockPanel>
        <Border Classes="Toolbar" DockPanel.Dock="Top">
            <Grid ColumnDefinitions="*,Auto">
                <StackPanel>
                    <Button AutomationProperties.Name="{l:Tr TraceCharacter}" Classes="Dd">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <TextBlock
                                Text="{Binding Bot.Name, FallbackValue={l:Tr TraceNoCharacter}}"
                                TextTrimming="CharacterEllipsis"
                                VerticalAlignment="Center" />
                            <c:Icon
                                Drawing="{StaticResource General.ChevronDown}"
                                Height="10"
                                Opacity="0.6"
                                VerticalAlignment="Center"
                                Width="10" />
                        </StackPanel>
                        <Button.Flyout>
                            <Flyout FlyoutPresenterClasses="Bare" Placement="BottomEdgeAlignedLeft">
                                <Border Classes="MenuPopup" MinWidth="220">
                                    <ItemsControl ItemsSource="{Binding Bots}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="logs:LogSourceViewModel">
                                                <Button
                                                    Classes="MenuRow"
                                                    Classes.On="{Binding IsSelected}"
                                                    Click="OnMenuRowClick"
                                                    Command="{Binding SelectCommand}">
                                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                                        <c:StatusPill Classes="Dot" Tone="{Binding Tone}" />
                                                        <TextBlock
                                                            Text="{Binding Name}"
                                                            TextTrimming="CharacterEllipsis"
                                                            VerticalAlignment="Center" />
                                                    </StackPanel>
                                                </Button>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </Border>
                            </Flyout>
                        </Button.Flyout>
                    </Button>
                    <TextBlock
                        Classes="Dim"
                        IsVisible="{Binding HasBehavior}"
                        Text="{Binding Behavior}"
                        TextTrimming="CharacterEllipsis"
                        VerticalAlignment="Center" />
                </StackPanel>
                <StackPanel Grid.Column="1">
                    <Button
                        AutomationProperties.Name="{l:Tr TraceRun}"
                        Classes="Dd"
                        IsEnabled="{Binding HasBehavior}">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <TextBlock
                                Text="{Binding Run.Label, FallbackValue={l:Tr TraceNoRun}}"
                                TextTrimming="CharacterEllipsis"
                                VerticalAlignment="Center" />
                            <c:Icon
                                Drawing="{StaticResource General.ChevronDown}"
                                Height="10"
                                Opacity="0.6"
                                VerticalAlignment="Center"
                                Width="10" />
                        </StackPanel>
                        <Button.Flyout>
                            <Flyout FlyoutPresenterClasses="Bare" Placement="BottomEdgeAlignedRight">
                                <Border Classes="MenuPopup" MinWidth="200">
                                    <ItemsControl ItemsSource="{Binding Runs}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="b:TraceRunViewModel">
                                                <Button
                                                    Classes="MenuRow"
                                                    Click="OnRunClick">
                                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                                        <TextBlock Text="{Binding Label}" VerticalAlignment="Center" />
                                                        <TextBlock
                                                            Classes="Dim"
                                                            Text="{Binding Behavior}"
                                                            TextTrimming="CharacterEllipsis"
                                                            VerticalAlignment="Center" />
                                                    </StackPanel>
                                                </Button>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </Border>
                            </Flyout>
                        </Button.Flyout>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>
        <Panel>
            <TextBlock
                Classes="Empty"
                IsVisible="{Binding IsEmpty}"
                Text="{Binding EmptyText}" />
            <ScrollViewer>
                <ItemsControl ItemsSource="{Binding Lines}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <VirtualizingStackPanel />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="b:TraceLineViewModel">
                            <Border Classes="Line Trace">
                                <Grid ColumnDefinitions="62,130,*,Auto" ColumnSpacing="10">
                                    <TextBlock Classes="Time" Text="{Binding Time}" />
                                    <StackPanel
                                        Grid.Column="1"
                                        Orientation="Horizontal"
                                        Spacing="6">
                                        <Ellipse
                                            Classes="TraceDot"
                                            Classes.Cut="{Binding IsCut}"
                                            Classes.Playing="{Binding IsPlaying}" />
                                        <TextBlock
                                            Classes="Muted"
                                            MaxWidth="116"
                                            Text="{Binding State}"
                                            TextTrimming="CharacterEllipsis"
                                            VerticalAlignment="Center" />
                                    </StackPanel>
                                    <TextBlock
                                        Grid.Column="2"
                                        Text="{Binding Text}"
                                        TextTrimming="CharacterEllipsis"
                                        VerticalAlignment="Center" />
                                    <Border
                                        Classes="Pill"
                                        Classes.Bad="{Binding IsBad}"
                                        Classes.Good="{Binding IsGood}"
                                        Grid.Column="3"
                                        IsVisible="{Binding HasOutcome}">
                                        <TextBlock Text="{Binding Outcome}" />
                                    </Border>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Panel>
    </DockPanel>
</UserControl>
