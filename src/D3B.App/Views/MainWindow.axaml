<shadui:Window
    x:Class="D3B.App.Views.MainWindow"
    x:ClassModifier="internal"
    x:DataType="vm:MainViewModel"
    Title="D3B"
    TitleFontWeight="SemiBold"
    Width="1240"
    Height="800"
    MinWidth="720"
    MinHeight="560"
    WindowStartupLocation="CenterScreen"
    xmlns="https://github.com/avaloniaui"
    xmlns:c="clr-namespace:D3B.App.Controls"
    xmlns:l="clr-namespace:D3B.App.Localization"
    xmlns:shadui="clr-namespace:ShadUI;assembly=ShadUI"
    xmlns:views="clr-namespace:D3B.App.Views"
    xmlns:vm="clr-namespace:D3B.App.ViewModels"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <shadui:Window.LogoContent>
        <c:Icon
            Data="{StaticResource IconBot}"
            Height="16"
            Margin="12,0,0,0"
            VerticalAlignment="Center"
            Width="16" />
    </shadui:Window.LogoContent>
    <shadui:Window.RightWindowTitleBarContent>
        <StackPanel
            Margin="0,0,6,0"
            Orientation="Horizontal"
            Spacing="4"
            VerticalAlignment="Center">
            <c:StatusPill
                Margin="0,0,8,0"
                Text="{Binding HostTitle}"
                ToolTip.Tip="{Binding HostDetail}"
                Tone="{Binding HostTone}" />
            <Button
                Classes="Ghost"
                Command="{Binding SwitchLanguageCommand}"
                CornerRadius="{DynamicResource MdCornerRadius}"
                Height="30"
                Padding="10,0"
                ToolTip.Tip="{l:Tr SwitchLanguage}">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <c:Icon
                        Data="{StaticResource IconLanguage}"
                        Height="15"
                        Width="15" />
                    <TextBlock
                        FontSize="12"
                        FontWeight="SemiBold"
                        Text="{Binding LanguageCode}"
                        VerticalAlignment="Center" />
                </StackPanel>
            </Button>
            <Button
                Classes="Ghost"
                Click="OnThemeClick"
                CornerRadius="{DynamicResource MdCornerRadius}"
                Height="30"
                Padding="0"
                ToolTip.Tip="{l:Tr SwitchTheme}"
                Width="30">
                <c:Icon
                    Height="15"
                    Name="ThemeIcon"
                    Width="15" />
            </Button>
        </StackPanel>
    </shadui:Window.RightWindowTitleBarContent>
    <Grid ColumnDefinitions="Auto,*">
        <Border Classes="Rail">
            <StackPanel Margin="0,14" Spacing="6">
                <Button
                    Classes="Ghost RailItem"
                    Classes.Selected="{Binding IsBotsPage}"
                    Command="{Binding ShowBotsCommand}"
                    ToolTip.Tip="{l:Tr Bots}">
                    <c:Icon Data="{StaticResource IconCards}" />
                </Button>
                <Button
                    Classes="Ghost RailItem"
                    Classes.Selected="{Binding IsAccountsPage}"
                    Command="{Binding ShowAccountsCommand}"
                    ToolTip.Tip="{l:Tr Accounts}">
                    <c:Icon Data="{StaticResource IconUsers}" />
                </Button>
                <Button
                    Classes="Ghost RailItem"
                    Classes.Selected="{Binding IsProfilesPage}"
                    Command="{Binding ShowProfilesCommand}"
                    ToolTip.Tip="{l:Tr Profiles}">
                    <c:Icon Data="{StaticResource IconSliders}" />
                </Button>
                <Border Classes="RailSeparator" IsVisible="{Binding HasPages}" />
                <ItemsControl ItemsSource="{Binding Pages}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Spacing="6" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:ModulePageViewModel">
                            <Button
                                Classes="Ghost RailItem"
                                Classes.Selected="{Binding IsSelected}"
                                Command="{Binding ShowCommand}"
                                ToolTip.Tip="{Binding Title}">
                                <c:Icon Data="{Binding Icon, TargetNullValue={StaticResource IconModule}}" />
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>
        <Panel Grid.Column="1">
            <StackPanel
                HorizontalAlignment="Center"
                IsVisible="{Binding IsStarting}"
                MaxWidth="420"
                Spacing="14"
                VerticalAlignment="Center">
                <shadui:Loading
                    Height="28"
                    HorizontalAlignment="Center"
                    Width="28" />
                <TextBlock
                    Classes="h4"
                    HorizontalAlignment="Center"
                    Text="{l:Tr HostStartingTitle}" />
                <TextBlock
                    Classes="Small Muted"
                    Text="{l:Tr HostStartingDetail}"
                    TextAlignment="Center"
                    TextWrapping="Wrap" />
            </StackPanel>
            <StackPanel
                HorizontalAlignment="Center"
                IsVisible="{Binding IsStopping}"
                Spacing="14"
                VerticalAlignment="Center">
                <shadui:Loading
                    Height="28"
                    HorizontalAlignment="Center"
                    Width="28" />
                <TextBlock
                    Classes="h4"
                    HorizontalAlignment="Center"
                    Text="{l:Tr HostStoppingTitle}" />
            </StackPanel>
            <ScrollViewer IsVisible="{Binding IsFailed}">
                <Border
                    Classes="Banner Danger"
                    HorizontalAlignment="Center"
                    Margin="40"
                    MaxWidth="720"
                    Padding="24,22"
                    VerticalAlignment="Center">
                    <StackPanel Spacing="16">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <c:Icon
                                Data="{StaticResource IconAlert}"
                                Foreground="{DynamicResource ErrorColor}"
                                Height="20"
                                VerticalAlignment="Center"
                                Width="20" />
                            <TextBlock
                                Classes="h4"
                                Text="{l:Tr HostFailedTitle}"
                                VerticalAlignment="Center" />
                        </StackPanel>
                        <Border Classes="Code">
                            <SelectableTextBlock
                                Classes="Mono"
                                Text="{Binding HostFailure}"
                                TextWrapping="Wrap" />
                        </Border>
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock
                                Classes="Small Muted"
                                Text="{l:Tr HostFailedHint}"
                                TextWrapping="Wrap"
                                VerticalAlignment="Center" />
                            <Button
                                Classes="Outline"
                                Click="OnCopyFailureClick"
                                Grid.Column="1"
                                Margin="16,0,0,0">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <c:Icon
                                        Data="{StaticResource IconCopy}"
                                        Height="14"
                                        Width="14" />
                                    <TextBlock Text="{l:Tr Copy}" />
                                </StackPanel>
                            </Button>
                        </Grid>
                    </StackPanel>
                </Border>
            </ScrollViewer>
            <Panel IsVisible="{Binding IsRunning}">
                <Panel IsVisible="{Binding IsBotsPage}">
                    <views:BotsView DataContext="{Binding Bots}" />
                </Panel>
                <Panel IsVisible="{Binding IsAccountsPage}">
                    <views:AccountsView DataContext="{Binding Accounts}" />
                </Panel>
                <Panel IsVisible="{Binding IsProfilesPage}">
                    <views:ProfilesView DataContext="{Binding Profiles}" />
                </Panel>
                <ContentControl Content="{Binding SelectedPage.Content}" IsVisible="{Binding IsModulePage}">
                    <ContentControl.DataTemplates>
                        <DataTemplate x:DataType="vm:PageFailureViewModel">
                            <ScrollViewer>
                                <Border
                                    Classes="Banner Danger"
                                    HorizontalAlignment="Center"
                                    Margin="40"
                                    MaxWidth="720"
                                    Padding="24,22"
                                    VerticalAlignment="Center">
                                    <StackPanel Spacing="16">
                                        <StackPanel Orientation="Horizontal" Spacing="10">
                                            <c:Icon
                                                Data="{StaticResource IconAlert}"
                                                Foreground="{DynamicResource ErrorColor}"
                                                Height="20"
                                                VerticalAlignment="Center"
                                                Width="20" />
                                            <TextBlock
                                                Classes="h4"
                                                Text="{l:Tr PageFailedTitle}"
                                                VerticalAlignment="Center" />
                                        </StackPanel>
                                        <TextBlock
                                            Classes="Small Muted"
                                            Text="{l:Tr PageFailedDetail}"
                                            TextWrapping="Wrap" />
                                        <Border Classes="Code">
                                            <SelectableTextBlock
                                                Classes="Mono"
                                                Text="{Binding Message}"
                                                TextWrapping="Wrap" />
                                        </Border>
                                    </StackPanel>
                                </Border>
                            </ScrollViewer>
                        </DataTemplate>
                    </ContentControl.DataTemplates>
                </ContentControl>
            </Panel>
        </Panel>
    </Grid>
</shadui:Window>
