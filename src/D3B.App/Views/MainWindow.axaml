<shadui:Window
    x:Class="D3B.App.Views.MainWindow"
    x:ClassModifier="internal"
    x:DataType="vm:MainViewModel"
    FontSize="12.5"
    Icon="/Assets/d3b.ico"
    Title="D3B"
    Width="1440"
    Height="900"
    MinWidth="960"
    MinHeight="600"
    WindowStartupLocation="CenterScreen"
    xmlns="https://github.com/avaloniaui"
    xmlns:c="clr-namespace:D3B.App.Controls"
    xmlns:l="clr-namespace:D3B.App.Localization"
    xmlns:ch="clr-namespace:D3B.App.ViewModels.Characters"
    xmlns:shadui="clr-namespace:ShadUI;assembly=ShadUI"
    xmlns:studio="clr-namespace:D3B.App.ViewModels.Studio"
    xmlns:views="clr-namespace:D3B.App.Views"
    xmlns:vm="clr-namespace:D3B.App.ViewModels"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <shadui:Window.KeyBindings>
        <KeyBinding Command="{Binding Search.OpenCommand}" Gesture="Ctrl+K" />
        <KeyBinding Command="{Binding ToggleBottomCommand}" Gesture="Ctrl+J" />
        <KeyBinding Command="{Binding GoToAssetsCommand}" Gesture="Ctrl+Space" />
        <KeyBinding Command="{Binding ShowSettingsCommand}" Gesture="Ctrl+OemComma" />
        <KeyBinding Command="{Binding NewProfileCommand}" Gesture="Ctrl+N" />
        <KeyBinding Command="{Binding SaveAllCommand}" Gesture="Ctrl+S" />
        <KeyBinding Command="{Binding ShowShortcutsCommand}" Gesture="Ctrl+OemQuestion" />
        <KeyBinding Command="{Binding RunBlock.PlayOrPauseCommand}" Gesture="F5" />
        <KeyBinding Command="{Binding RunBlock.PauseCommand}" Gesture="F6" />
        <KeyBinding Command="{Binding RunBlock.StopCommand}" Gesture="Shift+F5" />
    </shadui:Window.KeyBindings>
    <shadui:Window.Styles>
        <Style Selector="Border.Run">
            <Setter Property="Height" Value="34" />
            <Setter Property="Padding" Value="2" />
            <Setter Property="CornerRadius" Value="11" />
            <Setter Property="Background" Value="{DynamicResource PanelColor}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderColor60}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Duration="0:0:0.2" Property="BorderBrush" />
                    <BoxShadowsTransition Duration="0:0:0.2" Property="BoxShadow" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Border.Run.Playing">
            <Setter Property="BorderBrush" Value="{DynamicResource PlayingEdgeColor}" />
            <Setter Property="BoxShadow" Value="0 0 18 -6 #733ECF5C" />
        </Style>
        <Style Selector="Border.Run.Paused">
            <Setter Property="BorderBrush" Value="{DynamicResource PausedEdgeColor}" />
        </Style>
        <Style Selector="Button.RunWho">
            <Setter Property="Theme" Value="{DynamicResource StudioButton}" />
            <Setter Property="Height" Value="30" />
            <Setter Property="MinHeight" Value="30" />
            <Setter Property="MinWidth" Value="176" />
            <Setter Property="Padding" Value="4,0,6,0" />
            <Setter Property="CornerRadius" Value="9" />
            <Setter Property="Background" Value="{DynamicResource ClearColor}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="FontWeight" Value="Normal" />
        </Style>
        <Style Selector="Button.RunWho:pointerover, Button.RunWho:pressed">
            <Setter Property="Background" Value="{DynamicResource HoverColor}" />
        </Style>
        <Style Selector="Border.Avatar">
            <Setter Property="Width" Value="24" />
            <Setter Property="Height" Value="24" />
            <Setter Property="CornerRadius" Value="7" />
            <Setter Property="Background" Value="{DynamicResource RaisedColor}" />
        </Style>
        <Style Selector="Ellipse.StateDot">
            <Setter Property="Width" Value="9" />
            <Setter Property="Height" Value="9" />
            <Setter Property="Stroke" Value="{DynamicResource PanelColor}" />
            <Setter Property="StrokeThickness" Value="2" />
            <Setter Property="Fill" Value="{DynamicResource DimColor}" />
            <Setter Property="HorizontalAlignment" Value="Right" />
            <Setter Property="VerticalAlignment" Value="Bottom" />
            <Setter Property="Margin" Value="0,0,-3,-3" />
        </Style>
        <Style Selector="Ellipse.StateDot.Playing">
            <Setter Property="Fill" Value="{DynamicResource PlayingColor}" />
        </Style>
        <Style Selector="Ellipse.StateDot.Paused">
            <Setter Property="Fill" Value="{DynamicResource PausedColor}" />
        </Style>
        <Style Selector="TextBlock.RunDetail.Playing">
            <Setter Property="Foreground" Value="{DynamicResource PlayingTextColor}" />
        </Style>
        <Style Selector="TextBlock.RunDetail.Paused">
            <Setter Property="Foreground" Value="{DynamicResource PausedColor}" />
        </Style>
        <Style Selector="Button.Choice">
            <Setter Property="Theme" Value="{DynamicResource StudioButton}" />
            <Setter Property="Height" Value="40" />
            <Setter Property="MinHeight" Value="40" />
            <Setter Property="Padding" Value="8,0" />
            <Setter Property="CornerRadius" Value="7" />
            <Setter Property="Background" Value="{DynamicResource ClearColor}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="FontWeight" Value="Normal" />
        </Style>
        <Style Selector="Button.Choice:pointerover">
            <Setter Property="Background" Value="{DynamicResource HoverColor}" />
        </Style>
        <Style Selector="Button.Choice.Chosen">
            <Setter Property="Background" Value="{DynamicResource AccentSoftColor}" />
        </Style>
        <Style Selector="TextBox.PropertySearch">
            <Setter Property="Height" Value="28" />
            <Setter Property="MinHeight" Value="28" />
            <Setter Property="CornerRadius" Value="7" />
            <Setter Property="Background" Value="{DynamicResource InputColor}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderColor}" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style Selector="FlyoutPresenter.Bare">
            <Setter Property="Background" Value="{DynamicResource ClearColor}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="MaxWidth" Value="400" />
        </Style>
        <Style Selector="Ellipse.HostDot">
            <Setter Property="Width" Value="7" />
            <Setter Property="Height" Value="7" />
            <Setter Property="Fill" Value="{DynamicResource DimColor}" />
        </Style>
        <Style Selector="Ellipse.HostDot.Running">
            <Setter Property="Fill" Value="{DynamicResource PlayingColor}" />
        </Style>
        <Style Selector="Ellipse.HostDot.Starting">
            <Setter Property="Fill" Value="{DynamicResource AccentColor}" />
        </Style>
        <Style Selector="Ellipse.HostDot.Stopping">
            <Setter Property="Fill" Value="{DynamicResource PausedColor}" />
        </Style>
        <Style Selector="Ellipse.HostDot.Failed">
            <Setter Property="Fill" Value="{DynamicResource ErrorColor}" />
        </Style>
        <Style Selector="Border.Glow">
            <Setter Property="Width" Value="13" />
            <Setter Property="Height" Value="13" />
            <Setter Property="CornerRadius" Value="7" />
            <Setter Property="Background" Value="#263ECF5C" />
        </Style>
    </shadui:Window.Styles>

    <shadui:Window.LogoContent>
        <StackPanel Margin="10,0,0,0" Orientation="Horizontal">
            <Image
                Height="22"
                IsHitTestVisible="False"
                Margin="0,0,6,0"
                RenderOptions.BitmapInterpolationMode="HighQuality"
                Source="/Assets/d3b.png"
                VerticalAlignment="Center"
                Width="22" />
            <Menu Theme="{StaticResource TitleMenu}" VerticalAlignment="Center">
                <MenuItem Header="{l:Tr MenuFile}">
                    <MenuItem
                        Command="{Binding NewProfileCommand}"
                        Header="{l:Tr CommandNewProfile}"
                        Tag="Ctrl N" />
                    <MenuItem
                        Command="{Binding SaveAllCommand}"
                        Header="{l:Tr CommandSaveAll}"
                        Tag="Ctrl S" />
                    <Separator />
                    <MenuItem Command="{Binding OpenProjectFolderCommand}" Header="{l:Tr CommandProjectFolder}" />
                    <Separator />
                    <MenuItem Command="{Binding QuitCommand}" Header="{l:Tr MenuQuit}" />
                </MenuItem>
                <MenuItem Header="{l:Tr MenuEdit}">
                    <MenuItem
                        Header="{l:Tr MenuUndo}"
                        IsEnabled="False"
                        Tag="Ctrl Z" />
                    <MenuItem
                        Header="{l:Tr MenuRedo}"
                        IsEnabled="False"
                        Tag="Ctrl Y" />
                    <Separator />
                    <MenuItem
                        Command="{Binding ShowSettingsCommand}"
                        Header="{l:Tr Settings}"
                        Tag="Ctrl ," />
                </MenuItem>
                <MenuItem Header="{l:Tr MenuWindow}">
                    <MenuItem Classes="Heading" Header="{l:Tr MenuPanels}" />
                    <MenuItem
                        Command="{Binding Layout.ToggleCommand}"
                        CommandParameter="{x:Static studio:StudioPanel.Characters}"
                        Header="{l:Tr PanelCharacters}"
                        IsChecked="{Binding Layout.IsCharactersOpen, Mode=OneWay}" />
                    <MenuItem
                        Command="{Binding Layout.ToggleCommand}"
                        CommandParameter="{x:Static studio:StudioPanel.Assets}"
                        Header="{l:Tr PanelAssets}"
                        IsChecked="{Binding Layout.IsAssetsOpen, Mode=OneWay}"
                        Tag="{l:Tr KeysCtrlSpace}" />
                    <MenuItem
                        Command="{Binding Layout.ToggleCommand}"
                        CommandParameter="{x:Static studio:StudioPanel.Bottom}"
                        Header="{l:Tr PanelJournal}"
                        IsChecked="{Binding Layout.IsBottomOpen, Mode=OneWay}"
                        Tag="Ctrl J" />
                    <MenuItem
                        Command="{Binding Layout.ToggleCommand}"
                        CommandParameter="{x:Static studio:StudioPanel.Inspector}"
                        Header="{l:Tr PanelInspector}"
                        IsChecked="{Binding Layout.IsInspectorOpen, Mode=OneWay}" />
                    <Separator />
                    <MenuItem Classes="Heading" Header="{l:Tr MenuPages}" />
                    <MenuItem Command="{Binding ShowProfilesCommand}" Header="{l:Tr Profiles}" />
                    <MenuItem
                        Header="{l:Tr MenuModules}"
                        IsVisible="{Binding HasPages}"
                        ItemsSource="{Binding Pages}">
                        <MenuItem.ItemContainerTheme>
                            <ControlTheme BasedOn="{StaticResource {x:Type MenuItem}}" TargetType="MenuItem" x:DataType="vm:ModulePageViewModel">
                                <Setter Property="Header" Value="{Binding Title}" />
                                <Setter Property="Command" Value="{Binding ShowCommand}" />
                            </ControlTheme>
                        </MenuItem.ItemContainerTheme>
                    </MenuItem>
                    <Separator />
                    <MenuItem Command="{Binding Layout.ResetCommand}" Header="{l:Tr CommandDefaultLayout}" />
                </MenuItem>
                <MenuItem Header="{l:Tr MenuHelp}">
                    <MenuItem
                        Command="{Binding ShowShortcutsCommand}"
                        Header="{l:Tr MenuShortcuts}"
                        Tag="Ctrl /" />
                    <MenuItem Command="{Binding ShowSettingsCommand}" Header="{l:Tr MenuAbout}" />
                </MenuItem>
            </Menu>
        </StackPanel>
    </shadui:Window.LogoContent>

    <shadui:Window.MenuBarContent>
        <Button Classes="TitleSearch" Command="{Binding Search.OpenCommand}">
            <ToolTip.Tip>
                <c:KeyTip Keys="Ctrl K" Text="{l:Tr SearchEverywhere}" />
            </ToolTip.Tip>
            <Grid ColumnDefinitions="Auto,*,Auto">
                <c:Icon Drawing="{StaticResource General.Search}" VerticalAlignment="Center" />
                <TextBlock
                    Grid.Column="1"
                    Margin="8,0"
                    Text="{l:Tr TitleSearch}"
                    VerticalAlignment="Center" />
                <Border
                    Classes="Key Flat"
                    Grid.Column="2"
                    VerticalAlignment="Center">
                    <TextBlock Text="Ctrl K" />
                </Border>
            </Grid>
        </Button>
    </shadui:Window.MenuBarContent>

    <shadui:Window.RightWindowTitleBarContent>
        <StackPanel Orientation="Horizontal" Spacing="4">
            <Border
                Classes="Run"
                Classes.Paused="{Binding RunBlock.IsPaused}"
                Classes.Playing="{Binding RunBlock.IsPlaying}">
                <StackPanel Orientation="Horizontal" Spacing="2">
                    <Button
                        Classes="RunWho"
                        Name="RunWho">
                        <ToolTip.Tip>
                            <c:KeyTip Text="{l:Tr RunWhoTip}" />
                        </ToolTip.Tip>
                        <Button.Flyout>
                            <Flyout FlyoutPresenterClasses="Bare" Placement="BottomEdgeAlignedLeft">
                                <Border Classes="MenuPopup" MinWidth="260">
                                    <StackPanel>
                                        <TextBlock
                                            Classes="Dim"
                                            FontSize="11"
                                            Margin="10,6,10,3"
                                            Text="{l:Tr RunOnline}" />
                                        <TextBlock
                                            Classes="Muted"
                                            IsVisible="{Binding RunBlock.IsNobodyOnline}"
                                            Margin="10,4,10,8"
                                            Text="{l:Tr RunNobodyOnline}" />
                                        <ItemsControl ItemsSource="{Binding RunBlock.Online}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="vm:BotViewModel">
                                                    <Button
                                                        Classes="Choice"
                                                        Classes.Chosen="{Binding IsChosen}"
                                                        Click="OnRunChoiceClick">
                                                        <Grid ColumnDefinitions="Auto,*,Auto">
                                                            <Panel VerticalAlignment="Center">
                                                                <c:Portrait
                                                                    Color="{Binding PortraitColor}"
                                                                    Head="{Binding Head}"
                                                                    Height="26"
                                                                    Initials="{Binding Initials}"
                                                                    Radius="7"
                                                                    Width="26" />
                                                                <Ellipse
                                                                    Classes="StateDot"
                                                                    Classes.Paused="{Binding IsPaused}"
                                                                    Classes.Playing="{Binding IsActivityRunning}"
                                                                    Stroke="{DynamicResource PopupColor}" />
                                                            </Panel>
                                                            <StackPanel
                                                                Grid.Column="1"
                                                                Margin="10,0"
                                                                VerticalAlignment="Center">
                                                                <TextBlock
                                                                    Classes="Bright"
                                                                    FontWeight="SemiBold"
                                                                    Text="{Binding Name}"
                                                                    TextTrimming="CharacterEllipsis" />
                                                                <TextBlock
                                                                    Classes="Dim Small"
                                                                    Text="{Binding Doing}"
                                                                    TextTrimming="CharacterEllipsis" />
                                                            </StackPanel>
                                                            <TextBlock
                                                                Classes="Dim Small Figures"
                                                                Grid.Column="2"
                                                                Text="{Binding Level}"
                                                                VerticalAlignment="Center" />
                                                        </Grid>
                                                    </Button>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Border>
                            </Flyout>
                        </Button.Flyout>
                        <Grid ColumnDefinitions="Auto,*,Auto">
                            <Panel VerticalAlignment="Center">
                                <Border Classes="Avatar" IsVisible="{Binding RunBlock.PortraitColor, Converter={x:Static ObjectConverters.IsNull}}">
                                    <c:Icon
                                        Drawing="{StaticResource General.User}"
                                        Height="14"
                                        HorizontalAlignment="Center"
                                        Opacity="0.7"
                                        VerticalAlignment="Center"
                                        Width="14" />
                                </Border>
                                <c:Portrait
                                    Color="{Binding RunBlock.PortraitColor}"
                                    Head="{Binding RunBlock.Head}"
                                    Height="24"
                                    Initials="{Binding RunBlock.Initials}"
                                    IsVisible="{Binding RunBlock.PortraitColor, Converter={x:Static ObjectConverters.IsNotNull}}"
                                    Radius="7"
                                    Width="24" />
                                <Ellipse
                                    Classes="StateDot"
                                    Classes.Paused="{Binding RunBlock.IsPaused}"
                                    Classes.Playing="{Binding RunBlock.IsPlaying}"
                                    IsVisible="{Binding RunBlock.IsChosen}" />
                            </Panel>
                            <StackPanel
                                Grid.Column="1"
                                Margin="8,0"
                                VerticalAlignment="Center">
                                <TextBlock
                                    Classes.Bright="{Binding RunBlock.IsChosen}"
                                    Classes.Muted="{Binding !RunBlock.IsChosen}"
                                    FontWeight="SemiBold"
                                    LineHeight="15"
                                    Text="{Binding RunBlock.Name}"
                                    TextTrimming="CharacterEllipsis" />
                                <TextBlock
                                    Classes="Dim Small RunDetail"
                                    Classes.Paused="{Binding RunBlock.IsPaused}"
                                    Classes.Playing="{Binding RunBlock.IsPlaying}"
                                    LineHeight="13"
                                    MaxWidth="200"
                                    Text="{Binding RunBlock.Detail}"
                                    TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                            <c:Icon
                                Drawing="{StaticResource General.ChevronDown}"
                                Grid.Column="2"
                                Height="10"
                                Opacity="0.55"
                                VerticalAlignment="Center"
                                Width="10" />
                        </Grid>
                    </Button>
                    <Button
                        Classes="Tool Run"
                        Command="{Binding RunBlock.PlayCommand}"
                        IsEnabled="{Binding RunBlock.CanPlay}"
                        IsVisible="{Binding RunBlock.ShowsPlay}"
                        ToolTip.ShowOnDisabled="True">
                        <ToolTip.Tip>
                            <c:KeyTip Keys="F5" Text="{Binding RunBlock.PlayTip}" />
                        </ToolTip.Tip>
                        <c:Icon Drawing="{StaticResource Run.Run}" />
                    </Button>
                    <Button
                        Classes="Tool Run"
                        Command="{Binding RunBlock.PauseCommand}"
                        IsVisible="{Binding RunBlock.ShowsPause}">
                        <ToolTip.Tip>
                            <c:KeyTip Keys="F6" Text="{l:Tr RunPause}" />
                        </ToolTip.Tip>
                        <c:Icon Drawing="{StaticResource Run.Pause}" />
                    </Button>
                    <Button
                        Classes="Tool Run"
                        Command="{Binding RunBlock.StopCommand}"
                        IsVisible="{Binding RunBlock.ShowsStop}">
                        <ToolTip.Tip>
                            <c:KeyTip Keys="{l:Tr KeysShiftF5}" Text="{l:Tr RunStopTip}" />
                        </ToolTip.Tip>
                        <c:Icon Drawing="{StaticResource Run.Stop}" />
                    </Button>
                </StackPanel>
            </Border>
            <Border
                Background="{DynamicResource BorderColor}"
                Height="20"
                Margin="4,0"
                VerticalAlignment="Center"
                Width="1" />
            <Button
                Classes="Tool"
                Command="{Binding ShowSettingsCommand}"
                VerticalAlignment="Center"
                Width="30">
                <ToolTip.Tip>
                    <c:KeyTip Keys="Ctrl ," Text="{l:Tr Settings}" />
                </ToolTip.Tip>
                <c:Icon Drawing="{StaticResource General.Settings}" />
            </Button>
        </StackPanel>
    </shadui:Window.RightWindowTitleBarContent>

    <shadui:Window.Hosts>
        <shadui:DialogHost Name="DialogHost" />
        <shadui:ToastHost Name="ToastHost" Position="BottomRight" />
    </shadui:Window.Hosts>

    <Panel>
        <Grid RowDefinitions="*,34">
            <Grid
                Margin="5,0"
                Name="Docks">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="300" />
                    <ColumnDefinition Width="5" />
                    <ColumnDefinition MinWidth="320" Width="*" />
                    <ColumnDefinition Width="5" />
                    <ColumnDefinition Width="340" />
                </Grid.ColumnDefinitions>

                <Grid Name="LeftColumn">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="6*" />
                        <RowDefinition Height="5" />
                        <RowDefinition Height="4*" />
                    </Grid.RowDefinitions>
                    <Border
                        Classes="Dock Compact"
                        IsVisible="{Binding Layout.IsCharactersOpen}"
                        Name="CharactersDock">
                        <DockPanel>
                            <Border Classes="Strip" DockPanel.Dock="Top">
                                <Grid ColumnDefinitions="Auto,*">
                                    <Border Classes="TabHost On">
                                        <StackPanel Orientation="Horizontal">
                                            <StackPanel
                                                Margin="9,0,7,0"
                                                Orientation="Horizontal"
                                                Spacing="7">
                                                <c:Icon
                                                    Drawing="{StaticResource General.User}"
                                                    Height="14"
                                                    VerticalAlignment="Center"
                                                    Width="14" />
                                                <TextBlock Classes="TabTitle" Text="{l:Tr PanelCharacters}" />
                                            </StackPanel>
                                            <Button
                                                Classes="TabClose"
                                                Command="{Binding Layout.CloseCommand}"
                                                CommandParameter="{x:Static studio:StudioPanel.Characters}"
                                                ToolTip.Tip="{l:Tr Close}">
                                                <c:Icon
                                                    Drawing="{StaticResource General.Close}"
                                                    Height="12"
                                                    Width="12" />
                                            </Button>
                                        </StackPanel>
                                    </Border>
                                    <TextBlock
                                        Classes="Dim Figures"
                                        FontSize="11.5"
                                        Grid.Column="1"
                                        HorizontalAlignment="Right"
                                        IsVisible="{Binding !RunBlock.IsNobodyOnline}"
                                        Margin="0,0,6,0"
                                        Text="{Binding OnlineText}"
                                        VerticalAlignment="Center" />
                                </Grid>
                            </Border>
                            <Panel>
                                <views:CharactersView DataContext="{Binding Characters}" IsVisible="{Binding $parent[Window].((vm:MainViewModel)DataContext).IsRunning}" />
                                <views:HostStateView IsVisible="{Binding IsNotRunning}" />
                            </Panel>
                        </DockPanel>
                    </Border>
                    <c:DockSplitter
                        Grid.Row="1"
                        Height="8"
                        IsVisible="{Binding Layout.AreBothLeftOpen}"
                        LineBrush="{DynamicResource AccentColor}"
                        Margin="0,-1.5"
                        Name="ShareSplitter"
                        Orientation="Horizontal"
                        VerticalAlignment="Center" />
                    <Border
                        Classes="Dock"
                        Grid.Row="2"
                        IsVisible="{Binding Layout.IsAssetsOpen}"
                        Name="AssetsDock">
                        <DockPanel>
                            <Border Classes="Strip" DockPanel.Dock="Top">
                                <StackPanel Orientation="Horizontal">
                                    <Border Classes="TabHost On">
                                        <StackPanel Orientation="Horizontal">
                                            <StackPanel
                                                Margin="9,0,7,0"
                                                Orientation="Horizontal"
                                                Spacing="7">
                                                <c:Icon
                                                    Drawing="{StaticResource Nodes.Folder}"
                                                    Height="14"
                                                    VerticalAlignment="Center"
                                                    Width="14" />
                                                <TextBlock Classes="TabTitle" Text="{l:Tr PanelAssets}" />
                                            </StackPanel>
                                            <Button
                                                Classes="TabClose"
                                                Command="{Binding Layout.CloseCommand}"
                                                CommandParameter="{x:Static studio:StudioPanel.Assets}"
                                                ToolTip.Tip="{l:Tr Close}">
                                                <c:Icon
                                                    Drawing="{StaticResource General.Close}"
                                                    Height="12"
                                                    Width="12" />
                                            </Button>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </Border>
                            <StackPanel
                                HorizontalAlignment="Center"
                                Margin="20"
                                MaxWidth="240"
                                Spacing="10"
                                VerticalAlignment="Center">
                                <c:Icon
                                    Drawing="{StaticResource Nodes.Folder}"
                                    Height="20"
                                    HorizontalAlignment="Center"
                                    Opacity="0.6"
                                    Width="20" />
                                <TextBlock
                                    Classes="Dim"
                                    HorizontalAlignment="Center"
                                    Text="{l:Tr AssetsEmpty}"
                                    TextAlignment="Center"
                                    TextWrapping="Wrap" />
                                <Button
                                    Classes="Outline"
                                    Command="{Binding ShowProfilesCommand}"
                                    Content="{l:Tr AssetsOpenProfiles}"
                                    HorizontalAlignment="Center"
                                    Padding="12,0" />
                            </StackPanel>
                        </DockPanel>
                    </Border>
                </Grid>
                <c:DockSplitter
                    Grid.Column="1"
                    HorizontalAlignment="Center"
                    IsVisible="{Binding Layout.IsLeftOpen}"
                    LineBrush="{DynamicResource AccentColor}"
                    Margin="-1.5,0"
                    Name="LeftSplitter"
                    Orientation="Vertical"
                    Width="8" />

                <Grid Grid.Column="2" Name="CentreColumn">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="5" />
                        <RowDefinition Height="260" />
                    </Grid.RowDefinitions>
                    <Border
                        Classes="Dock Recess Focused"
                        Name="EditorDock">
                        <DockPanel>
                            <Border Classes="Strip" DockPanel.Dock="Top">
                                <ItemsControl ItemsSource="{Binding Editor.Items}" VerticalAlignment="Center">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Orientation="Horizontal" Spacing="2" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="studio:EditorTab">
                                            <Border Classes="TabHost" Classes.On="{Binding IsSelected}">
                                                <Grid ColumnDefinitions="*,Auto">
                                                    <Button
                                                        Classes="TabFace"
                                                        Command="{Binding $parent[Window].((vm:MainViewModel)DataContext).Editor.SelectCommand}"
                                                        CommandParameter="{Binding}">
                                                        <StackPanel Orientation="Horizontal" Spacing="7">
                                                            <Image
                                                                Height="14"
                                                                IsVisible="{Binding Icon, Converter={x:Static ObjectConverters.IsNull}}"
                                                                RenderOptions.BitmapInterpolationMode="HighQuality"
                                                                Source="/Assets/d3b.png"
                                                                VerticalAlignment="Center"
                                                                Width="14" />
                                                            <c:Icon
                                                                Drawing="{Binding Icon, Converter={x:Static c:DrawingOf.Instance}}"
                                                                Height="14"
                                                                IsVisible="{Binding !HasPicture}"
                                                                VerticalAlignment="Center"
                                                                Width="14" />
                                                            <c:Portrait
                                                                Head="{Binding Image}"
                                                                Height="16"
                                                                IsVisible="{Binding HasPicture}"
                                                                Radius="4"
                                                                VerticalAlignment="Center"
                                                                Width="16" />
                                                            <TextBlock Classes="TabTitle" Text="{Binding Title}" />
                                                        </StackPanel>
                                                    </Button>
                                                    <Button
                                                        Classes="TabClose"
                                                        Command="{Binding $parent[Window].((vm:MainViewModel)DataContext).Editor.CloseCommand}"
                                                        CommandParameter="{Binding}"
                                                        Grid.Column="1"
                                                        ToolTip.Tip="{l:Tr Close}">
                                                        <c:Icon
                                                            Drawing="{StaticResource General.Close}"
                                                            Height="12"
                                                            Width="12" />
                                                    </Button>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Border>
                            <Panel>
                                <views:WelcomeView IsVisible="{Binding Editor.IsEmpty}" />
                                <ItemsControl ItemsSource="{Binding Editor.Items}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <Panel />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="studio:EditorTab">
                                            <ContentControl
                                                Classes="FadeIn"
                                                Content="{Binding Content}"
                                                IsVisible="{Binding IsSelected}">
                                                <ContentControl.DataTemplates>
                                                    <DataTemplate x:DataType="vm:MainViewModel">
                                                        <views:WelcomeView />
                                                    </DataTemplate>
                                                    <DataTemplate x:DataType="vm:ProfilesViewModel">
                                                        <views:ProfilesView />
                                                    </DataTemplate>
                                                    <DataTemplate x:DataType="ch:CharacterTabViewModel">
                                                        <views:CharacterView />
                                                    </DataTemplate>
                                                    <DataTemplate x:DataType="vm:SettingsViewModel">
                                                        <views:SettingsView />
                                                    </DataTemplate>
                                                    <DataTemplate x:DataType="vm:ModulePageViewModel">
                                                        <ContentControl Content="{Binding Content}">
                                                            <ContentControl.DataTemplates>
                                                                <DataTemplate x:DataType="vm:PageFailureViewModel">
                                                                    <ScrollViewer>
                                                                        <Border
                                                                            Classes="Banner Danger"
                                                                            HorizontalAlignment="Center"
                                                                            Margin="32"
                                                                            MaxWidth="720"
                                                                            VerticalAlignment="Center">
                                                                            <StackPanel Spacing="16">
                                                                                <StackPanel Orientation="Horizontal" Spacing="8">
                                                                                    <c:Icon Drawing="{StaticResource Status.Error}" VerticalAlignment="Center" />
                                                                                    <TextBlock
                                                                                        Classes="Title"
                                                                                        Text="{l:Tr PageFailedTitle}"
                                                                                        VerticalAlignment="Center" />
                                                                                </StackPanel>
                                                                                <Border Classes="Code">
                                                                                    <SelectableTextBlock
                                                                                        Classes="Mono"
                                                                                        Text="{Binding Message}"
                                                                                        TextWrapping="Wrap" />
                                                                                </Border>
                                                                            </StackPanel>
                                                                        </Border>
                                                                    </ScrollViewer>
                                                                </DataTemplate>
                                                            </ContentControl.DataTemplates>
                                                        </ContentControl>
                                                    </DataTemplate>
                                                </ContentControl.DataTemplates>
                                            </ContentControl>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <Border Background="{DynamicResource RecessColor}">
                                    <Border.IsVisible>
                                        <MultiBinding Converter="{x:Static BoolConverters.And}">
                                            <Binding Path="Editor.Selected.NeedsHost" FallbackValue="False" />
                                            <Binding Path="IsNotRunning" />
                                        </MultiBinding>
                                    </Border.IsVisible>
                                    <views:HostStateView />
                                </Border>
                            </Panel>
                        </DockPanel>
                    </Border>
                    <c:DockSplitter
                        Grid.Row="1"
                        Height="8"
                        IsVisible="{Binding Layout.IsBottomOpen}"
                        LineBrush="{DynamicResource AccentColor}"
                        Margin="0,-1.5"
                        Name="BottomSplitter"
                        Orientation="Horizontal"
                        VerticalAlignment="Center" />
                    <Border
                        Classes="Dock Compact"
                        Grid.Row="2"
                        IsVisible="{Binding Layout.IsBottomOpen}"
                        Name="BottomDock">
                        <DockPanel>
                            <Border Classes="Strip" DockPanel.Dock="Top">
                                <Grid ColumnDefinitions="*,Auto">
                                    <StackPanel Orientation="Horizontal" Spacing="2">
                                        <Border Classes="TabHost" Classes.On="{Binding IsJournalShown}">
                                            <Button
                                                Classes="TabFace Plain"
                                                Command="{Binding ShowBottomCommand}"
                                                CommandParameter="{x:Static studio:BottomTab.Journal}">
                                                <StackPanel Orientation="Horizontal" Spacing="7">
                                                    <c:Icon
                                                        Drawing="{StaticResource Toolwindows.Messages}"
                                                        Height="14"
                                                        Width="14" />
                                                    <TextBlock Classes="TabTitle" Text="{l:Tr BottomJournal}" />
                                                </StackPanel>
                                            </Button>
                                        </Border>
                                        <Border Classes="TabHost" Classes.On="{Binding IsTraceShown}">
                                            <Button
                                                Classes="TabFace Plain"
                                                Command="{Binding ShowBottomCommand}"
                                                CommandParameter="{x:Static studio:BottomTab.Trace}">
                                                <StackPanel Orientation="Horizontal" Spacing="7">
                                                    <c:Icon
                                                        Drawing="{StaticResource Toolwindows.Run}"
                                                        Height="14"
                                                        Width="14" />
                                                    <TextBlock Classes="TabTitle" Text="{l:Tr BottomTrace}" />
                                                </StackPanel>
                                            </Button>
                                        </Border>
                                        <Border Classes="TabHost" Classes.On="{Binding IsProblemsShown}">
                                            <Button
                                                Classes="TabFace Plain"
                                                Command="{Binding ShowBottomCommand}"
                                                CommandParameter="{x:Static studio:BottomTab.Problems}">
                                                <StackPanel Orientation="Horizontal" Spacing="7">
                                                    <c:Icon
                                                        Drawing="{StaticResource Toolwindows.Problems}"
                                                        Height="14"
                                                        Width="14" />
                                                    <TextBlock Classes="TabTitle" Text="{l:Tr BottomProblems}" />
                                                </StackPanel>
                                            </Button>
                                        </Border>
                                        <Border Classes="TabHost" Classes.On="{Binding IsProtocolShown}">
                                            <Button
                                                Classes="TabFace Plain"
                                                Command="{Binding ShowBottomCommand}"
                                                CommandParameter="{x:Static studio:BottomTab.Protocol}">
                                                <StackPanel Orientation="Horizontal" Spacing="7">
                                                    <c:Icon
                                                        Drawing="{StaticResource Toolwindows.Web}"
                                                        Height="14"
                                                        Width="14" />
                                                    <TextBlock Classes="TabTitle" Text="{l:Tr BottomProtocol}" />
                                                </StackPanel>
                                            </Button>
                                        </Border>
                                        <Border Classes="TabHost" Classes.On="{Binding IsStatisticsShown}">
                                            <Button
                                                Classes="TabFace Plain"
                                                Command="{Binding ShowBottomCommand}"
                                                CommandParameter="{x:Static studio:BottomTab.Statistics}">
                                                <StackPanel Orientation="Horizontal" Spacing="7">
                                                    <c:Icon
                                                        Drawing="{StaticResource Toolwindows.Profiler}"
                                                        Height="14"
                                                        Width="14" />
                                                    <TextBlock Classes="TabTitle" Text="{l:Tr BottomStatistics}" />
                                                </StackPanel>
                                            </Button>
                                        </Border>
                                    </StackPanel>
                                    <Button
                                        Classes="Tool Small"
                                        Command="{Binding Layout.CloseCommand}"
                                        CommandParameter="{x:Static studio:StudioPanel.Bottom}"
                                        Grid.Column="1"
                                        VerticalAlignment="Center">
                                        <ToolTip.Tip>
                                            <c:KeyTip Keys="Ctrl J" Text="{l:Tr Close}" />
                                        </ToolTip.Tip>
                                        <c:Icon
                                            Drawing="{StaticResource General.Close}"
                                            Height="12"
                                            Width="12" />
                                    </Button>
                                </Grid>
                            </Border>
                            <Panel>
                                <views:LogsView DataContext="{Binding Logs}" IsVisible="{Binding $parent[Window].((vm:MainViewModel)DataContext).IsJournalShown}" />
                                <views:InspectorView DataContext="{Binding Inspector}" IsVisible="{Binding $parent[Window].((vm:MainViewModel)DataContext).IsProtocolShown}" />
                                <views:StatisticsView DataContext="{Binding Statistics}" IsVisible="{Binding $parent[Window].((vm:MainViewModel)DataContext).IsStatisticsShown}" />
                                <StackPanel
                                    HorizontalAlignment="Center"
                                    IsVisible="{Binding IsTraceShown}"
                                    MaxWidth="320"
                                    Spacing="6"
                                    VerticalAlignment="Center">
                                    <TextBlock
                                        Classes="Muted"
                                        HorizontalAlignment="Center"
                                        Text="{l:Tr TraceEmptyTitle}" />
                                    <TextBlock
                                        Classes="Dim"
                                        HorizontalAlignment="Center"
                                        Text="{l:Tr TraceEmptyText}"
                                        TextAlignment="Center"
                                        TextWrapping="Wrap" />
                                </StackPanel>
                                <StackPanel
                                    HorizontalAlignment="Center"
                                    IsVisible="{Binding IsProblemsShown}"
                                    Orientation="Horizontal"
                                    Spacing="8"
                                    VerticalAlignment="Center">
                                    <c:Icon Drawing="{StaticResource Status.Success}" VerticalAlignment="Center" />
                                    <TextBlock
                                        Classes="Muted"
                                        Text="{l:Tr ProblemsEmpty}"
                                        VerticalAlignment="Center" />
                                </StackPanel>
                                <Border Background="{DynamicResource PanelColor}">
                                    <Border.IsVisible>
                                        <MultiBinding Converter="{x:Static BoolConverters.And}">
                                            <Binding Path="IsNotRunning" />
                                            <MultiBinding Converter="{x:Static BoolConverters.Or}">
                                                <Binding Path="IsJournalShown" />
                                                <Binding Path="IsProtocolShown" />
                                                <Binding Path="IsStatisticsShown" />
                                            </MultiBinding>
                                        </MultiBinding>
                                    </Border.IsVisible>
                                    <views:HostStateView />
                                </Border>
                            </Panel>
                        </DockPanel>
                    </Border>
                </Grid>
                <c:DockSplitter
                    Grid.Column="3"
                    HorizontalAlignment="Center"
                    IsVisible="{Binding Layout.IsInspectorOpen}"
                    LineBrush="{DynamicResource AccentColor}"
                    Margin="-1.5,0"
                    Name="RightSplitter"
                    Orientation="Vertical"
                    Width="8" />

                <Border
                    Classes="Dock"
                    Grid.Column="4"
                    IsVisible="{Binding Layout.IsInspectorOpen}"
                    Name="InspectorDock">
                    <DockPanel>
                        <Border Classes="Strip" DockPanel.Dock="Top">
                            <StackPanel Orientation="Horizontal">
                                <Border Classes="TabHost On">
                                    <StackPanel Orientation="Horizontal">
                                        <StackPanel
                                            Margin="9,0,7,0"
                                            Orientation="Horizontal"
                                            Spacing="7">
                                            <c:Icon
                                                Drawing="{StaticResource Toolwindows.Structure}"
                                                Height="14"
                                                VerticalAlignment="Center"
                                                Width="14" />
                                            <TextBlock Classes="TabTitle" Text="{l:Tr PanelInspector}" />
                                        </StackPanel>
                                        <Button
                                            Classes="TabClose"
                                            Command="{Binding Layout.CloseCommand}"
                                            CommandParameter="{x:Static studio:StudioPanel.Inspector}"
                                            ToolTip.Tip="{l:Tr Close}">
                                            <c:Icon
                                                Drawing="{StaticResource General.Close}"
                                                Height="12"
                                                Width="12" />
                                        </Button>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Border>
                        <Border
                            DockPanel.Dock="Top"
                            IsVisible="{Binding !Properties.IsEmpty}"
                            Padding="6,6,6,2">
                            <TextBox
                                Classes="PropertySearch"
                                Text="{Binding Properties.Filter}"
                                Watermark="{l:Tr InspectorSearch}">
                                <TextBox.InnerLeftContent>
                                    <c:Icon
                                        Drawing="{StaticResource General.Search}"
                                        Height="14"
                                        Margin="8,0,0,0"
                                        Width="14" />
                                </TextBox.InnerLeftContent>
                            </TextBox>
                        </Border>
                        <views:PropertiesView DataContext="{Binding Properties}" />
                    </DockPanel>
                </Border>
            </Grid>

            <Grid
                ColumnDefinitions="*,Auto"
                Grid.Row="1"
                Margin="5,0">
                <StackPanel
                    Grid.Column="1"
                    Orientation="Horizontal"
                    Spacing="4"
                    VerticalAlignment="Center">
                    <Button
                        Classes="Status Accent"
                        Command="{Binding Updates.RestartCommand}"
                        IsVisible="{Binding Updates.IsReady}"
                        ToolTip.Tip="{Binding Updates.ReadyText}">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <c:Icon
                                Drawing="{StaticResource General.IdeUpdate}"
                                Height="14"
                                Width="14" />
                            <TextBlock Text="{l:Tr UpdateRestart}" />
                        </StackPanel>
                    </Button>
                    <Button Classes="Status" ToolTip.Tip="{Binding HostDetail}">
                        <StackPanel Orientation="Horizontal" Spacing="7">
                            <Panel VerticalAlignment="Center">
                                <Border Classes="Glow" IsVisible="{Binding IsRunning}" />
                                <Ellipse
                                    Classes="HostDot"
                                    Classes.Failed="{Binding IsFailed}"
                                    Classes.Running="{Binding IsRunning}"
                                    Classes.Starting="{Binding IsStarting}"
                                    Classes.Stopping="{Binding IsStopping}"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center" />
                            </Panel>
                            <TextBlock Text="{Binding HostTitle}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button Classes="Status" Content="{Binding ClientText}" />
                    <Button Classes="Status">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <c:Icon
                                Drawing="{StaticResource Status.Success}"
                                Height="14"
                                IsVisible="{Binding IsSaved}"
                                Width="14" />
                            <c:Icon
                                Drawing="{StaticResource Status.Warning}"
                                Height="14"
                                IsVisible="{Binding !IsSaved}"
                                Width="14" />
                            <TextBlock Text="{l:Tr StatusSaved}" IsVisible="{Binding IsSaved}" />
                            <TextBlock Text="{l:Tr StatusUnsaved}" IsVisible="{Binding !IsSaved}" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Grid>

        <Panel IsVisible="{Binding Search.IsOpen}">
            <Border Background="#8C050507" PointerPressed="OnScrimPressed" />
            <views:SearchView DataContext="{Binding Search}" />
        </Panel>
    </Panel>
</shadui:Window>
