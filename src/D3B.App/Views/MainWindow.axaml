<shadui:Window
    x:Class="D3B.App.Views.MainWindow"
    x:ClassModifier="internal"
    x:DataType="vm:MainViewModel"
    FontSize="12.5"
    Icon="/Assets/d3b.ico"
    Title="D3B"
    Width="1440"
    Height="900"
    MinWidth="960"
    MinHeight="600"
    WindowStartupLocation="CenterScreen"
    xmlns="https://github.com/avaloniaui"
    xmlns:c="clr-namespace:D3B.App.Controls"
    xmlns:l="clr-namespace:D3B.App.Localization"
    xmlns:ch="clr-namespace:D3B.App.ViewModels.Characters"
    xmlns:routes="clr-namespace:D3B.App.ViewModels.Routes"
    xmlns:world="clr-namespace:D3B.App.ViewModels.World"
    xmlns:zones="clr-namespace:D3B.App.ViewModels.Zones"
    xmlns:sequences="clr-namespace:D3B.App.ViewModels.Sequences"
    xmlns:shadui="clr-namespace:ShadUI;assembly=ShadUI"
    xmlns:statistics="clr-namespace:D3B.App.ViewModels.Statistics"
    xmlns:studio="clr-namespace:D3B.App.ViewModels.Studio"
    xmlns:views="clr-namespace:D3B.App.Views"
    xmlns:vm="clr-namespace:D3B.App.ViewModels"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <shadui:Window.KeyBindings>
        <KeyBinding Command="{Binding Search.OpenCommand}" Gesture="Ctrl+K" />
        <KeyBinding Command="{Binding ShowCommandPaletteCommand}" Gesture="Ctrl+Shift+P" />
        <KeyBinding Command="{Binding ToggleBottomCommand}" Gesture="Ctrl+J" />
        <KeyBinding
            Command="{Binding Layout.ToggleCommand}"
            CommandParameter="{x:Static studio:StudioPanel.Side}"
            Gesture="Ctrl+B" />
        <KeyBinding
            Command="{Binding Layout.ToggleCommand}"
            CommandParameter="{x:Static studio:StudioPanel.Details}"
            Gesture="Ctrl+Alt+B" />
        <KeyBinding Command="{Binding GoToAssetsCommand}" Gesture="Ctrl+Space" />
        <KeyBinding Command="{Binding ShowSettingsCommand}" Gesture="Ctrl+OemComma" />
        <KeyBinding Command="{Binding NewProfileCommand}" Gesture="Ctrl+N" />
        <KeyBinding Command="{Binding SaveAllCommand}" Gesture="Ctrl+S" />
        <KeyBinding Command="{Binding UndoCommand}" Gesture="Ctrl+Z" />
        <KeyBinding Command="{Binding RedoCommand}" Gesture="Ctrl+Y" />
        <KeyBinding Command="{Binding RedoCommand}" Gesture="Ctrl+Shift+Z" />
        <KeyBinding Command="{Binding ShowShortcutsCommand}" Gesture="Ctrl+OemQuestion" />
        <KeyBinding Command="{Binding RunBlock.PlayOrPauseCommand}" Gesture="F5" />
        <KeyBinding Command="{Binding RunBlock.PauseCommand}" Gesture="F6" />
        <KeyBinding Command="{Binding RunBlock.StopCommand}" Gesture="Shift+F5" />
    </shadui:Window.KeyBindings>
    <shadui:Window.Styles>
        <Style Selector="Button.Tool.Lit">
            <Setter Property="Background" Value="{DynamicResource AccentSoftColor}" />
        </Style>
        <Style Selector="Button.Tool.Toggle.Lit">
            <Setter Property="Background" Value="{DynamicResource RaisedColor}" />
            <Setter Property="Foreground" Value="{DynamicResource BrightColor}" />
        </Style>
        <Style Selector="TextBox.PropertySearch">
            <Setter Property="Height" Value="28" />
            <Setter Property="MinHeight" Value="28" />
            <Setter Property="CornerRadius" Value="7" />
            <Setter Property="Background" Value="{DynamicResource InputColor}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderColor}" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style Selector="FlyoutPresenter.Bare">
            <Setter Property="Background" Value="{DynamicResource ClearColor}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="MaxWidth" Value="400" />
        </Style>
        <Style Selector="Ellipse.HostDot">
            <Setter Property="Width" Value="7" />
            <Setter Property="Height" Value="7" />
            <Setter Property="Fill" Value="{DynamicResource DimColor}" />
        </Style>
        <Style Selector="Ellipse.HostDot.Running">
            <Setter Property="Fill" Value="{DynamicResource PlayingColor}" />
        </Style>
        <Style Selector="Ellipse.HostDot.Starting">
            <Setter Property="Fill" Value="{DynamicResource AccentColor}" />
        </Style>
        <Style Selector="Ellipse.HostDot.Stopping">
            <Setter Property="Fill" Value="{DynamicResource PausedColor}" />
        </Style>
        <Style Selector="Ellipse.HostDot.Failed">
            <Setter Property="Fill" Value="{DynamicResource ErrorColor}" />
        </Style>
    </shadui:Window.Styles>

    <shadui:Window.LogoContent>
        <StackPanel Margin="10,0,0,0" Orientation="Horizontal">
            <Button
                AutomationProperties.Name="{l:Tr Home}"
                Classes="Tool"
                Command="{Binding ShowHomeCommand}"
                Margin="0,0,2,0"
                Padding="3"
                ToolTip.Tip="{l:Tr Home}"
                VerticalAlignment="Center">
                <Image
                    Height="22"
                    RenderOptions.BitmapInterpolationMode="HighQuality"
                    Source="/Assets/d3b.png"
                    Width="22" />
            </Button>
            <Menu Theme="{StaticResource TitleMenu}" VerticalAlignment="Center">
                <MenuItem Header="{l:Tr MenuFile}">
                    <MenuItem
                        Command="{Binding NewProfileCommand}"
                        Header="{l:Tr CommandNewProfile}"
                        Tag="Ctrl N" />
                    <MenuItem
                        Command="{Binding SaveAllCommand}"
                        Header="{l:Tr CommandSaveAll}"
                        Tag="Ctrl S" />
                    <Separator />
                    <MenuItem Command="{Binding OpenProjectFolderCommand}" Header="{l:Tr CommandProjectFolder}" />
                    <Separator />
                    <MenuItem Command="{Binding QuitCommand}" Header="{l:Tr MenuQuit}" />
                </MenuItem>
                <MenuItem Header="{l:Tr MenuEdit}">
                    <MenuItem
                        Command="{Binding UndoCommand}"
                        Header="{l:Tr MenuUndo}"
                        Tag="Ctrl Z" />
                    <MenuItem
                        Command="{Binding RedoCommand}"
                        Header="{l:Tr MenuRedo}"
                        Tag="Ctrl Y" />
                    <Separator />
                    <MenuItem
                        Command="{Binding ShowSettingsCommand}"
                        Header="{l:Tr Settings}"
                        Tag="Ctrl ," />
                </MenuItem>
                <MenuItem Header="{l:Tr MenuView}">
                    <MenuItem Command="{Binding ShowHomeCommand}" Header="{l:Tr Home}" />
                    <MenuItem
                        Command="{Binding ShowStatisticsCommand}"
                        Header="{l:Tr ActivityStatistics}"
                        IsChecked="{Binding IsStatisticsShown, Mode=OneWay}" />
                    <Separator />
                    <MenuItem Classes="Heading" Header="{l:Tr MenuViews}" />
                    <MenuItem
                        Command="{Binding Layout.ShowViewCommand}"
                        CommandParameter="{x:Static studio:SideView.Characters}"
                        Header="{l:Tr ViewCharacters}"
                        IsChecked="{Binding Layout.IsCharactersShown, Mode=OneWay}" />
                    <MenuItem
                        Command="{Binding Layout.ShowViewCommand}"
                        CommandParameter="{x:Static studio:SideView.Library}"
                        Header="{l:Tr ViewLibrary}"
                        IsChecked="{Binding Layout.IsLibraryShown, Mode=OneWay}"
                        Tag="{l:Tr KeysCtrlSpace}" />
                    <MenuItem
                        Command="{Binding Layout.ShowViewCommand}"
                        CommandParameter="{x:Static studio:SideView.World}"
                        Header="{l:Tr ViewWorld}"
                        IsChecked="{Binding Layout.IsWorldShown, Mode=OneWay}" />
                    <Separator />
                    <MenuItem Classes="Heading" Header="{l:Tr MenuPanels}" />
                    <MenuItem
                        Command="{Binding Layout.ToggleCommand}"
                        CommandParameter="{x:Static studio:StudioPanel.Side}"
                        Header="{l:Tr PanelSide}"
                        IsChecked="{Binding Layout.IsSideOpen, Mode=OneWay}"
                        Tag="Ctrl B" />
                    <MenuItem
                        Command="{Binding Layout.ToggleCommand}"
                        CommandParameter="{x:Static studio:StudioPanel.Bottom}"
                        Header="{l:Tr PanelBottom}"
                        IsChecked="{Binding Layout.IsBottomOpen, Mode=OneWay}"
                        Tag="Ctrl J" />
                    <MenuItem
                        Command="{Binding Layout.ToggleCommand}"
                        CommandParameter="{x:Static studio:StudioPanel.Details}"
                        Header="{l:Tr PanelDetails}"
                        IsChecked="{Binding Layout.IsDetailsOpen, Mode=OneWay}"
                        Tag="Ctrl Alt B" />
                    <Separator />
                    <MenuItem
                        Command="{Binding Layout.ToggleAdvancedToolsCommand}"
                        Header="{l:Tr AdvancedTools}"
                        IsChecked="{Binding Layout.AdvancedTools, Mode=OneWay}" />
                    <MenuItem
                        Header="{l:Tr MenuModules}"
                        IsVisible="{Binding HasPages}"
                        ItemsSource="{Binding Pages}">
                        <MenuItem.ItemContainerTheme>
                            <ControlTheme BasedOn="{StaticResource {x:Type MenuItem}}" TargetType="MenuItem" x:DataType="vm:ModulePageViewModel">
                                <Setter Property="Header" Value="{Binding Title}" />
                                <Setter Property="Command" Value="{Binding ShowCommand}" />
                            </ControlTheme>
                        </MenuItem.ItemContainerTheme>
                    </MenuItem>
                    <Separator />
                    <MenuItem Command="{Binding Layout.ResetCommand}" Header="{l:Tr CommandDefaultLayout}" />
                </MenuItem>
                <MenuItem Header="{l:Tr MenuHelp}">
                    <MenuItem
                        Command="{Binding ShowShortcutsCommand}"
                        Header="{l:Tr MenuShortcuts}"
                        Tag="Ctrl /" />
                    <MenuItem Command="{Binding ShowReportCommand}" Header="{l:Tr MenuReport}" />
                    <MenuItem Command="{Binding ShowSettingsCommand}" Header="{l:Tr MenuAbout}" />
                </MenuItem>
            </Menu>
        </StackPanel>
    </shadui:Window.LogoContent>

    <shadui:Window.MenuBarContent>
        <!--  next's command centre (D540): the search's glyph and the app's name, centred; Ctrl K searches, Ctrl Shift P the commands.  -->
        <Button
            AutomationProperties.Name="{l:Tr CommandCentre}"
            Classes="TitleSearch"
            Command="{Binding Search.OpenCommand}">
            <ToolTip.Tip>
                <c:KeyTip Keys="Ctrl K" Text="{l:Tr CommandCentre}" />
            </ToolTip.Tip>
            <StackPanel Orientation="Horizontal" Spacing="6">
                <c:Icon
                    Drawing="{StaticResource General.Search}"
                    Height="14"
                    Opacity="0.8"
                    VerticalAlignment="Center"
                    Width="14" />
                <TextBlock Text="D3B" VerticalAlignment="Center" />
            </StackPanel>
        </Button>
    </shadui:Window.MenuBarContent>

    <shadui:Window.RightWindowTitleBarContent>
        <!--  next's layout toggles (D531): the side bar, the bottom panel, the Details, each pressed while it shows.  -->
        <StackPanel
            Name="LayoutToggles"
            Orientation="Horizontal"
            Spacing="2"
            VerticalAlignment="Center">
            <Button
                AutomationProperties.Name="{l:Tr PanelSide}"
                Classes="Tool Small Toggle"
                Classes.Lit="{Binding Layout.IsSideOpen}"
                Command="{Binding Layout.ToggleCommand}"
                CommandParameter="{x:Static studio:StudioPanel.Side}">
                <ToolTip.Tip>
                    <c:KeyTip Keys="Ctrl B" Text="{l:Tr PanelSide}" />
                </ToolTip.Tip>
                <c:Icon Drawing="{StaticResource Layout.PanelLeft}" />
            </Button>
            <Button
                AutomationProperties.Name="{l:Tr PanelBottom}"
                Classes="Tool Small Toggle"
                Classes.Lit="{Binding Layout.IsBottomOpen}"
                Command="{Binding ToggleBottomCommand}">
                <ToolTip.Tip>
                    <c:KeyTip Keys="Ctrl J" Text="{l:Tr PanelBottom}" />
                </ToolTip.Tip>
                <c:Icon Drawing="{StaticResource Layout.PanelBottom}" />
            </Button>
            <Button
                AutomationProperties.Name="{l:Tr PanelDetails}"
                Classes="Tool Small Toggle"
                Classes.Lit="{Binding Layout.IsDetailsOpen}"
                Command="{Binding Layout.ToggleCommand}"
                CommandParameter="{x:Static studio:StudioPanel.Details}">
                <ToolTip.Tip>
                    <c:KeyTip Keys="Ctrl Alt B" Text="{l:Tr PanelDetails}" />
                </ToolTip.Tip>
                <c:Icon Drawing="{StaticResource Layout.PanelRight}" />
            </Button>
        </StackPanel>
    </shadui:Window.RightWindowTitleBarContent>

    <shadui:Window.Hosts>
        <shadui:DialogHost Name="DialogHost" />
        <shadui:ToastHost Name="ToastHost" Position="BottomRight" />
    </shadui:Window.Hosts>

    <Panel>
        <Grid RowDefinitions="*,24">
            <Grid ColumnDefinitions="Auto,*">
                <!--  The activity bar (D513, D531): the side bar's views, as next's, and the settings at its foot as VS Code's Manage.  -->
                <DockPanel
                    Margin="4,0,5,0"
                    Name="ActivityBar"
                    Width="36">
                    <StackPanel DockPanel.Dock="Bottom" Spacing="4">
                        <Button
                            AutomationProperties.Name="{l:Tr Settings}"
                            Classes="Activity"
                            Command="{Binding ShowSettingsCommand}"
                            Margin="0,0,0,4">
                            <ToolTip.Tip>
                                <c:KeyTip Keys="Ctrl ," Text="{l:Tr Settings}" />
                            </ToolTip.Tip>
                            <c:Icon Drawing="{StaticResource General.Settings}" />
                        </Button>
                    </StackPanel>
                    <StackPanel Spacing="4">
                        <Button
                            AutomationProperties.Name="{l:Tr ViewCharacters}"
                            Classes="Activity"
                            Classes.On="{Binding Layout.IsCharactersShown}"
                            Command="{Binding Layout.ShowViewCommand}"
                            CommandParameter="{x:Static studio:SideView.Characters}"
                            ToolTip.Tip="{l:Tr ViewCharacters}">
                            <c:Icon Drawing="{StaticResource General.User}" />
                        </Button>
                        <Button
                            AutomationProperties.Name="{l:Tr ViewLibrary}"
                            Classes="Activity"
                            Classes.On="{Binding Layout.IsLibraryShown}"
                            Command="{Binding Layout.ShowViewCommand}"
                            CommandParameter="{x:Static studio:SideView.Library}">
                            <ToolTip.Tip>
                                <c:KeyTip Keys="{l:Tr KeysCtrlSpace}" Text="{l:Tr ViewLibrary}" />
                            </ToolTip.Tip>
                            <c:Icon Drawing="{StaticResource Toolwindows.Project}" />
                        </Button>
                        <Button
                            AutomationProperties.Name="{l:Tr ViewWorld}"
                            Classes="Activity"
                            Classes.On="{Binding Layout.IsWorldShown}"
                            Command="{Binding Layout.ShowViewCommand}"
                            CommandParameter="{x:Static studio:SideView.World}"
                            ToolTip.Tip="{l:Tr ViewWorld}">
                            <c:Icon Drawing="{StaticResource Toolwindows.Web}" />
                        </Button>
                    </StackPanel>
                </DockPanel>
            <Grid
                Grid.Column="1"
                Margin="0,0,5,0"
                Name="Docks">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="300" />
                    <ColumnDefinition Width="5" />
                    <ColumnDefinition MinWidth="320" Width="*" />
                    <ColumnDefinition Width="5" />
                    <ColumnDefinition Width="340" />
                </Grid.ColumnDefinitions>

                <!--  The side bar (D513): one view at a time, the one the activity bar chose, its header naming it.  -->
                <Border
                    Classes="Dock Compact"
                    IsVisible="{Binding Layout.IsSideOpen}"
                    Name="SideDock">
                    <DockPanel>
                        <Border Classes="Strip" DockPanel.Dock="Top">
                            <DockPanel LastChildFill="False">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock
                                        Classes="PartTitle"
                                        IsVisible="{Binding Layout.IsCharactersShown}"
                                        Text="{l:Tr ViewCharacters}" />
                                    <TextBlock
                                        Classes="PartTitle"
                                        IsVisible="{Binding Layout.IsLibraryShown}"
                                        Text="{l:Tr ViewLibrary}" />
                                    <TextBlock
                                        Classes="PartTitle"
                                        IsVisible="{Binding Layout.IsWorldShown}"
                                        Text="{l:Tr ViewWorld}" />
                                </StackPanel>
                                <Button
                                    AutomationProperties.Name="{l:Tr Hide}"
                                    Classes="Tool Small"
                                    Command="{Binding Layout.CloseCommand}"
                                    CommandParameter="{x:Static studio:StudioPanel.Side}"
                                    DockPanel.Dock="Right"
                                    Margin="0,0,4,0"
                                    VerticalAlignment="Center">
                                    <ToolTip.Tip>
                                        <c:KeyTip Keys="Ctrl B" Text="{l:Tr Hide}" />
                                    </ToolTip.Tip>
                                    <c:Icon
                                        Drawing="{StaticResource General.Close}"
                                        Height="12"
                                        Width="12" />
                                </Button>
                                <TextBlock
                                    Classes="Dim Figures"
                                    DockPanel.Dock="Right"
                                    FontSize="11.5"
                                    Margin="0,0,6,0"
                                    Text="{Binding OnlineText}"
                                    VerticalAlignment="Center">
                                    <TextBlock.IsVisible>
                                        <MultiBinding Converter="{x:Static BoolConverters.And}">
                                            <Binding Path="Layout.IsCharactersShown" />
                                            <Binding Path="!RunBlock.IsNobodyOnline" />
                                        </MultiBinding>
                                    </TextBlock.IsVisible>
                                </TextBlock>
                                <StackPanel
                                    DockPanel.Dock="Right"
                                    IsVisible="{Binding Layout.IsWorldShown}"
                                    Margin="0,0,6,0"
                                    Orientation="Horizontal"
                                    Spacing="2"
                                    VerticalAlignment="Center">
                                    <Button
                                        AutomationProperties.Name="{l:Tr HomeNewRoute}"
                                        Classes="Tool Small"
                                        Command="{Binding Home.NewRouteCommand}"
                                        IsEnabled="{Binding IsRunning}"
                                        Name="WorldNewRoute"
                                        ToolTip.Tip="{l:Tr HomeNewRoute}">
                                        <c:Icon Drawing="{StaticResource General.Vcs}" />
                                    </Button>
                                    <Button
                                        AutomationProperties.Name="{l:Tr HomeNewZone}"
                                        Classes="Tool Small"
                                        Command="{Binding Home.NewZoneCommand}"
                                        IsEnabled="{Binding IsRunning}"
                                        Name="WorldNewZone"
                                        ToolTip.Tip="{l:Tr HomeNewZone}">
                                        <c:Icon Drawing="{StaticResource Actions.SelectAll}" />
                                    </Button>
                                </StackPanel>
                                <StackPanel
                                    DockPanel.Dock="Right"
                                    IsVisible="{Binding Layout.IsLibraryShown}"
                                    Margin="0,0,6,0"
                                    Orientation="Horizontal"
                                    Spacing="2"
                                    VerticalAlignment="Center">
                                    <Button
                                        AutomationProperties.Name="{l:Tr LibraryByFolder}"
                                        Classes="Tool Small"
                                        Classes.Lit="{Binding !Assets.IsByKind}"
                                        Command="{Binding Assets.ToggleByKindCommand}"
                                        IsEnabled="{Binding Assets.IsAvailable}"
                                        ToolTip.Tip="{l:Tr LibraryByFolder}">
                                        <c:Icon Drawing="{StaticResource Nodes.Folder}" />
                                    </Button>
                                    <Button
                                        AutomationProperties.Name="{l:Tr KindsShown}"
                                        Classes="Tool Small"
                                        Classes.Lit="{Binding Assets.IsFiltered}"
                                        Click="OnAssetsFilterClick"
                                        IsEnabled="{Binding Assets.IsAvailable}"
                                        ToolTip.Tip="{l:Tr KindsShown}">
                                        <c:Icon Drawing="{StaticResource General.Filter}" />
                                    </Button>
                                    <Button
                                        AutomationProperties.Name="{l:Tr LocateTab}"
                                        Classes="Tool Small"
                                        Command="{Binding Assets.LocateOpenCommand}"
                                        IsEnabled="{Binding Assets.IsAvailable}"
                                        ToolTip.Tip="{l:Tr LocateTab}">
                                        <c:Icon Drawing="{StaticResource General.Locate}" />
                                    </Button>
                                    <Button
                                        AutomationProperties.Name="{l:Tr CollapseAll}"
                                        Classes="Tool Small"
                                        Command="{Binding Assets.CollapseAllCommand}"
                                        IsEnabled="{Binding Assets.IsAvailable}"
                                        ToolTip.Tip="{l:Tr CollapseAll}">
                                        <c:Icon Drawing="{StaticResource General.CollapseAll}" />
                                    </Button>
                                </StackPanel>
                            </DockPanel>
                        </Border>
                        <Panel>
                            <Panel IsVisible="{Binding !Layout.IsLibraryShown}">
                                <views:OutlinerView DataContext="{Binding Outliner}" IsVisible="{Binding $parent[Window].((vm:MainViewModel)DataContext).IsRunning}" />
                                <views:HostStateView IsVisible="{Binding IsNotRunning}" />
                            </Panel>
                            <views:AssetsView
                                DataContext="{Binding Assets}"
                                IsVisible="{Binding $parent[Window].((vm:MainViewModel)DataContext).Layout.IsLibraryShown}"
                                Name="AssetsPanel" />
                        </Panel>
                    </DockPanel>
                </Border>
                <c:DockSplitter
                    Grid.Column="1"
                    HorizontalAlignment="Center"
                    IsVisible="{Binding Layout.IsSideOpen}"
                    LineBrush="{DynamicResource AccentColor}"
                    Margin="-1.5,0"
                    Name="LeftSplitter"
                    Orientation="Vertical"
                    Width="8" />

                <Grid Grid.Column="2" Name="CentreColumn">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="5" />
                        <RowDefinition Height="260" />
                    </Grid.RowDefinitions>
                    <!--  The editor area as next's (D531): the tabs lie on the window's frame, the one shown rises into the editor's island
                         with rounded top corners; with no tab, the island shows the mark and the main keys.  -->
                    <DockPanel Name="EditorArea">
                            <Border Classes="EditorStrip" DockPanel.Dock="Top">
                                <ItemsControl ItemsSource="{Binding Editor.Items}" VerticalAlignment="Bottom">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Orientation="Horizontal" Spacing="2" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="studio:EditorTab">
                                            <Border Classes="TabHost EditorTabHost" Classes.On="{Binding IsSelected}">
                                                <Grid ColumnDefinitions="*,Auto">
                                                    <Button
                                                        Classes="TabFace"
                                                        Classes.Plain="{Binding IsPinned}"
                                                        Command="{Binding $parent[Window].((vm:MainViewModel)DataContext).Editor.SelectCommand}"
                                                        CommandParameter="{Binding}">
                                                        <StackPanel Orientation="Horizontal" Spacing="7">
                                                            <Image
                                                                Height="14"
                                                                IsVisible="{Binding Icon, Converter={x:Static ObjectConverters.IsNull}}"
                                                                RenderOptions.BitmapInterpolationMode="HighQuality"
                                                                Source="/Assets/d3b.png"
                                                                VerticalAlignment="Center"
                                                                Width="14" />
                                                            <c:Icon
                                                                Drawing="{Binding Icon, Converter={x:Static c:DrawingOf.Instance}}"
                                                                Height="14"
                                                                IsVisible="{Binding !HasPicture}"
                                                                VerticalAlignment="Center"
                                                                Width="14" />
                                                            <c:Portrait
                                                                Head="{Binding Image}"
                                                                Height="16"
                                                                IsVisible="{Binding HasPicture}"
                                                                Radius="4"
                                                                VerticalAlignment="Center"
                                                                Width="16" />
                                                            <TextBlock Classes="TabTitle" Text="{Binding Title}" />
                                                            <Ellipse
                                                                Fill="{DynamicResource PausedColor}"
                                                                Height="6"
                                                                IsVisible="{Binding IsModified}"
                                                                ToolTip.Tip="{l:Tr UnsavedChanges}"
                                                                VerticalAlignment="Center"
                                                                Width="6" />
                                                        </StackPanel>
                                                    </Button>
                                                    <Button
                                                        Classes="TabClose"
                                                        Command="{Binding $parent[Window].((vm:MainViewModel)DataContext).Editor.CloseCommand}"
                                                        CommandParameter="{Binding}"
                                                        Grid.Column="1"
                                                        IsVisible="{Binding !IsPinned}"
                                                        ToolTip.Tip="{l:Tr Close}">
                                                        <c:Icon
                                                            Drawing="{StaticResource General.Close}"
                                                            Height="12"
                                                            Width="12" />
                                                    </Button>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Border>
                            <Border
                                Classes="Dock Recess"
                                Name="EditorDock">
                            <Panel>
                                <ItemsControl ItemsSource="{Binding Editor.Items}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <Panel />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="studio:EditorTab">
                                            <ContentControl
                                                Classes="FadeIn"
                                                Content="{Binding Content}"
                                                IsVisible="{Binding IsSelected}">
                                                <ContentControl.DataTemplates>
                                                    <DataTemplate x:DataType="vm:MainViewModel">
                                                        <views:HomeView />
                                                    </DataTemplate>
                                                    <DataTemplate x:DataType="vm:ProfileViewModel">
                                                        <views:ProfileView />
                                                    </DataTemplate>
                                                    <DataTemplate x:DataType="world:WorldViewportViewModel">
                                                        <views:WorldView />
                                                    </DataTemplate>
                                                    <DataTemplate x:DataType="sequences:SequenceEditorViewModel">
                                                        <views:SequenceView />
                                                    </DataTemplate>
                                                    <DataTemplate x:DataType="ch:CharacterTabViewModel">
                                                        <views:CharacterView />
                                                    </DataTemplate>
                                                    <DataTemplate x:DataType="vm:SettingsViewModel">
                                                        <views:SettingsView />
                                                    </DataTemplate>
                                                    <DataTemplate x:DataType="statistics:StatisticsViewModel">
                                                        <views:StatisticsView />
                                                    </DataTemplate>
                                                    <DataTemplate x:DataType="vm:ModulePageViewModel">
                                                        <ContentControl Content="{Binding Content}">
                                                            <ContentControl.DataTemplates>
                                                                <DataTemplate x:DataType="vm:PageFailureViewModel">
                                                                    <ScrollViewer>
                                                                        <Border
                                                                            Classes="Banner Danger"
                                                                            HorizontalAlignment="Center"
                                                                            Margin="32"
                                                                            MaxWidth="720"
                                                                            VerticalAlignment="Center">
                                                                            <StackPanel Spacing="16">
                                                                                <StackPanel Orientation="Horizontal" Spacing="8">
                                                                                    <c:Icon Drawing="{StaticResource Status.Error}" VerticalAlignment="Center" />
                                                                                    <TextBlock
                                                                                        Classes="Title"
                                                                                        Text="{l:Tr PageFailedTitle}"
                                                                                        VerticalAlignment="Center" />
                                                                                </StackPanel>
                                                                                <Border Classes="Code">
                                                                                    <SelectableTextBlock
                                                                                        Classes="Mono"
                                                                                        Text="{Binding Message}"
                                                                                        TextWrapping="Wrap" />
                                                                                </Border>
                                                                            </StackPanel>
                                                                        </Border>
                                                                    </ScrollViewer>
                                                                </DataTemplate>
                                                            </ContentControl.DataTemplates>
                                                        </ContentControl>
                                                    </DataTemplate>
                                                </ContentControl.DataTemplates>
                                            </ContentControl>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <Border Background="{DynamicResource RecessColor}">
                                    <Border.IsVisible>
                                        <MultiBinding Converter="{x:Static BoolConverters.And}">
                                            <Binding Path="Editor.Selected.NeedsHost" FallbackValue="False" />
                                            <Binding Path="IsNotRunning" />
                                        </MultiBinding>
                                    </Border.IsVisible>
                                    <views:HostStateView />
                                </Border>
                                <StackPanel
                                    HorizontalAlignment="Center"
                                    IsHitTestVisible="False"
                                    IsVisible="{Binding Editor.IsEmpty}"
                                    Name="Watermark"
                                    Spacing="32"
                                    VerticalAlignment="Center">
                                    <Image
                                        Height="128"
                                        Opacity="0.12"
                                        RenderOptions.BitmapInterpolationMode="HighQuality"
                                        Source="/Assets/d3b.png"
                                        Width="128" />
                                    <Grid
                                        ColumnDefinitions="Auto,Auto"
                                        ColumnSpacing="16"
                                        HorizontalAlignment="Center"
                                        RowDefinitions="Auto,Auto,Auto,Auto"
                                        RowSpacing="10">
                                        <TextBlock Classes="Muted" HorizontalAlignment="Right" Text="{l:Tr HomeSearch}" />
                                        <Border Classes="Key" Grid.Column="1" HorizontalAlignment="Left">
                                            <TextBlock Text="Ctrl K" />
                                        </Border>
                                        <TextBlock Classes="Muted" Grid.Row="1" HorizontalAlignment="Right" Text="{l:Tr PanelSide}" />
                                        <Border Classes="Key" Grid.Column="1" Grid.Row="1" HorizontalAlignment="Left">
                                            <TextBlock Text="Ctrl B" />
                                        </Border>
                                        <TextBlock Classes="Muted" Grid.Row="2" HorizontalAlignment="Right" Text="{l:Tr PanelBottom}" />
                                        <Border Classes="Key" Grid.Column="1" Grid.Row="2" HorizontalAlignment="Left">
                                            <TextBlock Text="Ctrl J" />
                                        </Border>
                                        <TextBlock Classes="Muted" Grid.Row="3" HorizontalAlignment="Right" Text="{l:Tr HomePlay}" />
                                        <Border Classes="Key" Grid.Column="1" Grid.Row="3" HorizontalAlignment="Left">
                                            <TextBlock Text="F5" />
                                        </Border>
                                    </Grid>
                                </StackPanel>
                            </Panel>
                            </Border>
                    </DockPanel>
                    <c:DockSplitter
                        Grid.Row="1"
                        Height="8"
                        IsVisible="{Binding Layout.IsBottomOpen}"
                        LineBrush="{DynamicResource AccentColor}"
                        Margin="0,-1.5"
                        Name="BottomSplitter"
                        Orientation="Horizontal"
                        VerticalAlignment="Center" />
                    <Border
                        Classes="Dock Compact"
                        Grid.Row="2"
                        IsVisible="{Binding Layout.IsBottomOpen}"
                        Name="BottomDock">
                        <views:BottomPanelView DataContext="{Binding Bottom}" />
                    </Border>
                </Grid>
                <c:DockSplitter
                    Grid.Column="3"
                    HorizontalAlignment="Center"
                    IsVisible="{Binding Layout.IsDetailsOpen}"
                    LineBrush="{DynamicResource AccentColor}"
                    Margin="-1.5,0"
                    Name="RightSplitter"
                    Orientation="Vertical"
                    Width="8" />

                <Border
                    Classes="Dock"
                    Grid.Column="4"
                    IsVisible="{Binding Layout.IsDetailsOpen}"
                    Name="DetailsDock">
                    <DockPanel>
                        <Border Classes="Strip" DockPanel.Dock="Top">
                            <StackPanel Orientation="Horizontal">
                                <Border Classes="TabHost On">
                                    <StackPanel Orientation="Horizontal">
                                        <StackPanel
                                            Margin="9,0,7,0"
                                            Orientation="Horizontal"
                                            Spacing="7">
                                            <c:Icon
                                                Drawing="{StaticResource Toolwindows.Structure}"
                                                Height="14"
                                                VerticalAlignment="Center"
                                                Width="14" />
                                            <TextBlock Classes="TabTitle" Text="{l:Tr PanelDetails}" />
                                        </StackPanel>
                                        <Button
                                            Classes="TabClose"
                                            Command="{Binding Layout.CloseCommand}"
                                            CommandParameter="{x:Static studio:StudioPanel.Details}"
                                            ToolTip.Tip="{l:Tr Close}">
                                            <c:Icon
                                                Drawing="{StaticResource General.Close}"
                                                Height="12"
                                                Width="12" />
                                        </Button>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Border>
                        <Border
                            DockPanel.Dock="Top"
                            IsVisible="{Binding !Properties.IsEmpty}"
                            Padding="6,6,6,2">
                            <TextBox
                                Classes="PropertySearch"
                                Text="{Binding Properties.Filter}"
                                PlaceholderText="{l:Tr InspectorSearch}">
                                <TextBox.InnerLeftContent>
                                    <c:Icon
                                        Drawing="{StaticResource General.Search}"
                                        Height="14"
                                        Margin="8,0,0,0"
                                        Width="14" />
                                </TextBox.InnerLeftContent>
                            </TextBox>
                        </Border>
                        <views:PropertiesView DataContext="{Binding Properties}" />
                    </DockPanel>
                </Border>
            </Grid>
            </Grid>

            <!--  The status bar, VS Code's and next's (D531, D541): the app's state on the left, after its one accent, a small blue dot,
                 then the relay; its context on the right, the client and its data, the bots playing, the problems, the saving and the
                 update. Each item opens what it names; colour only for a problem or the update offered.  -->
            <Grid
                ColumnDefinitions="Auto,*,Auto"
                Grid.Row="1"
                Margin="6,0"
                Name="StatusBar">
                <StackPanel
                    Orientation="Horizontal"
                    Spacing="2"
                    VerticalAlignment="Center">
                    <Button
                        Classes="Status"
                        Command="{Binding StatusBar.ShowAboutPageCommand}"
                        Name="VersionItem"
                        ToolTip.Tip="{l:Tr StatusVersionTip}">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <Ellipse
                                Fill="{DynamicResource AccentColor}"
                                Height="6"
                                VerticalAlignment="Center"
                                Width="6" />
                            <TextBlock Text="{Binding StatusBar.VersionText}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button
                        Classes="Status"
                        Classes.Failed="{Binding StatusBar.IsRelayFailed}"
                        Command="{Binding StatusBar.ShowRelayJournalCommand}"
                        Name="RelayItem">
                        <ToolTip.Tip>
                            <TextBlock
                                MaxWidth="360"
                                Text="{Binding StatusBar.RelayTip}"
                                TextWrapping="Wrap" />
                        </ToolTip.Tip>
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <Ellipse
                                Classes="HostDot"
                                Classes.Failed="{Binding IsFailed}"
                                Classes.Running="{Binding IsRunning}"
                                Classes.Starting="{Binding IsStarting}"
                                Classes.Stopping="{Binding IsStopping}"
                                VerticalAlignment="Center" />
                            <TextBlock Text="{Binding StatusBar.RelayText}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </StackPanel>
                <StackPanel
                    Grid.Column="2"
                    Orientation="Horizontal"
                    Spacing="2"
                    VerticalAlignment="Center">
                    <Button
                        Classes="Status"
                        Command="{Binding StatusBar.ShowDataFilesCommand}"
                        Name="ClientItem"
                        ToolTip.Tip="{Binding StatusBar.ClientTip}">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <c:Icon
                                Drawing="{StaticResource Toolwindows.Project}"
                                Height="12"
                                Width="12" />
                            <TextBlock Text="{Binding StatusBar.ClientText}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button
                        Classes="Status"
                        Command="{Binding StatusBar.ShowCharactersViewCommand}"
                        IsVisible="{Binding StatusBar.ShowsPlaying}"
                        Name="PlayingItem">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <c:Icon
                                Drawing="{StaticResource Run.Run}"
                                Height="12"
                                Width="12" />
                            <TextBlock Text="{Binding StatusBar.PlayingText}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button
                        Classes="Status"
                        Command="{Binding StatusBar.ShowProblemsTabCommand}"
                        Name="ProblemsItem"
                        ToolTip.Tip="{l:Tr StatusProblemsTip}">
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <c:Icon
                                Drawing="{StaticResource Status.Error}"
                                Height="12"
                                Width="12" />
                            <TextBlock Text="{Binding StatusBar.ErrorsText}" VerticalAlignment="Center" />
                            <c:Icon
                                Drawing="{StaticResource Status.Warning}"
                                Height="12"
                                Margin="4,0,0,0"
                                Width="12" />
                            <TextBlock Text="{Binding StatusBar.WarningsText}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button Classes="Status" Command="{Binding StatusBar.SaveEverythingCommand}">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <c:Icon
                                Drawing="{StaticResource Status.Success}"
                                Height="12"
                                IsVisible="{Binding StatusBar.IsSaved}"
                                Width="12" />
                            <c:Icon
                                Drawing="{StaticResource Status.Warning}"
                                Height="12"
                                IsVisible="{Binding !StatusBar.IsSaved}"
                                Width="12" />
                            <TextBlock IsVisible="{Binding StatusBar.IsSaved}" Text="{l:Tr StatusSaved}" />
                            <TextBlock IsVisible="{Binding !StatusBar.IsSaved}" Text="{l:Tr StatusUnsaved}" />
                        </StackPanel>
                    </Button>
                    <Button
                        Classes="Status Accent"
                        Command="{Binding StatusBar.RestartIntoUpdateCommand}"
                        IsVisible="{Binding StatusBar.IsUpdateReady}"
                        Name="UpdateItem">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <c:Icon
                                Drawing="{StaticResource General.IdeUpdate}"
                                Height="12"
                                Width="12" />
                            <TextBlock Text="{Binding StatusBar.UpdateText}" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Grid>

        <Panel IsVisible="{Binding Search.IsOpen}">
            <Border Background="Transparent" PointerPressed="OnScrimPressed" />
            <views:SearchView DataContext="{Binding Search}" />
        </Panel>
    </Panel>
</shadui:Window>
