<shadui:Window
    x:Class="D3B.App.Views.MainWindow"
    x:ClassModifier="internal"
    x:DataType="vm:MainViewModel"
    FontSize="14"
    Title="D3B"
    TitleFontWeight="SemiBold"
    Width="1240"
    Height="800"
    MinWidth="720"
    MinHeight="560"
    WindowStartupLocation="CenterScreen"
    xmlns="https://github.com/avaloniaui"
    xmlns:c="clr-namespace:D3B.App.Controls"
    xmlns:l="clr-namespace:D3B.App.Localization"
    xmlns:shadui="clr-namespace:ShadUI;assembly=ShadUI"
    xmlns:views="clr-namespace:D3B.App.Views"
    xmlns:vm="clr-namespace:D3B.App.ViewModels"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <shadui:Window.LogoContent>
        <c:Icon
            Data="{StaticResource IconBot}"
            Margin="12,0,0,0"
            VerticalAlignment="Center" />
    </shadui:Window.LogoContent>
    <shadui:Window.RightWindowTitleBarContent>
        <c:StatusPill
            Margin="0,0,12,0"
            Text="{Binding HostTitle}"
            ToolTip.Tip="{Binding HostDetail}"
            Tone="{Binding HostTone}" />
    </shadui:Window.RightWindowTitleBarContent>
    <shadui:Window.Hosts>
        <shadui:DialogHost Name="DialogHost" />
        <shadui:ToastHost Name="ToastHost" Position="BottomRight" />
    </shadui:Window.Hosts>
    <Grid ColumnDefinitions="Auto,*">
        <shadui:Sidebar
            Name="Sidebar"
            BorderBrush="{DynamicResource BorderColor}"
            BorderThickness="0,0,1,0"
            CurrentRoute="{Binding CurrentRoute}"
            Expanded="{Binding IsSidebarExpanded}"
            MinWidth="56"
            Width="200">
            <StackPanel Margin="0,8" Spacing="4">
                <shadui:SidebarItem
                    AutomationProperties.Name="{l:Tr Bots}"
                    Route="bots"
                    ToolTip.ServiceEnabled="{Binding !IsSidebarExpanded}"
                    ToolTip.Tip="{l:Tr Bots}">
                    <shadui:SidebarItem.Icon>
                        <c:Icon Data="{StaticResource IconBot}" />
                    </shadui:SidebarItem.Icon>
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Text="{l:Tr Bots}" VerticalAlignment="Center" />
                        <TextBlock
                            Classes="Caption Muted Figures"
                            Grid.Column="1"
                            IsVisible="{Binding Bots.HasItems}"
                            Text="{Binding Bots.Count}"
                            VerticalAlignment="Center" />
                    </Grid>
                </shadui:SidebarItem>
                <shadui:SidebarItem
                    AutomationProperties.Name="{l:Tr Accounts}"
                    Content="{l:Tr Accounts}"
                    Route="accounts"
                    ToolTip.ServiceEnabled="{Binding !IsSidebarExpanded}"
                    ToolTip.Tip="{l:Tr Accounts}">
                    <shadui:SidebarItem.Icon>
                        <c:Icon Data="{StaticResource IconUsers}" />
                    </shadui:SidebarItem.Icon>
                </shadui:SidebarItem>
                <shadui:SidebarItem
                    AutomationProperties.Name="{l:Tr Profiles}"
                    Content="{l:Tr Profiles}"
                    Route="profiles"
                    ToolTip.ServiceEnabled="{Binding !IsSidebarExpanded}"
                    ToolTip.Tip="{l:Tr Profiles}">
                    <shadui:SidebarItem.Icon>
                        <c:Icon Data="{StaticResource IconSliders}" />
                    </shadui:SidebarItem.Icon>
                </shadui:SidebarItem>
                <shadui:SidebarItem
                    AutomationProperties.Name="{l:Tr Map}"
                    Content="{l:Tr Map}"
                    Route="map"
                    ToolTip.ServiceEnabled="{Binding !IsSidebarExpanded}"
                    ToolTip.Tip="{l:Tr Map}">
                    <shadui:SidebarItem.Icon>
                        <c:Icon Data="{StaticResource IconMap}" />
                    </shadui:SidebarItem.Icon>
                </shadui:SidebarItem>
                <shadui:SidebarItem
                    AutomationProperties.Name="{l:Tr Statistics}"
                    Content="{l:Tr Statistics}"
                    Route="statistics"
                    ToolTip.ServiceEnabled="{Binding !IsSidebarExpanded}"
                    ToolTip.Tip="{l:Tr Statistics}">
                    <shadui:SidebarItem.Icon>
                        <c:Icon Data="{StaticResource IconChart}" />
                    </shadui:SidebarItem.Icon>
                </shadui:SidebarItem>
                <shadui:SidebarItem
                    AutomationProperties.Name="{l:Tr Logs}"
                    Content="{l:Tr Logs}"
                    Route="logs"
                    ToolTip.ServiceEnabled="{Binding !IsSidebarExpanded}"
                    ToolTip.Tip="{l:Tr Logs}">
                    <shadui:SidebarItem.Icon>
                        <c:Icon Data="{StaticResource IconJournal}" />
                    </shadui:SidebarItem.Icon>
                </shadui:SidebarItem>
                <shadui:SidebarItem
                    AutomationProperties.Name="{l:Tr Inspector}"
                    Content="{l:Tr Inspector}"
                    Route="inspector"
                    ToolTip.ServiceEnabled="{Binding !IsSidebarExpanded}"
                    ToolTip.Tip="{l:Tr Inspector}">
                    <shadui:SidebarItem.Icon>
                        <c:Icon Data="{StaticResource IconInspector}" />
                    </shadui:SidebarItem.Icon>
                </shadui:SidebarItem>
                <Separator IsVisible="{Binding HasPages}" Margin="12,4" />
                <ItemsControl ItemsSource="{Binding Pages}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Spacing="4" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:ModulePageViewModel">
                            <shadui:SidebarItem
                                AutomationProperties.Name="{Binding Title}"
                                Content="{Binding Title}"
                                Route="{Binding Route}"
                                ToolTip.Tip="{Binding Title}">
                                <shadui:SidebarItem.Icon>
                                    <c:Icon Data="{Binding Icon, TargetNullValue={StaticResource IconModule}}" />
                                </shadui:SidebarItem.Icon>
                            </shadui:SidebarItem>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
            <shadui:Sidebar.Footer>
                <StackPanel Margin="0,8" Spacing="4">
                    <shadui:SidebarItem
                        AutomationProperties.Name="{l:Tr Settings}"
                        Content="{l:Tr Settings}"
                        Route="settings"
                        ToolTip.ServiceEnabled="{Binding !IsSidebarExpanded}"
                        ToolTip.Tip="{l:Tr Settings}">
                        <shadui:SidebarItem.Icon>
                            <c:Icon Data="{StaticResource IconGear}" />
                        </shadui:SidebarItem.Icon>
                    </shadui:SidebarItem>
                    <Button
                        AutomationProperties.Name="{Binding SidebarToggleText}"
                        Classes="Ghost IconButton"
                        Command="{Binding ToggleSidebarCommand}"
                        HorizontalAlignment="Left"
                        Margin="8,0"
                        ToolTip.Tip="{Binding SidebarToggleText}">
                        <c:Icon Data="{Binding SidebarToggleIcon, Converter={x:Static c:IconOf.Instance}}" />
                    </Button>
                </StackPanel>
            </shadui:Sidebar.Footer>
        </shadui:Sidebar>
        <DockPanel Grid.Column="1">
            <Border
                Classes="Banner Info Strip"
                DockPanel.Dock="Top"
                IsVisible="{Binding Updates.IsReady}"
                Margin="16,12,16,0">
                <Grid ColumnDefinitions="Auto,*,Auto">
                    <c:Icon
                        Data="{StaticResource IconDownload}"
                        Tone="Info"
                        VerticalAlignment="Center" />
                    <TextBlock
                        Grid.Column="1"
                        Margin="12,0"
                        Text="{Binding Updates.ReadyText}"
                        TextTrimming="CharacterEllipsis"
                        VerticalAlignment="Center" />
                    <Button
                        Classes="Primary"
                        Command="{Binding Updates.RestartCommand}"
                        Content="{l:Tr UpdateRestart}"
                        Grid.Column="2" />
                </Grid>
            </Border>
            <Panel>
                <Panel Classes="PageHost" IsVisible="{Binding IsSettingsPage}">
                    <views:SettingsView DataContext="{Binding Settings}" />
                </Panel>
                <Panel IsVisible="{Binding !IsSettingsPage}">
                    <StackPanel
                        HorizontalAlignment="Center"
                        IsVisible="{Binding IsStarting}"
                        Spacing="12"
                        VerticalAlignment="Center">
                        <shadui:Loading
                            Height="24"
                            HorizontalAlignment="Center"
                            Width="24" />
                        <TextBlock
                            Classes="Title"
                            HorizontalAlignment="Center"
                            Text="{l:Tr HostStartingTitle}" />
                        <TextBlock
                            Classes="Muted"
                            HorizontalAlignment="Center"
                            Text="{l:Tr HostStartingDetail}" />
                    </StackPanel>
                    <StackPanel
                        HorizontalAlignment="Center"
                        IsVisible="{Binding IsStopping}"
                        Spacing="12"
                        VerticalAlignment="Center">
                        <shadui:Loading
                            Height="24"
                            HorizontalAlignment="Center"
                            Width="24" />
                        <TextBlock
                            Classes="Title"
                            HorizontalAlignment="Center"
                            Text="{l:Tr HostStoppingTitle}" />
                    </StackPanel>
                    <ScrollViewer IsVisible="{Binding IsMissingBuild}">
                        <Border
                            Classes="Banner Info"
                            HorizontalAlignment="Center"
                            Margin="32"
                            MaxWidth="720"
                            VerticalAlignment="Center">
                            <StackPanel Spacing="16">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <c:Icon
                                        Classes="Large"
                                        Data="{StaticResource IconDownload}"
                                        Tone="Info"
                                        VerticalAlignment="Center" />
                                    <TextBlock
                                        Classes="Title"
                                        Text="{l:Tr MissingBuildTitle}"
                                        VerticalAlignment="Center" />
                                </StackPanel>
                                <TextBlock Text="{Binding MissingBuildText}" TextWrapping="Wrap" />
                                <c:StatusPill
                                    HorizontalAlignment="Left"
                                    Text="{Binding Updates.StatusText}"
                                    Tone="{Binding Updates.StatusTone}" />
                                <StackPanel
                                    HorizontalAlignment="Right"
                                    Orientation="Horizontal"
                                    Spacing="8">
                                    <Button
                                        Classes="Outline"
                                        Command="{Binding Updates.CheckCommand}"
                                        Content="{l:Tr UpdateCheck}" />
                                    <Button
                                        Classes="Primary"
                                        Command="{Binding Updates.RestartCommand}"
                                        Content="{l:Tr UpdateNow}"
                                        IsVisible="{Binding Updates.IsReady}" />
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </ScrollViewer>
                    <ScrollViewer>
                        <ScrollViewer.IsVisible>
                            <MultiBinding Converter="{x:Static BoolConverters.And}">
                                <Binding Path="IsFailed" />
                                <Binding Path="!IsMissingBuild" />
                            </MultiBinding>
                        </ScrollViewer.IsVisible>
                        <Border
                            Classes="Banner Danger"
                            HorizontalAlignment="Center"
                            Margin="32"
                            MaxWidth="720"
                            VerticalAlignment="Center">
                            <StackPanel Spacing="16">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <c:Icon
                                        Classes="Large"
                                        Data="{StaticResource IconAlert}"
                                        Tone="Danger"
                                        VerticalAlignment="Center" />
                                    <TextBlock
                                        Classes="Title"
                                        Text="{l:Tr HostFailedTitle}"
                                        VerticalAlignment="Center" />
                                </StackPanel>
                                <Border Classes="Code">
                                    <SelectableTextBlock
                                        Classes="Mono"
                                        Text="{Binding HostFailure}"
                                        TextWrapping="Wrap" />
                                </Border>
                                <Button
                                    Classes="Outline"
                                    Click="OnCopyFailureClick"
                                    HorizontalAlignment="Right">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <c:Icon Data="{StaticResource IconCopy}" />
                                        <TextBlock Text="{l:Tr Copy}" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Border>
                    </ScrollViewer>
                    <Panel IsVisible="{Binding IsRunning}">
                        <Panel Classes="PageHost" IsVisible="{Binding IsBotsPage}">
                            <views:BotsView DataContext="{Binding Bots}" />
                        </Panel>
                        <Panel Classes="PageHost" IsVisible="{Binding IsAccountsPage}">
                            <views:AccountsView DataContext="{Binding Accounts}" />
                        </Panel>
                        <Panel Classes="PageHost" IsVisible="{Binding IsProfilesPage}">
                            <views:ProfilesView DataContext="{Binding Profiles}" />
                        </Panel>
                        <Panel Classes="PageHost" IsVisible="{Binding IsMapPage}">
                            <views:MapView DataContext="{Binding Map}" />
                        </Panel>
                        <Panel Classes="PageHost" IsVisible="{Binding IsStatisticsPage}">
                            <views:StatisticsView DataContext="{Binding Statistics}" />
                        </Panel>
                        <Panel Classes="PageHost" IsVisible="{Binding IsLogsPage}">
                            <views:LogsView DataContext="{Binding Logs}" />
                        </Panel>
                        <Panel Classes="PageHost" IsVisible="{Binding IsInspectorPage}">
                            <views:InspectorView DataContext="{Binding Inspector}" />
                        </Panel>
                        <ContentControl
                            Classes="PageHost"
                            Content="{Binding SelectedPage.Content}"
                            IsVisible="{Binding IsModulePage}">
                            <ContentControl.DataTemplates>
                                <DataTemplate x:DataType="vm:PageFailureViewModel">
                                    <ScrollViewer>
                                        <Border
                                            Classes="Banner Danger"
                                            HorizontalAlignment="Center"
                                            Margin="32"
                                            MaxWidth="720"
                                            VerticalAlignment="Center">
                                            <StackPanel Spacing="16">
                                                <StackPanel Orientation="Horizontal" Spacing="8">
                                                    <c:Icon
                                                        Classes="Large"
                                                        Data="{StaticResource IconAlert}"
                                                        Tone="Danger"
                                                        VerticalAlignment="Center" />
                                                    <TextBlock
                                                        Classes="Title"
                                                        Text="{l:Tr PageFailedTitle}"
                                                        VerticalAlignment="Center" />
                                                </StackPanel>
                                                <Border Classes="Code">
                                                    <SelectableTextBlock
                                                        Classes="Mono"
                                                        Text="{Binding Message}"
                                                        TextWrapping="Wrap" />
                                                </Border>
                                            </StackPanel>
                                        </Border>
                                    </ScrollViewer>
                                </DataTemplate>
                            </ContentControl.DataTemplates>
                        </ContentControl>
                    </Panel>
                </Panel>
            </Panel>
        </DockPanel>
    </Grid>
</shadui:Window>
