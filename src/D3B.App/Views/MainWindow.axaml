<shadui:Window
    x:Class="D3B.App.Views.MainWindow"
    x:ClassModifier="internal"
    x:DataType="vm:MainViewModel"
    Title="D3B"
    TitleFontWeight="SemiBold"
    Width="1240"
    Height="800"
    MinWidth="960"
    MinHeight="600"
    WindowStartupLocation="CenterScreen"
    xmlns="https://github.com/avaloniaui"
    xmlns:c="clr-namespace:D3B.App.Controls"
    xmlns:l="clr-namespace:D3B.App.Localization"
    xmlns:shadui="clr-namespace:ShadUI;assembly=ShadUI"
    xmlns:views="clr-namespace:D3B.App.Views"
    xmlns:vm="clr-namespace:D3B.App.ViewModels"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <shadui:Window.LogoContent>
        <c:Icon
            Data="{StaticResource IconBot}"
            Height="16"
            Margin="12,0,0,0"
            VerticalAlignment="Center"
            Width="16" />
    </shadui:Window.LogoContent>
    <shadui:Window.RightWindowTitleBarContent>
        <StackPanel
            Margin="0,0,6,0"
            Orientation="Horizontal"
            Spacing="2"
            VerticalAlignment="Center">
            <Button
                Classes="Ghost"
                Command="{Binding SwitchLanguageCommand}"
                CornerRadius="{DynamicResource MdCornerRadius}"
                Height="30"
                Padding="10,0"
                ToolTip.Tip="{l:Tr SwitchLanguage}">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <c:Icon
                        Data="{StaticResource IconLanguage}"
                        Height="15"
                        Width="15" />
                    <TextBlock
                        FontSize="12"
                        FontWeight="SemiBold"
                        Text="{Binding LanguageCode}"
                        VerticalAlignment="Center" />
                </StackPanel>
            </Button>
            <Button
                Classes="Ghost"
                Click="OnThemeClick"
                CornerRadius="{DynamicResource MdCornerRadius}"
                Height="30"
                Padding="0"
                ToolTip.Tip="{l:Tr SwitchTheme}"
                Width="30">
                <c:Icon
                    Height="15"
                    Name="ThemeIcon"
                    Width="15" />
            </Button>
        </StackPanel>
    </shadui:Window.RightWindowTitleBarContent>
    <Grid ColumnDefinitions="232,*">
        <Border
            Background="{DynamicResource SidebarBackgroundColor}"
            BorderBrush="{DynamicResource BorderColor}"
            BorderThickness="0,0,1,0">
            <DockPanel Margin="12,12,12,14">
                <StackPanel
                    DockPanel.Dock="Top"
                    Margin="10,6,10,22"
                    Spacing="2">
                    <TextBlock
                        FontSize="20"
                        FontWeight="Bold"
                        Text="D3B" />
                    <TextBlock Classes="Caption Muted" Text="{l:Tr AppTagline}" />
                </StackPanel>
                <Border
                    Classes="Tile"
                    DockPanel.Dock="Bottom"
                    Padding="14,12">
                    <StackPanel Spacing="8">
                        <c:StatusPill
                            HorizontalAlignment="Left"
                            Text="{Binding HostTitle}"
                            Tone="{Binding HostTone}" />
                        <TextBlock
                            Classes="Caption Muted"
                            Text="{Binding HostDetail}"
                            TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
                <Border
                    Background="{DynamicResource GhostColor}"
                    CornerRadius="{DynamicResource LgCornerRadius}"
                    Padding="10,9"
                    VerticalAlignment="Top">
                    <Grid ColumnDefinitions="Auto,*,Auto">
                        <c:Icon
                            Data="{StaticResource IconBot}"
                            Height="16"
                            VerticalAlignment="Center"
                            Width="16" />
                        <TextBlock
                            Classes="Small"
                            Grid.Column="1"
                            Margin="10,0,0,0"
                            Text="{l:Tr Bots}"
                            VerticalAlignment="Center" />
                        <Border
                            Background="{DynamicResource BorderColor}"
                            CornerRadius="999"
                            Grid.Column="2"
                            IsVisible="{Binding IsRunning}"
                            Padding="8,1">
                            <TextBlock
                                FontSize="11"
                                FontWeight="SemiBold"
                                Text="{Binding Bots.Items.Count}" />
                        </Border>
                    </Grid>
                </Border>
            </DockPanel>
        </Border>
        <Panel Grid.Column="1">
            <StackPanel
                HorizontalAlignment="Center"
                IsVisible="{Binding IsStarting}"
                MaxWidth="420"
                Spacing="14"
                VerticalAlignment="Center">
                <shadui:Loading
                    Height="28"
                    HorizontalAlignment="Center"
                    Width="28" />
                <TextBlock
                    Classes="h4"
                    HorizontalAlignment="Center"
                    Text="{l:Tr HostStartingTitle}" />
                <TextBlock
                    Classes="Small Muted"
                    Text="{l:Tr HostStartingDetail}"
                    TextAlignment="Center"
                    TextWrapping="Wrap" />
            </StackPanel>
            <StackPanel
                HorizontalAlignment="Center"
                IsVisible="{Binding IsStopping}"
                Spacing="14"
                VerticalAlignment="Center">
                <shadui:Loading
                    Height="28"
                    HorizontalAlignment="Center"
                    Width="28" />
                <TextBlock
                    Classes="h4"
                    HorizontalAlignment="Center"
                    Text="{l:Tr HostStoppingTitle}" />
            </StackPanel>
            <ScrollViewer IsVisible="{Binding IsFailed}">
                <Border
                    Classes="Banner Danger"
                    HorizontalAlignment="Center"
                    Margin="40"
                    MaxWidth="720"
                    Padding="24,22"
                    VerticalAlignment="Center">
                    <StackPanel Spacing="16">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <c:Icon
                                Data="{StaticResource IconAlert}"
                                Foreground="{DynamicResource ErrorColor}"
                                Height="20"
                                VerticalAlignment="Center"
                                Width="20" />
                            <TextBlock
                                Classes="h4"
                                Text="{l:Tr HostFailedTitle}"
                                VerticalAlignment="Center" />
                        </StackPanel>
                        <Border Classes="Code">
                            <SelectableTextBlock
                                Classes="Mono"
                                Text="{Binding HostFailure}"
                                TextWrapping="Wrap" />
                        </Border>
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock
                                Classes="Small Muted"
                                Text="{l:Tr HostFailedHint}"
                                TextWrapping="Wrap"
                                VerticalAlignment="Center" />
                            <Button
                                Classes="Outline"
                                Click="OnCopyFailureClick"
                                Grid.Column="1"
                                Margin="16,0,0,0">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <c:Icon
                                        Data="{StaticResource IconCopy}"
                                        Height="14"
                                        Width="14" />
                                    <TextBlock Text="{l:Tr Copy}" />
                                </StackPanel>
                            </Button>
                        </Grid>
                    </StackPanel>
                </Border>
            </ScrollViewer>
            <Panel IsVisible="{Binding IsRunning}">
                <views:BotsView DataContext="{Binding Bots}" />
            </Panel>
        </Panel>
    </Grid>
</shadui:Window>
