<UserControl
    x:Class="D3B.App.Views.SearchView"
    x:ClassModifier="internal"
    x:DataType="studio:SearchViewModel"
    xmlns="https://github.com/avaloniaui"
    xmlns:c="clr-namespace:D3B.App.Controls"
    xmlns:l="clr-namespace:D3B.App.Localization"
    xmlns:studio="clr-namespace:D3B.App.ViewModels.Studio"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Styles>
        <Style Selector="Button.Scope">
            <Setter Property="Theme" Value="{DynamicResource StudioButton}" />
            <Setter Property="Height" Value="22" />
            <Setter Property="MinHeight" Value="22" />
            <Setter Property="Padding" Value="8,0" />
            <Setter Property="CornerRadius" Value="11" />
            <Setter Property="Background" Value="{DynamicResource ClearColor}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="Normal" />
            <Setter Property="Foreground" Value="{DynamicResource MutedColor}" />
        </Style>
        <Style Selector="Button.Scope:pointerover">
            <Setter Property="Background" Value="{DynamicResource HoverColor}" />
            <Setter Property="Foreground" Value="{DynamicResource ForegroundColor}" />
        </Style>
        <Style Selector="Button.Scope.On">
            <Setter Property="Background" Value="{DynamicResource RaisedColor}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderColor}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="{DynamicResource BrightColor}" />
        </Style>
        <!--  next's rows: 26 pixels, a radius of 4, the one the arrows are on in the blue of VS Code's lists.  -->
        <Style Selector="Border.Result">
            <Setter Property="Height" Value="26" />
            <Setter Property="Padding" Value="8,0" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Background" Value="{DynamicResource ClearColor}" />
        </Style>
        <Style Selector="Border.Result TextBlock">
            <Setter Property="FontSize" Value="13" />
        </Style>
        <Style Selector="Border.Result.Active">
            <Setter Property="Background" Value="{DynamicResource PaletteActiveColor}" />
        </Style>
        <Style Selector="Border.Result TextBlock.Enter">
            <Setter Property="Opacity" Value="0" />
        </Style>
        <Style Selector="Border.Result.Active TextBlock.Enter">
            <Setter Property="Opacity" Value="1" />
        </Style>
        <Style Selector="Border.Glyph">
            <Setter Property="Width" Value="18" />
            <Setter Property="Height" Value="18" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Background" Value="{DynamicResource TipColor}" />
        </Style>
    </UserControl.Styles>
    <!--  next's command palette (D540): under the title bar, 600 pixels wide, on its own grey with a lighter edge, dimming nothing.  -->
    <Border
        Background="{DynamicResource PaletteColor}"
        BorderBrush="{DynamicResource PaletteEdgeColor}"
        BorderThickness="1"
        BoxShadow="0 16 48 0 #99000000"
        CornerRadius="8"
        HorizontalAlignment="Center"
        Margin="16,4,16,16"
        MaxHeight="560"
        VerticalAlignment="Top"
        Width="600">
        <DockPanel>
            <Border
                BorderBrush="{DynamicResource BorderColor60}"
                BorderThickness="0,0,0,1"
                DockPanel.Dock="Top"
                Height="36"
                Padding="12,0">
                <Grid ColumnDefinitions="Auto,*,Auto">
                    <c:Icon
                        Drawing="{StaticResource General.Search}"
                        Height="16"
                        VerticalAlignment="Center"
                        Width="16" />
                    <TextBox
                        Background="Transparent"
                        BorderThickness="0"
                        FontSize="13"
                        Foreground="{DynamicResource BrightColor}"
                        Grid.Column="1"
                        KeyDown="OnQueryKeyDown"
                        Margin="8,0"
                        MinHeight="0"
                        Name="QueryBox"
                        Padding="0"
                        Text="{Binding Query}"
                        VerticalAlignment="Center"
                        PlaceholderText="{l:Tr SearchWatermark}" />
                    <Border
                        Classes="Key Popup"
                        Grid.Column="2"
                        VerticalAlignment="Center">
                        <TextBlock Text="{l:Tr KeyEscape}" />
                    </Border>
                </Grid>
            </Border>
            <Border
                BorderBrush="{DynamicResource BorderColor60}"
                BorderThickness="0,0,0,1"
                DockPanel.Dock="Top"
                Padding="8,6">
                <ItemsControl ItemsSource="{Binding Chips}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" Spacing="4" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="studio:SearchScopeChip">
                            <Button
                                Classes="Scope"
                                Classes.On="{Binding IsOn}"
                                Click="OnScopeClick"
                                Content="{Binding Name}"
                                Focusable="False" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Border>
            <Panel>
                <TextBlock
                    Classes="Dim"
                    HorizontalAlignment="Center"
                    IsVisible="{Binding IsEmpty}"
                    Margin="0,28"
                    Text="{Binding EmptyText}" />
                <ScrollViewer Name="Results" Padding="4">
                    <ItemsControl ItemsSource="{Binding Groups}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="studio:SearchGroup">
                                <StackPanel>
                                    <Grid
                                        ColumnDefinitions="*,Auto"
                                        Height="24"
                                        Margin="8,0">
                                        <TextBlock
                                            Classes="Dim"
                                            FontSize="11"
                                            FontWeight="Medium"
                                            Text="{Binding Title}"
                                            VerticalAlignment="Center" />
                                        <TextBlock
                                            Classes="Dim"
                                            FontSize="11"
                                            Grid.Column="1"
                                            IsVisible="{Binding HasMore}"
                                            Text="{Binding More}"
                                            VerticalAlignment="Center" />
                                    </Grid>
                                    <ItemsControl ItemsSource="{Binding Results}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="studio:SearchResult">
                                                <Border
                                                    Classes="Result"
                                                    Classes.Active="{Binding IsActive}"
                                                    PointerEntered="OnResultPointerEntered"
                                                    PointerPressed="OnResultPressed">
                                                    <Grid ColumnDefinitions="Auto,Auto,*,Auto">
                                                        <Panel VerticalAlignment="Center">
                                                            <Border Classes="Glyph" IsVisible="{Binding Item.Icon, Converter={x:Static ObjectConverters.IsNotNull}}">
                                                                <c:Icon
                                                                    Drawing="{Binding Item.Icon, Converter={x:Static c:DrawingOf.Instance}}"
                                                                    Height="12"
                                                                    HorizontalAlignment="Center"
                                                                    VerticalAlignment="Center"
                                                                    Width="12" />
                                                            </Border>
                                                            <Border Classes="Glyph" IsVisible="{Binding Item.Initials, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                                                                <TextBlock
                                                                    Classes="Bright"
                                                                    FontSize="9.5"
                                                                    FontWeight="SemiBold"
                                                                    HorizontalAlignment="Center"
                                                                    Text="{Binding Item.Initials}"
                                                                    VerticalAlignment="Center" />
                                                            </Border>
                                                            <Border Classes="Glyph">
                                                                <Border.IsVisible>
                                                                    <MultiBinding Converter="{x:Static BoolConverters.And}">
                                                                        <Binding Converter="{x:Static ObjectConverters.IsNull}" Path="Item.Icon" />
                                                                        <Binding Converter="{x:Static StringConverters.IsNullOrEmpty}" Path="Item.Initials" />
                                                                    </MultiBinding>
                                                                </Border.IsVisible>
                                                                <Path
                                                                    Data="M 5 3 L 9 7 L 5 11"
                                                                    HorizontalAlignment="Center"
                                                                    Stroke="{DynamicResource MutedColor}"
                                                                    StrokeLineCap="Round"
                                                                    StrokeJoin="Round"
                                                                    StrokeThickness="1.4"
                                                                    VerticalAlignment="Center" />
                                                            </Border>
                                                        </Panel>
                                                        <TextBlock
                                                            Grid.Column="1"
                                                            Margin="10,0,0,0"
                                                            TextTrimming="CharacterEllipsis"
                                                            VerticalAlignment="Center"><Run Text="{Binding Before}" /><Run FontWeight="SemiBold" Foreground="{DynamicResource AccentTextColor}" Text="{Binding Match}" /><Run Text="{Binding After}" /></TextBlock>
                                                        <TextBlock
                                                            Classes="Dim"
                                                            Grid.Column="2"
                                                            Margin="10,0,0,0"
                                                            Text="{Binding Item.Detail}"
                                                            TextTrimming="CharacterEllipsis"
                                                            VerticalAlignment="Center" />
                                                        <c:KeyTip
                                                            Grid.Column="3"
                                                            IsVisible="{Binding HasKeys}"
                                                            Keys="{Binding Item.Keys}"
                                                            VerticalAlignment="Center" />
                                                        <TextBlock
                                                            Classes="Dim Enter"
                                                            FontSize="11"
                                                            Grid.Column="3"
                                                            IsVisible="{Binding !HasKeys}"
                                                            Text="{l:Tr KeyEnter}"
                                                            VerticalAlignment="Center" />
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Panel>
        </DockPanel>
    </Border>
</UserControl>
