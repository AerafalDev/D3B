<UserControl
    x:Class="D3B.App.Views.StepRepeatView"
    x:ClassModifier="internal"
    x:DataType="vm:StepRepeatViewModel"
    xmlns="https://github.com/avaloniaui"
    xmlns:c="clr-namespace:D3B.App.Controls"
    xmlns:l="clr-namespace:D3B.App.Localization"
    xmlns:v="clr-namespace:D3B.App.Views"
    xmlns:vm="clr-namespace:D3B.App.ViewModels.Sequences"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel
        Margin="8,0,0,0"
        Orientation="Horizontal"
        Spacing="6">
        <TextBlock
            Classes="Dim"
            Text="{l:Tr RepeatLabel}"
            VerticalAlignment="Center" />
        <Button
            AutomationProperties.Name="{Binding Summary}"
            Classes="ValueToken"
            Classes.Problem="{Binding HasProblems}"
            Content="{Binding Summary}">
            <Button.Flyout>
                <Flyout Placement="BottomEdgeAlignedLeft">
                    <StackPanel MinWidth="300" Spacing="8">
                        <RadioButton Content="{l:Tr RepeatKindOnce}" IsChecked="{Binding IsOnce}" />
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <RadioButton Content="{l:Tr RepeatKindTimes}" IsChecked="{Binding IsTimes}" />
                            <NumericUpDown
                                AutomationProperties.Name="{l:Tr RepeatCount}"
                                FormatString="0"
                                Increment="1"
                                IsVisible="{Binding HasCount}"
                                Maximum="999"
                                Minimum="2"
                                Value="{Binding Count}"
                                Width="110" />
                        </StackPanel>
                        <RadioButton Content="{l:Tr RepeatKindUntil}" IsChecked="{Binding IsUntil}" />
                        <StackPanel
                            IsVisible="{Binding HasCondition}"
                            Margin="26,0,0,0"
                            Spacing="6">
                            <Button
                                Classes="Outline"
                                Content="{l:Tr RepeatCondition}"
                                HorizontalAlignment="Left">
                                <Button.Flyout>
                                    <Flyout Placement="BottomEdgeAlignedLeft">
                                        <ItemsControl ItemsSource="{Binding Conditions}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="vm:RepeatConditionChoiceViewModel">
                                                    <Button
                                                        Classes="Outline"
                                                        Command="{Binding ChooseCommand}"
                                                        Content="{Binding Name}"
                                                        HorizontalAlignment="Stretch"
                                                        HorizontalContentAlignment="Left"
                                                        Margin="0,1" />
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </Flyout>
                                </Button.Flyout>
                            </Button>
                            <v:ActionSentenceView DataContext="{Binding Condition}" />
                            <TextBlock
                                Classes="Dim"
                                FontSize="11"
                                Text="{l:Tr RepeatConditionHelp}"
                                TextWrapping="Wrap" />
                        </StackPanel>
                        <RadioButton
                            Content="{l:Tr RepeatKindForever}"
                            IsChecked="{Binding IsForever}"
                            IsVisible="{Binding AllowsForever}" />
                    </StackPanel>
                </Flyout>
            </Button.Flyout>
        </Button>
    </StackPanel>
</UserControl>
