    <PackageId>D3B.Network</PackageId>
    <Description>The network of D3B, a bot for Dofus 3: the relay between the official client and Ankama's servers.</Description>
    <PackageTags>d3b;dofus;bot;plugin;network</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="D3B.Network.Tests" />
    <InternalsVisibleTo Include="D3B.Bot.Tests" />
    <InternalsVisibleTo Include="D3B.App.Tests" />
  </ItemGroup>

</Project>
