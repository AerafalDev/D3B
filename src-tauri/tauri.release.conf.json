{
  "$schema": "https://schema.tauri.app/config/2",
  "build": {
    "beforeBuildCommand": "bun run build && bun scripts/notices.ts"
  },
  "bundle": {
    "createUpdaterArtifacts": true,
    "resources": {
      "../data/": "data/",
      "gen/THIRD-PARTY-NOTICES.txt": "THIRD-PARTY-NOTICES.txt"
    },
    "linux": {
      "appimage": {
        "files": {
          "/usr/lib/D3B/SYSTEM-LIBRARIES-NOTICES.txt": "gen/SYSTEM-LIBRARIES-NOTICES.txt"
        }
      }
    }
  }
}
