<Project>

  <Target Name="CopySamplePlugin" AfterTargets="Build" Condition="'@(SamplePlugin)' != ''">
    <PropertyGroup>
      <_SamplePluginName>@(SamplePlugin->'%(Filename)')</_SamplePluginName>
      <_SamplePluginDirectory>@(SamplePlugin->'%(RootDir)%(Directory)')</_SamplePluginDirectory>
    </PropertyGroup>
    <ItemGroup>
      <_SamplePluginFiles Include="$(_SamplePluginDirectory)**\*" />
    </ItemGroup>
    <Copy SourceFiles="@(_SamplePluginFiles)"
          DestinationFiles="@(_SamplePluginFiles->'$(OutDir)plugins\$(_SamplePluginName)\%(RecursiveDir)%(Filename)%(Extension)')"
          SkipUnchangedFiles="true" />
  </Target>

</Project>
