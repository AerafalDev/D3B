<UserControl
    x:Class="D3B.Samples.Hello.HelloPage"
    x:DataType="local:HelloPageModel"
    xmlns="https://github.com/avaloniaui"
    xmlns:local="clr-namespace:D3B.Samples.Hello"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Styles>
        <Style Selector="Border.Initials">
            <Setter Property="Width" Value="40" />
            <Setter Property="Height" Value="40" />
            <Setter Property="CornerRadius" Value="20" />
            <Setter Property="Background" Value="{DynamicResource GhostColor}" />
        </Style>
        <Style Selector="Border.Chip">
            <Setter Property="Background" Value="{DynamicResource GhostColor}" />
            <Setter Property="CornerRadius" Value="999" />
            <Setter Property="Padding" Value="10,3" />
            <Setter Property="VerticalAlignment" Value="Top" />
        </Style>
        <Style Selector="Border.Chip > TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="Foreground" Value="{DynamicResource MutedColor}" />
        </Style>
        <Style Selector="Border.Chip.Strolling">
            <Setter Property="Background" Value="{DynamicResource SuccessColor10}" />
        </Style>
        <Style Selector="Border.Chip.Strolling > TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource SuccessColor}" />
        </Style>
        <Style Selector="ProgressBar.Stroll">
            <Setter Property="Height" Value="6" />
            <Setter Property="MinHeight" Value="6" />
            <Setter Property="Maximum" Value="100" />
        </Style>
    </UserControl.Styles>
    <DockPanel>
        <StackPanel Classes="PageHeader" DockPanel.Dock="Top">
            <TextBlock Classes="PageTitle" Text="{Binding Texts[PageTitle]}" />
            <TextBlock
                Classes="Small Muted"
                Text="{Binding Texts[PageSummary]}"
                TextWrapping="Wrap" />
        </StackPanel>
        <Panel>
            <StackPanel
                HorizontalAlignment="Center"
                IsVisible="{Binding IsEmpty}"
                Margin="32"
                MaxWidth="420"
                Spacing="8"
                VerticalAlignment="Center">
                <TextBlock
                    Classes="h4"
                    HorizontalAlignment="Center"
                    Text="{Binding Texts[NoBotTitle]}" />
                <TextBlock
                    Classes="Small Muted"
                    Text="{Binding Texts[NoBotDetail]}"
                    TextAlignment="Center"
                    TextWrapping="Wrap" />
            </StackPanel>
            <ScrollViewer IsVisible="{Binding !IsEmpty}">
                <ItemsControl ItemsSource="{Binding Cards}" Margin="32,0,16,16">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="local:StrollCardModel">
                            <Border
                                Classes="Plate"
                                Margin="0,0,16,16"
                                Width="380">
                                <DockPanel>
                                    <Border Classes="PlateFooter" DockPanel.Dock="Bottom">
                                        <Panel>
                                            <StackPanel IsVisible="{Binding HasStroll}" Spacing="8">
                                                <Grid ColumnDefinitions="*,Auto">
                                                    <TextBlock
                                                        Classes="Small"
                                                        FontWeight="SemiBold"
                                                        Text="{Binding Texts[ThisStroll]}" />
                                                    <TextBlock
                                                        Classes="Caption Muted Figures"
                                                        Grid.Column="1"
                                                        Text="{Binding ProgressText}"
                                                        VerticalAlignment="Center" />
                                                </Grid>
                                                <ProgressBar Classes="Stroll" Value="{Binding Progress}" />
                                            </StackPanel>
                                            <TextBlock
                                                Classes="Caption Muted"
                                                IsVisible="{Binding !HasStroll}"
                                                Text="{Binding Texts[StartHint]}"
                                                TextWrapping="Wrap" />
                                        </Panel>
                                    </Border>
                                    <StackPanel Margin="20,18,20,20" Spacing="16">
                                        <Grid ColumnDefinitions="Auto,*,Auto">
                                            <Border Classes="Initials">
                                                <TextBlock
                                                    FontWeight="SemiBold"
                                                    HorizontalAlignment="Center"
                                                    Text="{Binding Initials}"
                                                    VerticalAlignment="Center" />
                                            </Border>
                                            <StackPanel
                                                Grid.Column="1"
                                                Margin="12,0"
                                                Spacing="1"
                                                VerticalAlignment="Center">
                                                <TextBlock
                                                    FontSize="16"
                                                    FontWeight="SemiBold"
                                                    Text="{Binding Name}"
                                                    TextTrimming="CharacterEllipsis" />
                                                <TextBlock Classes="Caption Muted" Text="{Binding Level}" />
                                            </StackPanel>
                                            <Border
                                                Classes="Chip"
                                                Classes.Strolling="{Binding IsStrolling}"
                                                Grid.Column="2">
                                                <TextBlock Text="{Binding Status}" />
                                            </Border>
                                        </Grid>
                                        <Grid ColumnDefinitions="*,*">
                                            <StackPanel>
                                                <TextBlock Classes="Coordinates" Text="{Binding Arrivals}" />
                                                <TextBlock Classes="Caption Muted" Text="{Binding ArrivalsLabel}" />
                                            </StackPanel>
                                            <StackPanel
                                                Grid.Column="1"
                                                Spacing="2"
                                                VerticalAlignment="Bottom">
                                                <TextBlock Classes="Caption Muted" Text="{Binding Texts[LastWalkTitle]}" />
                                                <TextBlock
                                                    Classes="Small Figures"
                                                    Text="{Binding LastWalk}"
                                                    TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                        </Grid>
                                    </StackPanel>
                                </DockPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Panel>
    </DockPanel>
</UserControl>
