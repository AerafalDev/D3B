<UserControl
    x:Class="MyPlugin.MyPluginPage"
    x:DataType="local:MyPluginPageModel"
    xmlns="https://github.com/avaloniaui"
    xmlns:local="clr-namespace:MyPlugin"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <DockPanel>
        <StackPanel Classes="PageHeader" DockPanel.Dock="Top">
            <TextBlock Classes="PageTitle" Text="{Binding Texts[PageTitle]}" />
            <TextBlock Classes="Small Muted" Text="{Binding Summary}" />
        </StackPanel>
        <ScrollViewer>
            <ItemsControl ItemsSource="{Binding Names}" Margin="32,0,32,32">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="x:String">
                        <Border
                            Classes="Plate"
                            Margin="0,0,0,12"
                            Padding="20,16">
                            <TextBlock FontWeight="SemiBold" Text="{Binding}" />
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </DockPanel>
</UserControl>
