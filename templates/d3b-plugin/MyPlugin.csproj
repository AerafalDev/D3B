<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <EnableDynamicLoading>true</EnableDynamicLoading>
<!--#if (Page) -->
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
<!--#endif -->
    <D3BPluginsDirectory>D3B_PLUGINS_DIRECTORY</D3BPluginsDirectory>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="D3B.Bot" Version="D3B_VERSION" ExcludeAssets="runtime" />
<!--#if (Page) -->
    <PackageReference Include="Avalonia" Version="12.1.4" ExcludeAssets="runtime" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" ExcludeAssets="runtime" />
<!--#endif -->
  </ItemGroup>

  <Target Name="DeployD3BPlugin" AfterTargets="Build" Condition="'$(D3BPluginsDirectory)' != ''">
    <ItemGroup>
      <_D3BPluginFiles Include="$(TargetDir)**\*" />
    </ItemGroup>
    <Copy SourceFiles="@(_D3BPluginFiles)"
          DestinationFiles="@(_D3BPluginFiles->'$(D3BPluginsDirectory)\$(AssemblyName)\%(RecursiveDir)%(Filename)%(Extension)')"
          SkipUnchangedFiles="true" />
    <Message Importance="high" Text="$(AssemblyName) -> deployed to $(D3BPluginsDirectory)\$(AssemblyName)" />
  </Target>

</Project>
